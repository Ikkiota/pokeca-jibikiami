    const row = i + 2, key = String(r[ZM.KEY - 1] || ''); if (!key) return;
    const cn = zCardNo_(key), grade = String(r[ZM.GRADE - 1] || '未鑑定');
    const o = own ? (own[key.toLowerCase() + '|' + grade] || (cn.num ? Object.keys(own).map(k => own[k]).find(x => x.num === cn.num && x.grade === grade && (!cn.set || !x.set || x.set.toLowerCase() === cn.set.toLowerCase())) : null)) : null;
    const ownN = o ? o.n : (Number(r[ZMX.OWN - 1]) || 0);
