/* ---------- v163：毎日の点検で見つかったところを自動で直す ----------
 *  1 レートテーブルの金額が足りない → 金額を入れ直す（eBayで手で変えられていても今の計算に戻す）
 *  2 v2の配送ポリシー（ない・レートテーブルにつながっていない・定額が足りない・料金のない国が送り先に入っている）→ 作り直し／直す
 *  4 燃油サーチャージが取れない・古い → 直せないので、直るまで新しい出品は今までの方法（商品ごとの正確な送料）にする
 *  直したあともう一度点検して、それでも残ったら新しい出品で v2 を使わないようにしてメールで知らせる
 *  出品中の商品の送料は変えない（点検の結果だけ知らせる）
 * ----------------------------------------------------------------- */
function rtAutoFix_() {
  const rs = rtSettings_();
  if (!rs.tableId || !rs.pol) return 'skip';
  const p = PropertiesService.getScriptProperties();
  const log = [];
  let r = rtAudit_({ listings: false });
  const before = r.findings.filter(x => x[0] === '赤字の危険');
  if (before.length) {
    const has = re => before.some(x => re.test(x[1] + ' ' + x[3] + ' ' + x[5]));
    if (has(/設定.*燃油|燃油サーチャージが取れていない/)) log.push('燃油サーチャージが取れていないので、直るまで新しい出品は今までの方法（商品ごとの正確な送料）にしました');
    if (has(/^レートテーブル/)) {
      try { const sy = rtSync_(); log.push('レートテーブルの金額を入れ直しました（' + sy.changed + '行）'); } catch (e) { log.push('レートテーブルの金額を入れ直せませんでした：' + e.message); }
    }
    if (has(/^配送ポリシー/) || before.some(x => x[1] === 'レートテーブル' && /料金がない国/.test(x[3]))) {
      try { rtEnsurePolicies_({ auto: true }); log.push('v2の配送ポリシーを今の内容に直しました（レートテーブル・定額の送料・送らない国）'); } catch (e) { log.push('v2の配送ポリシーを直せませんでした：' + e.message); }
    }
    r = rtAudit_({ listings: false });
  }
  const after = r.findings.filter(x => x[0] === '赤字の危険');
  const fuelBad = after.some(x => /燃油サーチャージが取れていない/.test(x[3]));
  if (after.length) {
    // 直らなかった：新しい出品では v2 を使わない（出品の確認で止まる）
    try { const live = JSON.parse(p.getProperty('RT_LIVE') || 'null'); if (live) { live.at = 0; p.setProperty('RT_LIVE', JSON.stringify(live)); } } catch (e) {}
    p.setProperty('RT_AUTOFIX_STOP', String(Date.now()));
  } else p.deleteProperty('RT_AUTOFIX_STOP');
  if ((before.length || after.length) && typeof rwQueue_ === 'function') {
    const subj = after.length ? '【国別送料】自動で直せないところが ' + after.length + '件あります（新しい出品は今までの方法で出品します）' : '【国別送料】送料の赤字の危険を ' + before.length + '件見つけて、自動で直しました';
    const body = ['毎日の点検で、国別送料（レートテーブル・v2の配送ポリシー・設定）を確かめました。', '',
      '■ 見つかったところ（直す前）：' + before.length + '件', before.slice(0, 15).map(x => '・' + x[2] + '：' + x[3]).join('\n'), '',
      '■ 自動でしたこと', log.length ? log.map(x => '・' + x).join('\n') : '・なし', '',
      '■ 直したあともう一度点検した結果：' + (after.length ? '赤字の危険が ' + after.length + '件残っています' : '送料の赤字は見つかりませんでした'),
      after.slice(0, 15).map(x => '・' + x[2] + '：' + x[3] + (x[5] ? '　→ ' + x[5] : '')).join('\n'),
      after.length ? '\n直るまで、新しい出品は今までの方法（商品ごとの正確な送料）で出品します。' + (fuelBad ? '燃油サーチャージが取れると、次の日の点検で自動で元に戻ります。' : 'このメールをClaudeに見せてください。') : '',
      '', '出品中の商品の送料は変えていません（メニューの「★ 国別送料をすべて点検する」で確かめられます）。', '詳しくは「国別送料の総点検」シート', ss_().getUrl()].join('\n');
    rwQueue_('料金変更', 'RTFIX|' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd'), subj, body); rwFlush_();
  }
  return after.length ? 'stopped' : before.length ? 'fixed' : 'ok';
}
