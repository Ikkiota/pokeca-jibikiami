      catch (e1) {
        if (!/400|Invalid/i.test(e1.message)) throw new Error(errText(e1));
        const b2 = JSON.parse(JSON.stringify(body));
        const intl = b2.shippingOptions.find(o => o.optionType === 'INTERNATIONAL');
        let changed = false;
        (intl.shippingServices || []).forEach(sv => { if (sv.shipToLocations && sv.shipToLocations.regionIncluded && sv.shipToLocations.regionIncluded.some(r => r.regionType === 'COUNTRY')) { sv.shipToLocations = { regionIncluded: [{ regionName: 'Worldwide' }] }; changed = true; } });
        if (changed) {
          try { const r = upsert1(b2); if (simplified.indexOf('eco') < 0) simplified.push('eco'); return r; } catch (e2) { if (!/400|Invalid/i.test(e2.message)) throw new Error(errText(e2)); }
        }
        const b3 = JSON.parse(JSON.stringify(b2));
        b3.shipToLocations = JSON.parse(JSON.stringify(base.shipToLocations || { regionIncluded: [{ regionName: 'Worldwide' }] }));
        try { const r = upsert1(b3); if (simplified.indexOf('excl') < 0) simplified.push('excl'); if (changed && simplified.indexOf('eco') < 0) simplified.push('eco'); return r; }
        catch (e3) {
          if (!/rateTableId/i.test(errText(e3))) throw new Error('配送ポリシーを作れませんでした：' + errText(e3));
