// まとめて送る：鍵を使わず、シートに1行足してすぐ返す（判定・在庫チェックは裏で）
function queueReceive_(d, bg) {
  const sh = ss_().getSheetByName('出品作成') || prepSheet_();
  const url = String(d.url || '').split('?')[0];
  const last = sh.getLastRow();
  if (last > 1) {
    const from = Math.max(2, last - 100);
    const rows = sh.getRange(from, 1, last - from + 1, Math.max(P.SRC, P.STATUS)).getValues();
    if (rows.some(r => String(r[P.SRC - 1]).split('?')[0] === url && /まとめ判定待ち|判定中/.test(String(r[P.STATUS - 1])))) {
      return quickPage_('この商品はすでに受け付けています', 'このタブは閉じて、次の商品へどうぞ。');
    }
  }
  let priceNum = Number(String(d.price || '').replace(/[^\d.]/g, '')) || '';
  if (!priceNum) { try { priceNum = zKcPriceByUrl_(d.url) || ''; } catch (e) {} }   // v201：ページから値段が読めないとき（Yahoo!フリマなど）は、出品候補（0円）に入っている値段を使う
  const r = new Array(PREP_HEADERS.length).fill('');
  r[P.DATE - 1] = new Date(); r[P.SRC - 1] = d.url || ''; r[P.NAME - 1] = String(d.title || '').replace(/｜Yahoo!フリマ（旧PayPayフリマ）$/, '');
  r[P.COST - 1] = priceNum; r[P.IMGS - 1] = (d.images || []).join('\n'); r[P.STATUS - 1] = 'まとめ判定待ち';
  r[P.RAW - 1] = JSON.stringify({ title: d.title, price: d.price, text: String(d.text || '').slice(0, 20000), pc: Number(d.pc) || 0, im: d.im || '', inote: d.inote || '', got: (d.images || []).length });
  photoLog_({ stage: '受信', url: d.url, method: d.im, page: d.pc, got: (d.images || []).length, sheet: (d.images || []).length, reason: d.inote || '' });
  r[P.GO - 1] = false;
  sh.appendRow(r);
  scheduleBatchSoon_();                    // 念のための予備（途中で止まっても1分後に続きから）
  if (bg) { try { zKcMarkSent_(d.url); } catch (e) {} return quickPage_('✅ 受け付けました（裏で判定・出品します）', esc_(String(d.title || '').slice(0, 80)) + '<br>1〜2分後から自動で、写真の確認 → 状態の判定 → 利益の計算 → 条件に合えば eBay に出品します。結果は「まとめ判定の結果」シートに入ります。<br>このタブはすぐ閉じて、次の商品へどうぞ。'); }   // v193
  try { batchJudge(); } catch (e) { scheduleBatchSoon_(); }   // v91：受け付けたその場で判定・出品を始める
  return quickPage_('✅ 受け付けました', esc_(String(d.title || '').slice(0, 80)) + '<br>判定・出品を始めました。結果は「まとめ判定の結果」シートに入ります。このタブは閉じて、次の商品へどうぞ。');
}
