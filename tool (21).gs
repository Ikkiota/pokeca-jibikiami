  else { p.setProperty('KW_TEST_LAST', String(Date.now())); const r = kwSearchRun_(true); msg = r.busy ? 'ほかの処理が動いていたので、次の定時から始めます。' : '今からリサーチを始めました（「キーワード検索（0円）」の D14 に進み具合）。'; }
  zLog_('リサーチのテスト', Utilities.formatDate(new Date(until), 'Asia/Tokyo', 'MM/dd HH:mm') + ' まで1時間ごとにリサーチする');
