  for (let i = 0; i < n; i++) {
    if (String(st[i][0]) !== 'エラー（準備）' || Number(co[i][0]) > 0) continue;
    const d = dt[i][0] instanceof Date ? dt[i][0].getTime() : Date.parse(String(dt[i][0]).replace(/\//g, '-')); if (d && d < lim) continue;
    const v = sh.getRange(i + 2, 1, 1, PREP_HEADERS.length).getValues()[0];
    try { if (zSentCost_(sh, i + 2, v) > 0) { sh.getRange(i + 2, P.STATUS).setValue('まとめ判定待ち'); back++; } } catch (e) {}
    if (back >= 60) break;
  }
  if (back) zLog_('送った品の仕入れ値', '値段が読めずに止まっていた ' + back + '件を、仕入れ値を補って判定待ちに戻した');
  return back;
}


/* =====================================================================
 * v215：オファーを必ず受けられるようにする
 *  ① 「出品一覧」の出品中の全部（「出品作成」に記録のない出品も）でオファーをオンにする。オンにできたかを eBay で確かめて「オファーの記録」に残す
