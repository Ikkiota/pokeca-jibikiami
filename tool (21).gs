    const itemId = String(g.item.getChildText('ItemID', ns));
    const ssx = g.item.getChild('SellingStatus', ns);
    const price = Number(g.item.getChildText('BuyItNowPrice', ns)) || Number(ssx ? ssx.getChildText('CurrentPrice', ns) : 0) || 0;
    const ri = pv.findIndex(v => String(v[P.ITEMID - 1]) === itemId);
    g.offers.getChildren('BestOffer', ns).forEach(bo => {
      const offerId = bo.getChildText('BestOfferID', ns), amt = Number(bo.getChildText('Price', ns)) || 0;
      const qty = Number(bo.getChildText('Quantity', ns)) || 1;
      const buyer = bo.getChild('Buyer', ns) ? bo.getChild('Buyer', ns).getChildText('UserID', ns) : '';
      const title = ri >= 0 ? String(pv[ri][P.TITLE - 1]).slice(0, 60) : '';
      if (ri < 0) { log.appendRow([new Date(), itemId, title, buyer, amt, price, '', 'そのまま', 'ツールで出品した記録がない商品のため、自動では処理しません（eBayの画面で判断してください）']); return; }
      const floor = zOfferFloor_(pv[ri]);   // v211：最低利益（設定F29）と売値で決まる利益率（追加の設定F303・F307）の両方を守る額
      const line = Math.max(floor, Math.ceil(price * os.ratio * 100) / 100);
      const base = '<ItemID>' + x_(itemId) + '</ItemID><BestOfferID>' + x_(offerId) + '</BestOfferID>';
      let action = '', res = '';
      try {
        if (!(floor > 0) || !(price > 0)) { action = 'そのまま'; res = '最低利益を守れる価格が分からないため、自動では処理しません'; }
        else if (qty > 1) { action = 'そのまま'; res = '2個以上のオファーのため、自動では処理しません'; }
        else if (zAskStateFor_(itemId, title, pv[ri][P.SRC - 1]) === 'out') { action = 'そのまま'; res = '仕入れ先が売り切れのため、自動では承認しません（「オファー・質問の在庫確認」シート）'; }   // v235
        else if (amt >= line) {
          trading_('RespondToBestOffer', base + '<Action>Accept</Action><SellerResponse>Thank you for your offer. Accepted!</SellerResponse>');
          action = '承認'; res = '✅ 承認しました'; done++;
        } else if (os.counter && line < price) {
          const counter = Math.min(Math.round((price - 0.01) * 100) / 100, Math.ceil(line * 100) / 100);
          trading_('RespondToBestOffer', base + '<Action>Counter</Action><CounterOfferPrice currencyID="USD">' + counter.toFixed(2) + '</CounterOfferPrice><CounterOfferQuantity>1</CounterOfferQuantity><SellerResponse>Thank you for your offer. This is the best price we can offer.</SellerResponse>');
          action = 'カウンター $' + counter.toFixed(2); res = '最低利益を割るため、守れる価格でカウンターしました'; done++;
        } else {
          trading_('RespondToBestOffer', base + '<Action>Decline</Action><SellerResponse>Thank you for your offer. Unfortunately we cannot accept this price.</SellerResponse>');
          action = '辞退'; res = '最低利益を割るため断りました'; done++;
        }
      } catch (e) { action = 'エラー'; res = String(e.message).slice(0, 200); }
      log.appendRow([new Date(), itemId, title, buyer, amt, price, floor || '', action, res]);
    });
  });
  return done;
}
