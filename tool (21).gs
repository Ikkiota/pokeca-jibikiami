// v184：出品候補（0円）で GO を付けた品のうち、「出品作成」で「候補」「候補（出品エラー）」のまま止まっている品を出品する
function zListGoWaiting_(deadline) {
  const intake = intakeSheet_(), n = intake.getLastRow() - 1;
  if (n < 1) return { ok: 0, err: 0 };
  const iv = intake.getRange(2, 1, n, IN_HEADERS.length).getValues();
  const goSrc = {}; iv.forEach((r, i) => { if (/^キーワード検索（0円/.test(String(r[IN.MEMO - 1] || ''))) goSrc[String(r[IN.URL - 1] || '').split('?')[0]] = i + 2; });
  const prep = prepSheet_(), pn = prep.getLastRow() - 1;
  if (pn < 1) return { ok: 0, err: 0 };
  const pv = prep.getRange(2, 1, pn, PREP_HEADERS.length).getValues(), ls = listingSettings_();
  let ok = 0, err = 0;
  for (let i = 0; i < pv.length; i++) {
    if (Date.now() > deadline) break;
    const r = pv[i], row = i + 2, st = String(r[P.STATUS - 1] || ''), src = String(r[P.SRC - 1] || '').split('?')[0];
    if (!(st === '候補' || st === '候補（出品エラー）') || !src || !goSrc[src] || String(r[P.ITEMID - 1] || '').trim()) continue;
    if (st === '候補（出品エラー）' && /二重出品|重複|未査定|傷・難あり/.test(String(r[P.NOTE - 1] || ''))) continue;
    const m0 = MANUAL_LIST_; MANUAL_LIST_ = true;
    try {
      const id = listRow_(prep, row, ls); ok++;
      intake.getRange(goSrc[src], IN.STATUS, 1, 2).setValues([['出品済み', 'eBay商品ID ' + id]]);
    } catch (e) {
      err++; prep.getRange(row, P.STATUS).setValue('候補（出品エラー）'); prep.getRange(row, P.NOTE).setValue(zLockNote_(e.message));
      intake.getRange(goSrc[src], IN.STATUS, 1, 2).setValues([['候補（出品エラー）', e.message + '／「出品作成」' + row + '行目']]);
    } finally { MANUAL_LIST_ = m0; }
  }
  return { ok: ok, err: err };
}
