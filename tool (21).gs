      a.n++; a.inT += Number(r[4]) + Number(r[6]) + Number(r[7]); a.outT += Number(r[5]); a.img += Number(r[9]) || 0; a.cost += cost; a.models[r[3]] = 1;
      if (item) { const b = byItem[item] = byItem[item] || { n: 0, cost: 0 }; b.n++; b.cost += cost; }
    });
