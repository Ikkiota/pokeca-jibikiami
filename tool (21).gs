function templateSheet_() {
  const ss = ss_();
  let sh = ss.getSheetByName('出品テンプレート');
  if (!sh) {
    sh = ss.insertSheet('出品テンプレート');
    sh.getRange('A1').setValue('説明文のテンプレート（A2のHTMLを毎回使います。書き換えると、次に作る出品から反映されます）').setFontWeight('bold');
    sh.getRange('A2').setValue(DEFAULT_TEMPLATE_HTML).setWrap(true).setVerticalAlignment('top');
    sh.setColumnWidth(1, 900);
  }
  return sh;
}
// 説明文は固定文（DEFAULT_TEMPLATE_HTML）をそのまま使う。シートを書き換えても反映しない（固定文を守るため）
function templateHtml_() {
  try {
    const sh = templateSheet_();
    if (String(sh.getRange('A2').getValue()) !== DEFAULT_TEMPLATE_HTML) sh.getRange('A2').setValue(DEFAULT_TEMPLATE_HTML);
    sh.getRange('A1').setValue('出品者の商品説明（固定文）。毎回この文をそのまま使います。ここを書き換えても反映されません（固定文を守るため）。');
  } catch (e) {}
  return DEFAULT_TEMPLATE_HTML;
}
function openTemplateSheet() { templateSheet_().activate(); }

