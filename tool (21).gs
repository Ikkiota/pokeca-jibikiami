// limit：切り替える件数の上限（0＝全部・時間切れなら自動で続ける）
function rtSwitchListings_(limit) {
  const rs = rtSettings_();
  if (!rs.on || !rs.pol) throw new Error('「設定」F210がオフ、またはv2の配送ポリシーがまだありません（「④」を押してください）');
  const p = PropertiesService.getScriptProperties();
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return { busy: true };
  try {
    const started = Date.now(), sh = prepSheet_(), log = rtSwitchLogSheet_();
    const n = Math.max(0, sh.getLastRow() - 1);
    const rows = n ? sh.getRange(2, 1, n, PREP_HEADERS.length).getValues() : [];
    let cur = limit ? 2 : (Number(p.getProperty('RT_SW_CURSOR')) || 2);
    let done = 0, kept = 0, failed = 0, row = cur;
    for (; row <= n + 1; row++) {
      if (Date.now() - started > 4 * 60 * 1000) break;
      if (limit && done >= limit) break;
      const r = rows[row - 2], itemId = String(r[P.ITEMID - 1] || '').trim();
      if (!itemId || String(r[P.STATUS - 1]) !== '出品済み') continue;
      if (/v2に切り替え済み/.test(String(r[P.NOTE - 1] || ''))) continue;
      const title = String(r[P.TITLE - 1] || '').slice(0, 40), when = new Date();
      const rtp = rtPolicyForRow_(r);
      if (!rtp) { kept++; log.appendRow([when, row, itemId, title, '', '今のまま', rtLastWhy_ || 'v2の確認に通らない']); continue; }
      let before;
      try { before = rtCurProfile_(itemId); } catch (e) { failed++; log.appendRow([when, row, itemId, title, '', '読めない', String(e.message).slice(0, 100)]); continue; }
      if (!before.active) continue;
      if (before.pid === rs.pol || before.pid === rs.polHi) { sh.getRange(row, P.NOTE).setValue(String(r[P.NOTE - 1] || '') + '／v2に切り替え済み'); continue; }
      try {
        accountGuard_('出品中の商品の配送ポリシーの切り替え');
        trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(itemId) + '</ItemID><SellerProfiles><SellerShippingProfile><ShippingProfileID>' + x_(rtp.id) + '</ShippingProfileID></SellerShippingProfile></SellerProfiles>' + (rtp.xml || '') + '</Item>');
        const after = rtCurProfile_(itemId);
        if (after.pid !== String(rtp.id)) throw new Error('切り替えたあと確かめたら、配送ポリシーが変わっていなかった（' + after.pid + '）');
        done++;
        sh.getRange(row, P.NOTE).setValue(String(r[P.NOTE - 1] || '') + '／v2に切り替え済み（' + Utilities.formatDate(when, 'Asia/Tokyo', 'MM/dd') + '・前のポリシー ' + before.pid + '）');
        log.appendRow([when, row, itemId, title, before.pid, '✅ v2に切り替えた（確認済み）', rtp.note]);
      } catch (e) { failed++; log.appendRow([when, row, itemId, title, before.pid, '❌ 切り替えられなかった（今のまま）', String(e.message).slice(0, 150)]); }
    }
    const more = row <= n + 1 && !(limit && done >= limit);
    if (!limit) {
      if (more) { p.setProperty('RT_SW_CURSOR', String(row)); try { runSoon_('rtSwitchContinue'); } catch (e) {} }
      else p.deleteProperty('RT_SW_CURSOR');
    }
    return { done: done, kept: kept, failed: failed, more: more };
  } finally { lock.releaseLock(); }
}
