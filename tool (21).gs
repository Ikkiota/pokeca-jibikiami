      '元の配送ポリシー（' + (base.name || ls.shipId) + '）の発送日数・除外国・米国の配送を引き継ぎました' + ((sync.plan.noRate || []).length && simplified.indexOf('excl') < 0 ? '（送料表に料金がない ' + sync.plan.noRate.join('・') + ' は送らない国に入れました）' : '') +
      (simplified.length ? '。※eBayに細かい指定を断られたので、' + simplified.map(x => x === 'eco' ? '安い便はどの国にも出す形' : x === 'domrt' ? '国内の配送はレートテーブルなし' : '送らない国は元のポリシーのまま').join('・') + 'にしました（送れない国・料金のない国がある商品は、出品の確認で自動で今までの方法になります）' : '') + '。今のポリシーと出品中の商品は変えていません。テストのあと「設定」F210をオンにすると、新しい出品から使います';
  }
