  if (!sh) sh = ss.insertSheet('広告の点検');
  sh.clear(); sh.getRange(1, 1, 1, 7).setValues([['点検日時', 'eBay商品ID', 'タイトル', '値段$', '広告率（%）', '判定', 'したこと']]).setFontWeight('bold').setBackground('#e8f0fe'); sh.setFrozenRows(1); sh.setColumnWidth(3, 320); sh.setColumnWidth(6, 200); sh.setColumnWidth(7, 360);
  const rows = [], t0 = Date.now(), now = new Date();
  out.listings = items.length;
