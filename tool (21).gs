// v163：v2の配送ポリシーを今の内容にそろえる（なければ作る・あれば直す）。④と自動の修正の両方で使う
function rtEnsurePolicies_(opt) {
  opt = opt || {};
  {
    const rs = rtSettings_(), ls = listingSettings_();
    const id = rtTableId_(rs);
    const table = ebay_('get', '/sell/account/v2/rate_table/' + encodeURIComponent(id));
    const base = ebay_('get', '/sell/account/v1/fulfillment_policy/' + ls.shipId);
    const exc = ((base.shipToLocations || {}).regionExcluded || []).map(r => String(r.regionName || ''));
    PropertiesService.getScriptProperties().setProperty('RT_EXCLUDED', JSON.stringify(exc));
    const sync = rtSync_();                      // 先に金額を入れる（入れられないときは、ポリシーも作らない）
    // v163：送料表に料金がない国（ロシアなど）は、v2のポリシーでは送らない国に入れる（その国からの注文で赤字にならないように）
    const baseLoc = JSON.parse(JSON.stringify(base.shipToLocations || { regionIncluded: [{ regionName: 'Worldwide' }] }));
    baseLoc.regionExcluded = (baseLoc.regionExcluded || []).slice();
    (sync.plan.noRate || []).forEach(cc => { if (!baseLoc.regionExcluded.some(r => String(r.regionName) === cc)) baseLoc.regionExcluded.push({ regionName: cc, regionType: 'COUNTRY' }); });
    const codes = rtServiceCodes_(table);
