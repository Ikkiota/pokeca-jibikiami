    '／レートテーブル ' + sum.table + '（国×便）を ' + weights.length + 'つの重さで確認・出品中の商品 ' + sum.listings + '件（足りない ' + sum.listingsShort + '件）・手数料と広告費 ' + Math.round(fee * 1000) / 10 + '%・為替 ' + fx + '円').setFontWeight('bold').setFontColor(danger ? '#b00020' : '#188038');
  const head = ['重要度', '区分', '対象', '内容', '足りない額（$）', '直し方'];
