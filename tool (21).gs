 * ===================================================================== */
const DEFAULT_ARRIVAL_BODY =
  'Hi! I hope your package arrived safely 😊\n\n' +
  'Thank you so much for your purchase — I hope you enjoy your item!\n\n' +
  'If you have any questions or concerns, please feel free to reach out anytime.\n\n' +
