function batchJudge() { return zTimed_('batchJudge', batchJudgeCore_); }   // v149：動いた時間を数える
function batchJudgeCore_() {
  if (zGhListOn_()) return;   // v245：GitHub がする
  if (!ZB_MANUAL_ && zTimeLeft_() < 5 * 60) { ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'batchJudge').forEach(t => ScriptApp.deleteTrigger(t)); zLogOnce_('時間の節約', '今日の動作時間が残り少ないので、まとめ判定は明日に回す'); return; }   // v149
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'batchJudge').forEach(t => ScriptApp.deleteTrigger(t));
  PropertiesService.getScriptProperties().deleteProperty('BATCH_SCHEDULED');
  const props = PropertiesService.getScriptProperties();
  const running = Number(props.getProperty('BATCH_RUNNING') || 0);
  if (running && Date.now() - running < 6 * 60 * 1000) return;          // 別のまとめ判定が動いている
  props.setProperty('BATCH_RUNNING', String(Date.now()));
  const done = [];
  try {
    ZSENT_ = true;   // v208
    try { zRescueCost_(); } catch (e) {}   // v214：値段が読めずに止まった送った品を、判定待ちに戻す
    const sh = prepSheet_();
    const ls = listingSettings_();
    const bs = batchSheet_();
    const started = Date.now();
    while (Date.now() - started < 4.5 * 60 * 1000 && (!ZB_DEADLINE_ || Date.now() < ZB_DEADLINE_)) {
      if (apiBudgetOver_()) { apiBudgetNotify_(); break; }   // v104：APIの予算の上限に達したら、新しい商品の判定を始めない
      // 次の1件を取り出す（ここだけ一瞬、鍵を使う）
      let row = 0;
      const lock = LockService.getScriptLock();
      if (!lock.tryLock(3000)) { Utilities.sleep(2000); continue; }
      try {
        const last = sh.getLastRow();
        if (last >= 2) {
          const st = sh.getRange(2, P.STATUS, last - 1, 1).getValues().map(r => r[0]);
          const i = st.indexOf('まとめ判定待ち');
          if (i >= 0) { row = i + 2; sh.getRange(row, P.STATUS).setValue('判定中'); SpreadsheetApp.flush(); }
        }
      } finally { lock.releaseLock(); }
      if (!row) break;

      const v = sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0];
      const base = [new Date(), '', v[P.NAME - 1], v[P.COST - 1], '', '', '', '', v[P.SRC - 1], '', prepTag_(v[P.DATE - 1])];
      let link = '';
      try {
        // 出品中の商品の仕入れ先なら、在庫チェック
        const hit = findListingBySource_(String(v[P.SRC - 1] || ''));
        if (hit) {
          let raw = {}; try { raw = JSON.parse(v[P.RAW - 1] || '{}'); } catch (e) {}
          stockCheck_(hit, { url: v[P.SRC - 1], title: raw.title || v[P.NAME - 1], price: raw.price || v[P.COST - 1], text: raw.text || '',
            images: String(v[P.IMGS - 1] || '').split(/\n+/).filter(x => x) });
          sh.deleteRow(row);
          base[1] = '🔁 在庫チェック'; base[7] = '出品中の商品だったため、在庫チェックを行いました（出品一覧の仕入れ先の状態を確認してください）';
        } else {
          sh.getRange(row, P.STATUS).setValue('受信');
          try { zSentCost_(sh, row, v); } catch (e) {}   // v208：値段が読めなかった品は、ほかの場所から仕入れ値を補う
          // v105（E）：14日以内に判定した同じ商品は、前の結果を使う
          const ru = reuseJudged_(sh, row);
          if (ru && ru.skip) {
            sh.deleteRow(row);
            base[1] = ru.label; base[7] = ru.skip;
            bs.appendRow(base); bs.getRange(bs.getLastRow(), 2).setBackground(batchColor_(base[1])); done.push(base);
            continue;
          }
          let pr = null;
          if (ru && ru.useRow) { sh.deleteRow(row); row = ru.useRow; }
          else pr = zPrepare_(sh, row, { early: true });   // v120：トレカは0円の判定
          if (pr && pr.earlyStop) {
            archiveRejected_(sh, row, pr.earlyStop);
            base[1] = '⏸ 見送り'; base[7] = pr.earlyStop + '（早期判定：写真分析・出品文の作成は省略）';
            bs.appendRow(base); bs.getRange(bs.getLastRow(), 2).setBackground(batchColor_(base[1])); done.push(base);
            continue;
          }
          const g = gateCandidate_(sh, row, ls);
          const r2 = sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0];
          if (g.ok) {
            let res = '✅ 候補', memo = g.summary;
            if (ls.autoList) {
              try { const id = listRow_(sh, row, ls); res = '🎉 出品'; memo = 'eBay商品ID ' + id + '／' + g.summary; }
              catch (e) {
                const unrated = /^未査定/.test(String(e.message));
                sh.getRange(row, P.STATUS).setValue(unrated ? '未査定（要確認）' : '候補（出品エラー）'); sh.getRange(row, P.NOTE).setValue(zLockNote_(e.message));
                res = unrated ? '⏳ 未査定（要確認）' : zIsLockErr_(e.message) ? '⏳ 順番待ち（10分ほどで自動で出品し直す）' : '⚠ 出品エラー'; memo = e.message;   // v237
              }
            }
            base[1] = res; base[4] = r2[P.PRICE - 1]; base[5] = g.profit; base[6] = r2[P.METHOD - 1]; base[7] = memo + '（出品作成 ' + row + '行目）';
          } else if (g.hold || g.keep) {
            base[1] = /^判定保留/.test(String(g.reason)) ? '⏳ 判定保留（Sold待ち）' : '⏳ 保留'; base[7] = g.reason + '（出品作成 ' + row + '行目）';
            link = prepSoldLink_(sh, row);
          } else {
            archiveRejected_(sh, row, g.reason, g.detailText);
            base[1] = '⏸ 見送り'; base[7] = g.reason;
          }
        }
      } catch (e) {
        try { sh.getRange(row, P.STATUS).setValue('エラー（準備）'); sh.getRange(row, P.NOTE).setValue(e.message); } catch (x) {}
        base[1] = '❌ エラー'; base[7] = e.message;
      }
      bs.appendRow(base);
      bs.getRange(bs.getLastRow(), 2).setBackground(batchColor_(base[1]));
      if (link) setBatchLink_(bs, bs.getLastRow(), link);
      done.push(base);
    }
  } finally { props.deleteProperty('BATCH_RUNNING'); ZSENT_ = false; }
  const acc = JSON.parse(props.getProperty('BATCH_DONE') || '[]').concat(done.map(b => [b[1], String(b[2]).slice(0, 80), b[4], b[5], String(b[7]).slice(0, 160)]));
  props.setProperty('BATCH_DONE', JSON.stringify(acc.slice(-150)));
  if (queueCount_() > 0) { if (!apiBudgetOver_()) scheduleBatchSoon_(); return; }   // v104：予算の上限のときは予約しない
  // v91：1件ずつその場で判定するので、メールは最後の判定から20分後にまとめて1通
  if (acc.length) {
    ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'batchDigest').forEach(t => ScriptApp.deleteTrigger(t));
    try { ScriptApp.newTrigger('batchDigest').timeBased().after(20 * 60 * 1000).create(); } catch (e) { batchDigest(); }
  }
}

function batchDigest() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'batchDigest').forEach(t => ScriptApp.deleteTrigger(t));
  const props = PropertiesService.getScriptProperties();
  const acc = JSON.parse(props.getProperty('BATCH_DONE') || '[]');
  props.deleteProperty('BATCH_DONE');
  if (!acc.length) return;
  {
    const cnt = k => acc.filter(a => String(a[0]).indexOf(k) >= 0).length;
    MailApp.sendEmail(Session.getEffectiveUser().getEmail(), '【まとめ判定】出品 ' + cnt('出品') + '件・候補 ' + cnt('候補') + '件・Sold待ち ' + cnt('判定保留') + '件・見送り ' + cnt('見送り') + '件',
      acc.map(a => a[0] + '　' + a[1] + (a[2] ? '　$' + a[2] : '') + (a[3] ? '　利益' + Number(a[3]).toLocaleString() + '円' : '') + '\n　' + String(a[4]).slice(0, 160)).join('\n') +
      (cnt('判定保留') ? '\n\nSold待ちの商品は、「まとめ判定の結果」のJ列「eBayでSoldを見る」を開いて「Soldを送る」を押すと、判定し直して出品まで進みます（メニュー「出品管理」→「Sold確認待ちの一覧を開く」でもまとめて見られます）。' : '') +
      '\n\n「まとめ判定の結果」シート：' + ss_().getUrl());
  }
}

function menuBatchJudge() {
  run_(() => { const n = queueCount_(); if (!n) return 'まとめ判定待ちの商品はありません'; batchJudge(); return 'まとめ判定を実行しました（残り ' + queueCount_() + '件）。結果は「まとめ判定の結果」シートにあります'; });
