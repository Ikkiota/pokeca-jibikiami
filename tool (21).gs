/* =====================================================================
 * 出品管理（Trading API）
 *  - 出品中の商品をシートに取り込み
 *  - シートで価格・在庫数を書き換えて、チェックした行だけeBayに反映
 *  - 仕入れ値・仕入れURL・メモ列は、取り込み直しても消えません
 * ===================================================================== */
const TRADING_URL = 'https://api.ebay.com/ws/api.dll';
const TRADING_SITE_ID = '0'; // 0 = eBay US
const LCOL = { ID: 1, SKU: 2, TITLE: 3, PRICE: 4, CUR: 5, QTY: 6, WATCH: 7, NEW_PRICE: 8, NEW_QTY: 9,
               APPLY: 10, RESULT: 11, URL: 12, COST: 13, SRC_URL: 14, MEMO: 15, CHECKED: 16, SRC_STATE: 17 };
const LIST_HEADERS = ['商品ID', 'SKU', 'タイトル', '現在価格', '通貨', '在庫数', 'ウォッチ数',
  '新しい価格', '新しい在庫数', '反映する', '結果', 'URL', '仕入れ値（円）', '仕入れURL', 'メモ', '最終在庫チェック', '仕入れ先の状態'];

function trading_(callName, innerXml) {
  for (let attempt = 0; attempt < 2; attempt++) {
    const xml = '<?xml version="1.0" encoding="utf-8"?><' + callName + 'Request xmlns="urn:ebay:apis:eBLBaseComponents">' +
      '<ErrorLanguage>en_US</ErrorLanguage><WarningLevel>High</WarningLevel>' + innerXml + '</' + callName + 'Request>';
    const res = UrlFetchApp.fetch(TRADING_URL, {
      method: 'post',
      contentType: 'text/xml',
      headers: {
        'X-EBAY-API-SITEID': TRADING_SITE_ID,
        'X-EBAY-API-COMPATIBILITY-LEVEL': '1193',
        'X-EBAY-API-CALL-NAME': callName,
        'X-EBAY-API-IAF-TOKEN': getToken_('user'),
      },
      payload: xml,
      muteHttpExceptions: true,
    });
    const root = XmlService.parse(res.getContentText()).getRootElement();
    const ns = root.getNamespace();
    const ack = root.getChildText('Ack', ns);
    const errors = root.getChildren('Errors', ns)
      .filter(e => e.getChildText('SeverityCode', ns) === 'Error')
      .map(e => e.getChildText('LongMessage', ns) || e.getChildText('ShortMessage', ns));
    if ((ack === 'Failure' || ack === 'PartialFailure') && errors.length) {
      if (attempt === 0 && /token/i.test(errors.join(' '))) { CacheService.getScriptCache().remove('tok_user'); continue; }
      throw new Error(errors.join(' / '));
    }
    return { root: root, ns: ns };
  }
}

function listSheet_() {
  const ss = ss_();
  let sh = ss.getSheetByName('出品一覧');
  if (!sh) {
    sh = ss.insertSheet('出品一覧');
    sh.getRange(1, 1, 1, LIST_HEADERS.length).setValues([LIST_HEADERS]).setFontWeight('bold').setBackground('#e8f0f2');
    sh.getRange(1, LCOL.NEW_PRICE, 1, 2).setBackground('#fff4dc');
    sh.getRange(1, LCOL.COST, 1, 3).setBackground('#eef6e8');
    sh.setFrozenRows(1);
    sh.setFrozenColumns(1);
    [110, 100, 380, 80, 50, 60, 70, 90, 90, 70, 220, 160, 100, 200, 180, 120, 240].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  }
  if (sh.getRange(1, LCOL.CHECKED).getValue() === '') {
    sh.getRange(1, LCOL.CHECKED, 1, 2).setValues([['最終在庫チェック', '仕入れ先の状態']]).setFontWeight('bold').setBackground('#eef6e8');
    sh.setColumnWidth(LCOL.CHECKED, 120).setColumnWidth(LCOL.SRC_STATE, 240);
    sh.getRange(2, LCOL.CHECKED, 999, 1).setNumberFormat('yyyy/mm/dd hh:mm');
  }
  return sh;
}

function importListings() {
  run_(() => '出品中の商品を ' + importListings_() + '件 取り込みました');
}

function importListings_() {
  {
    const sh = listSheet_();
    // 手入力の列（仕入れ値・仕入れURL・メモ）を商品IDごとに退避
    const keep = {};
    if (sh.getLastRow() > 1) {
      sh.getRange(2, 1, sh.getLastRow() - 1, LIST_HEADERS.length).getValues().forEach(r => {
        keep[String(r[0])] = [r[LCOL.COST - 1], r[LCOL.SRC_URL - 1], r[LCOL.MEMO - 1], r[LCOL.CHECKED - 1], r[LCOL.SRC_STATE - 1]];
      });
    }

    const rows = [];
    let page = 1, totalPages = 1;
    do {
      const out = trading_('GetMyeBaySelling',
        '<ActiveList><Include>true</Include><Pagination><EntriesPerPage>200</EntriesPerPage><PageNumber>' + page +
        '</PageNumber></Pagination></ActiveList>');
      const ns = out.ns;
      const active = out.root.getChild('ActiveList', ns);
      if (!active) break;
      const pr = active.getChild('PaginationResult', ns);
      totalPages = pr ? Number(pr.getChildText('TotalNumberOfPages', ns)) || 1 : 1;
      const arr = active.getChild('ItemArray', ns);
      (arr ? arr.getChildren('Item', ns) : []).forEach(it => {
        const id = it.getChildText('ItemID', ns);
        const ss = it.getChild('SellingStatus', ns);
        const priceEl = ss ? ss.getChild('CurrentPrice', ns) : null;
        const ld = it.getChild('ListingDetails', ns);
        const isVar = !!it.getChild('Variations', ns);
        const type = it.getChildText('ListingType', ns);
        const k = keep[id] || ['', '', '', '', ''];
        let note = '';
        if (isVar) note = 'バリエーション出品（このツールでは未対応）';
        else if (type === 'Chinese') note = 'オークション（価格変更は未対応）';
        rows.push([id, it.getChildText('SKU', ns) || '', it.getChildText('Title', ns) || '',
          priceEl ? Number(priceEl.getText()) : '', priceEl && priceEl.getAttribute('currencyID') ? priceEl.getAttribute('currencyID').getValue() : '',
          Number(it.getChildText('QuantityAvailable', ns) || it.getChildText('Quantity', ns) || 0),
          Number(it.getChildText('WatchCount', ns) || 0),
          '', '', false, note, ld ? ld.getChildText('ViewItemURL', ns) : '', k[0], k[1], k[2], k[3], k[4]]);
      });
      page++;
    } while (page <= totalPages && page <= 25);

    if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, LIST_HEADERS.length).clearContent().removeCheckboxes();
    if (rows.length) {
      sh.getRange(2, 1, rows.length, LIST_HEADERS.length).setValues(rows);
      sh.getRange(2, LCOL.APPLY, rows.length, 1).insertCheckboxes();
      sh.getRange(2, LCOL.PRICE, rows.length, 1).setNumberFormat('#,##0.00');
      sh.getRange(2, LCOL.NEW_PRICE, rows.length, 1).setNumberFormat('#,##0.00');
    }
    return rows.length;
  }
}

function applyListingChanges() {
  run_(() => {
    const sh = listSheet_();
    const last = sh.getLastRow();
    if (last < 2) throw new Error('先に「出品中の商品を取り込む」を実行してください');
    const data = sh.getRange(2, 1, last - 1, LIST_HEADERS.length).getValues();
    const stamp = () => Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm');
    let ok = 0, ng = 0;

    data.forEach((r, i) => {
      if (r[LCOL.APPLY - 1] !== true) return;
      const row = i + 2;
      const newPrice = r[LCOL.NEW_PRICE - 1], newQty = r[LCOL.NEW_QTY - 1];
      const setResult = (msg, success) => {
        sh.getRange(row, LCOL.RESULT).setValue(msg);
        sh.getRange(row, LCOL.APPLY).setValue(false);
        success ? ok++ : ng++;
      };
      if (newPrice === '' && newQty === '') return setResult('新しい価格か在庫数を入れてください', false);
      if (newPrice !== '' && !(Number(newPrice) > 0)) return setResult('価格が正しくありません', false);
      if (newQty !== '' && !(Number(newQty) >= 0 && Number.isInteger(Number(newQty)))) return setResult('在庫数は0以上の整数で入れてください', false);
      if (String(r[LCOL.RESULT - 1]).includes('未対応')) return setResult(r[LCOL.RESULT - 1], false);
      // 値下げの関門：利益が最低利益額を下回る価格、または利益を確かめられない値下げは、反映しない
      if (newPrice !== '' && Number(newPrice) < Number(r[LCOL.PRICE - 1])) {
        const chk = priceGuard_(String(r[LCOL.ID - 1]), Number(newPrice));
        if (!chk.ok) return setResult('⛔ 反映しませんでした：' + chk.reason + '（価格は $' + r[LCOL.PRICE - 1] + ' のまま）', false);
      }

      let inner = '<InventoryStatus><ItemID>' + r[LCOL.ID - 1] + '</ItemID>';
      if (newPrice !== '') inner += '<StartPrice>' + Number(newPrice) + '</StartPrice>';
      if (newQty !== '') inner += '<Quantity>' + Number(newQty) + '</Quantity>';
      inner += '</InventoryStatus>';
      try {
        trading_('ReviseInventoryStatus', inner);
        if (newPrice !== '') sh.getRange(row, LCOL.PRICE).setValue(Number(newPrice));
        if (newQty !== '') sh.getRange(row, LCOL.QTY).setValue(Number(newQty));
        sh.getRange(row, LCOL.NEW_PRICE, 1, 2).setValues([['', '']]);
        setResult('反映済み ' + stamp(), true);
      } catch (e) {
        setResult('エラー：' + e.message, false);
      }
    });
    if (!ok && !ng) throw new Error('「反映する」にチェックが入っている行がありません');
    return '反映 ' + ok + '件' + (ng ? '、エラー ' + ng + '件（結果列を確認してください）' : '');
  });
}

