  const imgsBySrc = {}; pv.forEach(r => { const u = String(r[P.SRC - 1] || '').split('?')[0]; const im = String(r[P.IMGS - 1] || '').split(/\n+/).map(x => x.trim()).filter(x => /^https?:\/\//.test(x) && !Z_BANNER_RX.test(x)); if (u && im.length && (!imgsBySrc[u] || im.length > imgsBySrc[u].length)) imgsBySrc[u] = im; });
  const t0 = Date.now(), cut = Date.now() - 14 * 86400000; let done = 0, failed = 0, ok = 0, more = false; const notes = [];
  for (let i = 0; i < lv.length; i++) {
    const r = lv[i], row = i + 2, itemId = String(r[LCOL.ID - 1] || '').trim(), memo = String(r[LCOL.MEMO - 1] || '');
    if (!itemId || /写真OK2|写真を入れ直した2/.test(memo)) continue;   // v175：前の「写真OK」は1枚目を見ていなかったので、もう一度確かめる
    const d = r[LCOL.CHECKED - 1]; if (d instanceof Date && d.getTime() < cut) continue;
    if (Date.now() - t0 > 4.5 * 60 * 1000) { more = true; break; }
    try {
      const urls = ebayPictureUrls_(itemId), cnt = urls ? urls.length : -1;
      const imgs = imgsBySrc[String(r[LCOL.SRC_URL - 1] || '').split('?')[0]] || [];
      // v175：1枚目も含めて、全部の写真が eBay の写真サーバー（ebayimg.com）にあるか。外のURL（明るさ補正のURLなど）が混ざっていたら入れ直す
      const allHosted = urls && urls.length > 0 && urls.every(u => /ebayimg\.com/i.test(u));
      if (!(allHosted && cnt >= Math.min(imgs.length || 1, 24)) && imgs.length) { const k0 = zDropBanners_(imgs); imgs.length = 0; k0.forEach(x => imgs.push(x)); }   // v180：案内画像を入れ直さない
      if (allHosted && cnt >= Math.min(imgs.length || 1, 24)) { ls.getRange(row, LCOL.MEMO).setValue(memo + (memo ? '／' : '') + '写真OK2（' + cnt + '枚）'); ok++; continue; }
      if (cnt < 0) throw new Error('eBay で写真の枚数を確かめられなかった');
      if (!imgs.length) throw new Error('出品作成に、この仕入れ先の写真がない');
      const eps = uploadPictures_(imgs.slice(0, 24));
      trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(itemId) + '</ItemID><PictureDetails>' + eps.map(u => '<PictureURL>' + x_(u) + '</PictureURL>').join('') + '</PictureDetails></Item>');
      const c2 = ebayPictureCount_(itemId);
      ls.getRange(row, LCOL.MEMO).setValue(memo + (memo ? '／' : '') + '写真を入れ直した2（' + cnt + '枚 → ' + c2 + '枚・' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）');
      done++;
