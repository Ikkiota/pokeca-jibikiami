}

/* =====================================================================
 * v145：重複の候補を出さない（同じカード＝同じ型番・同じ鑑定は、候補に1つだけ）
 *  ・まだ GO していない同じカードの候補があれば、安い方だけ残す（高い方は「重複」にして GO できなくする）
 *  ・7日以内に GO した・出品に回した同じカードがあれば、新しい候補は入れない（同じカードを二重に出品しない）
 *  ・仕入れ先が違っても（楽天とYahoo!ショッピングの同じお店など）同じカードなら1つにまとめる
 *  ・型番が分からない品（BOX など）は、今までどおり URL で重複を見る
 * ===================================================================== */
function zKcCardKey_(r) { const k0 = String(r[KC.KEY - 1] || '').trim(), k = ((zCardNo_(k0).num || k0) + '').toLowerCase().replace(/\s+/g, ' '); /* v182：「SM3+ 075/072」と「075/072」を同じカードにする */ return k ? k + '|' + String(r[KC.GRADE - 1] || '未鑑定').trim() : ''; }
function zKcAppend_(kc, rows) {
  const n = kc.getLastRow() - 1, since = Date.now() - 7 * 86400000;
  const v = n > 0 ? kc.getRange(2, 1, n, KC_HEAD.length).getValues() : [];
  const pend = {}, done = {};
  v.forEach((r, i) => {
    const k = zKcCardKey_(r); if (!k) return;
    const st = String(r[KC.STATE - 1] || '');
    if (/^重複（同じカード|^写真が少ない/.test(st)) return;
    if (!st || /^要：/.test(st)) { const ph0 = zKcPhotoCount_(r); if (r[KC.GO - 1] !== true && (!pend[k] || zKcBetter_(Number(r[KC.YEN - 1]) || 0, ph0, pend[k].yen, pend[k].ph))) pend[k] = { row: i + 2, yen: Number(r[KC.YEN - 1]) || 0, ph: ph0 }; }
    else if (r[KC.DATE - 1] instanceof Date && r[KC.DATE - 1].getTime() >= since) done[k] = i + 2;
  });
  const keep = [], batch = {}, listed = zListedCardKeys_();   // v163：もう eBay に出品中の同じカードは候補に入れない
  let dup = 0;
  // v167：同じカードは「写真が多い品」を優先（値段の差が15％以内なら）。それ以外は安い品
  const sorted = rows.slice().sort((a, b) => zKcBetter_(Number(a[KC.YEN - 1]) || 0, zKcPhotoCount_(a), Number(b[KC.YEN - 1]) || 0, zKcPhotoCount_(b)) ? -1 : 1);
  sorted.forEach(r => {
    const k = zKcCardKey_(r);
    if (!k) { keep.push(r); return; }
    if (batch[k] || done[k] || listed.has(zKcListedKey_(r))) { dup++; return; }
    const pv = pend[k];
    if (pv && !zKcBetter_(Number(r[KC.YEN - 1]) || 0, zKcPhotoCount_(r), pv.yen, pv.ph)) { dup++; return; }
    if (pv) { kc.getRange(pv.row, KC.STATE).setValue('重複（同じカードで写真が多い・安い品を下に入れた）'); kc.getRange(pv.row, KC.GO).setValue(false); }
    batch[k] = 1; keep.push(r);
  });
  if (keep.length) {
    const start = kc.getLastRow() + 1;
    kc.getRange(start, 1, keep.length, KC_HEAD.length).setValues(keep);
    kc.getRange(start, KC.GO, keep.length, 1).insertCheckboxes();
    kc.getRange(start, KC.URL, keep.length, 1).setRichTextValues(keep.map(r => [SpreadsheetApp.newRichTextValue().setText('開く').setLinkUrl(String(r[KC.URL - 1])).build()]));
  }
  return { added: keep, dup: dup };
}
// 今ある候補の重複を片付ける（GO していない同じカードは、いちばん安い1つだけ残す）
function zKcDedupNow_() {
  const kc = kcSheet_(), n = kc.getLastRow() - 1;
  if (n < 1) return 0;
  const v = kc.getRange(2, 1, n, KC_HEAD.length).getValues(), best = {}, done = {};
  v.forEach((r, i) => { const k = zKcCardKey_(r); if (!k) return; const st = String(r[KC.STATE - 1] || ''); if (/^重複|^写真が少ない/.test(st)) return;
    if (st && !/^要：/.test(st)) { done[k] = i + 2; return; }
    if (!best[k]) { best[k] = i + 2; return; } const b = v[best[k] - 2];
    if (zKcBetter_(Number(r[KC.YEN - 1]) || 0, zKcPhotoCount_(r), Number(b[KC.YEN - 1]) || 0, zKcPhotoCount_(b))) best[k] = i + 2; });   // v167：写真の多い品を優先
  let marked = 0;
  v.forEach((r, i) => { const k = zKcCardKey_(r); if (!k) return; const st = String(r[KC.STATE - 1] || ''); if (st && !/^要：/.test(st)) return; if (/^重複|^写真が少ない/.test(st)) return;
    const row = i + 2;
    if (done[k]) { kc.getRange(row, KC.STATE).setValue('重複（同じカードを ' + done[k] + '行目でもう GO した）'); kc.getRange(row, KC.GO).setValue(false); marked++; }
    else if (best[k] !== row) { kc.getRange(row, KC.STATE).setValue('重複（同じカードの安い品が ' + best[k] + '行目にある）'); kc.getRange(row, KC.GO).setValue(false); marked++; } });
