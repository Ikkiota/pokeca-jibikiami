      .sort((x, y) => y[6] - x[6]);
    const items = Object.keys(byItem).map(k => byItem[k]);
    const avg = items.length ? items.reduce((s2, b) => s2 + b.cost, 0) / items.length : 0;
    out.getRange(1, 1).setValue('API使用量の集計（' + v.length + '回の呼び出し・合計 $' + total.toFixed(2) + '）').setFontWeight('bold').setFontSize(13);
    out.getRange(2, 1).setValue('商品ごと（仕入れURL・商品IDつきの呼び出し）：' + items.length + '件・1件あたり平均 $' + avg.toFixed(4) + ' → 100件 $' + (avg * 100).toFixed(2) + '・1,000件 $' + (avg * 1000).toFixed(2));
    out.getRange(4, 1, 1, 9).setValues([['工程', '回数', '平均入力トークン', '平均出力トークン', '平均の画像枚数', '1回あたり（ドル）', '合計（ドル）', '割合', 'モデル']]).setFontWeight('bold').setBackground('#e8f0f2');
    if (rows.length) out.getRange(5, 1, rows.length, 9).setValues(rows);
    [220, 60, 110, 110, 100, 110, 90, 60, 200].forEach((w, i) => out.setColumnWidth(i + 1, w));
    out.activate();
    return '集計しました：合計 $' + total.toFixed(2) + '・商品1件あたり平均 $' + avg.toFixed(4);
  });
}

function claude_(key, model, system, user) {
  apiBudgetCheck_();
  const res = UrlFetchApp.fetch('https://api.anthropic.com/v1/messages', {
    method: 'post',
    contentType: 'application/json',
    headers: { 'x-api-key': key, 'anthropic-version': '2023-06-01' },
    payload: JSON.stringify(apiBody_({ model: model, max_tokens: 2000, system: system, messages: [{ role: 'user', content: user }] })),
    muteHttpExceptions: true,
  });
  const j = JSON.parse(res.getContentText() || '{}');
  apiRecord_(model, j.usage, res.getResponseCode(), Array.isArray(user) ? user.filter(c => c && c.type === 'image').length : 0);
  if (res.getResponseCode() !== 200) throw new Error('Claude API：' + (j.error ? j.error.message : res.getContentText()));
  return (j.content || []).filter(b => b.type === 'text').map(b => b.text).join('\n');
}

function parseJson_(text) {
  const t = text.replace(/```json|```/g, '').trim();
  try { return JSON.parse(t.slice(t.indexOf('{'), t.lastIndexOf('}') + 1)); }
  catch (e) { return { buyer_ja: '', reply: t, reply_ja: '' }; }
}

/* ========== 送信 ========== */
function processQueue_() {
  const sh = sheet_('メッセージ');
  const last = sh.getLastRow();
  if (last < 2) return { sent: 0 };
  const data = sh.getRange(2, 1, last - 1, MSG_HEADERS.length).getValues();
  const now = new Date();
  let sent = 0;

  data.forEach((r, i) => {
    const row = i + 2;
    if (r[COL.OK - 1] !== true || r[COL.STATUS - 1] === '送信済み') return;
    const at = r[COL.SEND_AT - 1];
    if (at instanceof Date && at > now) return;
    const reply = String(r[COL.REPLY - 1] || '').trim();
    const fail = msg => {
      sh.getRange(row, COL.STATUS).setValue('エラー');
      sh.getRange(row, COL.NOTE).setValue(msg);
      sh.getRange(row, COL.OK).setValue(false);
    };
    if (!reply) return fail('返信文が空です');
    if (reply.includes('[要確認')) return fail('「[要確認]」を消してから、もう一度チェックしてください');
    if (reply.length > 2000) return fail('2000文字を超えています（' + reply.length + '文字）');
    try {
      const sentRes = ebay_('post', '/commerce/message/v1/send_message', { body: { conversationId: r[COL.CONV - 1], messageText: reply } });
      if (sentRes && sentRes.messageId) sh.getRange(row, COL.MSG_ID).setValue(String(r[COL.MSG_ID - 1]) + ',' + String(sentRes.messageId));
      sh.getRange(row, COL.STATUS).setValue('送信済み');
      sh.getRange(row, COL.NOTE).setValue('送信：' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm'));
      try {
        ebay_('post', '/commerce/message/v1/update_conversation',
          { body: { conversationId: r[COL.CONV - 1], conversationType: 'FROM_MEMBERS', read: true } });
      } catch (e) {}
      sent++;
    } catch (e) {
      fail('送信エラー：' + e.message);
    }
  });
  return { sent: sent };
}

// 「送信OK」にチェックを入れたら、送信予定時刻を自動でセット
function onEdit(e) {
  if (onEditPolicy_(e)) return;
  if (onEditPurchaseList_(e)) return;
  const r = e.range, sh = r.getSheet();
  if (sh.getName() !== 'メッセージ' || r.getColumn() !== COL.OK || r.getRow() < 2 || r.getNumRows() > 1) return;
  const row = r.getRow();
  const status = sh.getRange(row, COL.STATUS);
  if (status.getValue() === '送信済み') return;
  if (r.getValue() === true) {
    const at = sh.getRange(row, COL.SEND_AT);
    if (!at.getValue()) at.setValue(new Date(Date.now() + (Number(getSettings_().delay) || 0) * 60000));
    status.setValue('送信待ち');
  } else if (status.getValue() === '送信待ち') {
    status.setValue('下書き済み（確認してください）');
  }
}

/* ========== リサーチ ========== */
function runResearch() {
  run_(() => {
    const sh = sheet_('リサーチ');
    const v = sh.getRange('B1:B5').getValues().map(x => x[0]);
    const kw = String(v[0]).trim();
    if (!kw) throw new Error('B1にキーワードを入れてください');
    const limit = Math.min(200, Math.max(1, Number(v[1]) || 50));
    const mk = String(v[2] || 'EBAY_US').trim();
    const sort = { 'おすすめ順': '', '安い順': 'price', '高い順': '-price', '新着順': 'newlyListed', '終了間近': 'endingSoonest' }[v[3]] || '';
    const cond = { '新品': 'NEW', '中古': 'USED' }[v[4]] || '';

    let q = '/buy/browse/v1/item_summary/search?q=' + encodeURIComponent(kw) + '&limit=' + limit;
    if (sort) q += '&sort=' + sort;
    if (cond) q += '&filter=' + encodeURIComponent('conditions:{' + cond + '}');
    const res = ebay_('get', q, { kind: 'app', marketplace: mk });
    const items = res.itemSummaries || [];

    const rows = items.map(it => {
      const price = Number(it.price && it.price.value) || 0;
      const so = it.shippingOptions && it.shippingOptions[0];
      const ship = so && so.shippingCost ? Number(so.shippingCost.value) : '';
      return [it.title || '', price, ship, price + (Number(ship) || 0), it.price ? it.price.currency : '',
        it.condition || '', it.seller ? it.seller.username : '', it.seller ? it.seller.feedbackPercentage : '',
        it.itemLocation ? it.itemLocation.country : '', (it.buyingOptions || []).join(','), it.itemWebUrl || '', it.itemId || ''];
    });

    if (sh.getMaxRows() > 8) sh.getRange(9, 1, sh.getMaxRows() - 8, 12).clearContent();
    if (rows.length) sh.getRange(9, 1, rows.length, 12).setValues(rows);

    const totals = rows.map(r => r[3]).filter(n => n > 0).sort((a, b) => a - b);
    const avg = totals.length ? totals.reduce((a, b) => a + b, 0) / totals.length : '';
    const med = totals.length ? (totals.length % 2 ? totals[(totals.length - 1) / 2]
      : (totals[totals.length / 2 - 1] + totals[totals.length / 2]) / 2) : '';
    sh.getRange('D1:E5').setValues([
      ['検索ヒット総数', res.total || 0],
      ['取得件数', rows.length],
      ['最安（送料込み）', totals.length ? totals[0] : ''],
      ['中央値（送料込み）', med],
      ['平均（送料込み）', avg],
    ]);
    sh.getRange('D1:D5').setFontWeight('bold');
    sh.getRange('E3:E5').setNumberFormat('#,##0.00');
    return '「' + kw + '」を ' + rows.length + '件 取得しました';
  });
}

/* ========== 自動実行 ========== */
function autoRun() { if (zGhCustOn_()) return; return zTimed_('autoRun', autoRunCore_); }   // v247：GitHub がする   // v149：動いた時間を数える
function autoRunCore_() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return;
  const note = [];
  try {
    try { const f = fetchMessages_(); note.push('取得 ' + f.added + '件'); } catch (e) { note.push('取得エラー：' + e.message); }
    if (getSettings_().autoDraft) {
      try { const d = draftReplies_(5); note.push(d.noKey ? '下書き：APIキー未登録' : '下書き ' + d.drafted + '件'); }
      catch (e) { note.push('下書きエラー：' + e.message); }
    }
    try { const s = processQueue_(); note.push('送信 ' + s.sent + '件'); } catch (e) { note.push('送信エラー：' + e.message); }
    try { const pl = syncPurchaseList_(); if (pl.added) note.push('仕入れリスト +' + pl.added + '件'); } catch (e) { note.push('仕入れリストエラー：' + e.message); }
    try { const pm = sendPurchaseMessages_(); if (pm.enabled) note.push('購入後 ' + pm.sent + '件'); } catch (e) { note.push('購入後エラー：' + e.message); }
    try {
      const sm = sendShipMessages_();
      if (sm.enabled) note.push('発送後 ' + sm.sent + '件' + (sm.waiting ? '（追跡番号待ち・確認待ち ' + sm.waiting + '件）' : ''));
    } catch (e) { note.push('発送後エラー：' + e.message); }
    try { const am = sendArrivalMessages_(); if (am.enabled) note.push('到着後 ' + am.sent + '件'); } catch (e) { note.push('到着後エラー：' + e.message); }
  } finally {
    sheet_('設定').getRange('B6').setValue(Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '　' + note.join(' / '));
    lock.releaseLock();
  }
}

function enableAuto() {
  disableAuto(true);
  ScriptApp.newTrigger('autoRun').timeBased().everyMinutes(30).create();   // v146：5分ごと → 30分ごと（1日の動作時間の上限のため）
  SpreadsheetApp.getUi().alert('自動実行をオンにしました。30分ごとに「取得 → 下書き → 送信」を行います。');
}

function disableAuto(silent) {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'autoRun').forEach(t => ScriptApp.deleteTrigger(t));
  if (silent !== true) SpreadsheetApp.getUi().alert('自動実行をオフにしました。');
}

