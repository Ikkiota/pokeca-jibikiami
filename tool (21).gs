 * 発送方法ごとの配送ポリシー
 *  ・エコノミー（SpeedPAK）で送る商品 → SpeedPAKの配送サービスが入ったポリシー
 *  ・エアパケ(US)で送る商品 → エアパケ用のポリシー
 *  ・どちらもeBayの一覧から人が選ぶ。選んだときに、ポリシーの中身（配送サービス）をeBayから読んで確かめる
 *  ・出品のたびに実在を確認し、見つからなければ止める（替えない）
 * ===================================================================== */
function methodPolicies_() {
  const p = PropertiesService.getScriptProperties();
  return { eco: { id: p.getProperty('SHIP_POLICY_ECO_ID') || '', name: p.getProperty('SHIP_POLICY_ECO_NAME') || '' },
           air: { id: p.getProperty('SHIP_POLICY_AIR_ID') || '', name: p.getProperty('SHIP_POLICY_AIR_NAME') || '' },
           fed: { id: p.getProperty('SHIP_POLICY_FED_ID') || '', name: p.getProperty('SHIP_POLICY_FED_NAME') || '' } };   // v115：FedEx便
}

// 発送方法に合った配送ポリシー（選んでいなければ、前の「固定」を使う）
function policyForMethod_(method) {
  const mp = methodPolicies_();
  const m = String(method || '');
  if (/エコノミー/.test(m) && mp.eco.id) return mp.eco;
  if (/エアパケ/.test(m) && mp.air.id) return mp.air;
  if (/FedEx/i.test(m) && mp.fed.id) return mp.fed;   // v115
  if (/FedEx/i.test(m) && !mp.fed.id && zShipRule_().on) throw new Error('FedEx便の商品ですが、FedEx用の配送ポリシーが選ばれていません。メニュー「0円の自動化」→「FedEx便（SpeedPAK Expedited）用の配送ポリシーを選ぶ」で選んでください');
  if (mp.eco.id || mp.air.id) {
    // 片方しか選んでいない、またはFedEx・DHLなどの場合：選んでいる方を使わず、止める（間違った表示を防ぐ）
    throw new Error('発送方法「' + (m || '不明') + '」に合う配送ポリシーが選ばれていません。「出品管理」→「発送方法ごとの配送ポリシーを選ぶ」で選んでください');
  }
  return fixedShipPolicy_();
}

// ポリシーの中身（配送サービスの名前）をeBayから読む（Account API）
function policyServices_(id) {
  try {
    const pol = ebay_('get', '/sell/account/v1/fulfillment_policy/' + encodeURIComponent(id));
    const out = [];
    (pol.shippingOptions || []).forEach(o => (o.shippingServices || []).forEach(sv =>
      out.push((o.optionType === 'DOMESTIC' ? '米国：' : '海外：') + sv.shippingServiceCode + (sv.freeShipping ? '（無料）' : sv.shippingCost ? '（$' + sv.shippingCost.value + '）' : ''))));
    return out;
  } catch (e) { return null; }
}

