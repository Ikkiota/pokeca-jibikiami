// 今付いている広告（一般・売れたら課金）：商品ID → { cid, rate }
function zAdMap_() {
  const map = {};
  const camps = ebay_('get', '/sell/marketing/v1/ad_campaign?limit=200');
  (camps.campaigns || []).filter(c => c.campaignStatus === 'RUNNING' && c.fundingStrategy && c.fundingStrategy.fundingModel === 'COST_PER_SALE').forEach(c => {
    let offset = 0;
    for (let page = 0; page < 20; page++) {
      const ads = ebay_('get', '/sell/marketing/v1/ad_campaign/' + c.campaignId + '/ad?limit=500&offset=' + offset);
      (ads.ads || []).forEach(a => { if (a.listingId) map[String(a.listingId)] = { cid: c.campaignId, rate: Number(a.bidPercentage) || 0 }; });
      if (!ads.next || !(ads.ads || []).length) break;
      offset += 500;
    }
  });
  return map;
}
// 過去60日：広告経由で売れた件数（Finances の AD_FEE）と、売れた件数（注文）
function zAdPerf_() {
  const by = {}, since = new Date(Date.now() - 60 * 86400000).toISOString(), until = new Date().toISOString();
  let note = '';
  try {
    let offset = 0;
    for (let page = 0; page < 20; page++) {
      const res = ebay_('get', 'https://apiz.ebay.com/sell/finances/v1/transaction?limit=200&offset=' + offset + '&filter=' + encodeURIComponent('transactionType:{NON_SALE_CHARGE},transactionDate:[' + since + '..' + until + ']'));
      (res.transactions || []).forEach(t => {
        if (String(t.feeType || '') !== 'AD_FEE') return;
        const ref = (t.references || []).find(x => /ITEM/i.test(String(x.referenceType || '')));
        if (!ref) return;
        const o = by[String(ref.referenceId)] = by[String(ref.referenceId)] || { ad: 0, sold: 0 }; o.ad++;
      });
      if (!res.next || !(res.transactions || []).length) break;
      offset += 200;
    }
  } catch (e) { note = '広告の実績を読めませんでした（広告率は上げません）'; }
  try {
    let url = '/sell/fulfillment/v1/order?limit=200&filter=' + encodeURIComponent('creationdate:[' + since + '..]');
    for (let page = 0; page < 10 && url; page++) {
      const res = ebay_('get', url);
      (res.orders || []).forEach(o => (o.lineItems || []).forEach(li => { const k = String(li.legacyItemId || ''); if (k) (by[k] = by[k] || { ad: 0, sold: 0 }).sold++; }));
      url = res.next ? res.next.replace(/^https:\/\/api\.ebay\.com/, '') : '';
    }
  } catch (e) {}
  return { by: by, note: note, ok: !note };
}
// eBayの推奨の広告率（まとめて500件ずつ）
function zAdSuggest_(ids) {
  const out = {};
  for (let i = 0; i < ids.length; i += 500) {
    try {
      const res = ebay_('post', '/sell/recommendation/v1/find?filter=' + encodeURIComponent('recommendationTypes:{AD}'), { marketplace: 'EBAY_US', body: { listingIds: ids.slice(i, i + 500) } });
      (res.listingRecommendations || []).forEach(rec => {
        const b = rec && rec.marketing && rec.marketing.ad && rec.marketing.ad.bidPercentages ? rec.marketing.ad.bidPercentages : [];
        const tr = b.find(x => x.basis === 'TRENDING') || b[0];
        if (tr) out[String(rec.listingId)] = Number(tr.value);
      });
    } catch (e) {}
  }
  return out;
}
const ZA_HEAD = ['反映する', 'eBay商品ID', '商品', '今の広告率%', 'eBayの推奨%', '利益を守れる上限%', '利益の30%まで%', '過去60日：広告で売れた／売れた', '新しい広告率%（0＝止める）', '変更後の利益（円・1件）', '理由', '結果', '出品作成の行'];
function zAdPlan_() {
  const st = zAdSettings_(), cs = calcSettings_(), off = official_();
  const inc = off.pl || 0.051, mult = 1 + st.tax;
  const prep = prepSheet_();
  const pv = prep.getLastRow() > 1 ? prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues() : [];
  const rows = pv.map((r, i) => ({ r: r, row: i + 2 })).filter(x => String(x.r[P.ITEMID - 1] || '').trim() && String(x.r[P.STATUS - 1]) === '出品済み');
  const ads = zAdMap_(), perf = zAdPerf_(), sug = zAdSuggest_(rows.map(x => String(x.r[P.ITEMID - 1])));
  const out = [];
  rows.forEach(x => {
    const r = x.r, id = String(r[P.ITEMID - 1]);
    const price = Number(r[P.PRICE - 1]) || 0, fx = Number(r[P.FX - 1]) || 0, f = Number(r[P.FRATE - 1]) || 0, t = Number(r[P.TRATE - 1]) || 0;
    if (!(price > 0 && fx > 0 && f > 0)) return;
    const sales = price * fx;
    const profit0 = sales * (1 - (f - inc) - t) - (Number(r[P.COST - 1]) || 0) - (Number(r[P.SHIP - 1]) || 0) - (Number(r[P.FIXED - 1]) || 0);
    const capProfit = Math.max(0, (profit0 - cs.minProfit) / (sales * mult) * 100);
    const capShare = Math.max(0, profit0 * st.share / (sales * mult) * 100);
    const cur = ads[id] ? ads[id].rate : 0, sg = sug[id] != null ? sug[id] : null;
    if (!cur && sheet_('設定').getRange('F78').getValue() === false) return;   // 広告を自動で付けない設定（F78）のときは、広告のない商品に新しく付けない
    const pf = perf.by[id] || { ad: 0, sold: 0 };
    const listed = r[P.DATE - 1] instanceof Date ? (Date.now() - r[P.DATE - 1].getTime()) / 86400000 : 0;
    let target = Math.min(/教科書/.test(String(r[P.FEETXT - 1] || '')) ? Z_TB.ad * 100 : AD_CAP, capProfit, capShare, sg != null ? sg : (cur || AD_MIN));   // v256：教科書の見積の品は 2.2% まで
    let nr, why;
    if (pf.ad > 0 && perf.ok) { nr = Math.min(target, (cur || AD_MIN) + st.step); why = '広告で売れている（' + pf.ad + '件）→ 上限の範囲で' + (nr > cur ? '上げる' : 'そのまま'); }
    else if (listed >= st.days && !pf.sold) { nr = Math.min(target, Math.max(0, (cur || AD_MIN) - st.step)); why = '出品から' + Math.floor(listed) + '日・売れていない → 0.5ポイント下げる'; }
    else if (pf.sold && !pf.ad) { nr = Math.min(target, cur || AD_MIN); why = '広告なしで売れている → 上げない'; }
    else { nr = Math.min(target, cur || AD_MIN); why = '実績がまだない → 上げない（利益の条件・5.1%の範囲）'; }
    nr = Math.floor(nr * 10) / 10;
    if (nr < AD_MIN) { nr = 0; why += '／2%未満になるので広告を止める'; }
    if (Math.abs(nr - cur) < 0.05) return;   // 変わらない商品は出さない
    const profitAfter = Math.round(profit0 - sales * (nr / 100) * mult);
    out.push([true, id, String(r[P.TITLE - 1] || '').slice(0, 60), cur || '（なし）', sg != null ? sg : '不明', Math.floor(capProfit * 10) / 10, Math.floor(capShare * 10) / 10, pf.ad + '／' + pf.sold, nr, profitAfter, why, '', x.row]);
  });
  const ss = ss_(); let sh = ss.getSheetByName('広告率の試算'); if (!sh) sh = ss.insertSheet('広告率の試算');
  sh.clear();
  sh.getRange(1, 1, 1, ZA_HEAD.length).setValues([ZA_HEAD]).setFontWeight('bold').setBackground('#e8f0fe').setWrap(true);
  if (out.length) { sh.getRange(2, 1, out.length, ZA_HEAD.length).setValues(out); sh.getRange(2, 1, out.length, 1).insertCheckboxes(); out.forEach((o, i) => sh.getRange(i + 2, 1).setValue(true)); }
  sh.setFrozenRows(1); sh.setColumnWidth(3, 280); sh.setColumnWidth(11, 360);
  return { sheet: sh, changes: out.length, note: perf.note, ads: ads };
}
function zAdApply_(sh, ads) {
  ads = ads || zAdMap_();
  const n = sh.getLastRow() - 1;
  if (n < 1) return { done: 0, failed: 0 };
  const v = sh.getRange(2, 1, n, ZA_HEAD.length).getValues();
  let done = 0, failed = 0;
  v.forEach((r, i) => {
    if (r[0] !== true || String(r[11] || '')) return;
    const id = String(r[1]), nr = Number(r[8]) || 0, a = ads[id];
    try {
      if (nr > AD_CAP) throw new Error('5.1%を超えるので反映しません');
      if (nr === 0) { if (a) ebay_('post', '/sell/marketing/v1/ad_campaign/' + a.cid + '/bulk_delete_ads_by_listing_id', { body: { requests: [{ listingId: id }] } }); }
      else if (a) ebay_('post', '/sell/marketing/v1/ad_campaign/' + a.cid + '/bulk_update_ads_bid_by_listing_id', { body: { requests: [{ listingId: id, bidPercentage: nr.toFixed(1) }] } });
      else ebay_('post', '/sell/marketing/v1/ad_campaign/' + adCampaignId_() + '/bulk_create_ads_by_listing_id', { body: { requests: [{ listingId: id, bidPercentage: nr.toFixed(1) }] } });
      const chk = nr === 0 ? { rate: '—' } : verifyAdRate_(id);
      sh.getRange(i + 2, 12).setValue(nr === 0 ? '✅ 広告を止めた' : '✅ ' + chk.rate + '%（eBayで確認済み）');
      done++;
    } catch (e) { sh.getRange(i + 2, 12).setValue('❌ ' + String(e.message).slice(0, 120)); failed++; }
  });
  return { done: done, failed: failed };
}

