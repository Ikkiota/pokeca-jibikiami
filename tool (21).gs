  // 売れた日（末尾の 919 → 9/19、1001・101 → 10/1）
  const dm = t.match(/(?:\s|[^\x00-\x7F])(\d{3,4})$/);
  if (dm) {
    const d = dm[1], now = new Date(), y = now.getFullYear(), cands = [];
    const add = (mo, da) => { if (mo >= 1 && mo <= 12 && da >= 1 && da <= 31) { let dt = new Date(y, mo - 1, da); if (dt > now) dt = new Date(y - 1, mo - 1, da); cands.push(dt); } };
    if (d.length === 3) { add(+d[0], +d.slice(1)); if (/^1[0-2]/.test(d)) add(+d.slice(0, 2), +d[2]); } else if (/^1[0-2]/.test(d)) add(+d.slice(0, 2), +d.slice(2));
    if (cands.length) { cands.sort((a, b) => b - a); o.date = Utilities.formatDate(cands[0], 'Asia/Tokyo', 'M/d'); t = t.slice(0, dm.index + dm[0].length - d.length).trim(); }
  }
  // v132：O13・N05・D20（O＝10月・N＝11月・D＝12月）も売れた日として読む（文の途中でも）
  t = t.replace(/(^|[^A-Za-z0-9])([OND])(\d{2})(?![A-Za-z0-9])/g, (a, p, m, dd) => { if (+dd >= 1 && +dd <= 31) { if (!o.date) o.date = ({ O: 10, N: 11, D: 12 })[m] + '/' + (+dd); return p + ' '; } return a; }).replace(/\s+/g, ' ').trim();
  const pm = t.match(/\$\s*([\d,]+(?:\.\d{1,2})?)/); if (pm) o.price = Number(pm[1].replace(/,/g, ''));
  // プロモの番号（039/BW P → 039/BW-P、025/P）
  t = t.replace(/(\d{1,3})\s*\/\s*(SV|SM|XY|BW|DP|S|M)\s?P\b/gi, (a, n, s) => n + '/' + s.toUpperCase() + '-P');
  let cn = zCardNo_(t);
