function zAdMap_() {
  const map = {};
  const camps = ebay_('get', '/sell/marketing/v1/ad_campaign?limit=200');
  (camps.campaigns || []).filter(c => c.campaignStatus === 'RUNNING' && c.fundingStrategy && c.fundingStrategy.fundingModel === 'COST_PER_SALE').forEach(c => {
    let offset = 0;
    for (let page = 0; page < 40; page++) {
      const ads = ebay_('get', '/sell/marketing/v1/ad_campaign/' + c.campaignId + '/ad?limit=500&offset=' + offset);
      (ads.ads || []).forEach(a => { if (a.listingId) map[String(a.listingId)] = { cid: c.campaignId, rate: Number(a.bidPercentage), status: a.adStatus || '', camp: c.campaignName || c.campaignId }; });   // v220：cid を足す（同じ名前の関数が2つあり、広告の最適化が cid を使うため）
      if (!ads.next || !(ads.ads || []).length) break;
      offset += 500;
    }
  });
  return map;
}
function zAdCheckAll_(fix) {
  const out = { listings: 0, ok: 0, low: 0, none: 0, paused: 0, fixed: 0, cannot: 0, more: false };
  const map = zAdMap_();
  const l = listSheet_(); if (l.getLastRow() < 2) return out;
  const items = l.getRange(2, 1, l.getLastRow() - 1, LIST_HEADERS.length).getValues().filter(v => String(v[LCOL.ID - 1] || '').trim() && Number(v[LCOL.QTY - 1]) > 0).map(v => ({ id: String(v[LCOL.ID - 1]).trim(), t: String(v[LCOL.TITLE - 1] || ''), price: Number(v[LCOL.PRICE - 1]) || 0 }));
