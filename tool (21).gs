/* v214：「エラー（準備）」で止まった送った品のうち、商品ページの文から仕入れ値が分かるものを「まとめ判定待ち」に戻す（14日以内・0円） */
function zRescueCost_() {
  const sh = prepSheet_(), n = sh.getLastRow() - 1; if (n < 1) return 0;
  const st = sh.getRange(2, P.STATUS, n, 1).getValues(), co = sh.getRange(2, P.COST, n, 1).getValues(), dt = sh.getRange(2, P.DATE, n, 1).getValues();
