// 直す（ReviseFixedPriceItem）→ もう一度読んで確かめる
function rtApplyListingFix_(pl, changes) {
  const ov = '<ShippingServiceCostOverrideList>' + changes.map(c => '<ShippingServiceCostOverride><ShippingServicePriority>' + c.prio + '</ShippingServicePriority><ShippingServiceType>International</ShippingServiceType>' +
    '<ShippingServiceCost currencyID="USD">' + c.to.toFixed(2) + '</ShippingServiceCost><ShippingServiceAdditionalCost currencyID="USD">' + c.to.toFixed(2) + '</ShippingServiceAdditionalCost></ShippingServiceCostOverride>').join('') + '</ShippingServiceCostOverrideList>';
  const prof = pl.pid ? '<SellerProfiles><SellerShippingProfile><ShippingProfileID>' + x_(pl.pid) + '</ShippingProfileID></SellerShippingProfile></SellerProfiles>' : '';
  try { accountGuard_('出品中の商品の海外送料の自動修正'); trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(pl.itemId) + '</ItemID>' + prof + ov + '</Item>'); }
  catch (e) { return { ok: false, why: 'eBayに断られた（' + String(e.message).slice(0, 80) + '）' }; }
  // 確かめる：もう一度読んで、直した配送サービスの送料が上がっているか
  try {
    const res = trading_('GetItem', '<ItemID>' + x_(pl.itemId) + '</ItemID><DetailLevel>ReturnAll</DetailLevel>');
    const ns = res.ns, sd = res.root.getChild('Item', ns).getChild('ShippingDetails', ns);
    const now = {};
    (sd ? sd.getChildren('InternationalShippingServiceOption', ns) : []).forEach(o => { now[Number(o.getChildText('ShippingServicePriority', ns))] = Number(o.getChildText('ShippingServiceCost', ns)) || 0; });
    const bad = changes.filter(c => !(now[c.prio] >= c.to - 0.005));
    if (bad.length) return { ok: false, why: '直したあと確かめたら、送料が変わっていなかった（優先 ' + bad.map(c => c.prio).join('・') + '）' };
  } catch (e) { return { ok: false, why: '直したあと確かめられなかった（' + String(e.message).slice(0, 60) + '）' }; }
  return { ok: true };
}
