}

// 自動で読める仕入れ先のページを取得（在庫の文言を含む本文と、構造化データの在庫状況）
function fetchStockPage_(url) {
  const host = (String(url).match(/^https?:\/\/([^\/?#]+)/i) || [])[1] || '';
  if (!host || NO_FETCH_SITES.test(host)) return { skip: true, note: '規約上、自動では読めないサイト' };
  if (!robotsAllow_(url)) return { skip: true, note: 'robots.txtで自動の読み取りが許可されていないサイト' };
  let res;
  try { res = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true, headers: { 'Accept-Language': 'ja,en;q=0.8' } }); }
  catch (e) { return { ok: false, note: 'ページを開けませんでした（' + e.message + '）' }; }
  const code = res.getResponseCode();
  if (code !== 200) return { ok: false, code: code, note: 'ページを開けませんでした（' + code + '）' };
  const html = res.getContentText();
  const avail = [];
  (html.match(/"availability"\s*:\s*"[^"]+"/gi) || []).forEach(m => { const v = m.replace(/.*:\s*"|"$/g, '').replace(/^https?:\/\/schema\.org\//i, ''); if (avail.indexOf(v) < 0) avail.push(v); });
  const title = ((html.match(/<title>([\s\S]*?)<\/title>/i) || [])[1] || '').replace(/\s+/g, ' ').trim();
  const text = html.replace(/<script[\s\S]*?<\/script>/gi, ' ').replace(/<style[\s\S]*?<\/style>/gi, ' ').replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();
  return { ok: true, title: title, text: (avail.length ? '【構造化データの在庫状況】' + avail.join(', ') + '\n' : '') + text.slice(0, 12000),
    price: Number(((html.match(/"price"\s*:\s*"?([\d.,]+)/i) || [])[1] || '').replace(/,/g, '')) || '' };
}

// 6時間ごとの在庫管理のあとに呼ばれる：確認する商品の順番を作って、1件ずつ確認を始める
function startAutoStockRound_() {
  const lsh = ss_().getSheetByName('出品一覧');
  if (!lsh || lsh.getLastRow() < 2) return;
  const rows = lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues();
  const list = rows.filter(r => (Number(r[LCOL.QTY - 1]) || 0) > 0 && /^https?:\/\//.test(String(r[LCOL.SRC_URL - 1] || '')))
    .filter(r => { const h = (String(r[LCOL.SRC_URL - 1]).match(/^https?:\/\/([^\/?#]+)/i) || [])[1] || ''; return !NO_FETCH_SITES.test(h); })
    .sort((a, b) => (a[LCOL.CHECKED - 1] instanceof Date ? a[LCOL.CHECKED - 1].getTime() : 0) - (b[LCOL.CHECKED - 1] instanceof Date ? b[LCOL.CHECKED - 1].getTime() : 0))
    .map(r => String(r[LCOL.ID - 1]));
  const p = PropertiesService.getScriptProperties();
  p.setProperty('AUTO_STOCK_QUEUE', JSON.stringify(list));
  p.setProperty('AUTO_STOCK_SUMMARY', JSON.stringify({ start: Date.now(), total: list.length, ok: 0, delisted: 0, review: 0, failed: 0, skipped: 0, items: [] }));
  if (list.length) autoStockCheck(); else autoStockFinish_();
}

function scheduleAutoStock_() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'autoStockCheck').forEach(t => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('autoStockCheck').timeBased().after(60 * 1000).create();
}

// 1件ずつ丁寧に確認（1回の実行は4分まで。残りは1分後に続きから）
function autoStockCheck() {
  if (zGhCareOn_()) return;   // v246：GitHub がする
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'autoStockCheck').forEach(t => ScriptApp.deleteTrigger(t));
  const p = PropertiesService.getScriptProperties();
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) { scheduleAutoStock_(); return; }
  let queue, sum;
  try {
    queue = JSON.parse(p.getProperty('AUTO_STOCK_QUEUE') || '[]');
    sum = JSON.parse(p.getProperty('AUTO_STOCK_SUMMARY') || '{}');
  } finally { lock.releaseLock(); }
  const started = Date.now();
  const lsh = listSheet_();
  while (queue.length && Date.now() - started < 4 * 60 * 1000) {
    const itemId = queue.shift();
    try {
      const vals = lsh.getLastRow() > 1 ? lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues() : [];
      const i = vals.findIndex(v => String(v[LCOL.ID - 1]) === itemId);
      if (i < 0) { sum.skipped++; continue; }
      const r = vals[i], url = String(r[LCOL.SRC_URL - 1] || '');
      if (!((Number(r[LCOL.QTY - 1]) || 0) > 0)) { sum.skipped++; continue; }
      const pg = fetchStockPage_(url);
      if (pg.skip) { sum.skipped++; continue; }
      if (!pg.ok) {
        // ページを開けないだけでは取り下げない（一時的なエラーの可能性）。記録して人の確認に回す
        sum.failed++;
        lsh.getRange(i + 2, LCOL.SRC_STATE).setValue('自動確認できず：' + pg.note + '（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）').setBackground('#fef7e0');
        stockLog_(r, '自動（ページ確認）', '⚠ 確認できず（変更なし）', pg.note + (pg.code === 404 ? '。ページが削除されている可能性があります。目で確認してください' : ''), url);
        sum.items.push(['⚠ 確認できず', r[LCOL.TITLE - 1], pg.note, url]);
        continue;
      }
      LAST_STOCK_ = null;
      stockCheck_({ row: i + 2, r: r }, { url: url, title: pg.title, price: '', text: pg.text }, {   // 価格はAIがページから読む（数字の取り違えで仕入れ値を書き換えないため）
        auto: true, method: '自動（ページ確認）',
        confirm: () => { Utilities.sleep(20000); const p2 = fetchStockPage_(url); return p2.ok ? { url: url, title: p2.title, price: '', text: p2.text } : null; }
      });
      const res = LAST_STOCK_ || { result: 'ok' };
      if (res.result === 'delisted') { sum.delisted++; sum.items.push(['🛑 取り下げ', r[LCOL.TITLE - 1], res.reason, url]); }
      else if (res.result === 'review') { sum.review++; sum.items.push(['⚠ 要目視', r[LCOL.TITLE - 1], res.reason, url]); }
      else if (res.result === 'soldout') { sum.review++; sum.items.push(['🔴 売り切れ', r[LCOL.TITLE - 1], res.state || res.reason, url]); }
      else sum.ok++;
    } catch (e) {
      sum.failed++;
      sum.items.push(['❌ エラー', itemId, e.message, '']);
    }
    Utilities.sleep(1500);   // 仕入れ先のサイトに負担をかけないよう、1件ずつ間をあける
  }
  sum.items = (sum.items || []).slice(-200);
  p.setProperty('AUTO_STOCK_QUEUE', JSON.stringify(queue));
  p.setProperty('AUTO_STOCK_SUMMARY', JSON.stringify(sum));
  if (queue.length) scheduleAutoStock_(); else autoStockFinish_();
}

function autoStockFinish_() {
  const p = PropertiesService.getScriptProperties();
  const sum = JSON.parse(p.getProperty('AUTO_STOCK_SUMMARY') || '{}');
  p.deleteProperty('AUTO_STOCK_QUEUE');
  if (!sum.total) return;
  const lsh = ss_().getSheetByName('出品一覧');
  let manual = 0;
  if (lsh && lsh.getLastRow() > 1) {
    lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues().forEach(r => {
      const h = (String(r[LCOL.SRC_URL - 1] || '').match(/^https?:\/\/([^\/?#]+)/i) || [])[1] || '';
      if ((Number(r[LCOL.QTY - 1]) || 0) > 0 && h && NO_FETCH_SITES.test(h)) manual++;
    });
  }
  if (!sum.delisted && !sum.review && !sum.failed) return;   // 問題がなければメールしない
  MailApp.sendEmail(Session.getEffectiveUser().getEmail(),
    '【在庫管理】取り下げ ' + sum.delisted + '件・要確認 ' + (sum.review + sum.failed) + '件（自動確認 ' + sum.total + '件）',
    '自動で読める仕入れ先を1件ずつ確認しました。\n在庫あり：' + sum.ok + '件／取り下げ：' + sum.delisted + '件／要目視：' + sum.review + '件／確認できず：' + sum.failed + '件\n\n' +
    sum.items.map(x => x[0] + '　' + String(x[1]).slice(0, 70) + '\n　' + String(x[2]).slice(0, 200) + (x[3] ? '\n　' + x[3] : '')).join('\n') +
    '\n\n取り下げた商品は「取り下げ記録」シートに、確認の結果は「在庫チェック記録」シートに残しています。' +
    (manual ? '\nメルカリ・Yahoo!フリマ・Amazonなど規約上自動で読めない仕入れ先の商品が ' + manual + '件あります。「在庫アラート」のリンクから開いて「まとめて送る」で確認してください。' : '') +
    '\n' + ss_().getUrl());
}

function inventorySettings_() {
  const s = sheet_('設定');
  if (s.getRange('E61').getValue() === '') {
    s.getRange('E61').setValue('■ 在庫管理').setFontWeight('bold');
    s.getRange('E62:E64').setValues([['何時間確認していなければ「確認が必要」にするか'], ['安全装置：長時間確認できないフリマ仕入れの商品を一時停止する'], ['安全装置が働くまでの時間']]).setFontWeight('bold');
    s.getRange('F62').setValue(24).setBackground('#fff4dc');
    s.getRange('F63').insertCheckboxes().setValue(false);
    s.getRange('F64').setValue(72).setBackground('#fff4dc');
    s.getRange('E65').setValue('安全装置をオンにすると、メルカリ・Yahoo!フリマ・ラクマ仕入れの商品で、F64の時間以上在庫を確認できていないものは、eBayの在庫を0にします（売れてから仕入れられない事故を防ぐため）。在庫を確認できれば自動で1に戻ります。')
      .setFontColor('#777777').setWrap(true);
  }
  if (s.getRange('E66').getValue() === '') {
    s.getRange('E66:E67').setValues([['売り切れと分かったときの処理'], ['メルカリ仕入れの安全装置が働くまでの時間']]).setFontWeight('bold');
    s.getRange('F66').setValue('eBayの在庫を0にする（おすすめ）').setBackground('#fff4dc')
      .setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['eBayの在庫を0にする（おすすめ）', 'eBayの出品を終了する']).build());
    s.getRange('F67').setValue(24).setBackground('#fff4dc');
    s.getRange('E68').setValue('「在庫を0にする」は、出品のページ・ウォッチ・販売履歴を残したまま検索から外れます（再入荷したら1に戻すだけ）。eBayの「Out-of-stock option」がオフだと在庫0で出品が終了するので、セラーハブの設定でオンにしておいてください。「出品を終了する」は、出品そのものを終わらせます。')
      .setFontColor('#777777').setWrap(true);
  }
  const v = s.getRange('F62:F64').getValues().map(r => r[0]);
  return { hours: Number(v[0]) || 24, safety: v[1] === true, safeHours: Number(v[2]) || 72,
    endOnSoldOut: /終了/.test(String(s.getRange('F66').getValue())), mercariHours: Number(s.getRange('F67').getValue()) || 24 };
}

// 売り切れやすさ：フリマ（1点もの）→ 中古ショップ → 新品の通販
function sourceRisk_(url) {
  const u = String(url || '');
  if (/mercari|paypayfleamarket|fril\.jp|rakuma|auctions\.yahoo/.test(u)) return 3;
  if (/suruga-ya|netoff|hardoff|netmall|diskunion|bookoff|treasure/.test(u)) return 2;
  return 1;
}

function inventoryRound_(lsh, rows) {
  const cfg = inventorySettings_();
  const now = Date.now();
  const fmt = d => d instanceof Date ? Utilities.formatDate(d, 'Asia/Tokyo', 'MM/dd HH:mm') : '未確認';
  const toCheck = [], paused = [];
  rows.forEach((r, i) => {
    const qty = Number(r[LCOL.QTY - 1]) || 0, src = String(r[LCOL.SRC_URL - 1] || '');
    if (!src) return;
    const checked = r[LCOL.CHECKED - 1];
    const age = checked instanceof Date ? (now - checked.getTime()) / 3600000 : 9999;
    const risk = sourceRisk_(src);
    if (qty > 0 && age >= cfg.hours) {
      toCheck.push({ risk: risk, age: age, row: [String(r[LCOL.ID - 1]), r[LCOL.TITLE - 1], qty, src, fmt(checked),
        (risk === 3 ? 'フリマ（売り切れやすい）' : risk === 2 ? '中古ショップ' : '通販') + '／' + (age >= 9999 ? '一度も確認していない' : Math.floor(age) + '時間前に確認')] });
    }
    // 安全装置
    const limit = /mercari/.test(src) ? cfg.mercariHours : cfg.safeHours;
    if (cfg.safety && qty > 0 && risk === 3 && age >= limit) {
      try {
        trading_('ReviseInventoryStatus', '<InventoryStatus><ItemID>' + x_(String(r[LCOL.ID - 1])) + '</ItemID><Quantity>0</Quantity></InventoryStatus>');
        lsh.getRange(i + 2, LCOL.QTY).setValue(0);
        lsh.getRange(i + 2, LCOL.SRC_STATE).setValue('未確認のため一時停止（eBay在庫0）' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm'));
        paused.push([String(r[LCOL.ID - 1]), r[LCOL.TITLE - 1], 0, src, fmt(checked), limit + '時間以上確認できなかったため一時停止']);
      } catch (e) {}
    }
  });
  toCheck.sort((a, b) => (b.risk - a.risk) || (b.age - a.age));
  return { toCheck: toCheck.map(x => x.row), paused: paused, hours: cfg.hours, safeHours: cfg.safeHours };
}

// 6時間ごとのメール：新しい在庫切れ・至急の注文 → 【在庫切れ】、確認が必要な商品だけ → 【在庫確認のお願い】
function inventoryMail_(inv, soldOut, toBuy) {
  const p = PropertiesService.getScriptProperties();
  const reported = new Set(JSON.parse(p.getProperty('INV_SOLDOUT_REPORTED') || '[]'));
  const newSold = soldOut.filter(r => !reported.has(r[0]));
  p.setProperty('INV_SOLDOUT_REPORTED', JSON.stringify(soldOut.map(r => r[0]).slice(-500)));
  if (!newSold.length && !inv.toCheck.length && !inv.paused.length && !toBuy.length) return;
  const link = r => '・' + r[1] + '\n　' + r[3] + '（' + r[5] + '）';
  const body = ['在庫管理（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）', '',
    newSold.length ? '🔴 新しく在庫切れになった商品：' + newSold.length + '件（eBayの在庫は0にしてあります）\n' + newSold.map(r => '・' + r[1] + '\n　' + r[3]).join('\n') + '\n' : '',
    toBuy.length ? '🛒 仕入れが必要な注文：' + toBuy.length + '件\n' + toBuy.slice(0, 10).map(r => '・' + r[1] + '\n　' + r[3]).join('\n') + '\n' : '',
    inv.paused.length ? '⏸ 安全のため一時停止した商品：' + inv.paused.length + '件\n' + inv.paused.slice(0, 10).map(link).join('\n') + '\n' : '',
    inv.toCheck.length ? '🔎 在庫の確認が必要な商品（売り切れやすい順・' + inv.toCheck.length + '件）\n各リンクを開いて「eBayへ送る」を押すと確認できます。\n' + inv.toCheck.slice(0, 20).map(link).join('\n') : '',
    '', '在庫管理画面：' + inventoryUrl_(), 'スプレッドシート：' + ss_().getUrl()].filter(x => x !== '').join('\n');
  const subject = newSold.length ? '【在庫切れ】' + newSold.length + '件' + (toBuy.length ? '・仕入れ待ち ' + toBuy.length + '件' : '')
    : toBuy.length ? '【仕入れ待ち】' + toBuy.length + '件' : '【在庫確認のお願い】' + inv.toCheck.length + '件';
  MailApp.sendEmail(Session.getEffectiveUser().getEmail(), subject, body);
}

// 在庫確認で売り切れと分かった瞬間のアラーム
function stockOutAlarm_(title, itemId, url, reason) {
  MailApp.sendEmail(Session.getEffectiveUser().getEmail(), '【在庫切れ】' + String(title || itemId).slice(0, 60),
    '仕入れ先で売り切れになっていました。eBayの在庫は0にしてあります。\n\n商品：' + title + '\neBay商品ID：' + itemId + '\n仕入れ先：' + url +
    '\n判断の理由：' + (reason || '') + '\n\n別の仕入れ先が見つかれば、その商品ページで「eBayへ送る」を押すと在庫を戻せます。\n' + ss_().getUrl());
}

// 注文が入った商品の仕入れ先を、24時間以上確認していなければ至急アラーム
function urgentOrderCheck_(itemId, title, url, orderId) {
  const lsh = ss_().getSheetByName('出品一覧');
  let checked = null;
  if (lsh && lsh.getLastRow() > 1) {
    const r = lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues().find(v => String(v[LCOL.ID - 1]) === itemId);
    if (r) checked = r[LCOL.CHECKED - 1];
  }
  const age = checked instanceof Date ? (Date.now() - checked.getTime()) / 3600000 : 9999;
  if (age < 24) return;
  MailApp.sendEmail(Session.getEffectiveUser().getEmail(), '【至急・在庫確認】売れました：' + String(title).slice(0, 50),
    '注文が入りましたが、この商品の仕入れ先を' + (age >= 9999 ? '一度も確認していません' : Math.floor(age) + '時間確認していません') + '。\nすぐに仕入れ先を開いて、在庫を確認・購入してください。\n\n' +
    '商品：' + title + '\n注文番号：' + orderId + '\n仕入れ先：' + (url || '（仕入れURLなし）') + '\n\n在庫がない場合は、早めにバイヤーへ連絡してください。\n' + ss_().getUrl());
}


