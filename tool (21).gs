  const out = [], seen = {}, rx = site === 'yf' ? /\/item\/(z\d+)/g : /\/jp\/auction\/([a-z0-9]+)/gi, pos = []; let m;
  while ((m = rx.exec(html)) !== null) { if (!seen[m[1]]) { seen[m[1]] = 1; pos.push({ id: m[1], i: m.index }); } }
  pos.forEach((x, k) => {
    const post = html.slice(x.i, (pos[k + 1] ? pos[k + 1].i : x.i + 2500)).replace(/\\u002F/g, '/'), pre = html.slice(Math.max(0, x.i - 300), x.i).replace(/\\u002F/g, '/');
