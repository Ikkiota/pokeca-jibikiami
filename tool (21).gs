function registerAuthCode() {
  const ui = SpreadsheetApp.getUi();
  const res = ui.prompt('戻り先URLを貼り付け', '「Thank You」画面のアドレスバーのURLをまるごと貼り付けてください。', ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return;
  const text = res.getResponseText().trim();
  const m = text.match(/[?&]code=([^&\s]+)/);
  let code = m ? decodeURIComponent(m[1]) : text;
  if (/%[0-9A-F]{2}/i.test(code)) code = decodeURIComponent(code);
  try {
    const t = tokenRequest_({ grant_type: 'authorization_code', code: code, redirect_uri: need_('EBAY_RUNAME') });
    if (!t.refresh_token) throw new Error('リフレッシュトークンが返ってきませんでした。');
    const p = PropertiesService.getScriptProperties();
    p.setProperty('EBAY_REFRESH_TOKEN', t.refresh_token);
    p.setProperty('EBAY_SCOPES', USER_SCOPES.join(' '));
    const until = new Date(Date.now() + (t.refresh_token_expires_in || 0) * 1000);
    CacheService.getScriptCache().put('tok_user', t.access_token, Math.max(60, Math.min(t.expires_in - 300, 21600)));
    ui.alert('eBay連携が完了しました！\n有効期限：' + Utilities.formatDate(until, 'Asia/Tokyo', 'yyyy/MM/dd') + ' ごろまで');
  } catch (e) {
    ui.alert('連携に失敗しました：' + e.message + '\n\n5分を過ぎると無効になるので、③からやり直してください。');
  }
}

/* ========== トークン・API共通 ========== */
function tokenRequest_(params) {
  const id = need_('EBAY_CLIENT_ID'), secret = need_('EBAY_CLIENT_SECRET');
  const payload = Object.keys(params).map(k => encodeURIComponent(k) + '=' + encodeURIComponent(params[k])).join('&');
  const res = UrlFetchApp.fetch(TOKEN_URL, {
    method: 'post',
    contentType: 'application/x-www-form-urlencoded',
    headers: { Authorization: 'Basic ' + Utilities.base64Encode(id + ':' + secret) },
    payload: payload,
    muteHttpExceptions: true,
  });
  const body = JSON.parse(res.getContentText() || '{}');
  if (res.getResponseCode() !== 200) {
    throw new Error('トークン取得エラー：' + (body.error_description || body.error || res.getContentText()));
  }
  return body;
}

function getToken_(kind) {
  const cache = CacheService.getScriptCache();
  const cached = cache.get('tok_' + kind);
  if (cached) return cached;
  let t;
  if (kind === 'user') {
    const rt = prop_('EBAY_REFRESH_TOKEN');
    if (!rt) throw new Error('eBay連携がまだです。メニュー③④を実行してください。');
    t = tokenRequest_({ grant_type: 'refresh_token', refresh_token: rt, scope: prop_('EBAY_SCOPES') || LEGACY_SCOPES.join(' ') });
  } else {
    t = tokenRequest_({ grant_type: 'client_credentials', scope: 'https://api.ebay.com/oauth/api_scope' });
  }
  cache.put('tok_' + kind, t.access_token, Math.max(60, Math.min(t.expires_in - 300, 21600)));
  return t.access_token;
}

function ebay_(method, path, opt) {
  opt = opt || {};
  const kind = opt.kind || 'user';
  for (let attempt = 0; attempt < 2; attempt++) {
    const params = {
      method: method,
      muteHttpExceptions: true,
      headers: { Authorization: 'Bearer ' + getToken_(kind), Accept: 'application/json' },
    };
    if (opt.marketplace) params.headers['X-EBAY-C-MARKETPLACE-ID'] = opt.marketplace;
    if (opt.headers) Object.keys(opt.headers).forEach(h => params.headers[h] = opt.headers[h]);
    if (opt.body !== undefined) { params.contentType = 'application/json'; params.payload = JSON.stringify(opt.body); }
    const res = UrlFetchApp.fetch(/^https:/.test(path) ? path : EBAY_API + path, params);
    const code = res.getResponseCode();
    if (code === 401 && attempt === 0) { CacheService.getScriptCache().remove('tok_' + kind); continue; }
    const text = res.getContentText();
    if (code >= 200 && code < 300) return text ? JSON.parse(text) : {};
    let msg = text, errs = null;
    try { const j = JSON.parse(text); if (j.errors && j.errors[0]) { msg = j.errors[0].longMessage || j.errors[0].message; errs = j.errors; } } catch (e) {}
    const err = new Error('eBay API エラー（' + code + '）：' + msg);
    err.ebayErrors = errs;
    throw err;
  }
}

/* ========== メッセージ取得 ========== */
function myUsername_() {
  let u = prop_('MY_USERNAME');
  if (u) return u;
  try {
    const out = trading_('GetUser', '');
    const user = out.root.getChild('User', out.ns);
    u = user ? user.getChildText('UserID', out.ns) : '';
    if (u) PropertiesService.getScriptProperties().setProperty('MY_USERNAME', u);
  } catch (e) {}
  return u || '';
}

// 最近の会話を取得（未読＋進行中を合わせて、会話IDで重複を除く）
function recentConversations_(limit) {
  const byId = {};
  ['UNREAD', 'ACTIVE'].forEach(status => {
    const res = ebay_('get', '/commerce/message/v1/conversation?conversation_type=FROM_MEMBERS&conversation_status=' +
      status + '&limit=' + limit);
    (res.conversations || []).forEach(c => { if (!byId[c.conversationId]) byId[c.conversationId] = c; });
  });
  return Object.keys(byId).map(k => byId[k]);
}

function fetchMessages_() {
  const sh = sheet_('メッセージ');
  const me = myUsername_();
  const since = Date.now() - 3 * 24 * 3600 * 1000; // 直近3日間のメッセージが対象
  const convs = recentConversations_(50);
  const last = sh.getLastRow();
  const data = last > 1 ? sh.getRange(2, 1, last - 1, MSG_HEADERS.length).getValues() : [];
  const seen = new Set();
  data.forEach(r => String(r[COL.MSG_ID - 1]).split(',').forEach(id => { if (id) seen.add(id.trim()); }));
  let added = 0, updated = 0;

  convs.forEach(c => {
    const lm = c.latestMessage;
    if (!lm || seen.has(String(lm.messageId))) return;
    if (me && lm.senderUsername === me) return;                 // 最後が自分の送信なら対応済み
    if (new Date(lm.createdDate).getTime() < since) return;     // 古いメッセージは取り込まない
    const idx = data.findIndex(r => r[COL.CONV - 1] === c.conversationId && r[COL.STATUS - 1] !== '送信済み');
    if (idx >= 0) {
      const row = idx + 2;
      sh.getRange(row, COL.DATE, 1, 2).setValues([[new Date(lm.createdDate), lm.messageBody || '']]);
      sh.getRange(row, COL.MSG_ID).setValue(String(data[idx][COL.MSG_ID - 1]) + ',' + String(lm.messageId));
      sh.getRange(row, COL.MSG_JA).setValue('');
      if (data[idx][COL.OK - 1] === true) {
        sh.getRange(row, COL.NOTE).setValue('バイヤーから追加メッセージあり。送信前に確認してください');
      } else {
        sh.getRange(row, COL.REPLY, 1, 2).setValues([['', '']]);
        sh.getRange(row, COL.STATUS).setValue('新着（追加メッセージ）');
      }
      updated++;
    } else {
      sh.appendRow([c.conversationId, lm.senderUsername || '', c.conversationTitle || lm.subject || '',
        new Date(lm.createdDate), lm.messageBody || '', '', '', '', false, '', '新着', '',
        c.referenceId || '', String(lm.messageId)]);
      sh.getRange(sh.getLastRow(), COL.OK).insertCheckboxes();
      added++;
      try { if (c.referenceId) zAskStock_('質問・メッセージ', c.referenceId, c.conversationTitle || lm.subject || ''); } catch (e) {}   // v235：質問が来たら仕入れ先の在庫をすぐ確かめる
    }
  });
  return { added: added, updated: updated };
}

