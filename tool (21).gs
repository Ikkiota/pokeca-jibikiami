    list.push({ q: q, key: r[ZM.KEY - 1], cap: cap, score: Math.round(score) });
  });
  list.sort((a, b) => b.score - a.score);
  const rows = list.slice(0, 100).map((o, i) => [i + 1, o.q, o.key, o.cap, 'https://jp.mercari.com/search?keyword=' + encodeURIComponent(o.q) + '&status=on_sale&sort=created_time&order=desc&price_max=' + o.cap, keep[o.q] === true, o.score]);
  if (rows.length) {
