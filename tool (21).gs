/* =====================================================================
 * v185：毎日100品を出品する（自動リサーチ担当が GO を付ける）
 *  ・「追加の設定」F300（オン/オフ・初めはオン）、F301（1日の目標・初めは100）
 *  ・8時〜22時の定時の仕事のたびに：足りない数 N ＝ 目標 − 今日出品した数 − 処理中の数。N が 0 以下なら何もしない
 *  ・出品候補（0円）で判定が通った品（✅／⚠ 傷・難あり）から、写真が多い順・利益の余裕が大きい順に N件まで GO を付けて出品に回す
 *    同じカード・もう出品中のカードは選ばない（1回は最大25件。残りは次の定時に）
 *  ・eBay の出品枠（今月の上限）に当たったら、その日は GO を付けるのをやめて、メールで知らせる（1日1回）
 *  ・利益・送料・状態・写真のルールは今までどおり（出品の判定で合わない品は出品しない）
 * ===================================================================== */
function zDaily100Settings_() {
  const s = addSettingsSheet_();
  if (s.getRange('E299').getValue() === '') {
    s.getRange('E299').setValue('■ 毎日100品の出品（v185：自動リサーチ担当が GO を付ける）').setFontWeight('bold');
    s.getRange('E300:F301').setValues([['毎日100品の自動 GO（オン/オフ）', true], ['1日の出品の目標（品）', 100]]);
    s.getRange('F300').insertCheckboxes().setValue(true);
    s.getRange('E300:E301').setFontWeight('bold'); s.getRange('F300:F301').setBackground('#fff4dc');
  }
  const on = s.getRange('F300').getValue() === true, t = Number(s.getRange('F301').getValue()) || 100;
  try { const cap = Number(s.getRange('F251').getValue()) || 0; if (on && cap < t + 30) s.getRange('F251').setValue(t + 30); } catch (e) {}   // 仕入れ候補へ送る1日の上限を目標より少し多く
  return { on: on, target: Math.max(1, Math.min(300, t)) };
}
const Z_LIMIT_RX = /selling limit|reached.*limit|limit.*(this month|per month)|exceed.*(limit|amount)|amount you can list|items you can list|出品(枠|上限|制限)|21919188/i;
function zDaily100Status_() {
  const today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd'), isToday = d => d instanceof Date && Utilities.formatDate(d, 'Asia/Tokyo', 'yyyyMMdd') === today;
  let listed = 0, inFlight = 0, limitHit = false, limitNote = '';
  try { const ls = listSheet_(), n = ls.getLastRow() - 1; if (n > 0) ls.getRange(2, 1, n, LIST_HEADERS.length).getValues().forEach(r => { if (isToday(r[LCOL.CHECKED - 1]) && /出品ツール/.test(String(r[LCOL.RESULT - 1] || ''))) listed++; }); } catch (e) {}
  try { const it = intakeSheet_(), n = it.getLastRow() - 1; if (n > 0) it.getRange(2, 1, n, IN_HEADERS.length).getValues().forEach(r => { if (r[IN.GO - 1] === true && String(r[IN.URL - 1] || '').trim() && /^(|処理中…|ページを読み取り中…)$/.test(String(r[IN.STATUS - 1] || ''))) inFlight++; }); } catch (e) {}
  try { const kc = kcSheet_(), n = kc.getLastRow() - 1; if (n > 0) kc.getRange(2, 1, n, 2).getValues().forEach(r => { if (r[0] === true && !String(r[1] || '')) inFlight++; }); } catch (e) {}
  try { const pr = prepSheet_(), n = pr.getLastRow() - 1; if (n > 0) pr.getRange(2, 1, n, PREP_HEADERS.length).getValues().forEach(r => { const nt = String(r[P.NOTE - 1] || ''); if (r[P.DATE - 1] instanceof Date && Date.now() - r[P.DATE - 1].getTime() < 3 * 3600000 && String(r[P.STATUS - 1] || '') !== '出品済み' && Z_LIMIT_RX.test(nt)) { limitHit = true; limitNote = nt.slice(0, 200); } /* v199：3時間以内の出品枠のエラーだけ（枠が増えたらすぐ再開） */ }); } catch (e) {}
  return { listed: listed, inFlight: inFlight, limitHit: limitHit, limitNote: limitNote };
}
function zDaily100_() {
  const st = zDaily100Settings_();
  if (!st.on) return { off: true };
  const s = zDaily100Status_(), p = PropertiesService.getScriptProperties(), day = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd');
  if (s.limitHit) {
    if (p.getProperty('D100_LIMIT') !== day) { p.setProperty('D100_LIMIT', day);
      try { MailApp.sendEmail(Session.getEffectiveUser().getEmail(), '【eBayツール】eBay の出品枠（今月の上限）に達しました', '今日の出品：' + s.listed + '品。eBay の出品枠に当たったので、今日は自動の GO を止めました。\n\nセラーハブ →「出品の上限（Selling limits）」→「上限の引き上げをリクエスト」で枠を増やせます。\n\nエラー：' + s.limitNote); } catch (e) {} }
    return { listed: s.listed, inFlight: s.inFlight, go: 0, why: 'eBayの出品枠に達した' };
  }
  let need = st.target - s.listed - s.inFlight;
  if (need <= 0) return { listed: s.listed, inFlight: s.inFlight, go: 0, why: '足りている' };
  need = Math.min(need, 25);
  const kc = kcSheet_(), n = kc.getLastRow() - 1;
  if (n < 1) return { listed: s.listed, inFlight: s.inFlight, go: 0, why: '出品候補がない' };
  const v = kc.getRange(2, 1, n, KC_HEAD.length).getValues(), listedKeys = zListedCardKeys_(), seen = {};
  const pool = [], sell = zSellMap_(), buf = zDaily100Buffer_();
  v.forEach((r, i) => {
    if (r[KC.GO - 1] === true || String(r[KC.STATE - 1] || '')) return;
    if (!/^(✅|⚠ 傷・難あり)/.test(String(r[KC.WHY - 1] || ''))) return;
    if (!zGradedOk_() && !/未鑑定|未開封/.test(String(r[KC.GRADE - 1] || '未鑑定'))) return;   // v202：鑑定品は自動で GO しない
    const lk = zKcListedKey_(r); if (lk && listedKeys.has(lk)) return;
    const yen = Number(r[KC.YEN - 1]) || 0, cap = Number(r[KC.CAP - 1]) || 0;
    if (!(yen > 0) || !(cap > 0) || cap - yen < buf) return;   // v187：利益：仕入れ上限より ○円以上安い品だけ（値段が少し動いても最低利益 1,500円を守れる）
    const tier = zSellTier_(sell, lk); if (!tier) return;   // v187：売れる見込み：eBay で売れた実績・自分の店で売れた実績・eBay で出品が適度にある型番だけ
    pool.push({ row: i + 2, key: zKcCardKey_(r), ph: zKcPhotoCount_(r), room: (cap - yen) / cap, tier: tier, dmg: /^⚠/.test(String(r[KC.WHY - 1] || '')) ? 1 : 0 });
  });
  pool.sort((a, b) => (b.tier - a.tier) || (a.dmg - b.dmg) || (b.ph - a.ph) || (b.room - a.room));   // v187：売れる見込みが高い順 → 傷なし → 写真が多い → 利益の余裕が大きい
  const pick = [];
  for (const x of pool) { if (pick.length >= need) break; if (x.key && seen[x.key]) continue; if (x.key) seen[x.key] = 1; pick.push(x.row); }
  pick.forEach(row => kc.getRange(row, KC.GO).setValue(true));
  let sent = 0; if (pick.length) { try { sent = (kwSendGo_(false) || {}).sent || 0; } catch (e) { zLog_('毎日100品', 'GO を送れなかった：' + e.message); } }
  return { listed: s.listed, inFlight: s.inFlight, need: need, go: pick.length, sent: sent, pool: pool.length };
}
function menuDaily100Now() { run_(() => { const r = zDaily100_(); return r.off ? '毎日100品の自動 GO はオフです（「追加の設定」F300）' : '今日の出品 ' + r.listed + '品・処理中 ' + r.inFlight + '品 → GO を付けた ' + (r.go || 0) + '品' + (r.why ? '（' + r.why + '）' : '') + (r.pool != null ? '・GO できる候補 ' + r.pool + '件' : ''); }); }

/* v186：毎日100品の報告（毎日22時にメール・「0円の自動化の記録」にも残す）
 *  今日の出品数／目標／処理中／GO できる候補／出品できなかった理由の内訳／100品に届かない一番の理由 */
function zDaily100Report_() {
  const st = zDaily100Settings_(), s = zDaily100Status_();
  const today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd'), isToday = d => d instanceof Date && Utilities.formatDate(d, 'Asia/Tokyo', 'yyyyMMdd') === today;
  const why = { 'eBayの出品枠を超えた': 0, '写真が足りない・アップロードできない': 0, '状態が判定できない（未査定）': 0, '二重出品・重複を止めた': 0, '傷・難あり': 0, 'その他のエラー': 0 };
  let hold = 0, wait = 0;
  try { const pr = prepSheet_(), n = pr.getLastRow() - 1; if (n > 0) pr.getRange(2, 1, n, PREP_HEADERS.length).getValues().forEach(r => {
    if (!isToday(r[P.DATE - 1])) return; const stt = String(r[P.STATUS - 1] || ''), nt = String(r[P.NOTE - 1] || '');
    if (stt === '候補（出品エラー）' || /^重複/.test(stt)) {
      if (Z_LIMIT_RX.test(nt)) why['eBayの出品枠を超えた']++; else if (/写真|画像|pictur|image/i.test(nt)) why['写真が足りない・アップロードできない']++;
      else if (/未査定|鑑定状態|condition/i.test(nt)) why['状態が判定できない（未査定）']++; else if (/二重出品|重複/.test(nt + stt)) why['二重出品・重複を止めた']++;
      else if (/傷・難あり/.test(nt)) why['傷・難あり']++; else why['その他のエラー']++;
    } else if (/^保留/.test(stt)) hold++; else if (stt === '候補') wait++; }); } catch (e) {}
  let rej = 0; try { const it = intakeSheet_(), n = it.getLastRow() - 1; if (n > 0) it.getRange(2, IN.STATUS, n, 1).getValues().forEach(r => { if (String(r[0]) === '見送り') rej++; }); } catch (e) {}
  let pool = 0; try { const kc = kcSheet_(), n = kc.getLastRow() - 1; if (n > 0) kc.getRange(2, 1, n, KC_HEAD.length).getValues().forEach(r => { if (r[KC.GO - 1] !== true && !String(r[KC.STATE - 1] || '') && /^(✅|⚠ 傷・難あり)/.test(String(r[KC.WHY - 1] || ''))) pool++; }); } catch (e) {}
  const errTotal = Object.keys(why).reduce((a, k) => a + why[k], 0);
  let main = '';
  if (s.listed >= st.target) main = '目標達成';
  else if (s.limitHit || why['eBayの出品枠を超えた']) main = 'eBay の出品枠（今月の上限）。セラーハブ →「出品の上限」→「上限の引き上げをリクエスト」で増やせます';
  else if (pool + s.inFlight < st.target - s.listed) main = '出品候補が足りない（GO できる候補 ' + pool + '件）。「キーワード検索：検索開始」やメルカリの「検索結果を送る」で候補を増やすと届きやすくなります';
  else if (s.inFlight > 0) main = 'Google の1日の動作時間で出品が翌日に回った（処理中 ' + s.inFlight + '品）。「★ GOした品を今すぐ出品」を押すと上限に数えずに進みます';
  else main = Object.keys(why).sort((a, b) => why[b] - why[a])[0] + '（' + why[Object.keys(why).sort((a, b) => why[b] - why[a])[0]] + '件）';
  const lines = ['毎日100品の報告（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）', '',
    '■ 今日の出品：' + s.listed + '品／目標 ' + st.target + '品' + (s.listed >= st.target ? '（達成）' : '（あと ' + (st.target - s.listed) + '品）'),
    '■ 処理中（GO 済み・出品待ち）：' + s.inFlight + '品', '■ まだ GO できる出品候補：' + pool + '件',
    '■ 出品できなかった：' + errTotal + '件' + (errTotal ? '\n' + Object.keys(why).filter(k => why[k]).map(k => '　・' + k + '：' + why[k] + '件').join('\n') : ''),
    '■ 判定で見送り（利益が足りないなど・これまでの合計）：' + rej + '件', '■ 保留（値段の確認待ち）：' + hold + '件',
    '■ 相場の2倍以上で値下げした品（今日）：' + zDayCount_('hprDown', 0) + '件', '',
    '■ 100品に届かない一番の理由：' + main];
  const body = lines.join('\n');
  zLog_('毎日100品の報告', body.replace(/\n+/g, '／').slice(0, 900));
  try { MailApp.sendEmail(Session.getEffectiveUser().getEmail(), '【eBayツール】毎日100品の報告：今日 ' + s.listed + '品／' + st.target + '品', body); } catch (e) {}
  return body;
}
