var d={kind:'ebaysold',rq:h?Number(h[1]):0,prep:pp?pp[1]:'',keyword:kw,url:location.href,cards:out};
var f=document.createElement('form');f.method='POST';f.action=W;f.target='_blank';f.acceptCharset='UTF-8';
[['data',JSON.stringify(d)],['token',T]].forEach(function(p){var i=document.createElement('input');i.type='hidden';i.name=p[0];i.value=p[1];f.appendChild(i)});
document.body.appendChild(f);f.submit();f.remove();})();`;
}

function demandSettings_() {
  const s = sheet_('設定');
  if (s.getRange('E57').getValue() === '') {
    s.getRange('E56').setValue('■ Soldの需要の判定').setFontWeight('bold');
    s.getRange('E57:E58').setValues([['30日で何個以上売れていれば「需要あり」'], ['7日で何個以上売れていれば「激熱」']]).setFontWeight('bold');
    s.getRange('F57:F58').setValues([[3], [2]]).setBackground('#fff4dc');
    s.getRange('E59').setValue('同じ出品は1個、同じ商品名・同じ価格・同じ日の販売は1個として数えます（まとめ買いで数が増えないように）。30日の基準に届かず、7日の基準にも届かない商品は「リサーチ候補」から外します。')
      .setFontColor('#777777').setWrap(true);
  }
  const v = s.getRange('F57:F58').getValues().map(r => Number(r[0]) || 0);
  return { min30: v[0] || 3, min7: v[1] || 2 };
}

const MONTHS_ = { jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5, jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11 };
function parseSoldCard_(text) {
  const t = String(text || '');
  let date = null;
  let m = t.match(/Sold\s+([A-Za-z]{3})\s+(\d{1,2}),?\s+(\d{4})/i);
  if (m && MONTHS_[m[1].toLowerCase()] !== undefined) date = new Date(Number(m[3]), MONTHS_[m[1].toLowerCase()], Number(m[2]));
  if (!date) { m = t.match(/(\d{4})\/(\d{1,2})\/(\d{1,2})/); if (m) date = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3])); }
  const lines = t.split('\n').map(x => x.trim().replace(/^new listing\s*/i, '')).filter(x => x);
  const title = (lines.find(x => x.length > 15 && !/^(sold|pre-owned|brand new|\$|free|\+|opens in a new)/i.test(x)) || '').slice(0, 150);
  const pm = t.match(/\$\s?([\d,]+\.\d{2})/);
  const price = pm ? Number(pm[1].replace(/,/g, '')) : 0;
  let ship = 0;
  const sm = t.match(/\+\s?\$\s?([\d,]+\.\d{2})\s*(shipping|delivery)/i);
  if (sm) ship = Number(sm[1].replace(/,/g, ''));
  const qty = (t.match(/(\d+)\s+sold/i) || [])[1];
  return { date: date, title: title, price: price, ship: ship, total: price + ship, multi: qty ? Number(qty) : 1 };
}

function receiveEbaySold_(d) {
  const cards = (d.cards || []).map(c => Object.assign({ id: c.id }, parseSoldCard_(c.text))).filter(c => c.date && c.price > 0);
  if (!cards.length) return page_('読み取れませんでした', '売れた日付と価格を読み取れませんでした。eBayの検索結果で「Sold items」にチェックを入れた画面で押してください。');
  if (d.prep) return receiveSoldForPrep_(d, cards);
  try { if (zFastSettings_().on) return zSoldFree_(d, cards); } catch (e) {}   // v123：AIなしでカード番号ごとに記録（売れる型番を育てる）
  const rq = researchQueueSheet_();
  const rqLast = rq.getLastRow();
  let rqRow = (d.rq >= 2 && d.rq <= rqLast) ? d.rq : 0;
  if (!rqRow && rqLast > 1 && d.keyword) {
    const kws = rq.getRange(2, RQ.KW, rqLast - 1, 1).getValues().map(r => String(r[0]).trim().toLowerCase());
    const i = kws.indexOf(String(d.keyword).trim().toLowerCase());
    if (i >= 0) rqRow = i + 2;
  }
  const rv = rqRow ? rq.getRange(rqRow, 1, 1, RQ_HEADERS.length).getValues()[0] : null;
  const kw = rv ? String(rv[RQ.KW - 1]) : String(d.keyword || '');

  // AIが同じ商品だけを残す（ゲームソフトは日本語版だけ）
  let same = null;
  try {
    const key = need_('ANTHROPIC_API_KEY');
    const st = getSettings_();
    const lines = cards.map((c, i) => i + '. ' + c.title.slice(0, 110) + ' | $' + c.total.toFixed(2));
    const out = parseJson_(claude_(key, st.model,
      'あなたはeBayの相場調査のアシスタントです。売れた出品の中から、探している商品とまったく同じ商品だけを選びます。' +
      'まとめ売り・別のタイトル・別の機種・部品だけ・箱だけ・説明書だけは除外。ゲームソフトは日本語版（Japanese / Japan / NTSC-J）だけを同じ商品とし、英語版・北米版・欧州版は除外。出力はJSONのみ。',
      '【探している商品】' + kw + (rv && rv[RQ.JA - 1] ? '／' + rv[RQ.JA - 1] : '') + '\n\n【売れた出品】\n' + lines.join('\n') + '\n\n{"same":[同じ商品の番号の配列]}'));
    same = new Set((out.same || []).map(Number));
  } catch (e) {}
  const matched = cards.filter((c, i) => !same || same.has(i));

  // 同じ出品は1個、同じ商品名・同じ価格・同じ日の販売は1個
  const keys = new Set(), uniq = [];
  matched.forEach(c => {
    const k1 = 'id:' + c.id, k2 = c.title.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 40) + '|' + c.total.toFixed(2) + '|' + c.date.toDateString();
    if (keys.has(k1) || keys.has(k2)) return;
    keys.add(k1); keys.add(k2); uniq.push(c);
  });
  const now = new Date();
  const days = c => (now - c.date) / 86400000;
  const s30 = uniq.filter(c => days(c) <= 30), s7 = uniq.filter(c => days(c) <= 7);
  const base = s30.length >= 3 ? s30 : uniq;
  const tot = base.map(c => c.total).sort((a, b) => a - b);
  const med = tot.length ? quantileSimple_(tot, 0.5) : '';
  const ds = demandSettings_();
  const demand = s7.length >= ds.min7 ? '🔥 激熱（7日で' + s7.length + '個）' : s30.length >= ds.min30 ? '◎ 需要あり（30日で' + s30.length + '個）' : '× 需要不足（30日で' + s30.length + '個）';

  let moved = false;
  if (rqRow) {
    rq.getRange(rqRow, RQ.SOLD30, 1, 4).setValues([[s30.length, s7.length, med, demand]]);
    rq.getRange(rqRow, RQ.SOLDJSON).setValue(JSON.stringify(uniq.slice(0, 200).map(c => [Math.round(c.total * 100) / 100, c.date.getTime()])));
    rq.getRange(rqRow, RQ.SOLDAT).setValue(now);
    rq.getRange(rqRow, RQ.DEMAND).setBackground(/激熱/.test(demand) ? '#fbd5d0' : /需要あり/.test(demand) ? '#d8f0d8' : '#f4f4f4');
    if (/^×/.test(demand)) {
      skipSheet_().appendRow([now, kw, demand + '（Soldで確認）', rv[RQ.LOW - 1], rv[RQ.MAXCOST - 1], rv[RQ.COUNT - 1], rv[RQ.JPSELL - 1]]);
      rq.deleteRow(rqRow);
      moved = true;
    }
  }
  const recent = s30.slice(0, 10).map(c => '<li>' + Utilities.formatDate(c.date, 'Asia/Tokyo', 'MM/dd') + '　$' + c.total.toFixed(2) + '　' + esc_(c.title) + '</li>').join('');
  return page_((/激熱/.test(demand) ? '🔥 ' : /需要あり/.test(demand) ? '◎ ' : '× ') + demand,
    '<b>' + esc_(kw) + '</b><br><br>読み取った売れた出品 ' + cards.length + '件 → 同じ商品 ' + matched.length + '件 → まとめ買いなどを除いて ' + uniq.length + '件<br>' +
    '30日：<b>' + s30.length + '個</b>／7日：<b>' + s7.length + '個</b>／実売の中央値：' + (med ? '$' + med.toFixed(2) : '—') +
    (recent ? '<br><br>最近の販売（30日）<ol>' + recent + '</ol>' : '') +
    (rqRow ? (moved ? '<br>需要が足りないため、「リサーチ候補」から外しました（「リサーチ見送り」に記録）。' : '<br>「リサーチ候補」の行に記録しました。') :
      '<br><span style="color:#b00">※「リサーチ候補」の行が分からなかったため、記録していません。「リサーチ候補」の「eBayでSoldを見る」から開いて押してください。</span>'));
}


/* =====================================================================
 * 自分の出品の「反応」を分析して、似た仕入れ候補を探す
 *  ① eBay公式API：出品中の商品（タイトル・価格・ウォッチ数・出品日・販売数）
 *                  ＋ Analytics API（過去30日の表示回数・インプレッション・クリック率・成約率）
 *  ② 反応スコア ＝ 1日あたりの表示回数 ＋ ウォッチ数×3（1週間あたり）＋ 販売数×10　→ 上位20%を「反応が強い」
 *  ③ AIが全タイトルに特徴のタグ（機種・シリーズ・ジャンル・限定版・箱説付き・日本限定・発売年代）を付け、
 *     反応が強い商品に多い特徴（全体と比べて何倍多いか）と価格帯を集計
 *  ④ AIが特徴を文章でまとめ、まだ出品していない似た商品のキーワードを提案
 *     → eBayで出品状況（価格帯・出品数）を確かめて「リサーチ候補」に追加
 * ===================================================================== */
function myActiveListings_() {
  const out = [];
  let page = 1, totalPages = 1;
  do {
    const res = trading_('GetMyeBaySelling', '<ActiveList><Include>true</Include><IncludeWatchCount>true</IncludeWatchCount>' +
      '<Pagination><EntriesPerPage>200</EntriesPerPage><PageNumber>' + page + '</PageNumber></Pagination></ActiveList>');
    const ns = res.ns;
    const active = res.root.getChild('ActiveList', ns);
    if (!active) break;
    const pr = active.getChild('PaginationResult', ns);
    totalPages = pr ? Number(pr.getChildText('TotalNumberOfPages', ns)) || 1 : 1;
    const arr = active.getChild('ItemArray', ns);
    (arr ? arr.getChildren('Item', ns) : []).forEach(it => {
      const ss = it.getChild('SellingStatus', ns);
      const priceEl = ss ? ss.getChild('CurrentPrice', ns) : null;
      const ld = it.getChild('ListingDetails', ns);
      out.push({
        id: it.getChildText('ItemID', ns), title: it.getChildText('Title', ns) || '',
        price: priceEl ? Number(priceEl.getText()) : 0,
        watch: Number(it.getChildText('WatchCount', ns) || 0),
        sold: ss ? Number(ss.getChildText('QuantitySold', ns) || 0) : 0,
        start: ld && ld.getChildText('StartTime', ns) ? new Date(ld.getChildText('StartTime', ns)) : null,
        url: ld ? ld.getChildText('ViewItemURL', ns) : '',
      });
    });
    page++;
  } while (page <= totalPages && page <= 25);
  return out;
}

// Analytics API：過去30日の表示回数など（許可がなければ空で返す）
function trafficByListing_(ids) {
  const out = {};
  const fmt = d => Utilities.formatDate(d, 'UTC', 'yyyyMMdd');
  const end = new Date(Date.now() - 86400000), start = new Date(Date.now() - 31 * 86400000);
  const metrics = ['LISTING_VIEWS_TOTAL', 'LISTING_IMPRESSION_TOTAL', 'CLICK_THROUGH_RATE', 'TRANSACTION', 'SALES_CONVERSION_RATE'];
  for (let i = 0; i < ids.length; i += 200) {
    const chunk = ids.slice(i, i + 200);
    const filter = 'marketplace_ids:{EBAY_US},date_range:[' + fmt(start) + '..' + fmt(end) + '],listing_ids:{' + chunk.join('|') + '}';
    let res;
    try {
      res = ebay_('get', '/sell/analytics/v1/traffic_report?dimension=LISTING&filter=' + encodeURIComponent(filter) + '&metric=' + metrics.join(','));
    } catch (e) {
      out._error = /403|insufficient|scope|権限|401/i.test(e.message)
        ? '表示回数を読む許可がまだありません（「③④ eBay連携」をやり直すと表示回数も分析に使えます）' : 'Analytics API：' + e.message;
      return out;
    }
    const keys = ((res.header && res.header.metrics) || []).map(m => m.key);
    (res.records || []).forEach(r => {
      const id = r.dimensionValues && r.dimensionValues[0] ? String(r.dimensionValues[0].value) : '';
      if (!id) return;
      const o = {};
      (r.metricValues || []).forEach((mv, k) => { o[keys[k] || metrics[k]] = Number(mv.value) || 0; });
      out[id] = o;
    });
  }
  return out;
}

function reactionAnalysis_() {
  const key = need_('ANTHROPIC_API_KEY');
  const st = getSettings_();
  const items = myActiveListings_();
  if (items.length < 5) throw new Error('出品中の商品が少ないため（' + items.length + '件）、分析できません。5件以上になってから実行してください');
  const traffic = trafficByListing_(items.map(x => x.id));
  const now = Date.now();

  // 反応スコア
  items.forEach(x => {
    const days = Math.max(1, Math.min(30, x.start ? (now - x.start.getTime()) / 86400000 : 30));
    const t = traffic[x.id] || {};
    x.views = t.LISTING_VIEWS_TOTAL || 0;
    x.impr = t.LISTING_IMPRESSION_TOTAL || 0;
    x.ctr = t.CLICK_THROUGH_RATE || 0;
    x.days = Math.round(days);
    x.score = Math.round(((x.views / days) + (x.watch / days * 7) * 3 + x.sold * 10) * 100) / 100;
  });
  const sorted = items.slice().sort((a, b) => b.score - a.score);
  const topN = Math.max(3, Math.round(items.length * 0.2));
  const topSet = new Set(sorted.slice(0, topN).map(x => x.id));

  // カテゴリー（出品作成シートの記録から）
  const prep = ss_().getSheetByName('出品作成');
  const catOf = {};
  if (prep && prep.getLastRow() > 1) prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues()
    .forEach(v => { if (v[P.ITEMID - 1]) catOf[String(v[P.ITEMID - 1])] = String(v[P.CAT - 1] || ''); });

  // AIが特徴のタグを付ける（100件ずつ）
  const tags = {};
  for (let i = 0; i < sorted.length; i += 100) {
    const chunk = sorted.slice(i, i + 100);
    try {
      const out = parseJson_(claude_(key, st.model,
        'あなたはeBay出品の分析アシスタントです。タイトルから商品の特徴を読み取ってタグを付けます。出力はJSONのみ。',
        chunk.map((x, k) => k + '. ' + x.title).join('\n') +
        '\n\n各番号について次のタグを付けてください（分からなければ空）：' +
        '{"tags":[{"n":番号,"type":"ゲームソフト／ゲーム機・周辺機器／CD／雑誌・本／ぬいぐるみ／その他グッズ","platform":"機種（3DS、PS2など）","series":"シリーズ・作品名","edition":"通常版／限定版・初回版・特典付き","completeness":"箱説付き（CIB）／ソフトのみ／新品未開封／不明","japan_only":"日本限定・日本版のみ ならtrue","era":"発売年代（1990年代など）"}]}'));
      (out.tags || []).forEach(t => { const x = chunk[Number(t.n)]; if (x) tags[x.id] = t; });
    } catch (e) {}
  }

  // 特徴ごとに、反応が強い商品にどれだけ多いか（全体の割合と比べて何倍か）
  const band = p => p < 40 ? '$40未満' : p < 70 ? '$40〜70' : p < 100 ? '$70〜100' : p < 200 ? '$100〜200' : '$200以上';
  const feats = x => {
    const t = tags[x.id] || {};
    return ['種類：' + (t.type || '不明'), '機種：' + (t.platform || '不明'), 'シリーズ：' + (t.series || '不明'), '版：' + (t.edition || '不明'),
      '付属：' + (t.completeness || '不明'), '日本限定：' + (String(t.japan_only) === 'true' ? 'はい' : 'いいえ'), '年代：' + (t.era || '不明'), '価格帯：' + band(x.price)];
  };
  const cnt = {}, cntTop = {};
  items.forEach(x => feats(x).forEach(f => { cnt[f] = (cnt[f] || 0) + 1; if (topSet.has(x.id)) cntTop[f] = (cntTop[f] || 0) + 1; }));
  const lift = Object.keys(cnt).filter(f => cnt[f] >= 2 && !/：不明$/.test(f)).map(f => ({
    f: f, all: cnt[f], top: cntTop[f] || 0, lift: ((cntTop[f] || 0) / topN) / (cnt[f] / items.length),
  })).sort((a, b) => b.lift - a.lift || b.top - a.top);

  // シート「反応分析」：出品ごとの数字
  const ss = ss_();
  let sh = ss.getSheetByName('反応分析');
  if (!sh) sh = ss.insertSheet('反応分析');
  sh.clear();
  sh.getRange('A1').setValue('自分の出品の反応分析（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm') + '・過去30日）').setFontWeight('bold').setFontSize(13);
  sh.getRange('A2').setValue('反応スコア ＝ 1日あたりの表示回数 ＋ 1週間あたりのウォッチ数×3 ＋ 販売数×10。上位20%（' + topN + '件）を「反応が強い」としています。' +
    (traffic._error ? '　※' + traffic._error : '')).setFontColor('#777777');
  const head = ['順位', '反応が強い', 'eBay商品ID', 'タイトル', '価格$', 'カテゴリーID', '出品日数', '表示回数（30日）', 'インプレッション', 'クリック率', 'ウォッチ数', '販売数', '反応スコア', '種類', '機種', 'シリーズ', '版', '付属', '日本限定', '年代'];
  sh.getRange(4, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#e8f0f2');
  const rows = sorted.map((x, i) => { const t = tags[x.id] || {};
    return [i + 1, topSet.has(x.id) ? '★' : '', x.id, x.title, x.price, catOf[x.id] || '', x.days, x.views, x.impr, x.ctr, x.watch, x.sold, x.score,
      t.type || '', t.platform || '', t.series || '', t.edition || '', t.completeness || '', String(t.japan_only) === 'true' ? 'はい' : '', t.era || '']; });
  sh.getRange(5, 1, rows.length, head.length).setValues(rows);
  sh.getRange(5, 1, topN, head.length).setBackground('#fef7e0');
  [40, 70, 120, 380, 60, 90, 60, 90, 90, 70, 70, 60, 80, 100, 80, 140, 110, 110, 70, 80].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(4);

  // AIが特徴をまとめ、似た商品のキーワードを提案
  const topList = sorted.slice(0, topN).map(x => '・' + x.title + '（$' + x.price + '、表示' + x.views + '、ウォッチ' + x.watch + '、販売' + x.sold + '）').join('\n');
  const liftText = lift.slice(0, 25).map(l => l.f + '：反応が強い商品の' + Math.round(l.top / topN * 100) + '%（全体の' + Math.round(l.all / items.length * 100) + '%）＝ ' + l.lift.toFixed(1) + '倍').join('\n');
  const active = new Set(items.map(x => x.title.toLowerCase()));
  const ins = parseJson_(claude_(key, st.model,
    'あなたは日本からeBayへ輸出するセラーの分析担当です。数字にもとづいて、事実だけで説明します。推測は「〜の可能性」と書きます。出力はJSONのみ。',
    '【反応が強い商品（上位' + topN + '件）】\n' + topList + '\n\n【特徴ごとの偏り（反応が強い商品に何倍多いか）】\n' + liftText +
    '\n\n次のJSONで答えてください：{"features":["反応が強い商品の特徴（日本語・1文ずつ、3〜6個。数字を添えて）"],' +
    '"keywords":[{"kw":"eBayの出品タイトルに近い英語のキーワード（まだ出品していない、特徴が似た商品）","ja":"メルカリ・Yahoo!フリマで探すための日本語の検索語","why":"どの特徴に合うか（日本語・短く）"}]}' +
    '\nキーワードは12個まで。今出品している商品と同じものは入れない。$40〜$500で売れそうなものに限る。'));

  // シート「反応の特徴」
  let fs = ss.getSheetByName('反応の特徴');
  if (!fs) fs = ss.insertSheet('反応の特徴');
  fs.clear();
  fs.getRange('A1').setValue('反応が強い商品の特徴（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd') + '・出品' + items.length + '件を分析）').setFontWeight('bold').setFontSize(13);
  const fl = (ins.features || []).map(x => ['・' + x]);
  if (fl.length) fs.getRange(3, 1, fl.length, 1).setValues(fl).setWrap(true);
  let r0 = 4 + fl.length;
  fs.getRange(r0, 1, 1, 4).setValues([['特徴', '反応が強い商品の中の割合', '全体の中の割合', '何倍多いか']]).setFontWeight('bold').setBackground('#e8f0f2');
  const lr = lift.slice(0, 25).map(l => [l.f, Math.round(l.top / topN * 100) + '%（' + l.top + '件）', Math.round(l.all / items.length * 100) + '%（' + l.all + '件）', Math.round(l.lift * 10) / 10]);
  if (lr.length) fs.getRange(r0 + 1, 1, lr.length, 4).setValues(lr);
  fs.setColumnWidth(1, 520).setColumnWidth(2, 170).setColumnWidth(3, 140).setColumnWidth(4, 90);

  // 似た商品のキーワードを、eBayで確かめてから「リサーチ候補」に追加
  const cfg = research24Settings_();
  const rq = researchQueueSheet_();
  const rqLast = rq.getLastRow();
  const existing = new Set((rqLast > 1 ? rq.getRange(2, RQ.KW, rqLast - 1, 1).getValues().map(r => String(r[0]).trim().toLowerCase()) : []).concat(skippedKeywords_()));
  let added = 0, skipped = 0;
  (ins.keywords || []).slice(0, 12).forEach(k => {
    const kw = String(k.kw || '').trim();
    if (!kw || existing.has(kw.toLowerCase()) || active.has(kw.toLowerCase())) return;
    existing.add(kw.toLowerCase());
    const qc = quickMarketCheck_(kw);
    if (!qc.ok(cfg)) { skipKeyword_(kw, '反応分析からの提案をeBayで確認：' + qc.text(cfg), qc); skipped++; return; }
    rq.appendRow([kw, '中古', '反応分析から提案・eBay確認済み（' + qc.text(cfg) + '）：' + (k.why || '')]);
    const r = rq.getLastRow();
    rq.getRange(r, 1, 1, 3).setBackground('#e0f7fa');
    if (k.ja) rq.getRange(r, RQ.JA).setValue(String(k.ja));
    added++;
  });
  return { items: items.length, top: topN, added: added, skipped: skipped, features: ins.features || [], trafficError: traffic._error || '' };
}

