function zRuleCardJudge_(r) {
  let raw = {}; try { raw = JSON.parse(r[P.RAW - 1] || '{}'); } catch (e) {}
  const name = zNorm_(String(r[P.NAME - 1] || '') + ' ' + String(raw.title || ''));
  const text = zNorm_(String(raw.text || '').slice(0, 3000));
  const all = name + ' ' + String(r[P.TITLE - 1] || '') + ' ' + text;
  const cn = zCardNo_(name + ' ' + String(r[P.TITLE - 1] || ''));
  if (!cn.num || !zKnownCardKeys_().has(cn.num.toLowerCase())) return null;   // 新しい型番 → AI
  if (/PSA\s*\d{1,2}(\.5)?\s*(相当|狙い|級|クラス|レベル|候補|予定|出し|向け|可能|ほど|くらい)|PSA\s*(狙い|向け|に出|出し|未|なし|無し|前)|鑑定(前|なし|無し|狙い|向け|に出|出し)|未鑑定.*PSA|PSA.*未鑑定/i.test(all)) return null;   // はっきりしない → AI
  const gm = name.match(/\bPSA\s*(10|9\.5|9|8\.5|8|7|6|5|4|3|2|1)\b/i);
  if (gm) {
    const cm = all.match(/(?:cert|証明|鑑定番号|認定番号|番号)[^\d]{0,8}(\d{8,10})/i);
    return { status: 'psa_graded', psa_grade: gm[1], cert: cm ? cm[1] : '', evidence_ja: '型番を知っているので文字で判定：商品名に「PSA' + gm[1] + '」（AIなし・0円）', rule: true };
  }
  if (/\b(BGS|CGC|ARS|SGC|TAG)\s*\d/i.test(name)) return { status: 'not_psa', other_grader: (name.match(/\b(BGS|CGC|ARS|SGC|TAG)\b/i) || [])[1] || '', card_condition: 'near_mint', evidence_ja: '型番を知っているので文字で判定：PSA以外の鑑定（AIなし・0円）', rule: true };
  if (/PSA|BGS|CGC|ARS|SGC|鑑定|グレード|graded|slab|スラブ/i.test(all)) return null;   // 鑑定の言葉はあるがはっきりしない → AI
  const cond = String(r[P.COND - 1] || '') + ' ' + all;
  const cc = /新品|未使用(?!に近い)|未開封|パック開封直後|開封したて/.test(cond) ? 'near_mint'
    : /未使用に近い|美品|極美品|目立った傷や汚れなし|状態A|ランクA/.test(cond) ? 'excellent'
    : /やや傷や汚れあり|状態B|ランクB|傷あり|キズあり/.test(cond) ? 'very_good'
    : /傷や汚れあり|全体的に状態が悪い|状態C|ランクC|ジャンク|折れ|破れ/.test(cond) ? 'poor' : 'very_good';
  return { status: 'not_psa', card_condition: cc, evidence_ja: '型番を知っているので文字で判定：鑑定の言葉なし → 未鑑定（AIなし・0円）', rule: true };
}

