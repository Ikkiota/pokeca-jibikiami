function apiPrice_(model) {
  const m = String(model || '');
  const hit = API_PRICES.find(x => m.indexOf(x[0]) === 0);
  return hit ? { in: hit[1], out: hit[2] } : { in: 3, out: 15 };   // 分からないモデルは高めに見積もる
}
function apiCaller_() {
  const st = String(new Error().stack || '').split('\n').map(l => (l.match(/at (?:Object\.)?([\w$]+) /) || [])[1]).filter(x => x);
  const skip = ['apiCaller_', 'apiRecord_', 'claude_', 'claudeContent_', 'claudeWebSearch_', 'call', 'parseJson_'];
  return st.find(n => skip.indexOf(n) < 0) || '';
}
function apiTotals_() {
  const p = PropertiesService.getScriptProperties();
  let t = {}; try { t = JSON.parse(p.getProperty('API_COST') || '{}'); } catch (e) {}
  const d = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd'), m = d.slice(0, 6);
  if (t.d !== d) { t.d = d; t.day = 0; t.dayCalls = 0; }
  if (t.m !== m) { t.m = m; t.month = 0; }
  return t;
}
function apiBudget_() {
  const c = CacheService.getScriptCache();
  const hit = c.get('API_BUDGET');
  if (hit) return JSON.parse(hit);
  let b = { day: 1, month: 10 };
  try {
    const s = sheet_('設定');
    if (s.getRange('E116').getValue() === '') {
      s.getRange('E116').setValue('■ Claude APIの予算（上限に達したら、AIを使う処理を止めます）').setFontWeight('bold');
      s.getRange('E117:E120').setValues([['1日の上限（ドル）'], ['1か月の上限（ドル）'], ['今日の使用額（ドル・自動）'], ['今月の使用額（ドル・自動）']]).setFontWeight('bold');
      s.getRange('F117:F118').setValues([[1], [10]]).setBackground('#fff4dc');
      s.getRange('E121').setValue('上限に達すると、まとめ判定・在庫確認・価格の見直し・リサーチなど、AIを使う処理を止めてメールでお知らせします（出品済みの商品はそのまま）。日付・月が変わるか、上限を上げると再開します。使用額の内訳は「API使用量」シート、メニュー「APIの使用量を集計する」で確認できます。料金は、APIの返す実際のトークン数から計算した目安です。')
        .setFontColor('#777777').setWrap(true);
    }
    const v = s.getRange('F117:F118').getValues().map(r => Number(r[0]));
    b = { day: v[0] > 0 ? v[0] : 1, month: v[1] > 0 ? v[1] : 10 };
  } catch (e) {}
  c.put('API_BUDGET', JSON.stringify(b), 60);
  return b;
}
function apiBudgetOver_() {
  const t = apiTotals_(), b = apiBudget_();
  return (t.day || 0) >= b.day || (t.month || 0) >= b.month;
}
function apiBudgetCheck_() {
  if (!apiBudgetOver_()) return;
  apiBudgetNotify_();
  const t = apiTotals_(), b = apiBudget_();
  throw new Error('Claude APIの予算の上限に達したため止めました（今日 $' + (t.day || 0).toFixed(2) + '／上限 $' + b.day + '・今月 $' + (t.month || 0).toFixed(2) + '／上限 $' + b.month + '）。「設定」F117・F118で変更できます');
}
