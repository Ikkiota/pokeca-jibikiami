    Object.keys(Z_EN2JA).forEach(k => { const at = low.search(new RegExp('(^|[^a-z])' + k.replace(/[-.]/g, '\\$&') + '([^a-z]|$)')); if (at >= 0) names.push({ at: at, len: k.length + 1, ja: Z_EN2JA[k], en: Z_POKE.concat(Z_TRAINER).find(p => p[0].toLowerCase() === k)[0] }); });
    Z_JA_NAMES.forEach(k => { const at = t.indexOf(k); if (at >= 0) names.push({ at: at, len: k.length, ja: k, en: Z_JA2EN[k] }); });
    SL_NAMES.forEach(x => { const m = t.match(x[0]); if (m) names.push({ at: m.index, len: m[0].length, ja: x[1], en: x[2] }); });
