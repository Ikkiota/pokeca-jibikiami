  zLog_('案内・バナーの写真を外す', '外した ' + done + '件・もともとなかった ' + same + '件・できなかった ' + failed + '件' + (more ? '・続きは1分後' : '') + (notes.length ? '：' + notes.slice(0, 5).join('／') : ''));
  return { done: done, same: same, failed: failed, more: more, notes: notes };
}
function zCleanBannerContinue() { ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'zCleanBannerContinue').forEach(t => ScriptApp.deleteTrigger(t)); try { zCleanBannerPhotos_(); } catch (e) { zLog_('案内・バナーの写真を外す', 'エラー：' + e.message); } }
function menuCleanBanner() { run_(() => { const r = zCleanBannerPhotos_(); return '出品中の品の写真から、海外購入の案内・バナーを外しました：' + r.done + '件' + (r.failed ? '・できなかった ' + r.failed + '件（' + r.notes[0] + '）' : '') + (r.more ? '。残りは1分後に自動で続けます' : ''); }); }

// v176：指定した出品を「1枚目の写真だけ」にする（eBay の商品ID を入れる・複数はカンマ区切り）
function menuFirstPhotoOnly() {
