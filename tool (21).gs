    let cnt = 0;
    (mk.items || []).forEach((t, i) => {
      if (!/japan/i.test(t) || Z_JUNK.test(t)) return;
      const cn = zCardNo_(t);
      const nm = zNameFromTitle_(t);
      if (cn.set) { const k2 = 'Pokemon Card ' + cn.set + ' SAR Japanese'; if (!have.has(k2.toLowerCase())) newKw[k2] = (newKw[k2] || 0) + 1; }
      if (!cn.num) return;
      const graded = zGraded_(t);
      const gm = graded ? (t.match(/\b(PSA|BGS|CGC)\s*(\d{1,2}(\.5)?)\b/i) || []) : [];
      const grade = graded && gm[1] ? gm[1].toUpperCase() + gm[2] : '未鑑定';
      const key = (cn.set ? cn.set + ' ' : (nm.en ? nm.en + ' ' : '')) + cn.num;
      const k = key.toLowerCase() + '|' + grade;
      const pr = Number(mk.prices[i]) || 0;
      const o = found[k] = found[k] || { key: key, en: nm.en, ja: nm.ja, grade: grade, n: 0, low: 0 };
      o.n++; if (pr > 0 && (!o.low || pr < o.low)) o.low = pr;
      cnt++;
    });
    sh.getRange(x.row, ZK.STATE, 1, 4).setValues([['済', new Date(), cnt, (Number(x.r[ZK.TIMES - 1]) || 0) + 1]]);
  });
  // 2回以上出てきて、下限の値段より高い型番だけ（追加候補として・「使う」は空）
  const list = Object.keys(found).map(k => found[k]).filter(o => o.n >= 2 && o.low >= st.minUsd).map(o => ({ key: o.key, en: o.en, ja: o.ja, grade: o.grade, low: o.low, memo: '追加候補（キーワードの検索で ' + o.n + '回）' }));
  const added = list.length ? zModelAdd_(list) : 0;
  // 3回以上出てきたシリーズは、新しいキーワードとして登録
  const nk = Object.keys(newKw).filter(k => newKw[k] >= 3);
  if (nk.length) sh.getRange(sh.getLastRow() + 1, 1, nk.length, ZK_HEAD.length).setValues(nk.map(k => [k, '見つけた', 2, '待ち', '', '', '', '検索結果から（' + newKw[k] + '回）']));
  return { searched: todo.length, models: added, keywords: nk.length };
}

/* ---------- ③ カード型番リストを毎日見直す（値段・出品数。外すだけ・消さない） ---------- */
function zModelReview_(limit) {
  const st = zSettings_(), M = zModelRows_();
  const DAY = 86400000, now = Date.now(), started = Date.now();
  let checked = 0, off = 0;
  const todo = M.rows.filter(x => String(x.r[ZM.KEY - 1]).trim() && (!(x.r[ZM.CHECKED - 1] instanceof Date) || now - x.r[ZM.CHECKED - 1].getTime() > 14 * DAY))
    .sort((a, b) => (b.r[ZM.USE - 1] === true) - (a.r[ZM.USE - 1] === true)).slice(0, limit || 40);
  todo.forEach(x => {
    if (Date.now() - started > 90 * 1000) return;
    const res = zModelRecheck_(M.sh, x);
    checked++;
    if (x.r[ZM.USE - 1] === true && x.r[ZM.KEEP - 1] !== true) {
      const why = !res.mk.count ? 'eBayに同じカードの出品がない' : res.mk.low < st.minUsd ? 'eBayの最安 $' + res.mk.low.toFixed(2) + ' が下限 $' + st.minUsd + ' 未満' : !(res.cap > 0) ? '最低利益を守れる仕入れ値がない' : '';
      if (why) { M.sh.getRange(x.row, ZM.USE).setValue(false); M.sh.getRange(x.row, ZM.MEMO).setValue('自動で外した（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd') + '）：' + why + '。残すなら「あなたが残す」にチェック'); off++; }
    }
  });
  return { checked: checked, off: off };
}

