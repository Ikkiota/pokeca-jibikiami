// カテゴリの状態ルール（使える状態と、状態ごとの Condition Descriptor）。6時間キャッシュ
function conditionPolicy_(catId) {
  const cache = CacheService.getScriptCache();
  const ck = 'condpol_' + catId;
  const hit = cache.get(ck);
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  const out = { allowed: [], desc: {}, ok: false };
  for (let i = 0; i < 2 && !out.ok; i++) {
    try {
      const res = ebay_('get', '/sell/metadata/v1/marketplace/EBAY_US/get_item_condition_policies?filter=' + encodeURIComponent('categoryIds:{' + catId + '}'),
        { kind: 'app', marketplace: 'EBAY_US' });
      const pol = (res.itemConditionPolicies || [])[0];
      if (pol) {
        out.ok = true;
        (pol.itemConditions || []).forEach(c => {
          const id = Number(c.conditionId);
          out.allowed.push(id);
          out.desc[id] = (c.conditionDescriptors || []).map(d => ({ id: String(d.conditionDescriptorId), name: String(d.conditionDescriptorName || ''),
            values: (d.conditionDescriptorValues || []).map(v => ({ id: String(v.conditionDescriptorValueId), name: String(v.conditionDescriptorValueName || '') })) }));
        });
      }
    } catch (e) { Utilities.sleep(1500); }
  }
  if (out.ok) cache.put(ck, JSON.stringify(out), 21600);
  return out;
}

// v93：カードの写真を見て、鑑定状態を判定する（カードの鑑定状態判定ルール）
//  返り値 status："psa_graded"（PSA鑑定済みが写真で明確）／"not_psa"（PSAと確認できない）／"undeterminable"（写真から判断できない）
function cardPhotoJudge_(r, imgs) {
  const photos = (imgs || []).filter(u => /^https?:\/\//.test(u)).slice(0, 8);
  if (!photos.length) return { status: 'undeterminable', evidence_ja: '写真がないため、鑑定状態を確認できません' };
  let raw = {}; try { raw = JSON.parse(r[P.RAW - 1] || '{}'); } catch (e) {}
  const content = [{ type: 'text', text: '【商品名】' + String(r[P.NAME - 1] || raw.title || '') + '\n【英語タイトル】' + String(r[P.TITLE - 1] || '') +
    '\n【商品ページの文章（カードの状態の参考。鑑定状態の判定には使わない）】\n' + String(raw.text || '').slice(0, 3000) + '\n\n以下が商品の写真です。' }];
  // v142：AIに見せる写真は小さくして送る（768px・同じ枚数のまま。お金が約3分の1）。読めなかったら元の大きさでもう1回
  const small = u => 'https://wsrv.nl/?url=' + encodeURIComponent(String(u)) + '&w=768&h=768&fit=inside&output=jpg&q=80';
  const useSmall = cardPhotoJudge_._big !== true;
  photos.forEach((u, i) => { content.push({ type: 'text', text: '写真' + (i + 1) + '：' }); content.push({ type: 'image', source: { type: 'url', url: useSmall ? small(u) : u } }); });
  content.push({ type: 'text', text:
    '【カードの鑑定状態判定ルール】写真だけを根拠に判定してください。文章の「PSA10」などの記載だけでは鑑定済みにしません。推測（おそらく・たぶん）は禁止です。\n' +
    '1. 写真に、PSAの鑑定ケース（スラブ）とPSAのラベル（「PSA」の文字・ロゴ、グレード、証明番号）がはっきり写っている → "psa_graded"\n' +
    '   ・ラベルのグレード（例：GEM MT 10 → "10"）と証明番号（数字）を読み取る。読み取れないものは空にする\n' +
    '2. 写真でカード本体がはっきり見え、PSA鑑定済みではないと確認できる → "not_psa"\n' +
    '   ・鑑定ケースに入っていないカード（スリーブ・トップローダー・ローダーに入っているだけも含む）\n' +
    '   ・BGS・CGC・ARS・SGCなど、PSA以外の会社の鑑定ケース（ラベルの会社名が読めてPSAではない）\n' +
    '3. 写真から判断できない → "undeterminable"\n' +
    '   ・写真がぼやけている・小さい・カードが写っていない（箱や袋だけ）・写真が読み込めない\n' +
    '   ・鑑定ケースらしきものに入っているが、ラベルの会社名が読めずPSAかどうか分からない\n' +
    '4. not_psa のときのカードの状態（card_condition）：写真と説明から、傷・白欠け・折れ・汚れがほぼない→"near_mint"、軽い傷→"excellent"、目立つ傷や白欠け→"very_good"、大きな傷・折れ・汚れ→"poor"。迷ったら低いほう\n' +
    '\n出力はJSONのみ：{"status":"psa_graded|not_psa|undeterminable","psa_grade":"","cert":"","other_grader":"BGSなど（PSA以外のケースのとき）","card_condition":"near_mint|excellent|very_good|poor","evidence_ja":"どの写真で何を確認したか（短く）"}' });
  const sys = 'あなたはトレーディングカードの鑑定状態を写真で確認する担当です。写真で明確に確認できることだけを答えます。出力はJSONのみ。';
  if (raw.z0) return parseJson_(claude_(need_('ANTHROPIC_API_KEY'), MODEL_H55, sys, content));   // v120：0円の判定の品は Haiku 5.5 で1回だけ（ほかのモデルでやり直さない）
  const ms = modelSettings_(), light = String(getSettings_().model || '');
  // v107：鑑定の記載がないカードは、軽いモデルで先に判定。「PSAではない」とはっきりしたときだけ採用（PSAらしい・判断できないときは F124 のモデルで判定し直す）
  const hint = /PSA|BGS|CGC|SGC|ARS|TAG|鑑定|グレード|graded|slab/i.test(String(r[P.NAME - 1] || '') + ' ' + String(r[P.TITLE - 1] || '') + ' ' + String(raw.title || '') + ' ' + String(raw.text || '').slice(0, 3000));
  if (ms.cascade && !hint && /^claude-haiku-5/.test(light) && light !== ms.card) {
    try {
      const j1 = parseJson_(claude_(need_('ANTHROPIC_API_KEY'), light, sys, content));
      if (j1 && j1.status === 'not_psa') { j1.evidence_ja = String(j1.evidence_ja || '') + '（軽いモデルで判定）'; return j1; }
    } catch (e) {}
  }
  return parseJson_(claude_(need_('ANTHROPIC_API_KEY'), ms.card, sys, content));
}

function pickDescValue_(desc, nameRe, want, fallbackId) {
  const d = (desc || []).find(x => nameRe.test(x.name));
  if (!d) return fallbackId || '';
  const w = String(want || '').toLowerCase().replace(/\s+/g, ' ').trim();
  if (!w) return fallbackId || '';
  const v = d.values.find(x => x.name.toLowerCase() === w) || d.values.find(x => x.name.toLowerCase().indexOf(w) === 0) ||
    (w.length >= 4 ? d.values.find(x => x.name.toLowerCase().indexOf(w) >= 0) : null);   // 例：Lightly Played (Excellent)
  return v ? v.id : (fallbackId || '');
}

// 出品に使う状態を決める（返り値：cond・ConditionDescriptorsのXML・メモ）
function resolveListingCondition_(sh, row, r, cat, cond, imgs) {
  const pol = conditionPolicy_(cat);
  const allowed = pol.allowed;
  const isCard = CARD_CATS_FALLBACK.indexOf(String(cat)) >= 0 || (allowed.length > 0 && allowed.indexOf(4000) >= 0 && allowed.every(c => c === 2750 || c === 4000));
  if (!isCard) {
    if (!allowed.length || allowed.indexOf(cond) >= 0) return { cond: cond, xml: '', note: '' };
    const order = cond >= 3000 ? [3000, 4000, 5000, 6000, 2750, 7000, 1000] : cond === 1500 ? [1500, 1750, 1000, 2750, 3000, 4000] : [1000, 1500, 1750, 2750, 3000, 4000];
    const c2 = order.find(c => allowed.indexOf(c) >= 0) || allowed[0];
    sh.getRange(row, P.COND).setValue(CONDITIONS.find(c => c.startsWith(String(c2))) || String(c2));
    return { cond: c2, xml: '', note: '状態を ' + cond + ' → ' + c2 + '（このカテゴリで使える状態）に変更' };
  }

  // トレカ：写真で鑑定状態を判定（3000は絶対に使わない）
  const stop = why => {
    sh.getRange(row, P.COND).setValue('未査定（要確認）');
    throw new Error('未査定：' + why + '。写真で鑑定状態を確認できないため出品しませんでした（要確認）。写真を確認し、PSA鑑定済みでなければE列で「4000 未鑑定」を選んで出品し直してください（PSA鑑定済みの場合は、ラベルがはっきり写った写真が必要です）');
  };
  let j = null;
  // v142：同じ品・同じ写真を前に確かめていれば、その結果を使う（やり直しでお金をかけない・30日）
  let rawc = {}; try { rawc = JSON.parse(r[P.RAW - 1] || '{}'); } catch (e) {}
  const pkey = imgs.slice(0, 8).join('|').length + ':' + imgs.slice(0, 8).join('|').slice(-120);
  if (rawc.cj && rawc.cj.k === pkey && Date.now() - rawc.cj.at < 30 * 86400000) j = rawc.cj.j;
  // v151：知っている型番（型番リスト・売れた実績・前に出品した型番）は、商品名と説明の文字で判定（AIなし・0円）。新しい型番・はっきりしない品だけ AI
  if (!j) { try { const rj = zRuleCardJudge_(r); if (rj) j = rj; } catch (e) {} }
  if (!j) {
    try { cardPhotoJudge_._big = false; j = cardPhotoJudge_(r, imgs); }
    catch (e) {
      if (/image|画像|url|fetch|download/i.test(String(e.message))) { try { cardPhotoJudge_._big = true; j = cardPhotoJudge_(r, imgs); } catch (e2) { stop('写真の確認でエラー（' + e2.message + '）'); } finally { cardPhotoJudge_._big = false; } }
      else stop('写真の確認でエラー（' + e.message + '）');
    }
    if (j && j.status === 'undeterminable' && !cardPhotoJudge_._triedBig) { try { cardPhotoJudge_._big = true; const j2 = cardPhotoJudge_(r, imgs); if (j2 && j2.status !== 'undeterminable') j = j2; } catch (e) {} finally { cardPhotoJudge_._big = false; } }   // 小さい写真で読めなかったときだけ元の大きさで
    try { if (j && j.status !== 'undeterminable') { rawc.cj = { k: pkey, at: Date.now(), j: j }; sh.getRange(row, P.RAW).setValue(JSON.stringify(rawc)); } } catch (e) {}
  }
  const status = String(j && j.status || 'undeterminable');
  const S = a => '<ConditionDescriptor><Name>' + a[0] + '</Name>' + (a[1] ? '<Value>' + a[1] + '</Value>' : '') + (a[2] ? '<AdditionalInfo>' + x_(a[2]) + '</AdditionalInfo>' : '') + '</ConditionDescriptor>';
  const ev = String(j && j.evidence_ja || '').slice(0, 120);
  const manual = parseInt(String(r[P.COND - 1]), 10);

  if (status === 'psa_graded') {
    const desc = pol.desc[2750] || [];
    const grade = String(j.psa_grade || '').replace(/^.*?(\d+(?:\.\d)?)\s*$/, '$1').trim();
    const grId = pickDescValue_(desc, /^grade$/i, grade, CD_FALLBACK.grade.values[grade]);
    if (!grade || !grId) stop('PSA鑑定済みは確認できましたが、ラベルのグレードを写真から読み取れませんでした（' + ev + '）');
    const gId = pickDescValue_(desc, /grader/i, 'PSA', CD_FALLBACK.grader.values.PSA) || CD_FALLBACK.grader.values.PSA;
    const graderD = (desc.find(x => /grader/i.test(x.name)) || {}).id || CD_FALLBACK.grader.id;
    const gradeD = (desc.find(x => /^grade$/i.test(x.name)) || {}).id || CD_FALLBACK.grade.id;
    const certD = (desc.find(x => /cert/i.test(x.name)) || {}).id || CD_FALLBACK.cert.id;
    const cert = String(j.cert || '').replace(/\D/g, '').slice(0, 30);
    sh.getRange(row, P.COND).setValue(CONDITIONS.find(c => c.startsWith('2750')));
    return { cond: 2750, xml: '<ConditionDescriptors>' + S([graderD, gId]) + S([gradeD, grId]) + (cert ? S([certD, '', cert]) : '') + '</ConditionDescriptors>',
      note: 'カードの鑑定状態：Graded／2750（PSA ' + grade + (cert ? '・Cert ' + cert : '') + '）写真で確認：' + ev };
  }
  // 一度「未査定」になった商品を、人が写真を見てE列で「4000 未鑑定」に選び直したときは、その判断で出品する
  const humanUngraded = status === 'undeterminable' && manual === 4000 && /未査定/.test(String(r[P.NOTE - 1] || '') + String(r[P.STATUS - 1] || ''));
  if (status === 'not_psa' || humanUngraded) {
    const desc = pol.desc[4000] || [];
    const key = ['near_mint', 'excellent', 'very_good', 'poor'].indexOf(String(j && j.card_condition)) >= 0 ? j.card_condition : 'very_good';
    const names = { near_mint: 'Near mint or better', excellent: 'Excellent', very_good: 'Very good', poor: 'Poor' };
    const vId = pickDescValue_(desc, /card condition/i, names[key], CD_FALLBACK.card.values[key]) || CD_FALLBACK.card.values[key];
    const cD = (desc.find(x => /card condition/i.test(x.name)) || {}).id || CD_FALLBACK.card.id;
    sh.getRange(row, P.COND).setValue(CONDITIONS.find(c => c.startsWith('4000')));
    return { cond: 4000, xml: '<ConditionDescriptors>' + S([cD, vId]) + '</ConditionDescriptors>',
      note: 'カードの鑑定状態：Ungraded／4000' + (humanUngraded ? '（未査定 → 人の確認で未鑑定に決定）' : '') + (j && j.other_grader ? '（PSA以外の鑑定ケース：' + j.other_grader + '）' : '') + '・カードの状態 ' + names[key] + '　写真で確認：' + ev };
  }
  stop(ev || '写真から鑑定状態を判断できませんでした');
}

function validCondition_(catId, condId, APP) {
  try {
    const res = ebay_('get', '/sell/metadata/v1/marketplace/EBAY_US/get_item_condition_policies?filter=' +
      encodeURIComponent('categoryIds:{' + catId + '}'), APP);
    const pol = (res.itemConditionPolicies || [])[0];
    let allowed = pol && pol.itemConditions ? pol.itemConditions.map(c => Number(c.conditionId)) : [];
    if (!allowed.length) allowed = conditionPolicy_(catId).allowed;
    if (!allowed.length && CARD_CATS_FALLBACK.indexOf(String(catId)) >= 0) allowed = [2750, 4000];
    if (!allowed.length || allowed.indexOf(condId) >= 0) return condId;
    const order = condId >= 3000 ? [3000, 4000, 5000, 6000, 2750, 7000, 1000] : condId === 1500 ? [1500, 1750, 1000, 2750, 3000, 4000] : [1000, 1500, 1750, 2750, 3000, 4000];
    return order.find(c => allowed.indexOf(c) >= 0) || allowed[0];
  } catch (e) {
    if (CARD_CATS_FALLBACK.indexOf(String(catId)) >= 0) return condId >= 3000 ? 4000 : condId;
    return condId;
  }
}


/* =====================================================================
 * 相場のリサーチ（1件ずつ確認）
 *  ・詳しい検索語／通常の検索語／短い検索語／JANコードで、eBay USの即決出品を最大100件ずつ集める
 *  ・米国の購入者から見た送料で「商品価格＋送料」を計算（出品者の国は問わない）
 *  ・AIが1件ずつタイトルを見て、同じ商品か（サイズ・種類・限定版・セット品など）を判定
 *  ・同じ状態（新品／中古）の出品が3件以上あればその中央値、なければ同じ商品全体の中央値
 *  ・確認した出品はすべて「相場の根拠」シートに記録
 * ===================================================================== */
function researchMarket_(key, st, info, jan, condId, APP, srcUrl) {
  const cs = calcSettings_();
  const hdr = { 'X-EBAY-C-ENDUSERCTX': 'contextualLocation=country%3DUS%2Czip%3D10001' };
  const ptype = normType_(info.product_type);
  const japanLimited = info.japan_limited === true || String(info.japan_limited) === 'true';
  const qFull = String(info.search_query_full_en || '').trim();
  const q = String(info.search_query_en || '').trim();
  const qs = String(info.search_query_short_en || '').trim();
  const params = [];
  if ([8, 12, 13].indexOf(jan.length) >= 0) params.push('&gtin=' + jan);
  [qFull, q, qs].filter((x, i, a) => x && a.indexOf(x) === i).forEach(x => params.push('&q=' + encodeURIComponent(x)));
  const byId = {};
  params.forEach(pm => {
    try {
      const r = ebay_('get', '/buy/browse/v1/item_summary/search?limit=100&filter=' + encodeURIComponent('buyingOptions:{FIXED_PRICE}') + pm,
        { kind: 'app', marketplace: 'EBAY_US', headers: hdr });
      (r.itemSummaries || []).forEach(it => { if (!byId[it.itemId]) byId[it.itemId] = it; });
    } catch (e) {}
  });
  const me = String(info.excludeSeller || '').toLowerCase();
  const all = Object.keys(byId).map(k => byId[k]).filter(it =>
    !(me && it.seller && String(it.seller.username || '').toLowerCase() === me) && !(info.excludeItemId && String(it.legacyItemId || '') === String(info.excludeItemId)));
  all.forEach(it => {
    const p = Number(it.price && it.price.value) || 0;
    const so = (it.shippingOptions || []).find(o => o.shippingCost) || null;
    it._ship = so ? Number(so.shippingCost.value) || 0 : 0;
    it._total = p + it._ship;                                  // 商品価格＋送料の合計で比べる
    it._used = Number(it.conditionId) >= 3000;
    it._jp = ((it.itemLocation && it.itemLocation.country) || '') === 'JP';
    it._mark = '× 別の商品';
  });
  const mainQ = qFull || q || qs || jan;
  const url = 'https://www.ebay.com/sch/i.html?_nkw=' + encodeURIComponent(mainQ).replace(/%20/g, '+') + '&LH_BIN=1';
  if (!all.length) return { items: [], med: '', low: '', checked: 0, url: url, pool: 'なし' };

  // ① AIが1件ずつ同じ商品か判定（ゲームソフトは日本語版だけ）
  const list = all.slice(0, 120);
  let same = [];
  try {
    const lines = list.map((it, i) => i + '. ' + String(it.title || '').slice(0, 110) + ' | $' + it._total.toFixed(2) + ' | ' + (it.condition || '') +
      ' | ' + ((it.itemLocation && it.itemLocation.country) || ''));
    const out = parseJson_(claude_(key, st.model,
      'あなたはeBayの相場調査のアシスタントです。仕入れる商品と「同じ商品」の出品だけを選びます。出力はJSONのみ。\n' +
      '同じ商品の条件：同じキャラクター・同じ種類（ぬいぐるみ、ソフト、CDなど）・同じサイズや型番・同じ限定の種類。\n' +
      '違う商品として除外：別のサイズ、キーホルダー・バッジなど別の種類、複数個のセットやまとめ売り、他の商品との抱き合わせ、部品だけ、説明書だけ、箱だけ、ディスクだけ、ジャンク、コピー品・非公式品。\n' +
      '色・柄・デザインがある商品（衣類・手袋・小物・雑貨・ぬいぐるみなど）は、色・柄・デザインがまったく同じものだけを同じ商品とする。タイトルに違う色・柄・デザインが書かれていたら除外。タイトルに色・柄が書かれていない出品は、あとで画像で確認するので残してよい。\n' +
      (ptype === 'game_soft' ? 'ゲームソフトは日本語版（Japanese ver. / Japan import / NTSC-J / JPN）だけを同じ商品とし、英語版・北米版・欧州版（US ver. / NTSC-U / PAL / English）は除外。版が分からないものは、発送国が日本なら日本語版とみなす。\n' : ''),
      '【仕入れる商品】\n' + JSON.stringify({ name: info.name_ja, brand: info.brand, model: info.model, features: info.features_ja, condition: info.condition, identity: info.identity || {} }) +
      '\n\n【eBayの出品（番号. タイトル | 商品＋送料 | 状態 | 発送国）】\n' + lines.join('\n') +
      '\n\n次のJSONで答えてください：{"same":[同じ商品の番号の配列]}'));
    same = (out.same || []).map(Number).filter(i => i >= 0 && i < list.length);
  } catch (e) {
    same = list.map((_, i) => i);
  }
  let matched = same.map(i => list[i]);
  matched.forEach(it => it._mark = '○ 同じ商品');

  // ② 状態をそろえる（中古なら中古同士）
  const wantUsed = condId >= 3000;
  const sameCond = matched.filter(it => it._used === wantUsed);
  let pool = sameCond.length >= 3 ? sameCond : matched;
  if (pool === sameCond) matched.filter(it => it._used !== wantUsed).forEach(it => it._mark = '○ 同じ商品（状態違い）');

  // ③ 比べる相手：日本限定なら日本のセラーだけ、海外にも出回っている商品は海外セラーも含める
  let poolName = '全セラー';
  if (japanLimited) {
    const jpOnly = pool.filter(it => it._jp);
    if (jpOnly.length) {
      pool.filter(it => !it._jp).forEach(it => it._mark = '○ 同じ商品（海外セラー・日本限定のため比較外）');
      pool = jpOnly; poolName = '日本のセラーのみ（日本限定品）';
    }
  }

  // ③' 色・柄・デザインがある商品は、安い順に最大15件を出品データと画像で確認（まったく同じものだけ残す）
  if (!info.light && (ptype === 'other' || ptype === 'game_hw' || ptype === 'magazine')) {
    pool.sort((a, b) => a._total - b._total);
    const head = pool.slice(0, 15), rest = pool.slice(15);
    const keepIds = visualSameCheck_(key, st, info, head);
    if (keepIds) {
      head.forEach(it => { if (!keepIds.has(it.itemId)) it._mark = '× 色・柄・デザインが違う（画像・出品データで確認）'; });
      pool = head.filter(it => keepIds.has(it.itemId)).concat(rest);
      poolName += '・色柄を画像で確認';
    }
  }

  // ④ ゲームソフトは、安い順に出品データ（地域・言語）を確認して日本語版以外を除外
  if (ptype === 'game_soft' && !info.light) {
    pool.sort((a, b) => a._total - b._total);
    let checked = 0;
    pool = pool.filter(it => {
      if (checked >= 12) return true;
      checked++;
      try {
        const d = ebay_('get', '/buy/browse/v1/item/' + encodeURIComponent(it.itemId), { kind: 'app', marketplace: 'EBAY_US' });
        const asp = (d.localizedAspects || []).map(a => a.name + ':' + a.value).join(' | ');
        if (/Region Code:[^|]*(NTSC-U|NTSC-C|PAL|USA|North America|Europe)/i.test(asp) && !/NTSC-J|Japan/i.test(asp)) { it._mark = '× 日本語版ではない（出品データで確認）'; return false; }
        if (/Language:[^|]*English/i.test(asp) && !/Japanese/i.test(asp)) { it._mark = '× 日本語版ではない（出品データで確認）'; return false; }
      } catch (e) {}
      return true;
    });
    poolName += '・日本語版のみ';
  }

  // ⑤ 明らかに安すぎる出品を除外（すぐ上の出品との差が設定額以上）
  pool.sort((a, b) => a._total - b._total);
  //    出品が少ないときに外しすぎないよう、残りが3件以上あるときだけ、最大2件まで
  let dropped = 0;
  while (pool.length >= 3 && dropped < 2 && pool[1]._total - pool[0]._total >= cs.outlierGap) {
    pool[0]._mark = '△ 安すぎて除外（次の出品と$' + (pool[1]._total - pool[0]._total).toFixed(0) + '差）';
    pool.shift();
    dropped++;
  }
  pool.forEach(it => it._mark = '◎ 相場に使用');
  if (pool.length) pool[0]._mark = '◎ 勝負する最安値';
  const tot = pool.map(it => it._total);
  const med = tot.length ? (tot.length % 2 ? tot[(tot.length - 1) / 2] : (tot[tot.length / 2 - 1] + tot[tot.length / 2]) / 2) : '';
  const low = tot.length ? tot[0] : '';

  // 相場の根拠を記録
  try {
    const ss = ss_();
    let lg = ss.getSheetByName('相場の根拠');
    if (!lg) {
      lg = ss.insertSheet('相場の根拠');
      lg.getRange(1, 1, 1, 12).setValues([['調べた日時', '仕入れURL', '検索（ブラウザ）', 'eBayの出品タイトル', '商品価格$', '送料$', '合計$', '状態', '発送国', '判定', 'eBayの出品URL', '比べた相手']])
        .setFontWeight('bold').setBackground('#e8f0f2');
      lg.setFrozenRows(1);
      [120, 160, 160, 420, 70, 60, 70, 110, 60, 220, 200, 180].forEach((w, i) => lg.setColumnWidth(i + 1, w));
    }
    const now = new Date();
    const rows = list.slice().sort((a, b) => a._total - b._total).map(it => [now, srcUrl, url, it.title, Number(it.price && it.price.value) || 0, it._ship, it._total,
      it.condition || '', (it.itemLocation && it.itemLocation.country) || '', it._mark, it.itemWebUrl || '', poolName]);
    if (rows.length) lg.getRange(lg.getLastRow() + 1, 1, rows.length, 12).setValues(rows);
  } catch (e) {}

  const jpM = matched.filter(it => it._jp);
  const sellerSet = arr => new Set(arr.map(it => it.seller && it.seller.username).filter(x => x));
  const broad = matched.filter(it => !/日本語版ではない/.test(String(it._mark))).map(it => it._total).filter(n => n > 0).sort((a, b) => a - b);
  let bd = 0;
  while (broad.length >= 3 && bd < 2 && broad[1] - broad[0] >= cs.outlierGap) { broad.shift(); bd++; }
  return { items: pool, med: med, low: low, checked: list.length, url: url, pool: poolName,
    broadLow: broad.length ? broad[0] : '', broadLow2: broad.length >= 2 ? broad[1] : '',
    matchedCount: matched.length, jpCount: jpM.length, jpSellers: sellerSet(jpM).size, sellers: sellerSet(matched).size,
    lowJp: jpM.length ? Math.min.apply(null, jpM.map(it => it._total)) : '' };
}


// 価格の決め方の設定（F32：安すぎる出品の判断、F33：最安値からの値下げ幅）
function ensurePricingSettings_(s) {
  if (s.getRange('E32').getValue() !== '') return;
  s.getRange('E31').setValue('■ 価格の決め方').setFontWeight('bold');
  s.getRange('E32:E33').setValues([['安すぎる出品として無視する差（ドル）'], ['勝負する最安値からの値下げ幅']]).setFontWeight('bold');
  s.getRange('F32').setValue(20).setBackground('#fff4dc');
  s.getRange('F33').setValue(0.01).setNumberFormat('0%').setBackground('#fff4dc');
  s.getRange('E34').setValue('同じ商品の出品を合計（商品＋送料）の安い順に並べ、すぐ上の出品より F32 のドル以上安い出品は無視します。残った最安値から F33 下げた価格で利益が最低利益額以上なら候補。届かなければ中央値（B16%引き）で判定します。日本限定品は日本のセラーだけ、ゲームソフトは日本語版だけと比べます。')
    .setFontColor('#777777').setWrap(true);
}


/* =====================================================================
 * eBayの検索結果を1件ずつ調べる
 *  ブラウザで見ているeBayの検索URL（またはキーワード）を貼ると、同じ条件で全件を取得し、
 *  出品数・日本のセラー数・最安値などを「eBay調査」シートにまとめる
 * ===================================================================== */
function parseEbaySearchUrl_(text) {
  const t = String(text || '').trim();
  const get = k => { const m = t.match(new RegExp('[?&]' + k + '=([^&#]*)')); return m ? decodeURIComponent(m[1].replace(/\+/g, ' ')) : ''; };
  const isUrl = /^https?:\/\//i.test(t);
  const kw = isUrl ? get('_nkw') : t;
  const cond = isUrl ? get('LH_ItemCondition') : '';
  // eBayの状態の番号：4＝中古、3＝新品（画面の絞り込み）、1000/1500…＝新品系、3000以上＝中古系
  let condition = '';
  if (cond) {
    const codes = cond.split('|').map(Number);
    const used = codes.some(c => c === 4 || c >= 3000), neu = codes.some(c => c === 3 || (c >= 1000 && c < 3000));
    condition = used && !neu ? 'USED' : neu && !used ? 'NEW' : '';
  }
  return { keywords: kw, condition: condition, binOnly: isUrl && get('LH_BIN') === '1', auctionOnly: isUrl && get('LH_Auction') === '1' };
}

function surveyEbaySearch() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.prompt('eBayの検索結果を調べる', 'eBayの検索結果ページのURL（またはキーワード）を貼り付けてください。\n状態（中古・新品）や即決の絞り込みもURLから読み取ります。', ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;
  const q = parseEbaySearchUrl_(r.getResponseText());
  if (!q.keywords) { ui.alert('キーワードを読み取れませんでした。'); return; }
  try {
    const out = surveySearch_(q);
    ui.alert('調べました',
      'キーワード：' + q.keywords + (q.condition ? '（' + (q.condition === 'USED' ? '中古' : '新品') + 'のみ）' : '') + '\n\n' +
      '出品数：' + out.count + '件（うち日本から発送 ' + out.jpCount + '件）\n' +
      '日本のセラー：' + out.jpSellers + '人／全セラー：' + out.sellers + '人\n' +
      '最安値（全体）：' + (out.low ? '$' + out.low.total.toFixed(2) + '（' + out.low.country + '・' + out.low.seller + '）' : '—') + '\n' +
      '最安値（日本のセラー）：' + (out.lowJp ? '$' + out.lowJp.total.toFixed(2) + '（' + out.lowJp.seller + '）' : '—') + '\n' +
      '中央値（全体）：' + (out.med ? '$' + out.med.toFixed(2) : '—') + '\n\n' +
      '※価格は「商品＋米国への送料」の合計。1件ずつの内容は「eBay調査」シートを見てください。', ui.ButtonSet.OK);
    ss_().getSheetByName('eBay調査').activate();
  } catch (e) {
    ui.alert('エラー：' + e.message);
  }
}

function surveySearch_(q) {
  const hdr = { 'X-EBAY-C-ENDUSERCTX': 'contextualLocation=country%3DUS%2Czip%3D10001' };
  const filters = [];
  if (q.condition) filters.push('conditions:{' + q.condition + '}');
  if (q.binOnly) filters.push('buyingOptions:{FIXED_PRICE}');
  if (q.auctionOnly) filters.push('buyingOptions:{AUCTION}');
  const items = [];
  let total = 0;
  for (let offset = 0; offset < 1000; offset += 200) {
    const res = ebay_('get', '/buy/browse/v1/item_summary/search?q=' + encodeURIComponent(q.keywords) + '&limit=200&offset=' + offset +
      (filters.length ? '&filter=' + encodeURIComponent(filters.join(',')) : ''), { kind: 'app', marketplace: 'EBAY_US', headers: hdr });
    total = res.total || total;
    (res.itemSummaries || []).forEach(it => items.push(it));
    if (!res.next || !(res.itemSummaries || []).length) break;
  }
  const rows = items.map(it => {
    const price = Number(it.price && it.price.value) || Number(it.currentBidPrice && it.currentBidPrice.value) || 0;
    const so = (it.shippingOptions || []).find(o => o.shippingCost);
    const ship = so ? Number(so.shippingCost.value) || 0 : 0;
    return { title: it.title || '', price: price, ship: ship, total: price + ship, cond: it.condition || '',
      country: (it.itemLocation && it.itemLocation.country) || '', seller: (it.seller && it.seller.username) || '',
      fb: it.seller ? (it.seller.feedbackPercentage || '') + '%（' + (it.seller.feedbackScore || 0) + '）' : '',
      type: (it.buyingOptions || []).join(','), url: it.itemWebUrl || '' };
  }).sort((a, b) => a.total - b.total);

  const jp = rows.filter(r => r.country === 'JP');
  const uniq = arr => new Set(arr.map(r => r.seller).filter(x => x)).size;
  const tot = rows.map(r => r.total).filter(n => n > 0);
  const med = tot.length ? (tot.length % 2 ? tot[(tot.length - 1) / 2] : (tot[tot.length / 2 - 1] + tot[tot.length / 2]) / 2) : 0;

  const ss = ss_();
  let sh = ss.getSheetByName('eBay調査');
  if (!sh) sh = ss.insertSheet('eBay調査');
  sh.clear();
  sh.getRange('A1').setValue('eBay調査：' + q.keywords + (q.condition ? '（' + (q.condition === 'USED' ? '中古' : '新品') + 'のみ）' : '') + '　' +
    Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm')).setFontWeight('bold').setFontSize(12);
  sh.getRange('A2').setValue('出品数 ' + rows.length + '件（eBayの検索総数 ' + total + '件）／日本から発送 ' + jp.length + '件・日本のセラー ' + uniq(jp) + '人／全セラー ' + uniq(rows) + '人／' +
    '最安値 $' + (rows[0] ? rows[0].total.toFixed(2) : '—') + '／日本のセラーの最安値 $' + (jp[0] ? jp[0].total.toFixed(2) : '—') + '／中央値 $' + (med ? med.toFixed(2) : '—'));
  const head = ['順位', '合計$（商品＋米国送料）', '商品価格$', '送料$', '発送国', 'セラー', '評価', '状態', '販売形式', 'タイトル', 'URL'];
  sh.getRange(4, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#e8f0f2');
  if (rows.length) {
    sh.getRange(5, 1, rows.length, head.length).setValues(rows.map((r, i) => [i + 1, r.total, r.price, r.ship, r.country, r.seller, r.fb, r.cond, r.type, r.title, r.url]));
    sh.getRange(5, 2, rows.length, 3).setNumberFormat('0.00');
    rows.forEach((r, i) => { if (r.country === 'JP') sh.getRange(5 + i, 1, 1, head.length).setBackground('#fff4dc'); });
  }
  [50, 110, 80, 60, 60, 140, 110, 100, 90, 420, 220].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(4);
  return { count: rows.length, jpCount: jp.length, jpSellers: uniq(jp), sellers: uniq(rows), low: rows[0], lowJp: jp[0], med: med };
}


/* =====================================================================
 * リサーチの自動化：「リサーチ候補」シート
 *  A列にキーワード（Terapeakで見つけた売れ筋の商品名）を入れておくと、
 *  毎朝（またはメニューから）自動で：
 *   ・eBayの出品を1件ずつ確認（相場調査と同じルール）→ 出品数・日本のセラー数・勝負できる最安値
 *   ・その価格で最低利益額を残すための「仕入れ上限（円）」
 *   ・狙い目かどうかの判定
