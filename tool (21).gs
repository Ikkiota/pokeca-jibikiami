// カテゴリの仕様項目を、すべて（必須→推奨→任意）AIに渡す
function aspectGuideText_(asp) {
  const order = a => a.aspectConstraint && a.aspectConstraint.aspectRequired ? 0 : (a.aspectConstraint && a.aspectConstraint.aspectUsage === 'RECOMMENDED' ? 1 : 2);
  return (asp.aspects || []).slice().sort((a, b) => order(a) - order(b)).slice(0, 60).map(a => {
    const c = a.aspectConstraint || {};
    const vals = (a.aspectValues || []).map(v => v.localizedValue);
    const tag = c.aspectRequired ? '[必須] ' : (c.aspectUsage === 'RECOMMENDED' ? '[推奨] ' : '[任意] ');
    const opt = c.aspectMode === 'SELECTION_ONLY' ? '（選択肢: ' + vals.slice(0, 25).join(', ') + '）'
      : (vals.length ? '（例: ' + vals.slice(0, 8).join(', ') + '）' : '');
    return tag + a.localizedAspectName + opt;
  }).join('\n');
}

// この商品の写真ではないもの（広告・バナー・ロゴ・別の商品・お店の告知）だけを外す。順番は変えない
function verifyProductImages_(key, st, info, urls) {
  const list = urls.slice(0, 24);
  const removed = [];
  let note = '';
  for (let b = 0; b < list.length; b += 12) {
    const batch = list.slice(b, b + 12);
    const content = [{ type: 'text', text:
      '次の写真は、通販・フリマの1つの商品ページから取った写真です。この商品の写真「ではない」もの（広告、バナー、ロゴ、アイコン、お店の告知や注意書きの画像、ほかの商品の写真）だけを選んでください。' +
      'この商品そのもの・箱・説明書・付属品・タグ・裏側・傷のアップなどは、すべて「この商品の写真」として残します。迷ったら残します。出力はJSONのみ。\n' +
      '【商品】' + JSON.stringify({ name: info.name_ja, brand: info.brand, model: info.model, identity: info.identity || {} }) }];
    batch.forEach((u, i) => { content.push({ type: 'text', text: '写真' + (b + i) + '：' }); content.push({ type: 'image', source: { type: 'url', url: u } }); });
    content.push({ type: 'text', text: '{"not_this_item":[この商品の写真ではない写真の番号の配列],"note":"気になる点があれば短く"}' });
    try {
      const out = parseJson_(claudeContent_(key, st.model, 'あなたはeBay出品の写真をチェックするアシスタントです。', content));
      (out.not_this_item || []).map(Number).forEach(n => { if (n >= b && n < b + batch.length) removed.push(n); });
      if (out.note) note = String(out.note).slice(0, 120);
    } catch (e) {
      note = '一部の写真をAIで確認できませんでした（そのまま残しています）';
    }
  }
  // v101：写真は外さない（仕入れ先の写真を勝手に削除しない）。AIが気になった写真はメモに残すだけ
  const sus = removed.filter((x, k) => removed.indexOf(x) === k).sort((a, b) => a - b);
  return { keep: list.slice(), removed: [], note: (sus.length ? 'AIが「この商品の写真ではないかも」と判断：' + sus.map(i => i + 1 + '枚目').join('、') + '（外さずに残しています）' : '') + (note ? (sus.length ? '／' : '') + note : '') };
}

// 写真を1枚ずつ、順番どおりにeBayのサーバーへアップロード（1枚でも失敗したら止める）
let ZB_MANUAL_ = false, ZB_DEADLINE_ = 0;
let ZSENT_ = false;   /* v208：あなたが送った品（まとめ判定）を判定している間だけ true。見送りにせず出品する（最低利益・利益率は守る） */   // v200：あなたが押した実行（Google の上限の残りを見ない）
let PIC_EXT_ = [];   // v140：eBayへアップロードできず、写真のURLをそのまま使った写真の番号
/* v183：eBay は 2026/9/30 で写真のアップロード（Trading API の UploadSiteHostedPictures）を終了した（「Caught SAXException … Content is not allowed in prolog」になる）
 *  → 新しい Media API（無料）で eBay の写真サーバーへ入れる。①写真のURLを渡す ②だめなら写真をダウンロードしてファイルで渡す */
let MEDIA_ERR_ = '', TRADING_PIC_DEAD_ = false;
function zMediaUpload_(url) {
  const base = 'https://apim.ebay.com/commerce/media/v1_beta/image/';
  const pick = (res) => {
    const code = res.getResponseCode(), txt = res.getContentText() || '';
    if (code !== 200 && code !== 201) throw new Error('Media API ' + code + '：' + txt.slice(0, 200));
    let j = {}; try { j = JSON.parse(txt || '{}'); } catch (e) {}
    let u = j.imageUrl || j.maxDimensionImageUrl || '';
    if (!u) { const h = res.getAllHeaders(), loc = h.Location || h.location || ''; if (loc) { const g = UrlFetchApp.fetch(String(loc), { muteHttpExceptions: true, headers: { Authorization: 'Bearer ' + getToken_('user'), Accept: 'application/json' } }); try { const j2 = JSON.parse(g.getContentText() || '{}'); u = j2.imageUrl || j2.maxDimensionImageUrl || ''; } catch (e) {} } }
    if (!/^https?:\/\//.test(u)) throw new Error('Media API：写真のURLが返ってこなかった（' + txt.slice(0, 150) + '）');
    return u;
  };
  const call = (fn) => { let r = fn(); if (r.getResponseCode() === 401) { CacheService.getScriptCache().remove('tok_user'); r = fn(); } return r; };
  let e1 = '';
  if (/^https:\/\//i.test(String(url))) {
    try { return pick(call(() => UrlFetchApp.fetch(base + 'create_image_from_url', { method: 'post', contentType: 'application/json', muteHttpExceptions: true, headers: { Authorization: 'Bearer ' + getToken_('user'), Accept: 'application/json' }, payload: JSON.stringify({ imageUrl: String(url) }) }))); }
    catch (e) { e1 = e.message; }
  }
  try {
    const img = UrlFetchApp.fetch(String(url), { muteHttpExceptions: true, followRedirects: true, headers: { 'User-Agent': 'Mozilla/5.0' } });
    if (img.getResponseCode() !== 200) throw new Error('写真をダウンロードできない（' + img.getResponseCode() + '）');
    const blob = img.getBlob(); const ct = String(blob.getContentType() || ''); blob.setName('item.' + (/png/.test(ct) ? 'png' : /webp/.test(ct) ? 'webp' : /gif/.test(ct) ? 'gif' : 'jpg'));
    return pick(call(() => UrlFetchApp.fetch(base + 'create_image_from_file', { method: 'post', muteHttpExceptions: true, headers: { Authorization: 'Bearer ' + getToken_('user'), Accept: 'application/json' }, payload: { image: blob } })));
  } catch (e2) { MEDIA_ERR_ = (e1 ? 'URL：' + e1 + '／' : '') + 'ファイル：' + e2.message; throw new Error(MEDIA_ERR_); }
}
function uploadPictures_(urls) {
  const out = [];
  LAST_PHOTO_NOTE_ = ''; PIC_EXT_ = [];
  const adj = photoAdjustSettings_();
  let adjusted = 0;
  const failedAdj = [];
  urls.forEach((u, i) => {
    let full = '';
    // v97：1枚目（TOP）だけ明るさを調整した写真を使う。調整に失敗したときは元の写真のまま出品する
    if (adj.on && (adj.all || i === 0)) {
      const bu = brightenUrl_(u, adj);
      try { full = zMediaUpload_(bu); } catch (e) {}   // v183
      if (!full && !TRADING_PIC_DEAD_) try {
        const res = trading_('UploadSiteHostedPictures', '<ExternalPictureURL>' + x_(bu) + '</ExternalPictureURL><PictureSet>Supersize</PictureSet>');
        const d = res.root.getChild('SiteHostedPictureDetails', res.ns);
        full = d ? d.getChildText('FullURL', res.ns) : '';
      } catch (e) {}
      if (!full && !TRADING_PIC_DEAD_) { try { full = uploadPictureBinary_(bu); } catch (e) {} }
      if (full && !/ebayimg\.com/i.test(full)) full = '';   // v175：eBay の写真サーバーに入らなかったら、明るさ補正なしの元の写真にする
      if (full) adjusted++; else failedAdj.push(i + 1);
    }
    if (!full) { try { full = zMediaUpload_(u); } catch (e) {} }   // v183：新しい Media API を先に使う
    if (!full && TRADING_PIC_DEAD_) {   // v183：古い方法はもう動かないので、時間をかけずに写真のURLをそのまま使う（あとで「写真がない出品を直す」で eBay に入れ直せる）
      const ext = /^https:\/\//i.test(String(u)) ? String(u) : '';
      if (!ext) throw new Error('写真の' + (i + 1) + '枚目をeBayにアップロードできませんでした（' + MEDIA_ERR_ + '）。写真URL：' + u);
      full = ext; PIC_EXT_.push(i + 1);
    }
    for (let attempt = 0; attempt < 2 && !full; attempt++) {
      try {
        const res = trading_('UploadSiteHostedPictures',
          '<ExternalPictureURL>' + x_(u) + '</ExternalPictureURL><PictureSet>Supersize</PictureSet>');
