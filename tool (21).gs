// v201：英語のカード名を、①カード型番リスト（同じ番号）②eBay の同じカードの出品のタイトル から取る
const Z_EN_STOP = /^(pokemon|pokémon|card|cards|japanese|japan|jp|psa|bgs|cgc|ars|gem|mint|near|nm|holo|rare|promo|sar|sr|ar|ur|hr|chr|csr|ssr|rr|rrr|full|art|secret|the|of|and|tcg|game|graded|lot|set|ex|gx|v|vmax|vstar|mega|m)$/i;
function zEnFallback_(cn, mk) {
  try { const num = cn && cn.num; if (num) { const hit = zModelRows_().rows.find(x => { const c = zCardNo_(String(x.r[ZM.KEY - 1] || '')); return c.num === num && (!cn.set || !c.set || c.set.toLowerCase() === String(cn.set).toLowerCase()) && /^[A-Za-z]/.test(String(x.r[ZM.EN - 1] || '')); }); if (hit) return String(hit.r[ZM.EN - 1]).trim(); } } catch (e) {}
  const cnt = {};
  (mk && mk.items || []).forEach(tt => { const words = String(tt).replace(/[^A-Za-z0-9&'\- ]/g, ' ').split(/\s+/).filter(w => w);
    for (const w of words) { if (/\d/.test(w) || Z_EN_STOP.test(w)) continue; if (/^[A-Z][a-z]{2,}$/.test(w)) { cnt[w] = (cnt[w] || 0) + 1; break; } } });
  const top = Object.keys(cnt).sort((a, b) => cnt[b] - cnt[a])[0];
  return top && cnt[top] >= 2 ? top : '';
}

