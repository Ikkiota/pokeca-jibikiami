/* =====================================================================
 * v216：出品の健康診断（0円・見るだけ。オファーがオフの品だけはその場でオンにする）
 *  「出品一覧」の出品中の全部を eBay で1品ずつ確かめて、シート「出品の健康診断」に書く
 *  確かめること：出品中か／買える在庫があるか（数量−売れた数）／即決（固定価格）か／オファーがオンか／
 *  アメリカに送れるか（発送先・除外地域）／写真の枚数／状態（Condition）／返品の受付／発送までの日数／閲覧数（HitCount）・ウォッチ数
 *  1回4分ずつ。残りは1分後から自動で続ける
 * ===================================================================== */
const LH_HEAD = ['点検日時', 'eBay商品ID', 'タイトル', '値段$', '判定', '問題', '出品中', '買える数', '即決', 'オファー', 'アメリカへ発送', '写真', '状態', '返品', '発送まで(日)', '閲覧数', 'ウォッチ'];
function lhSheet_() {
  const ss = ss_(); let sh = ss.getSheetByName('出品の健康診断');
  if (!sh) { sh = ss.insertSheet('出品の健康診断'); sh.getRange(1, 1, 1, LH_HEAD.length).setValues([LH_HEAD]).setFontWeight('bold').setBackground('#e8f0fe'); sh.setFrozenRows(1); sh.setColumnWidth(3, 320); sh.setColumnWidth(6, 360); }
  return sh;
}
function zListingHealth_(restart) {
  const out = { checked: 0, ok: 0, ng: 0, fixedOffer: 0, err: 0, more: false };
  const p = PropertiesService.getScriptProperties();
  const l = listSheet_(); if (l.getLastRow() < 2) return out;
  const ids = l.getRange(2, 1, l.getLastRow() - 1, LIST_HEADERS.length).getValues().filter(v => String(v[LCOL.ID - 1] || '').trim() && Number(v[LCOL.QTY - 1]) > 0).map(v => String(v[LCOL.ID - 1]).trim());
  const sh = lhSheet_();
  let i = restart ? 0 : Number(p.getProperty('Z_LH_POS') || 0); if (!(i >= 0) || i >= ids.length) i = 0;
  if (i === 0 && sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, LH_HEAD.length).clearContent().setBackground(null);
  const t0 = Date.now(), outRows = [];
  for (; i < ids.length; i++) {
    if (Date.now() - t0 > 4 * 60 * 1000) { out.more = true; break; }
    const id = ids[i]; out.checked++;
    try {
      const res = trading_('GetItem', '<ItemID>' + x_(id) + '</ItemID><DetailLevel>ReturnAll</DetailLevel><IncludeWatchCount>true</IncludeWatchCount>');
      const ns = res.ns, it = res.root.getChild('Item', ns), ss = it.getChild('SellingStatus', ns);
      const t = (el, n) => el ? String(el.getChildText(n, ns) || '') : '';
      const status = t(ss, 'ListingStatus') || 'Active';
      const qty = Number(t(it, 'Quantity')) - Number(t(ss, 'QuantitySold') || 0);
      const type = t(it, 'ListingType');
      const bod = it.getChild('BestOfferDetails', ns); let offer = !!(bod && t(bod, 'BestOfferEnabled') === 'true');
      const ship = it.getChildren('ShipToLocations', ns).map(e => e.getText());
      const excl = []; const sd = it.getChild('ShippingDetails', ns); if (sd) sd.getChildren('ExcludeShipToLocation', ns).forEach(e => excl.push(e.getText()));
      const toUS = (ship.indexOf('Worldwide') >= 0 || ship.indexOf('US') >= 0 || ship.indexOf('Americas') >= 0 || ship.indexOf('North America') >= 0) && excl.indexOf('US') < 0 && excl.indexOf('North America') < 0 && excl.indexOf('Americas') < 0;
      const pd = it.getChild('PictureDetails', ns), pics = pd ? pd.getChildren('PictureURL', ns).length : 0;
      const cond = t(it, 'ConditionDisplayName') || t(it, 'ConditionID');
      const rp = it.getChild('ReturnPolicy', ns), ret = rp ? (t(rp, 'ReturnsAcceptedOption') === 'ReturnsAccepted' ? '受付' + (t(rp, 'ReturnsWithinOption') ? '（' + t(rp, 'ReturnsWithinOption').replace('Days_', '') + '日）' : '') : '受付なし') : '不明';
      const disp = t(it, 'DispatchTimeMax'), hits = t(it, 'HitCount'), watch = t(it, 'WatchCount');
      const price = Number(t(ss, 'CurrentPrice')) || 0, title = t(it, 'Title');
      const probs = [];
      if (status !== 'Active') probs.push('出品が終わっている（' + status + '）');
      if (!(qty > 0)) probs.push('買える在庫が0（売り切れ表示）');
      if (type && type !== 'FixedPriceItem') probs.push('即決ではない（' + type + '）');
      if (!offer && status === 'Active') {
        try { trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(id) + '</ItemID>' + offerXmlNew_(price, price) + '</Item>'); if (offerItemState_(id).on) { offer = true; out.fixedOffer++; try { offerLogSheet_().appendRow([new Date(), id, title.slice(0, 40), '', '', price, '', 'オファーをオン', '✅ 確認済み（健康診断）']); } catch (e) {} } } catch (e) {}
        if (!offer) probs.push('オファーがオフ（オンにできなかった）');
      }
      if (!toUS) probs.push('アメリカに送れない設定（発送先：' + (ship.join(',') || 'なし') + (excl.length ? '・除外：' + excl.slice(0, 5).join(',') : '') + '）');
      if (pics < 3) probs.push('写真が' + pics + '枚');
      if (!cond) probs.push('状態（Condition）がない');
      if (ret === '受付なし') probs.push('返品を受け付けていない');
      if (Number(disp) > 5) probs.push('発送まで' + disp + '日（長い）');
      const ok = !probs.length; if (ok) out.ok++; else out.ng++;
      outRows.push([new Date(), id, title, price, ok ? '✅ OK' : '❌ 要対応', probs.join(' ／ '), status === 'Active' ? '○' : '×', qty, type === 'FixedPriceItem' ? '○' : type, offer ? '○' : '×', toUS ? '○' : '×', pics, cond, ret, disp, hits, watch]);
    } catch (e) { out.err++; outRows.push([new Date(), id, '', '', '⚠ 確認できない', String(e.message).slice(0, 200), '', '', '', '', '', '', '', '', '', '', '']); }
    if (outRows.length >= 25) { sh.getRange(sh.getLastRow() + 1, 1, outRows.length, LH_HEAD.length).setValues(outRows); outRows.length = 0; }
  }
  if (outRows.length) sh.getRange(sh.getLastRow() + 1, 1, outRows.length, LH_HEAD.length).setValues(outRows);
  p.setProperty('Z_LH_POS', String(out.more ? i : 0));
  return out;
}
