  const items = [], seen = {};
  const rx = /(?:page\.)?auctions\.yahoo\.co\.jp\/jp\/auction\/([a-z]?\d{8,11})|paypayfleamarket\.yahoo\.co\.jp\/item\/([a-z]\d{6,12})/gi;
  let m; const ms = [];
  while ((m = rx.exec(dec)) !== null) ms.push(m);
  ms.forEach((m, mi) => {
    const id = m[1] || m[2], fm = !m[1];
    if (seen[id]) return;
    seen[id] = 1;
    let nx = dec.length; for (let k = mi + 1; k < ms.length; k++) { if ((ms[k][1] || ms[k][2]) !== id) { nx = ms[k].index; break; } }
    const at = m.index, end = Math.min(at + 1800, nx), win = dec.slice(Math.max(0, at - 300), end);
    let title = '';
    const am = win.match(new RegExp('<a[^>]*' + id + '[^>]*>([\\s\\S]*?)<\\/a>', 'i'));
    if (am) title = zfmStrip_(am[1]).trim();
    if (!title) { const im = win.match(/alt="([^"]{6,200})"/i); if (im) title = zfmStrip_(im[1]).trim(); }
    if (!title) { const after = zfmStrip_(dec.slice(at, end)).split(/\n/).map(x => x.trim()).filter(x => x && !/^https?:|yahoo\.co\.jp/.test(x) && !/^[¥￥]?\s*[\d,]+\s*円?$/.test(x) && !/^(即決|現在|入札)/.test(x)); if (after.length) title = after[0]; }
    const txt = zfmStrip_(dec.slice(at, end));
    const num = s => Number(String(s).replace(/,/g, ''));
    const bn = txt.match(/即決[^\d\n]{0,12}([\d,]{3,9})\s*円?/);
    const cur = txt.match(/現在[^\d\n]{0,12}([\d,]{3,9})\s*円?/);
    const any = txt.match(/[¥￥]\s*([\d,]{3,9})/) || txt.match(/([\d,]{3,9})\s*円/);
    const it = { url: fm ? 'https://paypayfleamarket.yahoo.co.jp/item/' + id : 'https://auctions.yahoo.co.jp/jp/auction/' + id, title: title.slice(0, 200), site: fm ? 'Yahoo!フリマ' : 'ヤフオク', text: txt.slice(0, 600) };
    if (fm) it.price = any ? num(any[1]) : 0;
    else { it.buyNow = bn ? num(bn[1]) : 0; it.price = it.buyNow || (cur ? num(cur[1]) : (any ? num(any[1]) : 0)); }
