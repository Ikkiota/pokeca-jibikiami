function menuMorePhotos() { run_(() => { const r = zMorePhotos_(); return '出品中のカードの写真を増やしました：' + r.done + '件（ページの写真も同じ枚数だった ' + r.same + '件）' + (r.failed ? '・できなかった ' + r.failed + '件' : '') + (r.more ? '。残りは1分後に自動で続けます' : ''); }); }

/* =====================================================================
 * v167：写真の多いカードを選ぶ
 *  ・候補を作るとき、お店の商品ページの写真まで数える（判定で通った品だけ・1品 約1〜2秒）
 *  ・写真が「追加の設定」F295 枚（初めは 3枚）より少ない品は、状態に「写真が少ない」と書いて GO できないようにする
 *  ・同じカードが何か所にあるときは、写真が多い品を選ぶ（値段の差が15％以内のとき。それより高いなら安い品）
 *  ・判定の列に「写真 ○枚」を書く
 * ===================================================================== */
function zPhotoSettings_() {
  if (zPhotoSettings_._c) return zPhotoSettings_._c;
  const s = addSettingsSheet_();
  if (s.getRange('E294').getValue() === '') {
    s.getRange('E294').setValue('■ 写真の枚数（v167）').setFontWeight('bold');
    s.getRange('E295').setValue('出品候補にする写真の枚数（これより少ない品は GO できない）').setFontWeight('bold');
    s.getRange('F295').setValue(1).setBackground('#fff4dc');
  }
  // v179：写真は少なくてもよい（1枚から OK）。同じカードは写真がいちばん多い品を選ぶ。前の「3枚」は1回だけ 1枚に戻し、「写真が少ない」で止めた候補も戻す
  try { const pp = PropertiesService.getScriptProperties(); if (!pp.getProperty('PH_MIN_V179')) { pp.setProperty('PH_MIN_V179', '1');
    if (Number(s.getRange('F295').getValue()) === 3) s.getRange('F295').setValue(1);
    s.getRange('E295').setValue('出品候補にする写真の最低枚数（1＝少なくてもOK。同じカードは写真の多い品を選ぶ）');
    const kc = kcSheet_(), n = kc.getLastRow() - 1;
    if (n > 0) { const rg = kc.getRange(2, KC.STATE, n, 1), sv = rg.getValues(); let ch = 0; sv.forEach(r => { if (/^写真が少ない/.test(String(r[0] || ''))) { r[0] = ''; ch++; } }); if (ch) rg.setValues(sv); } } } catch (e) {}
  const v = Number(s.getRange('F295').getValue());
  zPhotoSettings_._c = { min: v >= 0 && s.getRange('F295').getValue() !== '' ? v : 1 };
  return zPhotoSettings_._c;
}
function zKcPhotoCount_(r) { return String(r[14] || '').split(/\n+/).filter(x => /^https?:\/\//.test(String(x).trim())).length; }
// a が b よりよいか（写真が多くて値段の差が15％以内 → 写真の多い方。そうでなければ安い方）
function zKcBetter_(yenA, phA, yenB, phB) {
  // v168：どちらも最低利益は守れる品なので、写真の枚数がいちばん多い品を選ぶ。同じ枚数なら安い品
  if (phA !== phB) return phA > phB;
  return (yenA || 0) < (yenB || 0);
}

/* v168：写真の枚数がいちばん多い品を選ぶ（値段の差に関係なく。どちらも最低利益は守れる品だけが候補なので、利益は今までどおり）
 *  ・ボタン「出品候補を写真の多い順に並べる」：まだ GO していない候補を、写真の多い順に上へ */
function menuKcSortByPhotos() {
  run_(() => {
    const kc = kcSheet_(), n = kc.getLastRow() - 1;
    if (n < 2) return '並べる候補がありません';
