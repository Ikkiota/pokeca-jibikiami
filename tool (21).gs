function zShopApiTick_() {
  if (!zShopApiOn_()) return 'オフ（「追加の設定」F317・教科書 第18章）';   // v231
  const h = Number(Utilities.formatDate(new Date(), 'Asia/Tokyo', 'H')); if (h < 7 || h >= 23) return '夜は動かさない';
  if (zTimeLeft_() < (zListReserveMin_() + 5) * 60) return '今日の動作時間は出品に残す';
  const p = PropertiesService.getScriptProperties(), today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd'), t0 = Date.now();
  { const hk = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMddHH'); if (p.getProperty('ZSH_LASTH') === hk) return 'この1時間はもう探した'; p.setProperty('ZSH_LASTH', hk); }   // v229：1時間ごと（教科書・お手本どおり。前は10分ごと）
  let stt = {}; try { stt = JSON.parse(p.getProperty('ZSH_ST') || '{}'); } catch (e) {} if (stt.d !== today) stt = { d: today, q: 0, found: 0, sent: 0, f: {} };
  if (stt.q >= 300) return '今日は300語まで';
  const qs = zYsQueries_().filter(o => !o.broad); if (!qs.length) return '「フリマで探す（今日）」がまだありません';
  let cur = Number(p.getProperty('ZSH_CUR') || 0); if (cur >= qs.length) cur = 0;
  const st = kwSettings_(), known = kwKnownUrls_(), listedNow = zListedCardKeys_(), minPh = zPhotoSettings_().min;
  const rows = [], models = []; let n = 0;
  for (; n < 5 && Date.now() - t0 < 60000; n++) {
    const q = qs[cur]; cur = (cur + 1) % qs.length; stt.q++;
    let items = []; try { const fb = kwFetchBothFast_(q.q, st); items = fb.items || []; } catch (e) { stt.f['APIのエラー'] = (stt.f['APIのエラー'] || 0) + 1; continue; }
    stt.found += items.length;
    items.forEach(it => {
      const u = String(it.url).split('?')[0];
      if (known.has(u) || kwSeenSkip_(u, it.price)) { stt.f['もう見た品'] = (stt.f['もう見た品'] || 0) + 1; return; }
      kwSeenAdd_(u, it.price);
      const dm = zDomShip_({ url: it.url, text: it.desc, freeShip: it.freeShip, shopShip: st.ship, box: zIsSealedBox_(zNorm_(it.title)) });
      const yen = it.price + dm.yen - (zPointsOn_() ? (Number(it.pt) || 0) : 0), j = kwJudge_(it, st, yen);
      if (!j.ok) { const k = j.why.replace(/（.*$/, '').replace(/上限 [\d,]+円を [\d,]+円こえる/, '仕入れ上限をこえる'); stt.f[k] = (stt.f[k] || 0) + 1; return; }
      const num = zCardNo_(j.key || '').num, lk = num ? num.toLowerCase() + '|' + (j.grade === '未鑑定' ? 'u' : 'g') : '';
      if (lk && listedNow.has(lk)) { zBackupSrc_(it.store || 'お店', j.key, it); stt.f['もう出品中のカード（予備へ）'] = (stt.f['もう出品中のカード（予備へ）'] || 0) + 1; return; }
      known.add(u);
      let ph = it.images || []; try { ph = zMergePhotos_(zPagePhotos_(it.url), ph); } catch (e) {}
      rows.push([false, ph.length < minPh ? '写真が少ない（' + ph.length + '枚・' + minPh + '枚以上の品だけ GO できる）' : '', new Date(), 'お店API（昼）「' + q.q.slice(0, 30) + '」', it.title, yen, j.cap, j.low, j.key, j.grade, j.why + '（' + dm.note + '）・写真 ' + ph.length + '枚', it.store, it.url, it.cond || '中古', ph.join('\n')]);
      if (j.key) models.push({ key: j.key, en: j.en || '', ja: kwJaName_(it.title), grade: j.grade === '未鑑定' ? '未鑑定' : j.grade, low: j.low, cap: j.cap, memo: '追加候補（お店API・昼で見つけた）' });
    });
  }
  p.setProperty('ZSH_CUR', String(cur)); try { kwSeenSave_(); } catch (e) {}
