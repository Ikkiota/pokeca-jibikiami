function uploadPictureBinary_(url) {
  const img = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });
  if (img.getResponseCode() !== 200) throw new Error('画像をダウンロードできませんでした（' + img.getResponseCode() + '）');
  const blob = img.getBlob();
  const ct = blob.getContentType() || 'image/jpeg';
  if (!/^image\//i.test(ct)) throw new Error('画像ではありませんでした（' + ct + '）');
  const b = 'MIME_boundary_' + Utilities.getUuid().replace(/-/g, '');
  const xml = '<?xml version="1.0" encoding="utf-8"?><UploadSiteHostedPicturesRequest xmlns="urn:ebay:apis:eBLBaseComponents">' +
    '<PictureName>item</PictureName><PictureSet>Supersize</PictureSet></UploadSiteHostedPicturesRequest>';
  const head = Utilities.newBlob('--' + b + '\r\nContent-Disposition: form-data; name="XML Payload"\r\nContent-Type: text/xml;charset=utf-8\r\n\r\n' + xml +
    '\r\n--' + b + '\r\nContent-Disposition: form-data; name="dummy"; filename="item.jpg"\r\nContent-Transfer-Encoding: binary\r\nContent-Type: ' + ct + '\r\n\r\n').getBytes();
  const tail = Utilities.newBlob('\r\n--' + b + '--\r\n').getBytes();
  const res = UrlFetchApp.fetch(TRADING_URL, {
    method: 'post', contentType: 'multipart/form-data; boundary=' + b, muteHttpExceptions: true,
    headers: { 'X-EBAY-API-SITEID': TRADING_SITE_ID, 'X-EBAY-API-COMPATIBILITY-LEVEL': '1193', 'X-EBAY-API-CALL-NAME': 'UploadSiteHostedPictures', 'X-EBAY-API-IAF-TOKEN': getToken_('user') },
    payload: head.concat(blob.getBytes()).concat(tail),
  });
  const root = XmlService.parse(res.getContentText()).getRootElement(), ns = root.getNamespace();
  const d = root.getChild('SiteHostedPictureDetails', ns);
  const full = d ? d.getChildText('FullURL', ns) : '';
  if (!full) {
    const er = root.getChildren('Errors', ns).map(e => e.getChildText('LongMessage', ns) || e.getChildText('ShortMessage', ns)).join(' / ');
    throw new Error(er || 'アップロードの結果を受け取れませんでした');
  }
  return full;
}


/* =====================================================================
 * 出品ポリシーの確認と自動修正
 *  eBayに登録されているポリシーの一覧（GetUserPreferences）と照らし合わせて、
 *  「設定」B12〜B14・重さ別の配送ポリシーのIDが実在するか確かめる。実在しなければ：
 *   ・配送：ツールが作った「Japan Free US / Intl 500g」の最新 → デフォルトの配送ポリシー → 最初のもの
 *   ・返品：名前に「60」が入る返品ポリシー → デフォルト → 最初のもの
 *   ・支払い：デフォルト → 最初のもの
 *   ・重さ別：同じ重さの名前の最新のもの。なければその重さは使わない（B12を使う）
 *  既存のポリシーの中身は変更しない
 * ===================================================================== */
/* =====================================================================
 * v100：ポリシー一覧（「設定」17行目から）をチェック式に
 *  ・A：種類　B：名前　C：ID　D：使う（チェック）
 *  ・種類ごとに1つだけチェックできる。チェックすると、これから出品する商品にそのポリシーを使う
 *    配送 → B12 と「出品に使う配送ポリシー（固定）」に反映（重さ別・発送方法別の自動選択より優先）
 *    返品 → B13　支払い → B14
 *  ・出品中の商品のポリシーは変えない
 * ===================================================================== */
const POL_TOP = 17;
const POL_TYPE_JA = { SHIPPING: '配送', RETURN_POLICY: '返品', PAYMENT: '支払い' };
const POL_CELL = { '配送': 'B12', '返品': 'B13', '支払い': 'B14' };

// 今使っている配送ポリシーID（固定 → B12）
function currentShipPolicyId_() {
  const fx = fixedShipPolicy_();
  return fx.id || String(sheet_('設定').getRange('B12').getValue() || '').trim();
}

function renderPolicyList_(list) {
  const s = sheet_('設定');
  const order = ['SHIPPING', 'RETURN_POLICY', 'PAYMENT'];
  const seen = {};
  const items = (list || []).filter(x => { const k = x.type + ':' + x.id; if (seen[k]) return false; seen[k] = 1; return true; })
    .sort((a, b) => (order.indexOf(a.type) - order.indexOf(b.type)) || String(a.name).localeCompare(String(b.name)));
  const used = { SHIPPING: currentShipPolicyId_(), RETURN_POLICY: String(s.getRange('B13').getValue() || '').trim(), PAYMENT: String(s.getRange('B14').getValue() || '').trim() };
  // 種類ごとに、使っているIDが一覧にないときは、デフォルト（なければ最初）にチェック
  order.forEach(t => { if (!items.some(x => x.type === t && x.id === used[t])) { const d = items.find(x => x.type === t && x.isDefault) || items.find(x => x.type === t); used[t] = d ? d.id : ''; } });
  const old = s.getRange(POL_TOP, 1, Math.max(1, s.getMaxRows() - POL_TOP + 1), 4);
  old.clearContent(); old.clearDataValidations(); old.setBackground(null);
  s.getRange(POL_TOP, 1, 1, 4).setValues([['ポリシーの種類', '名前', 'ID', '使う（チェック）']]).setFontWeight('bold').setBackground('#e8f0f2');
  if (!items.length) return;
  const rows = items.map(x => [POL_TYPE_JA[x.type] || x.type, x.name + (x.isDefault ? '［eBayのデフォルト］' : ''), x.id, x.id === used[x.type]]);
  s.getRange(POL_TOP + 1, 1, rows.length, 4).setValues(rows.map(r => [r[0], r[1], r[2], false]));
  s.getRange(POL_TOP + 1, 3, rows.length, 1).setNumberFormat('@');
  s.getRange(POL_TOP + 1, 4, rows.length, 1).insertCheckboxes();
  s.getRange(POL_TOP + 1, 4, rows.length, 1).setValues(rows.map(r => [r[3]]));
  rows.forEach((r, i) => { if (r[3]) s.getRange(POL_TOP + 1 + i, 1, 1, 4).setBackground('#d8f0d8'); });
  s.getRange(POL_TOP + 1 + rows.length, 1).setValue('使うポリシーに1つずつチェックを入れてください（種類ごとに1つ）。チェックしたポリシーが、これから出品する商品に使われます。出品中の商品のポリシーは変わりません。')
    .setFontColor('#777777');
  // B12〜B14もチェックに合わせる
  s.getRange('B12:B14').setNumberFormat('@').setValues([[used.SHIPPING], [used.RETURN_POLICY], [used.PAYMENT]]);
}

// チェックを入れた・外したとき（onEditから呼ばれる）。処理したら true
function onEditPolicy_(e) {
  try {
    const r = e.range, sh = r.getSheet();
    if (sh.getName() !== '設定' || r.getColumn() !== 4 || r.getRow() <= POL_TOP || r.getNumRows() > 1 || r.getNumColumns() > 1) return false;
    const row = r.getRow();
    const v = sh.getRange(row, 1, 1, 4).getValues()[0];
    const type = String(v[0]), id = String(v[2] || '').trim(), name = String(v[1] || '').replace(/［eBayのデフォルト］$/, '');
    if (!POL_CELL[type] || !id) return false;
    const last = sh.getLastRow();
    const all = sh.getRange(POL_TOP + 1, 1, last - POL_TOP, 4).getValues();
    if (r.getValue() !== true) {
      // 外しただけで、同じ種類にほかのチェックがない → 外せないように戻す
      if (!all.some((x, i) => i + POL_TOP + 1 !== row && String(x[0]) === type && x[3] === true)) {
        r.setValue(true);
        e.source.toast('「' + type + '」のポリシーは1つ必ず選んでください。別のポリシーにチェックを入れると切り替わります。', 'ポリシー', 6);
      }
      return true;
    }
    // 同じ種類のほかのチェックを外す
    all.forEach((x, i) => {
      const rr = POL_TOP + 1 + i;
      if (String(x[0]) !== type) return;
      if (rr !== row && x[3] === true) sh.getRange(rr, 4).setValue(false);
      sh.getRange(rr, 1, 1, 4).setBackground(rr === row ? '#d8f0d8' : null);
    });
    sh.getRange(POL_CELL[type]).setNumberFormat('@').setValue(id);
    const p = PropertiesService.getScriptProperties();
    if (type === '配送') {
      // チェックした配送ポリシーを最優先にする（重さ別・発送方法別の自動選択は使わない）
      p.setProperty('FIXED_SHIP_POLICY_ID', id);
      p.setProperty('FIXED_SHIP_POLICY_NAME', name);
      ['SHIP_POLICY_ECO_ID', 'SHIP_POLICY_ECO_NAME', 'SHIP_POLICY_AIR_ID', 'SHIP_POLICY_AIR_NAME'].forEach(k => p.deleteProperty(k));
    }
    CacheService.getScriptCache().remove('LIVE_POLICIES');
    e.source.toast('これから出品する商品の' + type + 'ポリシーを「' + name + '」（ID ' + id + '）にしました。', 'ポリシーを切り替えました', 6);
    return true;
  } catch (err) { return false; }
}

function livePolicies_() {
  const c = CacheService.getScriptCache().get('LIVE_POLICIES');
  if (c) return JSON.parse(c);
  const out = trading_('GetUserPreferences', '<ShowSellerProfilePreferences>true</ShowSellerProfilePreferences>');
  const ns = out.ns;
  const pref = out.root.getChild('SellerProfilePreferences', ns);
  const sup = pref ? pref.getChild('SupportedSellerProfiles', ns) : null;
  const list = (sup ? sup.getChildren('SupportedSellerProfile', ns) : []).map(p => {
    const cg = p.getChild('CategoryGroup', ns);
    return { type: p.getChildText('ProfileType', ns), name: p.getChildText('ProfileName', ns) || '', id: String(p.getChildText('ProfileID', ns)),
      isDefault: !!(cg && cg.getChildText('IsDefault', ns) === 'true') };
  });
  try { CacheService.getScriptCache().put('LIVE_POLICIES', JSON.stringify(list), 1800); } catch (e) {}
  return list;
}

function ensureValidPolicies_(ls) {
  const fixed = [];
  let list;
  try { list = livePolicies_(); } catch (e) { return { fixed: fixed }; }   // 確かめられないときはそのまま
  const ofType = t => list.filter(x => x.type === t);
  const exists = (t, id) => !!id && ofType(t).some(x => x.id === String(id).trim());
  const newest = arr => arr.slice().sort((a, b) => b.name.localeCompare(a.name))[0];
  const pick = (t, prefer) => (prefer ? newest(ofType(t).filter(x => prefer.test(x.name))) : null) || ofType(t).find(x => x.isDefault) || ofType(t)[0] || null;
  const s = sheet_('設定');

  const mp = methodPolicies_();
  const fx = mp.eco.id || mp.air.id ? null : fixedShipPolicy_();
  [mp.eco, mp.air].concat(fx && fx.id ? [fx] : []).forEach(x => {
    if (x.id && !ofType('SHIPPING').some(y => y.id === x.id)) throw new Error('配送ポリシー「' + x.name + '」（ID ' + x.id + '）がeBayに見つかりません。別のポリシーに勝手に替えず、出品を止めました。「出品管理」→「発送方法ごとの配送ポリシーを選ぶ」で選び直してください');
  });
  if (fx && fx.id) ls.shipId = fx.id;
  else if (mp.eco.id || mp.air.id) { /* 発送方法ごとに使い分ける */ }
  else if (!exists('SHIPPING', ls.shipId)) {
    const p = pick('SHIPPING', /^Japan Free US \/ Intl 500g/);
    fixed.push('配送 ' + (ls.shipId || '（空）') + ' → ' + (p ? p.name + '（' + p.id + '）' : '見つからない'));
    ls.shipId = p ? p.id : '';
    s.getRange('B12').setNumberFormat('@').setValue(ls.shipId);
  }
  if (!exists('RETURN_POLICY', ls.returnId)) {
    const p = pick('RETURN_POLICY', /60/);
    fixed.push('返品 ' + (ls.returnId || '（空）') + ' → ' + (p ? p.name + '（' + p.id + '）' : '見つからない'));
    ls.returnId = p ? p.id : '';
    s.getRange('B13').setNumberFormat('@').setValue(ls.returnId);
  }
  if (!exists('PAYMENT', ls.payId)) {
    const p = pick('PAYMENT', null);
    fixed.push('支払い ' + (ls.payId || '（空）') + ' → ' + (p ? p.name + '（' + p.id + '）' : '見つからない'));
    ls.payId = p ? p.id : '';
    s.getRange('B14').setNumberFormat('@').setValue(ls.payId);
  }
  // 重さ別の配送ポリシー
  let bands = [];
  try { bands = JSON.parse(prop_('SHIP_POLICY_BANDS') || '[]'); } catch (e) {}
  if (bands.length) {
    let changed = false;
    bands = bands.map(b => {
      if (exists('SHIPPING', b.id)) return b;
      const label = b.max >= 1000 ? (b.max / 1000) + 'kg' : b.max + 'g';
      const p = newest(ofType('SHIPPING').filter(x => x.name.indexOf('Japan Free US / Intl ' + label) === 0));
      changed = true;
      fixed.push('配送（' + label + 'まで） ' + b.id + ' → ' + (p ? p.id : '使わない（B12を使用）'));
      return p ? { max: b.max, id: p.id } : null;
    }).filter(b => b);
    if (changed) PropertiesService.getScriptProperties().setProperty('SHIP_POLICY_BANDS', JSON.stringify(bands));
  }
  return { fixed: fixed };
}

function menuCheckPolicies() {
