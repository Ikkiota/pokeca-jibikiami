  let m = 80;
  try { const s = addSettingsSheet_();
    if (s.getRange('E309').getValue() === '') { s.getRange('E309').setValue('自動の仕事の1日の動作時間の上限（分）：無料のGmailは80のまま。Google Workspace（有料・1日6時間）なら240まで上げられる').setFontWeight('bold'); s.getRange('F309').setValue(80).setBackground('#fff4dc'); }
    const x = Number(s.getRange('F309').getValue()); if (x >= 30) m = Math.min(330, x); } catch (e) {}
  zTbLimitSec_._c = m * 60; return zTbLimitSec_._c;
}
function zTimed_(name, fn) {
  const t0 = Date.now();
