/* =====================================================================
 * v140：出品できなかった品を自動でやり直す・国際エアパケットの出品を SpeedPAK Economy に直す
 *  ・「出品作成」で「候補（出品エラー）」の品を、1時間ごとに自動でやり直す（1品3回まで）。配送方法と値段は、出す前に計算し直す
 *  ・写真が eBay の写真サーバーに上がらないときは、仕入れ先の写真のURL（https）をそのまま使って出品する（写真は外さない）
 *  ・国際エアパケットでは出品しない（設定に関係なく）。すでにエアパケで出品中の品は、メニューで SpeedPAK Economy のポリシーへ
 *    （送料が上がって最低利益を割るときは、最低利益を守れる値段に上げる）
 * ===================================================================== */
function zListRetry_(max) {
  if (zGhListOn_()) return { tried: 0, github: true };   // v245：GitHub がする
  if (listPaused_()) return { tried: 0, paused: true };   // v143
  const sh = prepSheet_(), n = sh.getLastRow() - 1;
  if (n < 1) return { tried: 0 };
  const p = PropertiesService.getScriptProperties();
  let cnt = {}; try { cnt = JSON.parse(p.getProperty('LR_RETRY') || '{}'); } catch (e) {}
  const v = sh.getRange(2, 1, n, PREP_HEADERS.length).getValues();
  const ls = listingSettings_(), started = Date.now();
  let tried = 0, ok = 0, fail = 0, gaveUp = 0;
  for (let i = 0; i < v.length && tried < (max || 10); i++) {
    if (Date.now() - started > 4 * 60 * 1000) break;
    const r = v[i], row = i + 2;
    if (String(r[P.STATUS - 1]) !== '候補（出品エラー）') continue;
    if (zIsLockErr_(r[P.NOTE - 1])) continue;   // v237：順番待ちの品は、すぐのやり直し（zLockRetry_）にまかせる・回数に数えない
    const key = String(r[P.SRC - 1] || row).split('?')[0];
    const c = cnt[key] || { n: 0, at: 0 };
    const limErr = Z_LIMIT_RX.test(String(r[P.NOTE - 1] || ''));   // v199：eBay の出品枠で止まった品は、品物の問題ではないので回数に関係なくやり直す
    if (c.n >= 3 && !limErr) continue;
    if (Date.now() - c.at < 55 * 60 * 1000) continue;
    tried++; c.n++; c.at = Date.now(); cnt[key] = c;
    try {
      const z0 = ZSENT_; ZSENT_ = /^【送った品】/.test(String(r[P.PJUDGE - 1] || ''));   // v208
      let g; try { g = gateCandidate_(sh, row, ls); } finally { ZSENT_ = z0; }   // 配送方法（エアパケなし）・値段を計算し直す
      if (!g.ok) { sh.getRange(row, P.STATUS).setValue('候補（出品エラー）'); throw new Error('計算し直したら出品の条件に合わない：' + (g.reason || '')); }
      const id = listRow_(sh, row, ls);
      ok++; delete cnt[key];
      zLog_('出品のやり直し', '✅ 出品できた（' + (c.n) + '回目）：' + String(r[P.TITLE - 1] || r[P.NAME - 1]).slice(0, 50) + '／eBay商品ID ' + id);
    } catch (e) {
      fail++;
      try { if (String(sh.getRange(row, P.STATUS).getValue()) !== '出品済み') { sh.getRange(row, P.STATUS).setValue('候補（出品エラー）'); sh.getRange(row, P.NOTE).setValue('やり直し ' + c.n + '回目も失敗：' + String(e.message).slice(0, 400)); } } catch (x) {}
      if (c.n >= 3) gaveUp++;
      zLog_('出品のやり直し', (c.n >= 3 ? '❌ 3回やり直しても出品できなかった（手で確認）' : '問題（1時間後にもう一度）') + '：' + String(r[P.TITLE - 1] || r[P.NAME - 1]).slice(0, 40) + '：' + String(e.message).slice(0, 250));
    }
  }
  p.setProperty('LR_RETRY', JSON.stringify(cnt));
  return { tried: tried, ok: ok, fail: fail, gaveUp: gaveUp };
}
function menuListRetryNow() {
  run_(() => { PropertiesService.getScriptProperties().deleteProperty('LR_RETRY'); const r = zListRetry_(15); return '出品エラーの品 ' + r.tried + '件をやり直しました：出品できた ' + r.ok + '件・まだできない ' + r.fail + '件（「0円の自動化の記録」の「出品のやり直し」に理由）'; });
