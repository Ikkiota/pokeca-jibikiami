 *   あなたの「全てこのテンプレートにかえて！商品説明は商品によってかえて！」（11/15 15:02）
 *   ・出品一覧の在庫1以上の品を順番に。出品作成にある品はその行の仕様、ない品は eBay から仕様を読む（GetItem）
 *   ・変えるのは説明（Description）だけ。タイトル・値段・写真・仕様は変えない
 *   ・1回 約4分ずつ。続きは1分後（メニューから）か、毎朝の自動点検担当の続き。終わったら二度と同じことはしない（版ごとに1回）
 *   ・うまくいかなかった品は「自動点検の記録」に残す
 * ===================================================================== */
const Z_DESC_VER = 'v234';
function zDescAll_(sec) {
  const out = { done: 0, err: 0, more: false, total: 0, pos: 0, already: false };
  const p = PropertiesService.getScriptProperties();
  if (p.getProperty('ZDESC_VER') === Z_DESC_VER) { out.already = true; return out; }
  const run = Number(p.getProperty('ZDESC_RUN') || 0); if (run && Date.now() - run < 6 * 60 * 1000) { out.more = true; return out; }   // 別の回が動いている
  p.setProperty('ZDESC_RUN', String(Date.now()));
  try {
    const l = listSheet_(), n = l.getLastRow() - 1; if (n < 1) return out;
    const ids = []; l.getRange(2, 1, n, LIST_HEADERS.length).getValues().forEach(r => { const id = String(r[LCOL.ID - 1] || '').trim(); if (id && Number(r[LCOL.QTY - 1]) > 0) ids.push(id); });
    out.total = ids.length;
    const prep = prepSheet_(), pn = prep.getLastRow() - 1, pr = {};
    if (pn > 0) prep.getRange(2, 1, pn, PREP_HEADERS.length).getValues().forEach(r => { const id = String(r[P.ITEMID - 1] || '').trim(); if (id && String(r[P.STATUS - 1]) === '出品済み') pr[id] = r; });
    let i = Number(p.getProperty('ZDESC_POS') || 0); if (!(i >= 0) || i > ids.length) i = 0;
    const t0 = Date.now(), errs = [];
    for (; i < ids.length; i++) {
      if (Date.now() - t0 > (sec || 240) * 1000) { out.more = true; break; }
      const id = ids[i];
      try {
        let title = '', specs = [], cond = 0, note = '';
        const r = pr[id];
        if (r) { title = String(r[P.TITLE - 1] || ''); specs = r[P.SPECS - 1]; cond = parseInt(String(r[P.COND - 1]), 10) || 0; note = conditionNoteAllowed_(cond) ? String(r[P.CONDNOTE - 1] || '') : ''; }
        if (!r || !title) {
          const it = trading_('GetItem', '<ItemID>' + x_(id) + '</ItemID><DetailLevel>ReturnAll</DetailLevel><IncludeItemSpecifics>true</IncludeItemSpecifics>');
          const ns = it.ns, item = it.root.getChild('Item', ns);
          title = item.getChildText('Title', ns) || '';
          cond = parseInt(item.getChildText('ConditionID', ns), 10) || 0;
          note = item.getChildText('ConditionDescription', ns) || '';
          const isp = item.getChild('ItemSpecifics', ns);
          specs = isp ? isp.getChildren('NameValueList', ns).map(e => [e.getChildText('Name', ns), e.getChildText('Value', ns)]) : [];
        }
        const d = zItemDesc_(title, specs, cond, note);
        trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(id) + '</ItemID><Description><![CDATA[' + d.replace(/]]>/g, ']]&gt;') + ']]></Description></Item>');
        out.done++;
      } catch (e) { out.err++; if (errs.length < 40) errs.push([id, '説明を入れ替えられなかった', '', '', String(e.message).slice(0, 200)]); }
    }
    zInspRep_(errs);
    out.pos = i;
    if (out.more) p.setProperty('ZDESC_POS', String(i)); else { p.deleteProperty('ZDESC_POS'); p.setProperty('ZDESC_VER', Z_DESC_VER); }
    zLog_('説明の入れ替え（v234）', '入れ替えた ' + out.done + '件・失敗 ' + out.err + '件・' + i + '/' + ids.length + (out.more ? '（続きあり）' : '（全部おわり）'));
  } finally { p.deleteProperty('ZDESC_RUN'); }
  return out;
}
function zDescAllJob() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'zDescAllJob').forEach(t => ScriptApp.deleteTrigger(t));
  zTimed_('zDescAllJob', () => {
    try { const r = zDescAll_(240); if (r.more) ScriptApp.newTrigger('zDescAllJob').timeBased().after(60 * 1000).create(); }
    catch (e) { zLog_('説明の入れ替え（v234）', 'エラー：' + e.message); }
  });
}
function menuDescAllNow() {
  run_(() => {
    const r = zDescAll_(150);
    if (r.already) return '出品中の品の説明は、もう全部新しい形になっています';
    if (r.more) { try { ScriptApp.newTrigger('zDescAllJob').timeBased().after(60 * 1000).create(); } catch (e) {} }
    return '説明を新しい形に入れ替えました：' + r.done + '件（失敗 ' + r.err + '件）・' + r.pos + '/' + r.total + (r.more ? '。残りは1分後から自動で続けます（全部で1時間ほど）' : '。全部おわりました');
  });
}


/* =====================================================================
 * v235：オファー・質問の在庫確認（あなたの「このシステムいれて！」11/15 16:24・別のアカウントと同じ形）
 *   オファーやバイヤーからのメッセージが届いたら、その品の仕入れ先の在庫を、すぐに確かめる（0円・AIなし）
 *   ・Yahoo!フリマ・ヤフオク：商品ページを1回だけ開いて判断（地引網と同じ読み方）
 *   ・メルカリなど自動で読めないサイト・URLがない品：「オーナーが確かめる」
 *   ・結果はシート「オファー・質問の在庫確認」に1行。G列にあなたが「ある／ない」を書く
 *   ・オファーのメールにも在庫の結果を入れる。売り切れのときは、オファーの自動承認をしない
 *   ・同じ品は、同じ日に1回だけ確かめる
 * ===================================================================== */
function zAskSheet_() {
  const ss = ss_(); let sh = ss.getSheetByName('オファー・質問の在庫確認');
  if (!sh) {
    sh = ss.insertSheet('オファー・質問の在庫確認');
    sh.getRange(1, 1, 1, 7).setValues([['日時', 'きっかけ', 'eBay商品ID', 'タイトル', '仕入れ先URL', '結果', 'オーナーの確認（ある／ない）']]).setFontWeight('bold').setBackground('#fff2cc');
    sh.setFrozenRows(1); [110, 120, 120, 320, 320, 320, 150].forEach((w, i) => sh.setColumnWidth(i + 1, w));
    try { sh.getRange('G2:G2000').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['ある', 'ない'], true).setAllowInvalid(true).build()); } catch (e) {}
  }
  return sh;
}
function zSrcUrlOf_(itemId, fallback) {
  const id = String(itemId || '').trim(); if (!id) return String(fallback || '');
  try { const l = listSheet_(), n = l.getLastRow() - 1; if (n > 0) { const v = l.getRange(2, 1, n, LIST_HEADERS.length).getValues().find(r => String(r[LCOL.ID - 1]).trim() === id); if (v && /^https?:\/\//.test(String(v[LCOL.SRC_URL - 1] || ''))) return String(v[LCOL.SRC_URL - 1]); } } catch (e) {}
  try { const p = prepSheet_(), n = p.getLastRow() - 1; if (n > 0) { const ids = p.getRange(2, P.ITEMID, n, 1).getValues(); const i = ids.findIndex(r => String(r[0]).trim() === id); if (i >= 0) { const u = String(p.getRange(i + 2, P.SRC).getValue() || ''); if (/^https?:\/\//.test(u)) return u; } } } catch (e) {}
  return /^https?:\/\//.test(String(fallback || '')) ? String(fallback) : '';
}
function zStockNow_(url) {
  if (!url) return { state: 'unknown', txt: '仕入れ先URLが記録にない → オーナーが確かめる' };
  const host = (String(url).match(/^https?:\/\/([^\/?#]+)/i) || [])[1] || '';
  try {
    if (/paypayfleamarket\.yahoo\.co\.jp$/i.test(host)) { const r = zFleaPageOf_(url); return r.available === true ? { state: 'in', txt: '在庫あり（Yahoo!フリマ：販売中）' } : r.available === false ? { state: 'out', txt: '🔴 売り切れ（Yahoo!フリマ：' + r.why + '）→ オファーは受けない' } : { state: 'unknown', txt: 'Yahoo!フリマを判断できない（' + r.why + '）→ オーナーが確かめる' }; }
    if (/auctions\.yahoo\.co\.jp$/i.test(host)) { const r = zYaucStockOf_(url); return r.available === true ? { state: 'in', txt: '在庫あり（ヤフオク：' + r.why + (r.price ? '・即決 ' + r.price.toLocaleString() + '円' : '') + '）' } : r.available === false ? { state: 'out', txt: '🔴 売り切れ（ヤフオク：' + r.why + '）→ オファーは受けない' } : { state: 'unknown', txt: 'ヤフオクを判断できない（' + r.why + '）→ オーナーが確かめる' }; }
    if (/mercari|fril\.jp|rakuma/i.test(host)) return { state: 'unknown', txt: 'メルカリ・ラクマは自動で読めない（規約）→ オーナーが確かめる' };
    const pg = fetchStockPage_(url);
    if (pg.skip) return { state: 'unknown', txt: (pg.note || '自動では読めないサイト') + ' → オーナーが確かめる' };
    if (!pg.ok) return { state: 'unknown', txt: (pg.note || 'ページを開けない') + ' → オーナーが確かめる' };
    const av = (String(pg.text).match(/【構造化データの在庫状況】([^\n]*)/) || [])[1] || '';
    if (/OutOfStock|SoldOut|Discontinued/i.test(av)) return { state: 'out', txt: '🔴 売り切れ（ページの在庫表示：' + av + '）→ オファーは受けない' };
    if (/InStock|LimitedAvailability/i.test(av)) return { state: 'in', txt: '在庫あり（ページの在庫表示：' + av + '）' };
    return { state: 'unknown', txt: 'ページから在庫を判断できない → オーナーが確かめる' };
  } catch (e) { return { state: 'unknown', txt: '確認でエラー（' + String(e.message).slice(0, 80) + '）→ オーナーが確かめる' }; }
}
// きっかけ（オファー／質問・メッセージ）で1品を確かめて、シートに1行。同じ品・同じきっかけは1日1回
function zAskStock_(why, itemId, title, fallbackUrl) {
  const id = String(itemId || '').trim(); if (!/^\d{9,15}$/.test(id)) return null;
  const p = PropertiesService.getScriptProperties(), day = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd'), key = day + '|' + why + '|' + id;
  let done = {}; try { done = JSON.parse(p.getProperty('ZASK_DONE') || '{}'); } catch (e) {}
  if (done[key]) return done[key];
  const url = zSrcUrlOf_(id, fallbackUrl), r = zStockNow_(url), res = { state: r.state, txt: r.txt, url: url };
  try { zAskSheet_().appendRow([new Date(), why, id, String(title || '').slice(0, 120), url, r.txt, '']); } catch (e) {}
  Object.keys(done).forEach(k => { if (k.slice(0, 8) !== day) delete done[k]; });
  done[key] = res; try { p.setProperty('ZASK_DONE', JSON.stringify(done).slice(0, 8500)); } catch (e) {}
  return res;
}
// 自動承認の前に使う：その品のきょうの確認結果（なければ今確かめる）
function zAskStateFor_(itemId, title, fallbackUrl) { const r = zAskStock_('オファー', itemId, title, fallbackUrl); return r ? r.state : 'unknown'; }
// メニュー：今届いているオファー（返事待ち）の品を、今すぐ確かめる
function menuAskStockNow() {
  run_(() => {
    const out = trading_('GetBestOffers', '<BestOfferStatus>Active</BestOfferStatus><DetailLevel>ReturnAll</DetailLevel>'), ns = out.ns, items = [];
    const arr = out.root.getChild('ItemBestOffersArray', ns);
    (arr ? arr.getChildren('ItemBestOffers', ns) : []).forEach(g => { const it = g.getChild('Item', ns); if (it) items.push(it); });
    if (!items.length) { const it = out.root.getChild('Item', ns); if (it) items.push(it); }
    let n = 0, outN = 0; items.forEach(it => { const r = zAskStock_('オファー', it.getChildText('ItemID', ns), it.getChildText('Title', ns) || ''); if (r) { n++; if (r.state === 'out') outN++; } });
    zAskSheet_().activate();
    return '返事待ちのオファー ' + n + '品の仕入れ先を確かめました' + (outN ? '（🔴 売り切れ ' + outN + '品：オファーは受けないでください）' : '') + '。結果は「オファー・質問の在庫確認」シート';
  });
}



/* =====================================================================
 * v236：売れるたびに、仕入れ先のURLをGmailへ送る（あなたの「売れるたびにGmailに送って」11/17 20:47）
 *   ・注文（支払い済み）が「仕入れリスト」に入った瞬間に1通。1品1通・同じ注文は二度送らない
 *   ・仕入れ先のURL・仕入れ値・利益の目安・eBayの注文ページ・仕入れ先の今の在庫（Yahoo!フリマ・ヤフオクは自動で確認・0円）
 *   ・仕入れ先を24時間以上確かめていない品は「至急」と書く（今までの至急メールをこの1通にまとめた）
 * ===================================================================== */
function zSoldMail_(o, li, s2, total, profit) {
  const itemId = String(li.legacyItemId), orderId = String(o.orderId), title = String(li.title || '');
  const p = PropertiesService.getScriptProperties(), key = 'ZSOLD_' + orderId + '_' + itemId;
  if (p.getProperty(key)) return;
  let checked = null;
  try { const lsh = listSheet_(); if (lsh.getLastRow() > 1) { const r = lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues().find(v => String(v[LCOL.ID - 1]) === itemId); if (r) checked = r[LCOL.CHECKED - 1]; } } catch (e) {}
  const age = checked instanceof Date ? (Date.now() - checked.getTime()) / 3600000 : 9999;
  const url = String(s2.url || '');
  let stock = ''; if (url) { try { stock = zStockNow_(url).txt; } catch (e) {} }
  const urgent = age >= 24;
  const body = [
    'eBayで売れました。仕入れ先で購入してください。', '',
    '■ 商品：' + title,
    '■ 仕入れ先：' + (url || '（仕入れ先のURLが記録にありません。出品作成シートで確かめてください）'),
    stock ? '■ 仕入れ先の今の在庫：' + stock : '',
    '■ 売値：$' + (Number(total) || 0).toFixed(2) + (s2.cost ? '／仕入れ値の目安：' + Number(s2.cost).toLocaleString() + '円' : '') + (profit !== '' && profit != null ? '／利益の目安：' + Number(profit).toLocaleString() + '円' : ''),
    (profit !== '' && profit != null && Number(profit) < 1500) ? '　⚠ 利益の目安が下限（1,500円）を下回っています。仕入れ値が上がっていないか確かめてください' : '',
    urgent ? '■ 至急：この品の仕入れ先を' + (age >= 9999 ? '一度も確かめていません' : Math.floor(age) + '時間確かめていません') + '。すぐに在庫を確かめてください' : '',
    '■ 注文番号：' + orderId + '（' + Utilities.formatDate(new Date(o.creationDate || Date.now()), 'Asia/Tokyo', 'MM/dd HH:mm') + '）',
    '■ eBayの注文：https://www.ebay.com/sh/ord/details?orderid=' + encodeURIComponent(orderId),
    '■ eBayの商品ページ：https://www.ebay.com/itm/' + itemId, '',
    '在庫がない場合は、早めにバイヤーへ連絡してください。仕入れたら「仕入れリスト」の「仕入れ済み」にチェック。',
    ss_().getUrl()].filter(x => x !== '').join('\n');
  MailApp.sendEmail(Session.getEffectiveUser().getEmail(), (urgent ? '【至急】' : '') + '【売れました・仕入れ先】' + title.slice(0, 60), body);
  p.setProperty(key, String(Date.now()));
}



/* =====================================================================
 * v237：一度にたくさん送ったときの「ロックのタイムアウト」で出品が止まらないようにする（あなたの「はい」11/18 00:15）
 *   ① 出品の窓口（二重出品を防ぐ順番待ち）の待ち時間を 30秒 → 2分
 *   ② 窓口の中で読むのを、出品作成シートの必要な2列だけにして、1品が窓口にいる時間を短くする
 *   ③ それでも順番が来なかった品は「⚠ 出品エラー」にせず【ロック待ち】の印を付け、10分ごとに（回数に数えずに）すぐ出品し直す
 *      ・出品の直前に、値段と利益をもう一度計算する（下限を割るなら出さない）
 *      ・品物の問題（二重出品・写真など）で失敗したら、印を外して、今までの「出品のやり直し」に回す
 * ===================================================================== */
function zIsLockErr_(msg) { return /ロックのタイムアウト|別のプロセスがロック|Lock timeout|lock.*timed out|too many LockService|【ロック待ち】/i.test(String(msg || '')); }
function zLockNote_(msg) { const m = String(msg || ''); return zIsLockErr_(m) && !/^【ロック待ち】/.test(m) ? '【ロック待ち】' + m : m; }
function zLockRetry_() {
  const out = { tried: 0, ok: 0, again: 0, fail: 0 };
  if (zGhListOn_()) return out;   // v245：GitHub がする
  const sh = prepSheet_(), n = sh.getLastRow() - 1; if (n < 1) return out;
  const st = sh.getRange(2, P.STATUS, n, 1).getValues(), nt = sh.getRange(2, P.NOTE, n, 1).getValues();
  const rows = []; for (let i = 0; i < n; i++) if ((String(st[i][0]) === '候補（出品エラー）' && zIsLockErr_(nt[i][0])) || (/GitHubで出品します/.test(String(nt[i][0])) && !/出品済み|重複|見送り/.test(String(st[i][0])))) rows.push(i + 2);   // 今までの書き方（印なし）のロック待ちも拾う
  if (!rows.length) return out;
  const ls = listingSettings_(), t0 = Date.now();
  for (const row of rows) {
    if (Date.now() - t0 > 150 * 1000 || out.tried >= 15) break;
    out.tried++;
    const r = sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0];
    try {
      const z0 = ZSENT_; ZSENT_ = /^【送った品】/.test(String(r[P.PJUDGE - 1] || ''));
      let g; try { g = gateCandidate_(sh, row, ls); } finally { ZSENT_ = z0; }
      if (!g.ok) { sh.getRange(row, P.STATUS).setValue('候補（出品エラー）'); sh.getRange(row, P.NOTE).setValue('計算し直したら出品の条件に合わない：' + (g.reason || '')); out.fail++; continue; }
      const id = listRow_(sh, row, ls);   // 今までの出品のやり直しと同じ扱い（出品停止中・傷あり・PSA の止めはそのまま効く）
      out.ok++; zLog_('順番待ちの出品のやり直し', '✅ 出品できた：' + String(r[P.TITLE - 1] || r[P.NAME - 1]).slice(0, 50) + '／eBay商品ID ' + id);
    } catch (e) {
      const lockAgain = zIsLockErr_(e.message);
      try { if (String(sh.getRange(row, P.STATUS).getValue()) !== '出品済み') { sh.getRange(row, P.STATUS).setValue('候補（出品エラー）'); sh.getRange(row, P.NOTE).setValue(lockAgain ? zLockNote_(e.message) : String(e.message).slice(0, 500)); } } catch (x) {}
      if (lockAgain) { out.again++; break; } else out.fail++;   // まだ混んでいるときは、次の回（10分後）に
    }
  }
  return out;
}



/* =====================================================================
 * v238：自動リサーチの「判定」を GitHub で動かす（あなたの「①の自動リサーチからはじめて」11/19 09:51）
 *   GitHub が、このツールと同じプログラム（コード.gs）をそのまま動かして判定する（判定のきまりは今と同じ・作り直さない）
 *   Googleのツールは、GitHub から頼まれたシートの値・設定を渡すだけ（読むだけ）と、結果の書き込みだけをする
 *   ・ghxmeta：シートの名前と大きさ　・ghxrange：シートの一部の値　・ghxprops：設定（合言葉・鍵は渡さない）と、eBayの相場を見るための一時的な鍵
 *   ・ghxjudged：判定の結果（外した理由の数・見た品）を記録　・ghxappend：記録用のシートに行を足す（決まったシートだけ）
 * ===================================================================== */
const Z_GHX_APPEND_OK = ['0円の自動化の記録', '予備の仕入れ先'];
const Z_GH_VER = 'v259';
var Z_GH_RUNNER_ = false;   // v245：GitHub で動いているときだけ true（GitHub が自分で立てる）
/* v245：判定・利益計算・出品を GitHub で（あなたの「判定、利益計算、自動出品すべてGASやめて、GitHubで作業させて」「はい」11/19 15:23）
 *  ・「追加の設定」F320 がオンの間、Googleのツールはまとめ判定・送った品の処理・出品のやり直しをしない。出品は「【ロック待ち】GitHubで出品します」にして GitHub に回す
 *  ・GitHub が3時間動かなかったら、Googleのツールが自動で引き継ぐ（出品が止まらないように）
 *  ・判定・利益計算・出品のプログラムは今のまま（同じコードを GitHub で動かす）。利益・利益率・PSA・傷・出品停止の止めはそのまま */
/* v246：出品中の品の手入れ（在庫チェック・値段の見直し・最低利益までの値上げ・相場の2倍の見直し・オファーをオン・自動点検・出品文の作り直し）を GitHub で
 *  （あなたの「ここすべてGitHubに変えて！」11/19 15:47）。「追加の設定」F321 がオンの間、Googleのツールはこれらをしない。GitHub が3時間動かなければ自動で引き継ぐ */
function zGhCareOn_() {
  if (Z_GH_RUNNER_) return false;
  if (zGhCareOn_._c != null) return zGhCareOn_._c;
