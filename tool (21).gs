/* ---------- 配送ポリシーを2つ作る（今のポリシーは変えない） ---------- */
function rtServiceCodes_(table) {
  const out = {};
  (table.rates || []).forEach(r => { const c = String(r.shippingCategory || '').toUpperCase(); if (r.shippingServiceCode && !out[c]) out[c] = r.shippingServiceCode; });
  if (out.ECONOMY && out.EXPEDITED) return out;
  try {
    const res = trading_('GeteBayDetails', '<DetailName>ShippingServiceDetails</DetailName>');
    const ns = res.root.getNamespace();
    res.root.getChildren('ShippingServiceDetails', ns).forEach(d => {
      if (d.getChildText('InternationalService', ns) !== 'true' || d.getChildText('ValidForSellingFlow', ns) === 'false') return;
      const code = d.getChildText('ShippingService', ns), cat = String(d.getChildText('ShippingCategory', ns) || '').toUpperCase();
      if (/USPS|UPS|Freight|Pickup/i.test(code)) return;
      if (cat === 'ECONOMY' && !out.ECONOMY) out.ECONOMY = code;
      if (cat === 'STANDARD' && !out.STANDARD) out.STANDARD = code;
      if (cat === 'EXPEDITED' && !out.EXPEDITED) out.EXPEDITED = code;
    });
  } catch (e) {}
  // v163：それでも分からなければ、今のv2の配送ポリシーに入っている配送サービスを使う
  if (!out.ECONOMY || !out.EXPEDITED) {
    const rs = rtSettings_();
    [rs.pol, rs.polHi].filter(x => x).forEach(id => {
      try {
        const pol = ebay_('get', '/sell/account/v1/fulfillment_policy/' + encodeURIComponent(id));
        const intl = (pol.shippingOptions || []).find(o => o.optionType === 'INTERNATIONAL');
        ((intl && intl.shippingServices) || []).forEach(sv => { const c = sv.shippingServiceCode; if (!c) return; if (/Expedited|Express|Priority/i.test(c)) { if (!out.EXPEDITED) out.EXPEDITED = c; } else if (!out.ECONOMY) out.ECONOMY = c; });
      } catch (e) {}
    });
  }
  if (!out.ECONOMY && out.STANDARD) out.ECONOMY = out.STANDARD;
  return out;
}
function menuRtCreatePolicies() {
