}
// ① 自分の店で売れたカード（eBayの注文）
function zOwnSales_() {
  const ss = zSellSettings_();
  const since = new Date(Date.now() - ss.days * 86400000).toISOString();
  const cnt = {};
  let url = '/sell/fulfillment/v1/order?limit=200&filter=' + encodeURIComponent('creationdate:[' + since + '..]');
  for (let page = 0; page < 10 && url; page++) {
    const res = ebay_('get', url);
    (res.orders || []).forEach(o => (o.lineItems || []).forEach(li => {
      const c = zCardFromEbayTitle_(li.title); if (!c) return;
      const k = zKeyOf_(c); (cnt[k] = cnt[k] || Object.assign({ n: 0, prices: [] }, c)).n += Number(li.quantity) || 1;
      const pr = Number(li.lineItemCost && li.lineItemCost.value) || 0; if (pr) cnt[k].prices.push(pr);
    }));
    url = res.next || '';
  }
  return cnt;
}
// 点数を付け直して「使う」を決める（リスト全体・0円）
function zScoreModels_(own) {
  const ss = zSellSettings_(), zs = zSettings_();
  const M = zModelIndex_();
