/* ---------- v115：発送方法の使い分け（$50未満＝SpeedPAK Economy／$50以上＝FedEx便・国際エアパケットなし） ---------- */
function zShipRule_() {
  if (zShipRule_._c && Date.now() - zShipRule_._c.at < 30000) return zShipRule_._c.v;
  let v = { on: true, noAir: true, border: 100 };
  try {
    const s = addSettingsSheet_();
    if (s.getRange('E263').getValue() === '') {
      s.getRange('E263').setValue('■ 発送方法の使い分け（v115）').setFontWeight('bold');
      s.getRange('E264:F266').setValues([['SpeedPAK Economy と FedEx便（SpeedPAK Expedited）の境目（販売価格$）', 100], ['国際エアパケットを使わない（米国・海外とも）', true], ['価格で使い分ける（境目未満＝Economy／境目以上＝FedEx便）', true]]);
      s.getRange('E264:E266').setFontWeight('bold');
      s.getRange('F264').setBackground('#fff4dc');
      s.getRange('F265').insertCheckboxes().setValue(true); s.getRange('F266').insertCheckboxes().setValue(true);
      s.getRange('E267').setValue('安いカードは送料の安い SpeedPAK Economy、高いカードは速くて追跡が細かい FedEx便にします。FedEx便の商品は、メニュー「0円の自動化」→「FedEx便用の配送ポリシーを選ぶ」で選んだポリシーで出品します。すでに出品中の商品は変えません。').setFontColor('#777777').setWrap(true);
    }
    // v116：v115 の初期値 50 を、1回だけ 100 に直す
    const pp = PropertiesService.getScriptProperties();
    if (pp.getProperty('SHIP_BORDER_V116') !== '1') { if (Number(s.getRange('F264').getValue()) === 50) s.getRange('F264').setValue(100); pp.setProperty('SHIP_BORDER_V116', '1'); }
    const x = s.getRange('F264:F266').getValues().map(r => r[0]);
    v = { border: Number(x[0]) > 0 ? Number(x[0]) : 100, noAir: x[1] !== false, on: x[2] !== false };
  } catch (e) {}
  zShipRule_._c = { at: Date.now(), v: v };
  return v;
}
function zNoAir_() { return true; }   // v140：国際エアパケットは使わない（いつも）
// 計算に使う配送方法：エアパケを外し、使い分けがオンなら Economy と FedEx を必ず入れる
function zShipMethods_(arr) {
  let a = (arr || []).slice();
  let r; try { r = zShipRule_(); } catch (e) { return a; }
  a = a.filter(m => !/エアパケ/.test(m));   // v140：国際エアパケットは使わない（設定に関係なく・あなたの決まり）
  if (r.on) ['エコノミー', 'FedEx'].forEach(m => { if (a.indexOf(m) < 0) a.push(m); });
  return a.length ? a : ['エコノミー', 'FedEx'];
}
// 販売価格の見込み（Economy で最低利益を守れる価格と、競合の最安・中央値の高いほう）で決める
function zShipPick_(plans, needOf, low, med) {
  let r; try { r = zShipRule_(); } catch (e) { return null; }
  if (!r.on) return null;
  const eco = plans['エコノミー'], fed = plans['FedEx'] || null;
  const mkt = low > 0 ? low : med > 0 ? med : 0;
  const est = Math.max(eco ? needOf(eco) : 0, mkt);
  if (est > 0 && est < r.border) return eco ? 'エコノミー' : null;
  if (est >= r.border) return fed ? 'FedEx' : (plans['DHL'] ? 'DHL' : (eco ? 'エコノミー' : null));
  return eco ? 'エコノミー' : null;
}
function chooseFedexPolicy() {
  CacheService.getScriptCache().remove('LIVE_POLICIES');
  const list = livePolicies_().filter(x => x.type === 'SHIPPING');
  if (!list.length) { SpreadsheetApp.getUi().alert('eBayに配送ポリシーが見つかりませんでした。'); return; }
  const cur = methodPolicies_().fed.id;
  const html = HtmlService.createHtmlOutput('<div style="font-family:sans-serif;font-size:14px;line-height:1.6">' +
    '<p><b>FedEx便（eBay SpeedPAK Expedited）で送る商品</b>（販売価格 $' + zShipRule_().border + ' 以上）に使う配送ポリシー</p>' +
    '<select id="f" size="10" style="width:100%;font-size:13px">' + list.map(x => '<option value="' + esc_(x.id) + '"' + (x.id === cur || (!cur && /fedex|expedited/i.test(x.name)) ? ' selected' : '') + '>' + esc_(x.name) + '（ID ' + esc_(x.id) + '）</option>').join('') + '</select>' +
    '<p style="color:#777;font-size:12px">米国向けに SpeedPAK Expedited（FedEx）の配送サービスが入っているポリシーを選んでください。送料は販売価格に含めているので、米国向けは送料無料のものにします。出品中の商品のポリシーは変わりません。</p>' +
    '<button onclick="var f=document.getElementById(\'f\').value;if(!f){alert(\'選んでください\');return}this.disabled=true;this.textContent=\'確認中…\';google.script.run.withSuccessHandler(function(m){document.body.innerHTML=\'<div style=font-family:sans-serif;line-height:1.7>\'+m+\'</div>\'}).setFedexPolicy(f)" style="padding:10px 18px;background:#1a73e8;color:#fff;border:0;border-radius:8px;font-weight:bold">これに決める</button></div>').setWidth(640).setHeight(520);
  SpreadsheetApp.getUi().showModalDialog(html, 'FedEx便用の配送ポリシーを選ぶ');
}
function setFedexPolicy(id) {
  CacheService.getScriptCache().remove('LIVE_POLICIES');
  const pol = livePolicies_().filter(x => x.type === 'SHIPPING').find(x => x.id === String(id));
  if (!pol) return '選んだポリシーがeBayに見つかりませんでした。もう一度選んでください。';
  const p = PropertiesService.getScriptProperties();
  p.setProperty('SHIP_POLICY_FED_ID', pol.id); p.setProperty('SHIP_POLICY_FED_NAME', pol.name);
  const sv = policyServices_(pol.id);
  const warn = sv && !sv.some(x => /^米国：.*(expedited|fedex)/i.test(x)) ? '<br><br><span style="color:#b00">⚠ 米国向けに Expedited（FedEx）の配送サービスが見つかりませんでした。お客様には別の配送サービスが表示されます。中身を確かめてください。</span>' : '';
  return '<b>決めました。</b>販売価格 $' + zShipRule_().border + ' 以上の商品は、このポリシーで出品します。<br><br><b>' + esc_(pol.name) + '</b>（ID ' + esc_(pol.id) + '）<br>' + (sv ? esc_(sv.join('、')) : '（中身を読めませんでした）') + warn +
    '<br><br>国別送料 v2 を使っているときは、メニュー「eBayのレートテーブル（国別送料 v2）」→「④」をもう一度押してください（高額品のポリシーの米国の配送を、このポリシーに合わせます）。';
}

