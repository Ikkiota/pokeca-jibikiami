      if (cur.length && list.length !== cur.length) {
        trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(id) + '</ItemID><PictureDetails>' + list.map(u => '<PictureURL>' + x_(u) + '</PictureURL>').join('') + '</PictureDetails></Item>');
        done++; zLog_('案内・バナーの写真を外す', id + '：' + cur.length + '枚 → ' + list.length + '枚');
      } else same++;
      done0[id] = 1;
    } catch (e) { failed++; notes.push(id + '：' + String(e.message).slice(0, 100)); if (/Ended|終了|not found|見つから/i.test(e.message)) done0[id] = 1; }
  }
  try { p.setProperty('BANNER_DONE2', JSON.stringify(done0)); } catch (e) {}
