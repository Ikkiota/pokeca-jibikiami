    '<h2>' + esc_(title) + '</h2><p>' + body + '</p></div>').setTitle(title);
}
function esc_(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

/* ---------- 準備：読み取り → eBay検索 → アレンジ ---------- */
function menuPrepareRows() {
  run_(() => {
    const sh = prepSheet_();
    const last = sh.getLastRow();
    if (last < 2) throw new Error('「出品作成」シートに商品がありません');
    const status = sh.getRange(2, P.STATUS, last - 1, 1).getValues();
    const ls = listingSettings_();
    let ok = 0, ng = 0, rej = 0;
    for (let i = status.length - 1; i >= 0 && ok + ng + rej < 8; i--) {
      const s = String(status[i][0]);
      if (s !== '受信' && !s.startsWith('エラー（準備）') && s !== '候補（出品エラー）') continue;
      const row = i + 2;
      try {
        const pr0 = zPrepare_(sh, row);   // v120
        if (pr0 && pr0.earlyStop) { archiveRejected_(sh, row, pr0.earlyStop); rej++; continue; }
        const g = gateCandidate_(sh, row, ls);
        if (g.ok) ok++; else if (g.keep || g.hold) ng++; else { archiveRejected_(sh, row, g.reason, g.detailText); rej++; }
      } catch (e) { sh.getRange(row, P.STATUS).setValue('エラー（準備）'); sh.getRange(row, P.NOTE).setValue(e.message); ng++; }
    }
    return '候補 ' + ok + '件・利益が出ないため除外 ' + rej + '件' + (ng ? '・エラー ' + ng + '件' : '') + (ok + ng + rej === 0 ? '（対象の行がありません）' : '');
  });
}

