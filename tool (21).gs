/* =====================================================================
 * v176：お店のページの「海外購入の案内（Buyee など）」「バナー」の画像を、写真に入れない
 *  ・v166 でお店のページの写真を全部使うようにしたら、Buyee（海外のお客様へ）の案内画像まで入ってしまった
 *  ・これからは、画像のURLに buyee・banner・bnr・kaigai（海外）・tenso・worldshopping・campaign・logo などがある画像は使わない
 *  ・ボタン「出品中の写真から案内・バナーを消す」：出品中の品の写真から、案内・バナーの画像を外して、カードの写真だけで入れ直す
 *    カードの写真が1枚も残らないときは、1枚目だけにする
 * ===================================================================== */
const Z_BANNER_RX = /buyee|banner|bnr|kaigai|oversea|global[_-]?(shop|ship)|tenso|worldshopping|world-shopping|campaign|coupon|point[_-]?up|logo|icon|guide|shipping_|soryo|souryou|haisou|caution|notice|attention|_info|info_|footer|header/i;
// v180：画像の縦横の大きさを読む（JPEG・PNG・GIF・WEBP。読めなければ null）
function zImgDims_(bytes) {
  const b = i => bytes[i] & 255, n = bytes.length;
  if (n > 24 && b(0) === 0x89 && b(1) === 0x50) return { w: (b(16) << 24 | b(17) << 16 | b(18) << 8 | b(19)), h: (b(20) << 24 | b(21) << 16 | b(22) << 8 | b(23)) };
  if (n > 10 && b(0) === 0x47 && b(1) === 0x49) return { w: b(6) | b(7) << 8, h: b(8) | b(9) << 8 };
  if (n > 30 && b(0) === 0x52 && b(8) === 0x57) { const t = String.fromCharCode(b(12), b(13), b(14), b(15));
    if (t === 'VP8X') return { w: 1 + (b(24) | b(25) << 8 | b(26) << 16), h: 1 + (b(27) | b(28) << 8 | b(29) << 16) };
    if (t === 'VP8 ') return { w: (b(26) | b(27) << 8) & 0x3fff, h: (b(28) | b(29) << 8) & 0x3fff };
    if (t === 'VP8L') { const x = b(21) | b(22) << 8 | b(23) << 16 | b(24) << 24; return { w: (x & 0x3fff) + 1, h: ((x >> 14) & 0x3fff) + 1 }; } }
  if (n > 4 && b(0) === 0xFF && b(1) === 0xD8) { let i = 2;
    while (i + 9 < n) { if (b(i) !== 0xFF) { i++; continue; } const m = b(i + 1); if (m === 0xFF) { i++; continue; } if (m === 0xD8 || m === 0x01 || (m >= 0xD0 && m <= 0xD7)) { i += 2; continue; }
      const len = b(i + 2) << 8 | b(i + 3); if ((m >= 0xC0 && m <= 0xCF) && m !== 0xC4 && m !== 0xC8 && m !== 0xCC) return { h: b(i + 5) << 8 | b(i + 6), w: b(i + 7) << 8 | b(i + 8) }; i += 2 + len; } }
  return null;
}
// v180：案内・バナーの画像を外す。URLの文字（buyee・banner など）に加えて、横長（横÷縦が 1.7 以上）や小さすぎる画像（150px 未満）も外す
//  1枚目（カードの写真）はそのまま残す。カードの写真が1枚も残らないときも1枚目だけは残す（写真なしの出品にはしない）
function zDropBanners_(urls, strict) {
  urls = (urls || []).map(u => String(u || '').trim()).filter(u => /^https?:\/\//.test(u));
  if (!urls.length) return urls;
  const c = CacheService.getScriptCache(), key = u => 'imgd_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, u));
  const dims = {}, need = [];
  urls.forEach(u => { if (Z_BANNER_RX.test(u)) return; let d = null; try { d = c.get(key(u)); } catch (e) {} if (d) dims[u] = d; else need.push(u); });
  for (let i = 0; i < need.length; i += 12) {
    const part = need.slice(i, i + 12);
    let res = []; try { res = UrlFetchApp.fetchAll(part.map(u => ({ url: u, muteHttpExceptions: true, followRedirects: true }))); } catch (e) {}
    part.forEach((u, j) => { let d = '?'; try { const r = res[j]; if (r && r.getResponseCode() === 200) { const x = zImgDims_(r.getContent()); if (x && x.w > 0 && x.h > 0) d = x.w + 'x' + x.h; } } catch (e) {}
      dims[u] = d; try { c.put(key(u), d, 21600); } catch (e) {} });
  }
  const bad = u => { if (Z_BANNER_RX.test(u)) return true; const d = String(dims[u] || '?'); if (d === '?') return false; const p = d.split('x').map(Number); return p[0] / p[1] >= 1.7 || Math.max(p[0], p[1]) < 150; };
  const keep = urls.filter(u => !bad(u));
  return keep.length || strict ? keep : urls.slice(0, 1);
}
// v180：出品中の品（出品作成で「出品済み」・出品一覧の30日以内）を eBay で確かめ、2枚目以降の案内・バナーの画像（URLの文字・横長の形）を外す
//  写真は eBay にある写真をそのまま使う（アップロードし直さない＝早い・0円）
function zCleanBannerPhotos_() {
  const p = PropertiesService.getScriptProperties();
  let done0 = {}; try { done0 = JSON.parse(p.getProperty('BANNER_DONE2') || '{}'); } catch (e) {}
  const ids = [], seen = {}, addId = id => { id = String(id || '').replace(/\D/g, ''); if (id.length >= 10 && !seen[id] && !done0[id]) { seen[id] = 1; ids.push(id); } };
  const sh = prepSheet_(), n = sh.getLastRow() - 1;
  if (n > 0) sh.getRange(2, 1, n, PREP_HEADERS.length).getValues().forEach(r => { if (String(r[P.STATUS - 1]) === '出品済み') addId(r[P.ITEMID - 1]); });
  try { const ls = listSheet_(), ln = ls.getLastRow() - 1, cut = Date.now() - 30 * 86400000;
    if (ln > 0) ls.getRange(2, 1, ln, LIST_HEADERS.length).getValues().forEach(r => { const d = r[LCOL.CHECKED - 1]; if (!(d instanceof Date) || d.getTime() >= cut) addId(r[LCOL.ID - 1]); }); } catch (e) {}
  const t0 = Date.now(); let done = 0, same = 0, failed = 0, more = false; const notes = [];
