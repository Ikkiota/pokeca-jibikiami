/* ---------- v167：出品中の商品の海外送料を、毎日自動で点検して直す（12時台） ----------
 *  「出品作成」シートの出品済みの商品を順に、eBayに付いている今の海外送料と、国ごとの今の実費（手数料・広告費込み）で比べる
 *  足りない配送サービスだけ、送り先でいちばん高い国の実費まで上げる。下げない・商品の値段は変えない
 *  ていねいに：
 *   ・重さが空／30g未満（入れ間違いかも）の商品は直さず「要確認」にする
 *   ・上げ幅が大きすぎる（今の3倍超かつ $40 超の値上げ、または $300 超）ときは直さず「要確認」にする（重さ・箱の入れ間違いの可能性）
 *   ・直したあとeBayからもう一度読み、本当に直ったか確かめる
 *   ・v2（レートテーブル）の商品は、毎日のレートテーブルの入れ直しで直るので触らない
 *   ・1回4分まで。続きは自動で次の回に。結果は「海外送料の自動修正の記録」シートとメール
 * ------------------------------------------------------------------------------- */
function rtListingsDaily() {
  const p = PropertiesService.getScriptProperties();
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return 'busy';
  try {
    const started = Date.now();
    const sh = prepSheet_();
    const n = Math.max(0, sh.getLastRow() - 1);
    if (!n) return 'none';
    let cur = Number(p.getProperty('RT_LST_CURSOR')) || 2;
    if (cur < 2 || cur > n + 1) cur = 2;
    const day = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
    if (cur === 2) { if (p.getProperty('RT_LST_DAY') === day) return 'done'; p.setProperty('RT_LST_RUN', JSON.stringify({ day: day, fixed: [], skipped: [], failed: [], checked: 0 })); }
    let run = {}; try { run = JSON.parse(p.getProperty('RT_LST_RUN') || '{}'); } catch (e) {}
    run.fixed = run.fixed || []; run.skipped = run.skipped || []; run.failed = run.failed || []; run.checked = run.checked || 0;
    const rows = sh.getRange(2, 1, n, PREP_HEADERS.length).getValues();
    const log = rtFixLogSheet_();
    let row = cur;
    for (; row <= n + 1; row++) {
      if (Date.now() - started > 4 * 60 * 1000) break;
      const r = rows[row - 2], itemId = String(r[P.ITEMID - 1] || '').trim();
      if (!itemId || String(r[P.STATUS - 1]) !== '出品済み') continue;
      const title = String(r[P.TITLE - 1] || '').slice(0, 40), w = Number(r[P.WEIGHT - 1]) || 0;
      run.checked++;
      if (!(w >= 30)) { run.skipped.push('行' + row + ' ' + title + '：重さが' + (w ? w + 'g（軽すぎるかも）' : '空') + 'なので直していない'); continue; }
      let pl;
      try { pl = rtListingFixPlan_(itemId, r); } catch (e) { if (!/not active|終了|ended/i.test(e.message)) run.failed.push('行' + row + ' ' + title + '：eBayから読めない（' + String(e.message).slice(0, 60) + '）'); continue; }
      if (pl.v2 || !pl.changes.length) { if (pl.cant.length) run.skipped.push('行' + row + ' ' + title + '：送れない国から買える（' + pl.cant.slice(0, 5).join('・') + '）→ 除外国を確かめる'); continue; }
      const ok = [], big = [];
      pl.changes.forEach(c => { const up = c.to - c.from; if (c.to > 300 || (c.from > 0 && c.to > c.from * 3 && up > 40) || (c.from === 0 && up > 80)) big.push(c); else ok.push(c); });
      big.forEach(c => run.skipped.push('行' + row + ' ' + title + '：' + c.service + ' $' + c.from.toFixed(2) + ' → $' + c.to.toFixed(2) + ' は上げ幅が大きすぎるので直していない（重さ・箱の大きさを確かめて、メニューの「出品中の商品の海外送料を直す」で）'));
      if (!ok.length) continue;
      const res = rtApplyListingFix_(pl, ok);
      const when = new Date();
      if (res.ok) {
        run.fixed.push('行' + row + ' ' + title + '：' + ok.map(c => c.service + ' $' + c.from.toFixed(2) + '→$' + c.to.toFixed(2)).join('・'));
        sh.getRange(row, P.NOTE).setValue(String(sh.getRange(row, P.NOTE).getValue() || '') + '／海外送料を自動で直した（' + Utilities.formatDate(when, 'Asia/Tokyo', 'MM/dd') + '：' + ok.map(c => '$' + c.from.toFixed(2) + '→$' + c.to.toFixed(2)).join('・') + '）');
      } else run.failed.push('行' + row + ' ' + title + '：' + res.why);
      ok.forEach(c => log.appendRow([when, row, itemId, title, c.service, c.from, c.to, IC_COUNTRIES[c.at] ? IC_COUNTRIES[c.at][0] : c.at, res.ok ? '直した（確認済み）' : '直せなかった：' + res.why]));
    }
