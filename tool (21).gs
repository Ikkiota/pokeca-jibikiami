    for (let i = names.length - 1; i > 0; i--) if (names.slice(0, i).some(n => n.ja === names[i].ja || n.ja.indexOf(names[i].ja) >= 0 || names[i].ja.indexOf(n.ja) >= 0)) names.splice(i, 1);
