// 「3,000円」「¥3000」「3000円（送料込み）」などから数字を取り出す
function toYen_(v) {
  if (typeof v === 'number') return v;
  const t = String(v || '').replace(/[０-９]/g, c => String.fromCharCode(c.charCodeAt(0) - 0xFEE0)).replace(/[,，\s]/g, '');
  const m = t.match(/\d+(\.\d+)?/);
  return m ? Number(m[0]) : 0;
}


// 手数料率の内訳（説明用）
function feeText_(off, catId, price, method) {
  if (zTbOn_()) return '教科書の見積：eBay手数料 15%（落札手数料13.6%＋国際手数料1.35%）＋広告 2.2% ＝ 17.20%';
  const cat = catFee_(off, catId, price);
  const parts = ['カテゴリー手数料 ' + (cat * 100).toFixed(2) + '%', '海外手数料 ' + (off.intl * 100).toFixed(2) + '%',
    'PL ' + (off.pl * 100).toFixed(2) + '%'];
  if (off.plus3) parts.push('3%（On）');
  const mult = ['EMS', '印刷物書留', '書状書留'].indexOf(method) >= 0;
  const total = feeRate_(off, catId, price, method);
  return parts.join('＋') + (mult ? '、ペイオニア ' + (off.payoneer * 100).toFixed(1) + '%（掛け算）' : '＋ペイオニア ' + (off.payoneer * 100).toFixed(1) + '%') + ' ＝ ' + (total * 100).toFixed(2) + '%';
}


// 使う配送方法すべての計算条件（利益判定の価格は後で決まるので、率と金額を保存）
function allPlans_(off, cs, catId, priceUsd, cost, weightG, box, originRate) {
  const out = {};
  cs.methods.forEach(m => {
    const sr = shipYen_(off, m, weightG, priceUsd, box);
    if (sr.yen === null) return;
    const d = dutyParts_(off, cs, m, cost, originRate, priceUsd);
    out[m] = { method: m, f: feeRate_(off, catId, priceUsd, m), ship: Math.round(sr.yen), tRate: d.tRate, fixed: d.fixed,
      shipText: sr.text || '', fixedText: d.text || '', dutyText: d.dutyText || '', feeText: feeText_(off, catId, priceUsd, m) };
  });
  return out;
}

