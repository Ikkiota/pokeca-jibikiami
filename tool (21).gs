function icSettings_() {
  const s = sheet_('設定');
  if (s.getRange('E190').getValue() === '') {
    s.getRange('E189').setValue('■ 国別送料（FedEx・DHL・国際エアパケット・EMS、5グループ）').setFontWeight('bold');
    s.getRange('E190:F194').setValues([['出品ごとに国別送料を設定する（5グループ）', false], ['FedExの燃油サーチャージ（自動で取得。取れないときだけ手入力を使う）', ''], ['DHLの燃油サーチャージ（自動で取得・SpeedPAKの割引後。取れないときだけ手入力）', ''],
      ['国別送料の配送ポリシーID（ツールが作成）', ''], ['海外の送料の端数（ドル単位で切り上げ）', 0.5]]);
    s.getRange('E190:E194').setFontWeight('bold'); s.getRange('F190').insertCheckboxes().setValue(false);
    s.getRange('F191:F192').setBackground('#fde7e9'); s.getRange('F193').setNumberFormat('@');
  }
  const v = s.getRange('F190:F194').getValues().map(r => r[0]);
  const pctv = x => x === '' || x == null || isNaN(Number(String(x).replace('%', ''))) ? null : (Number(String(x).replace('%', '')) > 1 ? Number(String(x).replace('%', '')) / 100 : Number(x));
  // 燃油サーチャージは自動で取得した率を使う（取れないときだけ F191・F192 の手入力）
  const auto = icSettings_._fuel || (icSettings_._fuel = icFuelAuto_());
  return { on: v[0] === true, fxFuel: auto.fx ? auto.fx.rate : pctv(v[1]), dhFuel: auto.dh ? auto.dh.rate : pctv(v[2]), fuelInfo: auto, policyId: String(v[3] || '').trim(), step: Number(v[4]) || 0.5 };
}
const icLookup_ = (tbl, kg) => { const r = tbl.find(x => x[0] >= kg - 1e-9); return r ? r[1] : null; };
// 1つの国への送料（4つの方法を計算して、いちばん安いもの）
function icCountryCost_(cc, weightG, box, st) {
  const c = IC_COUNTRIES[cc]; if (!c) return null;
  st = st || icSettings_();
  box = box || { l: 0, w: 0, h: 0 };
  const vol = box.l * box.w * box.h, all = {};
  const billKg = Math.max(weightG, vol / 5) / 1000;
  const roundKg = k => k <= 20 ? Math.ceil(k * 2) / 2 : Math.ceil(k);
  if (c[1] && st.fxFuel != null && !(box.l > 274 || (box.l && box.l + 2 * (box.w + box.h) > 330))) { const b = icLookup_(IC_FEDEX[c[1]], roundKg(billKg)); if (b) all.FedEx = Math.round(b * (1 + st.fxFuel)); }
  if (c[2] && st.dhFuel != null && !(box.l > 120)) { const b = icLookup_(IC_DHL[c[2]], roundKg(billKg)); if (b) all.DHL = Math.round(b * (1 + st.dhFuel)); }
  if (!zNoAir_() && weightG <= 2000 && !(box.l && (box.l > 60 || box.l + box.w + box.h > 90)) && typeof AIRPACKET_JPY !== 'undefined' && AIRPACKET_JPY[c[3]]) all['国際エアパケット'] = AIRPACKET_JPY[c[3]][Math.max(0, Math.ceil(weightG / 100) - 1)];
  if (weightG <= 30000) { const r = IC_EMS.find(x => x[0] >= weightG); if (r) all.EMS = r[c[3]]; }
  // v150：SpeedPAK Economy（料金がある国だけ：米国・イギリス・EUの対象国・オーストラリア）
  try { const sp = icSpeedpakYen_(cc, weightG, box); if (sp) all['SpeedPAK'] = sp; } catch (e) {}
  // v149：高額品は FedEx・DHL の安いほう（どちらも送れなければ4つの中で一番安い）
  let ms = Object.keys(all).sort((a, b) => all[a] - all[b]);
  if (st.highOnly) { const hi = ms.filter(m => m === 'FedEx' || m === 'DHL'); if (hi.length) ms = hi; }
  return ms.length ? { m: ms[0], yen: all[ms[0]], all: all } : null;
}
// SpeedPAK Economy の送料（円・燃油込み）。料金表がない国・大きさの条件に合わないときは null
//  条件（SpeedPAK Economy）：商品価格1,200ドルまで・長さ66cmまで・長さ＋2×(幅＋高さ)≦274cm・25kgまで・容積重量は÷8000
function icSpeedpakYen_(cc, weightG, box) {
  let off = null; try { off = official_(); } catch (e) { return null; }
  box = box || { l: 0, w: 0, h: 0 };
  if (box.l && (box.l > 66 || box.l + 2 * (box.w + box.h) > 274)) return null;
  if (weightG > 25000) return null;
  const w = Math.max(weightG, box.l * box.w * box.h / 8);
  let list = null;
  if (cc === 'US') list = off.ship && off.ship['エコノミー'];
  else if (off.speedpak) list = cc === 'GB' ? off.speedpak.UK : cc === 'AU' ? off.speedpak.AU : (off.speedpak.EU || {})[cc];
  const hit = (list || []).find(r => r[0] >= w);
  const fuelIncl = !!(off.speedpak && off.speedpak.US && off.speedpak.US.length);   // 送料マスタ（公式の料金表）は燃油込み
  return hit ? Math.round(hit[1] * (1 + (fuelIncl ? 0 : (off.ecoSurcharge || 0)))) : null;
}
// グループごとの送料（グループ内でいちばん高い国に合わせる）
function icGroupCosts_(weightG, box, ccs, st) {
  st = st || icSettings_();
  const out = {};
  IC_ORDER.forEach(g => {
    let mx = null;
    (ccs || Object.keys(IC_COUNTRIES)).filter(cc => IC_COUNTRIES[cc] && IC_COUNTRIES[cc][4] === g).forEach(cc => { const r = icCountryCost_(cc, weightG, box, st); if (r && (!mx || r.yen > mx.yen)) mx = { yen: r.yen, cc: cc, m: r.m }; });
    out[g] = mx;
  });
  return out;
}
// 出品ごとの送料の上書き（ShippingServiceCostOverrideList）
function icOverrideXml_(r) {
  const st = icSettings_();
  if (!st.on || !st.policyId) return '';
  let prio = {}, ccs = null;
  try { prio = JSON.parse(PropertiesService.getScriptProperties().getProperty('IC_GROUP_PRIO') || '{}'); ccs = JSON.parse(PropertiesService.getScriptProperties().getProperty('IC_GROUP_CCS') || 'null'); } catch (e) {}
  const w = Number(r[P.WEIGHT - 1]) || 0;
  if (!(w > 0)) throw new Error('国別送料：重さが空のため、送料を計算できません（出品を止めました）');
  const fx = Number(r[P.FX - 1]) || Number(official_().rate) || 150, us = Number(r[P.SHIP - 1]) || 0;
  const priceUsd = Number(r[P.PRICE - 1]) || 0;
  let highUsd = 200; try { if (typeof shipRuleSettings_ === 'function') highUsd = shipRuleSettings_().highUsd; } catch (e) {}
  const gc = icGroupCosts_(w, parseBox_(r[P.BOX - 1]), ccs, Object.assign({}, st, { highOnly: priceUsd >= highUsd }));
  const parts = [];
  IC_ORDER.forEach(g => {
    if (!prio[g]) return;
    const c = gc[g];
    if (!c) throw new Error('国別送料：' + IC_GROUPS[g] + 'に送れる方法がありません（重さ・大きさを確認）');
    // v162：海外の送料にもeBayの手数料・広告費がかかるので、その分を上乗せ（送料の赤字を防ぐ）
    const feeR = Math.max(typeof rtSettings_ === 'function' ? rtSettings_().fee : 0.22, Number(r[P.FRATE - 1]) || 0);
    const usd = Math.max(0, Math.ceil(((c.yen - us) / fx / (1 - feeR)) / st.step) * st.step);
    parts.push('<ShippingServiceCostOverride><ShippingServicePriority>' + prio[g] + '</ShippingServicePriority><ShippingServiceType>International</ShippingServiceType>' +
      '<ShippingServiceCost currencyID="USD">' + usd.toFixed(2) + '</ShippingServiceCost><ShippingServiceAdditionalCost currencyID="USD">' + usd.toFixed(2) + '</ShippingServiceAdditionalCost></ShippingServiceCostOverride>');
  });
  return parts.length ? '<ShippingServiceCostOverrideList>' + parts.join('') + '</ShippingServiceCostOverrideList>' : '';
}

/* ---------- 5グループの配送ポリシーを作る（今回だけツールが作成） ---------- */
function icIntlServiceCodes_() {
  const out = trading_('GeteBayDetails', '<DetailName>ShippingServiceDetails</DetailName>');
  const ns = out.root.getNamespace();
  const list = out.root.getChildren('ShippingServiceDetails', ns).filter(d => d.getChildText('InternationalService', ns) === 'true' && d.getChildText('ValidForSellingFlow', ns) === 'true').map(d => d.getChildText('ShippingService', ns));
  const pref = ['ExpeditedInternational', 'StandardInternational', 'OtherInternational', 'FedExInternationalPriority', 'FedExInternationalEconomy'];
  const pick = pref.filter(c => list.indexOf(c) >= 0);
  list.filter(c => pick.indexOf(c) < 0 && !/USPS|UPS|Freight|Pickup/i.test(c)).forEach(c => { if (pick.length < 5) pick.push(c); });
  return pick.slice(0, 5);
}
