/* =====================================================================
 * 在庫管理（6時間ごと）とアラーム
 *  ・仕入れ先のページは、規約上ツールが自動で読みに行けないため、
 *    「確認が必要な商品」を売り切れやすい順に並べて知らせ、リンクからボタン1回で確認できるようにする
 *  ・在庫切れが分かったら、すぐメール（eBayの在庫は自動で0）
 *  ・注文が入った商品の仕入れ先を24時間以上確認していなければ、至急メール
 *  ・安全装置（オンのとき）：フリマ仕入れで長時間確認できない商品は、eBayの在庫を0にして一時停止
 * ===================================================================== */
/* =====================================================================
 * v90：在庫チェックの記録・取り下げ記録・自動の在庫確認（1件ずつ）
 * ===================================================================== */
let LAST_STOCK_ = null;

function stockLog_(r, method, result, reason, url) {
  try {
    const ss = ss_();
    let sh = ss.getSheetByName('在庫チェック記録');
    if (!sh) {
      sh = ss.insertSheet('在庫チェック記録');
      sh.getRange(1, 1, 1, 8).setValues([['確認日時', '商品ID', 'タイトル', '確認方法', '結果', '判断の理由・メモ', '仕入れURL', '前回の確認']]).setFontWeight('bold').setBackground('#e8f0f2');
      [120, 120, 300, 150, 220, 380, 240, 110].forEach((w, i) => sh.setColumnWidth(i + 1, w));
      sh.setFrozenRows(1);
    }
    const prev = r[LCOL.CHECKED - 1];
    sh.appendRow([new Date(), String(r[LCOL.ID - 1]), r[LCOL.TITLE - 1], method, result, String(reason || '').slice(0, 2000), url || r[LCOL.SRC_URL - 1] || '',
      prev instanceof Date ? Utilities.formatDate(prev, 'Asia/Tokyo', 'MM/dd HH:mm') : '未確認']);
    sh.getRange(sh.getLastRow(), 2).setNumberFormat('@');
    if (sh.getLastRow() > 20000) sh.deleteRows(2, 2000);   // 古い記録から整理（取り下げ記録は消さない）
  } catch (e) { Logger.log(e); }
}

// 取り下げた商品を、理由と元データごと記録する（このシートは自動では消しません）
