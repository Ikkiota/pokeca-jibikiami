const Z_DESC_KEYS = [['Card Name', 'Card Name'], ['Character', 'Pokémon'], ['Card Number', 'Card Number'], ['Set', 'Set'], ['Rarity', 'Rarity'], ['Finish', 'Finish'], ['Features', 'Features'], ['Language', 'Language'], ['Year Manufactured', 'Year'], ['Card Condition', 'Condition']];
function zSpecsArr_(specs) {
  if (Array.isArray(specs)) return specs;
  return String(specs || '').split(/\n+/).map(l => { const k = l.indexOf(':'); return k > 0 ? [l.slice(0, k).trim(), l.slice(k + 1).trim()] : null; }).filter(v => v && v[0] && v[1]);
}
function zItemDesc_(title, specs, condId, condNote) {
  const base = fixedDescription_(), a = zSpecsArr_(specs), get = k => { const v = a.find(x => String(x[0]).toLowerCase() === k.toLowerCase()); return v ? String(v[1]).trim() : ''; };
  const rows = [];
  Z_DESC_KEYS.forEach(k => { let v = get(k[0]); if (k[0] === 'Character' && v && v === get('Card Name')) v = ''; if (v) rows.push([k[1], v]); });
  if (!get('Card Condition')) { const c = condLabel_(condId); if (c) rows.push(['Condition', c.replace(/^Used - Very Good \/ Ungraded$/, 'Ungraded')]); }
  if (!get('Language')) rows.push(['Language', 'Japanese']);
