    }
    run.total = kws.length;
    const more = run.i < kws.length && !budgetStop;
    if (budgetStop) { p.deleteProperty('KW_RUN'); zLog_('時間の節約', 'リサーチを ' + run.i + '／' + kws.length + ' で止めた（今日の動作時間の残りを、メッセージと出品に残すため。続きは次の毎日の検索で）'); }
    if (more) { p.setProperty('KW_RUN', JSON.stringify(run)); try { runSoon_('kwSearchContinue'); } catch (e) {} }
    else p.deleteProperty('KW_RUN');
    let auto = 0;
    if (!more && st.autoGo && !listPaused_()) auto = kwSendGo_(true).sent;
    kwProgress_(more ? '続きを1分後に自動で進めます：' + run.i + '／' + kws.length + '・見つけた ' + run.found + '件・通った ' + run.pass + '件'
      : '終わりました：キーワード ' + kws.length + '件・見つけた ' + run.found + '件・通った ' + run.pass + '件（「出品候補（0円）」）' + (st.autoGo ? '・自動GO ' + auto + '件' : '・GO にチェックして「GOした候補を判定・出品に回す」'));
    return { more: more, found: run.found, pass: run.pass, auto: auto, total: kws.length };
  } finally { lock.releaseLock(); }
}
