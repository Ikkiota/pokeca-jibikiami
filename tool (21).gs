}

// 1日の利用回数を数える
function dayCount_(name, add) {
  const p = PropertiesService.getScriptProperties();
  const today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd');
  const k = 'CNT_' + name;
  let o = {};
  try { o = JSON.parse(p.getProperty(k) || '{}'); } catch (e) {}
  if (o.d !== today) o = { d: today, n: 0 };
  if (add) { o.n += add; p.setProperty(k, JSON.stringify(o)); }
  return o.n;
}

// ① 種から具体的なタイトルを提案
function seedExpand_(maxSeeds, cfg) {
  const seeds = seedSheet_();
  const rq = researchQueueSheet_();
  if (rq.getLastRow() - 1 >= cfg.maxRows) return 0;
  const last = seeds.getLastRow();
  if (last < 2) return 0;
  const rows = seeds.getRange(2, 1, last - 1, 4).getValues().map((r, i) => ({ i: i, seed: String(r[0] || '').trim(), on: r[1] === true, t: r[2] instanceof Date ? r[2].getTime() : 0, n: Number(r[3]) || 0 }))
    .filter(x => x.seed && x.on).sort((a, b) => a.t - b.t).slice(0, maxSeeds);
  if (!rows.length) return 0;
  const key = need_('ANTHROPIC_API_KEY');
  const st = getSettings_();
  const rqLast = rq.getLastRow();
  const existing = new Set((rqLast > 1 ? rq.getRange(2, RQ.KW, rqLast - 1, 1).getValues().map(r => String(r[0]).trim().toLowerCase()) : []).concat(skippedKeywords_()));
  let added = 0;
  rows.forEach(x => {
    const out = parseJson_(claude_(key, st.model,
      'あなたは日本からeBay（米国）へ中古ゲームソフトを輸出するセラーのリサーチ担当です。出力はJSONのみ。',
      'ジャンル：' + x.seed + '\n' +
      'このジャンルで、eBay USで「日本版」が中古でよく売れていて、$' + cfg.priceMin + '〜$' + cfg.priceMax + '（送料込み）で売れることが多いタイトルを10個提案してください。' +
      '日本だけで発売されたタイトル、海外版がない・少ないタイトル、コレクターに人気のタイトルを優先。どこでも安く手に入る大量生産のタイトルは避ける。' +
      'すでに提案済みのものと重ならないように、これまでの提案数（' + x.n + '）も考えて別のタイトルを。\n' +
      'キーワードはeBayの出品タイトルに近い英語（タイトル名＋機種＋Japanese/Japan＋CIBなど）。\n{"items":[{"kw":"","why":"理由（日本語・短く）"}]}'));
    let n = 0;
    (out.items || []).slice(0, 10).forEach(it => {
      const kw = String(it.kw || '').trim();
      if (!kw || existing.has(kw.toLowerCase())) return;
      existing.add(kw.toLowerCase());
      // eBayで出品状況を確かめる：同じタイトルが3件以上出品されていて、価格の中央値が対象の価格帯に入っているものだけ
      const qc = quickMarketCheck_(kw);
      if (!qc.ok(cfg)) { skipKeyword_(kw, '種（' + x.seed + '）からの提案をeBayで確認：' + qc.text(cfg), qc); return; }
      rq.appendRow([kw, '中古', '種（' + x.seed + '）から提案・eBay確認済み（' + qc.text(cfg) + '）：' + (it.why || '')]);
      rq.getRange(rq.getLastRow(), 1, 1, 3).setBackground('#fef7e0');
      existing.add(kw.toLowerCase());
      n++; added++;
    });
    seeds.getRange(x.i + 2, 3, 1, 2).setValues([[new Date(), x.n + n]]);
  });
  return added;
}

// ③ 前回あった出品が終了していたら「売れた」として数える（検索結果の入れ替わりを売れたと数えないよう、出品を確認）
function trackSales_(sh, row, v, mk) {
  const ids = (mk.items || []).map(it => it.itemId).filter(x => x);
  let prev = {};
  try { prev = JSON.parse(v[RQ.SNAP - 1] || '{}'); } catch (e) {}
  let log = [];
  try { log = JSON.parse(v[RQ.SALESLOG - 1] || '[]'); } catch (e) {}
  if (prev.ids && prev.ids.length) {
    const now = new Set(ids);
    const gone = prev.ids.filter(id => !now.has(id)).slice(0, 10);
    let sold = 0;
    gone.forEach(id => {
      try { ebay_('get', '/buy/browse/v1/item/' + encodeURIComponent(id), { kind: 'app', marketplace: 'EBAY_US' }); }   // まだ出品中なら売れていない
      catch (e) { if (/404|11001|not found|ended|見つかり/i.test(e.message)) sold++; }
    });
    log.push([Date.now(), sold]);
  }
  const weekAgo = Date.now() - 7 * 86400000;
  log = log.filter(x => x[0] >= weekAgo).slice(-60);
  const sales = log.reduce((a, x) => a + x[1], 0);
  sh.getRange(row, RQ.SNAP, 1, 3).setValues([[JSON.stringify({ t: Date.now(), ids: ids.slice(0, 150) }), log.length ? sales : '', JSON.stringify(log)]]);
}

// ⑤ 朝8時・夜8時に、新しい狙い目と✅をまとめて知らせる
function research24Digest_() {
  const p = PropertiesService.getScriptProperties();
  const h = Number(Utilities.formatDate(new Date(), 'Asia/Tokyo', 'H'));
  const slot = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd') + (h >= 20 ? 'PM' : h >= 8 ? 'AM' : '');
  if (!/AM|PM$/.test(slot) || p.getProperty('R24_DIGEST') === slot) return;
  const since = Number(p.getProperty('R24_DIGEST_T') || 0);
  const sh = researchQueueSheet_();
  const last = sh.getLastRow();
  p.setProperty('R24_DIGEST', slot);
  p.setProperty('R24_DIGEST_T', String(Date.now()));
  if (last < 2) return;
  const rows = sh.getRange(2, 1, last - 1, RQ_HEADERS.length).getValues()
    .filter(r => r[RQ.DATE - 1] instanceof Date && r[RQ.DATE - 1].getTime() > since && /狙い目|✅|激熱|需要あり/.test(String(r[RQ.JUDGE - 1]) + String(r[RQ.VERDICT - 1]) + String(r[RQ.DEMAND - 1])))
    .sort((a, b) => (/激熱/.test(String(b[RQ.DEMAND - 1])) - /激熱/.test(String(a[RQ.DEMAND - 1]))));
  if (!rows.length) return;
  const lines = rows.slice(0, 30).map(r => '・' + r[RQ.KW - 1] + '：' + r[RQ.JUDGE - 1] + '／仕入れ上限 ' + (Number(r[RQ.MAXCOST - 1]) || 0).toLocaleString() + '円' +
    (r[RQ.DEMAND - 1] ? '／' + r[RQ.DEMAND - 1] : '／Sold未確認') + (r[RQ.VERDICT - 1] ? '／' + r[RQ.VERDICT - 1] : ''));
  MailApp.sendEmail(Session.getEffectiveUser().getEmail(), '【24時間リサーチ】狙い目 ' + rows.length + '件',
    '前回のお知らせ以降に見つかった狙い目です。\n\n' + lines.join('\n') +
    '\n\n「リサーチ候補」シートの「仕入れ先で探す」から、メルカリ・Yahoo!フリマ・Amazonを開いて「検索結果を送る」を押してください。\n' + ss_().getUrl());
}

function research24h() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return;
  try {
    const cfg = research24Settings_();
    const h = Number(Utilities.formatDate(new Date(), 'Asia/Tokyo', 'H'));
    // ① キーワードを増やす（6時間ごとに種から、毎回売れた商品から）
    try { expandRelatedKeywords_(1); } catch (e) {}
    // 候補（未調査・狙い目・検討）が30件より少なくなったら毎時間、多ければ6時間ごとに、種から新しく探す
    let pending = 0;
    try {
      const q = researchQueueSheet_(), ql = q.getLastRow();
      if (ql > 1) pending = q.getRange(2, RQ.DATE, ql - 1, 1).getValues().length;
    } catch (e) {}
    if (pending < 30 || h % 6 === 0) { try { seedExpand_(2, cfg); } catch (e) {} }
    // ② ③ 市場を調べる（1日の上限まで）
    const left = cfg.perDay - dayCount_('R24', 0);
    if (left > 0) {
      const r = researchQueueRun_(Math.min(cfg.perRun, left));
      dayCount_('R24', r.done);
    }
    // ④ 狙い目の国内ページを探す
    const srcLeft = cfg.srcPerDay - dayCount_('R24SRC', 0);
    if (srcLeft > 0) { try { dayCount_('R24SRC', findSourcesForHot_(1)); } catch (e) {} }
    // ⑤ 知らせる
    try { research24Digest_(); } catch (e) {}
  } finally { lock.releaseLock(); }
}

