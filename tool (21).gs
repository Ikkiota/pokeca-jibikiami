  const html = HtmlService.createHtmlOutput('<div style="font-family:sans-serif;font-size:14px;line-height:1.6">' +
    '<p>リンクを開き、eBayのSold検索結果で赤い「<b>Soldを送る</b>」を押してください。判定し直して、条件を満たせば出品まで進みます。</p>' +
    '<ol style="padding-left:20px">' + body + '</ol></div>').setWidth(560).setHeight(600);
  SpreadsheetApp.getUi().showModalDialog(html, 'Sold確認待ち：' + items.length + '件');
}

// v89：同じJAN・同じ英語タイトルの別の行で取り込み済みのSoldを探す（1回の実行の中では覚えておく）
let SOLD_SHARE_CACHE_ = null;
function sharedSoldFor_(r) {
  const jan = String(r[P.JAN - 1] || '').replace(/\D/g, '');
  const title = String(r[P.TITLE - 1] || '').trim().toLowerCase();
  if (jan.length < 8 && title.length < 15) return null;
  if (!SOLD_SHARE_CACHE_) {
    SOLD_SHARE_CACHE_ = [];
    const sh = ss_().getSheetByName('出品作成');
    if (sh && sh.getLastRow() >= 2) {
      sh.getRange(2, 1, sh.getLastRow() - 1, PREP_HEADERS.length).getValues().forEach(v => {
        const j = String(v[P.S_JSON - 1] || '');
        if (j.length > 2) SOLD_SHARE_CACHE_.push({ jan: String(v[P.JAN - 1] || '').replace(/\D/g, ''), title: String(v[P.TITLE - 1] || '').trim().toLowerCase(), json: j });
      });
    }
  }
  const hit = SOLD_SHARE_CACHE_.find(x => (jan.length >= 8 && x.jan === jan) || (title.length >= 15 && x.title === title));
  return hit ? hit.json : null;
}

// 行のSOLD（商品ごと → 同じJAN・同じタイトルの別の行 → リサーチ候補のキーワード）
function soldDataForRow_(r) {
  const since = Date.now() - 90 * 86400000;
  try { const j = JSON.parse(r[P.S_JSON - 1] || 'null'); if (j && j.length) return { list: j.filter(x => x[1] >= since).map(x => x[0]), level: '商品' }; } catch (e) {}
  try {
    const shared = sharedSoldFor_(r);
    if (shared) { const j = JSON.parse(shared); const list = j.filter(x => x[1] >= since).map(x => x[0]); if (list.length) return { list: list, level: '同じ商品（JAN・タイトル一致）' }; }
  } catch (e) {}
  const kw = String(r[P.RQREF - 1] || '').trim().toLowerCase();
  if (kw) {
    const rq = researchQueueSheet_();
    if (rq.getLastRow() > 1) {
      const rows = rq.getRange(2, 1, rq.getLastRow() - 1, RQ_HEADERS.length).getValues();
      const hit = rows.find(v => String(v[RQ.KW - 1]).trim().toLowerCase() === kw);
      if (hit) { try { const j = JSON.parse(hit[RQ.SOLDJSON - 1] || 'null'); if (j && j.length) return { list: j.filter(x => x[1] >= since).map(x => x[0]), level: 'キーワード' }; } catch (e) {} }
    }
  }
  return { list: [], level: '' };
}

function soldGuardFor_(r, price, minPrice) {
  const rule = soldRuleSettings_();
  const sd = soldDataForRow_(r);
  const st = robustStats_(sd.list);
  const out = { status: 'PRICE_REVIEW', med: st ? st.median : '', count: st ? st.count : 0, min: st ? st.min : '', max: st ? st.max : '', conf: '低', reason: '' };
  if (!st || st.count < rule.minCount) {
    out.reason = '同じ商品のSOLDが不足しています（' + (st ? st.count : 0) + '件／必要 ' + rule.minCount + '件）。「eBayでSoldを見る」→「Soldを送る」で確認してください';
  } else {
    out.conf = st.count >= 8 && sd.level === '商品' ? '高' : st.count >= 8 || sd.level === '商品' ? '中' : '低';
    if (minPrice > st.max || minPrice > st.median * rule.dnl) {
      out.status = 'DO_NOT_LIST';
      out.reason = '最低利益を守る価格 $' + minPrice.toFixed(2) + ' が、SOLDの実績（中央値 $' + st.median.toFixed(2) + '・最高 $' + st.max.toFixed(2) + '）を大きく超えています。その価格で売れた実績がありません';
    } else if (price > st.median * rule.review) {
      out.status = 'PRICE_REVIEW';
      out.reason = '提案価格 $' + price.toFixed(2) + ' が、SOLD中央値 $' + st.median.toFixed(2) + ' の' + Math.round(rule.review * 100) + '%を超えています';
    } else {
      out.status = 'NORMAL';
      out.reason = '提案価格 $' + price.toFixed(2) + ' は、同じ商品のSOLD（' + st.count + '件・中央値 $' + st.median.toFixed(2) + '）の範囲内です' + (st.removed ? '（外れ値 ' + st.removed + '件を除外）' : '');
    }
    out.reason += '／SOLDの出どころ：' + (sd.level === '商品' ? 'この商品のSold検索' : 'リサーチ候補のキーワードのSold検索');
  }
  return out;
}

function soldGuard_(sh, row, price, minPrice) {
  const r = sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0];
  const g = soldGuardFor_(r, price, minPrice);
  sh.getRange(row, P.S_MED, 1, 7).setValues([[g.med, g.count, g.min, g.max, g.conf, g.status, g.reason]]);
  sh.getRange(row, P.S_STATUS).setBackground(g.status === 'NORMAL' ? '#d8f0d8' : g.status === 'PRICE_REVIEW' ? '#fef7e0' : '#f8d0d0');
  g.text = 'suggested_price $' + price.toFixed(2) + '／sold_median ' + (g.med !== '' ? '$' + Number(g.med).toFixed(2) : '—') + '／sold_count ' + g.count +
    '／sold_min ' + (g.min !== '' ? '$' + Number(g.min).toFixed(2) : '—') + '／sold_max ' + (g.max !== '' ? '$' + Number(g.max).toFixed(2) : '—') +
    '／price_confidence ' + g.conf + '／price_status ' + g.status + '／price_reason ' + g.reason;
  return g;
}

// 商品ごとのSOLD（「出品作成」の「eBayでSoldを見る」から送られたもの）→ その場で判定し直す
function receiveSoldForPrep_(d, cards) {
  const sh = prepSheet_();
  const parts = String(d.prep).split('-');
  let row = Number(parts[0]);
  const tag = parts[1] || '';
  const ok = rr => { const dt = sh.getRange(rr, P.DATE).getValue(); return dt instanceof Date && String(dt.getTime() % 100000000) === tag; };
  if (!(row >= 2 && row <= sh.getLastRow() && ok(row))) {
    row = 0;
    const last = sh.getLastRow();
    if (last > 1) { const dts = sh.getRange(2, P.DATE, last - 1, 1).getValues(); const i = dts.findIndex(x => x[0] instanceof Date && String(x[0].getTime() % 100000000) === tag); if (i >= 0) row = i + 2; }
  }
  if (!row) return page_('対象の商品が見つかりませんでした', '「出品作成」シートの「eBayでSoldを見る」から開いた画面で押してください。');
  const v = sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0];
  // AIが同じ商品だけを残す（同じ型番・同じ版・日本語版など。ジャンルが同じだけの商品は除外）
  let same = null;
  try {
    const out = parseJson_(claude_(need_('ANTHROPIC_API_KEY'), getSettings_().model,
      'あなたはeBayの価格調査のアシスタントです。売れた出品の中から、仕入れる商品とまったく同じ商品（同じ型番・同じバージョン・同じ版・同じ付属品の範囲）だけを選びます。' +
      '同シリーズの別商品・ジャンルが同じだけの商品・まとめ売り・部品だけは除外。ゲームソフトは日本語版だけ。出力はJSONのみ。',
      '【仕入れる商品】' + v[P.TITLE - 1] + '／' + v[P.NAME - 1] + '／状態：' + v[P.COND - 1] + '\n\n【売れた出品】\n' +
      cards.map((c, i) => i + '. ' + c.title.slice(0, 110) + ' | $' + c.total.toFixed(2)).join('\n') + '\n\n{"same":[同じ商品の番号の配列]}'));
    same = new Set((out.same || []).map(Number));
  } catch (e) {}
  const matched = cards.filter((c, i) => same && same.has(i));
  const keys = new Set(), uniq = [];
  matched.forEach(c => { const k1 = 'id:' + c.id, k2 = c.title.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 40) + '|' + c.total.toFixed(2) + '|' + c.date.toDateString();
    if (keys.has(k1) || keys.has(k2)) return; keys.add(k1); keys.add(k2); uniq.push(c); });
  sh.getRange(row, P.S_JSON).setValue(JSON.stringify(uniq.slice(0, 200).map(c => [Math.round(c.total * 100) / 100, c.date.getTime()])));
  // 判定し直す（状態をいったん戻す）
  if (/PRICE_REVIEW|高値注意|保留/.test(String(v[P.STATUS - 1]))) sh.getRange(row, P.STATUS).setValue('受信');
  const ls = listingSettings_();
  const g = gateCandidate_(sh, row, ls);
  const st = sh.getRange(row, P.S_MED, 1, 7).getValues()[0];
  let msg = '同じ商品のSOLD：読み取った ' + cards.length + '件 → 同じ商品 ' + matched.length + '件 → まとめ買いなどを除いて ' + uniq.length + '件<br>' +
    'sold_median：' + (st[0] !== '' ? '$' + Number(st[0]).toFixed(2) : '—') + '／sold_count：' + st[1] + '／sold_min：' + (st[2] !== '' ? '$' + Number(st[2]).toFixed(2) : '—') +
    '／sold_max：' + (st[3] !== '' ? '$' + Number(st[3]).toFixed(2) : '—') + '／price_confidence：' + st[4] + '<br><b>price_status：' + st[5] + '</b><br>price_reason：' + esc_(st[6]);
  if (g.ok && ls.autoList) {
    try { const id = listRow_(sh, row, ls); msg += '<br><br>🎉 NORMALのため出品しました（eBay商品ID ' + id + '）'; }
    catch (e) { msg += '<br><br>出品でエラー：' + esc_(e.message); }
  } else if (g.ok) msg += '<br><br>✅ 候補になりました。「出品作成」' + row + '行目で確認して出品してください';
  else if (!g.hold && !g.keep) { archiveRejected_(sh, row, g.reason, g.detailText); msg += '<br><br>⏸ 出品しません：' + esc_(g.reason); }
  try { updateBatchResultAfterSold_(tag, g, msg); } catch (e) {}
  return page_(String(st[5] || '判定しました'), esc_(v[P.TITLE - 1] || v[P.NAME - 1]) + '<br><br>' + msg);
}

