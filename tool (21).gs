// 国内の仕入れ先の検索リンク
function sourceLinks_(ja, row) {
  const e = encodeURIComponent(ja);
  const tag = row ? '#ebaytool-rq=' + row : '';
  return [
    ['メルカリ', 'https://jp.mercari.com/search?keyword=' + e + '&status=on_sale' + tag],
    ['駿河屋', 'https://www.suruga-ya.jp/search?search_word=' + e],
    ['Yahoo!フリマ', 'https://paypayfleamarket.yahoo.co.jp/search/' + e + tag],
    ['オフモール', 'https://netmall.hardoff.co.jp/search/?q=' + e],
    ['Amazon', 'https://www.amazon.co.jp/s?k=' + e + tag],
    ['その他（Google）', 'https://www.google.com/search?q=' + e + '+%E4%B8%AD%E5%8F%A4'],
  ].concat(topShops_(3).map(sp => [sp.name, 'https://www.google.com/search?q=site%3A' + encodeURIComponent(sp.domain) + '+' + e]));
}

function researchOne_(sh, row, key, st, off, cs) {
  const v = sh.getRange(row, 1, 1, RQ_HEADERS.length).getValues()[0];
  const kw = String(v[RQ.KW - 1] || '').trim();
  if (!kw) return false;
  const wantNew = String(v[RQ.COND - 1]) === '新品';

  // キーワードから日本語の検索語・種類・日本限定かをAIで判断
  const meta = parseJson_(claude_(key, st.model,
    'あなたはeBay輸出のリサーチのアシスタントです。出力はJSONのみ。',
    'eBayのキーワード：' + kw + '\n次のJSONで答えてください：{"ja_query":"日本の通販・フリマで同じ商品を探すための日本語の検索語（短く）",' +
    '"product_type":"cd / game_soft / game_hw / magazine / other","japan_limited":true または false,"brand":"","model":""}'));
  const ja = String(v[RQ.JA - 1] || meta.ja_query || kw).trim();
  const ptype = normType_(meta.product_type);
  const info = { name_ja: ja, brand: meta.brand || '', model: meta.model || '', features_ja: '', condition: wantNew ? 'new' : 'used',
    search_query_full_en: kw, search_query_en: kw, search_query_short_en: '', product_type: ptype, japan_limited: meta.japan_limited };
  const mk = researchMarket_(key, st, info, '', wantNew ? 1000 : 3000, { kind: 'app', marketplace: 'EBAY_US' }, 'リサーチ候補：' + kw);

  // 勝負できる価格と、利益を残せる仕入れ上限（重さ・外箱は商品の種類の既定値で見積もり）
  const price = mk.low ? Math.round(mk.low * (1 - cs.undercut) * 100) / 100 : '';
  let maxCost = '', method = '';
  if (price) {
    const weight = ptype === 'magazine' ? 600 : ptype === 'game_hw' ? 800 : ptype === 'other' ? cs.weight : 150;
    const box = parseBox_(ptype === 'cd' ? cs.boxCd : /^game/.test(ptype) ? cs.boxGame : cs.boxOther);
    const originRate = cs.zeroDutyTypes.indexOf(ptype) >= 0 ? 0 : off.tariff;
    const plan = bestPlan_(off, cs, '', price, 0, weight, box, originRate);
    if (plan) {
      maxCost = Math.floor(price * off.rate * (1 - plan.f - plan.tRate) - plan.ship - plan.fixed - cs.minProfit);
      method = plan.method;
    }
  }
  let judge;
  const rcfg = research24Settings_();
  if (!mk.matchedCount) judge = 'eBayに出品なし（要確認）';
  else if (price && (price < rcfg.priceMin || price > rcfg.priceMax)) judge = '価格帯外（$' + rcfg.priceMin + '〜$' + rcfg.priceMax + '）';
  else if (maxCost === '' || maxCost < 300) judge = '利益が出にくい';
  else if (mk.jpSellers >= 10) judge = '競争多い';
  else if (mk.jpSellers <= 3 && maxCost >= 1000) judge = '◎ 狙い目';
  else judge = '○ 検討';

  const links = sourceLinks_(ja, row);
  const rich = SpreadsheetApp.newRichTextValue().setText(links.map(l => l[0]).join('　'));
  let pos = 0;
  links.forEach(l => { rich.setLinkUrl(pos, pos + l[0].length, l[1]); pos += l[0].length + 1; });

  sh.getRange(row, RQ.JA, 1, 10).setValues([[ja, TYPE_LABELS[ptype] || 'その他', mk.matchedCount, mk.jpSellers, mk.sellers,
    mk.lowJp || '', mk.low || '', price, maxCost, judge]]);
  sh.getRange(row, RQ.LINKS).setRichTextValue(rich.build());
  sh.getRange(row, RQ.EBAY).setRichTextValue(SpreadsheetApp.newRichTextValue().setText('eBayで見る').setLinkUrl(mk.url).build());
  sh.getRange(row, RQ.SOLDLINK).setRichTextValue(SpreadsheetApp.newRichTextValue().setText('eBayでSoldを見る').setLinkUrl(ebaySoldUrl_(kw, wantNew, row)).build());
  sh.getRange(row, RQ.DATE, 1, 2).setValues([[new Date(), '比べた相手：' + mk.pool + (method ? '／想定の配送：' + method : '') + '／確認した出品 ' + mk.checked + '件']]);
  try { trackSales_(sh, row, v, mk); } catch (e) {}
  const color = /狙い目/.test(judge) ? '#d8f0d8' : /検討/.test(judge) ? '#fff4dc' : '#f4f4f4';
  sh.getRange(row, RQ.JUDGE).setBackground(color);
  return true;
}

function researchQueueRun_(limit) {
  const sh = researchQueueSheet_();
  const last = sh.getLastRow();
  if (last < 2) return { done: 0, hot: 0 };
  const key = need_('ANTHROPIC_API_KEY');
  const st = getSettings_();
  const off = official_();
  const cs = calcSettings_();
  const rows = sh.getRange(2, 1, last - 1, RQ_HEADERS.length).getValues();
  // 調べた日時が古い（未調査を含む）順に
  const order = rows.map((r, i) => {
    const d = r[RQ.DATE - 1] instanceof Date ? r[RQ.DATE - 1].getTime() : 0;
    const sales = Number(r[RQ.SALES - 1]) || 0;
    const dem = String(r[RQ.DEMAND - 1] || '');
    const boost = /激熱/.test(dem) ? 72 : /需要あり/.test(dem) ? 36 : 0;      // Soldで売れている行は早く調べ直す（時間）
    return { i: i, d: d ? d - (Math.min(sales, 20) * 6 + boost) * 3600 * 1000 : 0, kw: String(r[RQ.KW - 1] || '').trim() };
  }).filter(x => x.kw).sort((a, b) => a.d - b.d).slice(0, limit);
  let done = 0;
  const started = Date.now();
  for (const x of order) {
    if (Date.now() - started > 4.5 * 60 * 1000) break;      // 実行時間の上限に余裕を持たせる
    try { if (researchOne_(sh, x.i + 2, key, st, off, cs)) done++; }
    catch (e) { sh.getRange(x.i + 2, RQ.NOTE).setValue('エラー：' + e.message); }
  }
  // 利益が出なさそうな行（利益が出にくい・競争多い・価格帯外・eBayに出品なし）は、「リサーチ見送り」へ移して表示しない
  pruneResearchQueue_(sh);
  const nl = sh.getLastRow();
  const after = nl > 1 ? sh.getRange(2, RQ.JUDGE, nl - 1, 1).getValues().filter(r => /狙い目/.test(String(r[0]))).length : 0;
  return { done: done, hot: after };
}

function researchDaily() {
  if (Z_GH_RESEARCH) return;   // v243：GASの自動リサーチは止める
  try {
    try { expandRelatedKeywords_(5); } catch (e) {}
    const r = researchQueueRun_(30);
    try { findSourcesForHot_(10); } catch (e) {}
