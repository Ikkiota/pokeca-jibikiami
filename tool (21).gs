    src, siteName, method, String(reason || ''), prev instanceof Date ? prev : '未確認', 'https://www.ebay.com/itm/' + itemId, r[LCOL.SKU - 1],
    r[LCOL.MEMO - 1] || '', prepData, JSON.stringify(raw)]);
