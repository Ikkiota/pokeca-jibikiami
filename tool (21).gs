}
// robots.txt（パスと「?」のあとまで見る。v537 のまね）
function zYsRobotsOk_(host, path) {
  const p = PropertiesService.getScriptProperties(), key = 'ZYS_RB_' + host; let rs = null;
  try { const c = JSON.parse(p.getProperty(key) || 'null'); if (c && Date.now() - c.at < 7 * 864e5) rs = c.rs; } catch (e) {}
  if (!rs) { rs = []; let on = false;
    try { const r = UrlFetchApp.fetch('https://' + host + '/robots.txt', { muteHttpExceptions: true, headers: ZYS_UA });
      if (r.getResponseCode() === 200) String(r.getContentText()).split(/\r?\n/).forEach(l => { const t = l.replace(/#.*$/, '').trim(); if (/^user-agent:/i.test(t)) on = /:\s*\*\s*$/.test(t); else if (on && /^(dis)?allow:/i.test(t)) rs.push(t); }); } catch (e) {}
    try { p.setProperty(key, JSON.stringify({ at: Date.now(), rs: rs })); } catch (e) {} }
  let best = null;
  rs.forEach(r => { const m = r.match(/^(dis)?allow:\s*(.*)$/i); if (!m || !m[2].trim()) return; const pat = m[2].trim();
    const rx = new RegExp('^' + pat.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*').replace(/\\\$$/, '$'));
    if (rx.test(path) && (!best || pat.length > best.len)) best = { len: pat.length, allow: !m[1], rule: r }; });
  zYsRobotsOk_._why = best && !best.allow ? best.rule : '';
  return best ? best.allow : true;
}
// 検索ページから品を読む（v546・v549 のまね）
function zYsParse_(site, html) {
