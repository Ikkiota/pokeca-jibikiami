  API_ITEM_ = String(cur[P.SRC - 1] || '');
  // 1) 仕入れ先ページから情報を読み取る
  API_STAGE_ = '商品情報の読み取り';
  const info = parseJson_(claude_(key, st.model,
    'あなたは日本の通販・フリマの商品ページから商品情報を抜き出すアシスタントです。出力はJSONのみ。',
    '仕入れ先URL: ' + (cur[P.SRC - 1] || '') + '\n' + SITE_HINTS +
    '\nページタイトル: ' + (raw.title || '') + '\n表示価格: ' + (raw.price || '') + '\n\nページの文章:\n' + (raw.text || '') +
    '\n\n次のJSONで答えてください:\n{"name_ja":"商品名","price_jpy":数値またはnull,"condition":"new か new_other か used",' +
    '"condition_note_ja":"状態の補足（傷・付属品など）",' +
    '"condition_source_ja":"ページに書かれている商品の状態の説明だけを抜き出す（状態ランク、傷・汚れ・使用感、動作確認、付属品の有無など）。送料・発送方法・発送日数・値下げ交渉・購入前のお願い・あいさつ・ショップの定型文・注意書き・他の商品の情報は入れない。状態の記載がなければ空","brand":"","model":"型番","jan":"JANコード（なければ空）",' +
    '"features_ja":"主な特徴を箇条書きで","search_query_en":"eBayで同じ商品を探す英語の検索語（ブランド・型番・商品の種類、8語以内）",' +
    '"search_query_short_en":"もっと短い英語の検索語（3〜4語）",' +
    '"search_query_full_en":"eBayの出品タイトルのような詳しい英語の検索語（ブランド・限定の種類・キャラクター・商品の種類・サイズなど、10語前後）",' +
    '"japan_limited":"日本限定・日本国内だけで流通する商品なら true（東京ディズニーリゾート限定、日本版のみの商品など）、海外でも普通に売られている商品なら false",' +
    '"identity":{"color":"色（例：ネイビー、赤と白）","pattern":"柄・模様（例：チェック、キャラクター総柄、無地）","design":"デザインの特徴（例：ミッキーの刺繍、ロゴの位置）","size":"サイズ","material":"素材"},' +
    '"weight_g":"梱包込みの推定重量（グラムの数値。ページに重量があれば、それに梱包分として100gほど足す）",' +
    '"origin":"原産国（ページに原産国・生産国・製造国の記載があれば「日本」「中国」などで。書いていなければ「不明」）",' +
    '"product_type":"cd / game_soft / game_hw / magazine / other のどれか（CD・レコード＝cd、ゲームソフト＝game_soft、ゲーム機本体・コントローラー・周辺機器＝game_hw、雑誌・本・漫画＝magazine、それ以外＝other。付録つき雑誌は magazine）"}'));

  const condId = info.condition === 'used' ? 3000 : info.condition === 'new_other' ? 1500 : 1000;
  const jan = String(info.jan || '').replace(/\D/g, '');
  const q = String(info.search_query_en || '').trim();
  const qs = String(info.search_query_short_en || '').trim();

  // 2) eBayで相場を調べる：複数の検索語で最大100件ずつ集め、AIが1件ずつ「同じ商品か」を確認
  // 写真の確認：v105から、梱包サイズの写真分析（全写真）と1回にまとめる。重さ・外箱サイズが入力済みで写真分析をしない商品だけ、ここで確認する
  if (cur[P.WEIGHT - 1] && cur[P.BOX - 1]) try {
    const before = String(cur[P.IMGS - 1] || '').split(/\n+/).map(x => x.trim()).filter(x => /^https?:\/\//.test(x));
    if (before.length) {
      const vr = verifyProductImages_(key, st, info, before);
      sh.getRange(row, P.IMGS).setValue(vr.keep.join('\n'));
      cur[P.IMGS - 1] = vr.keep.join('\n');
      sh.getRange(row, P.IMGSTAT).setValue('写真 ' + vr.keep.length + '枚（仕入れ先のページの順番どおり）' +
        (vr.removed.length ? '／この商品の写真ではないため外した：' + vr.removed.map(x => x.i + 1 + '枚目').join('、') : '') + (vr.note ? '／' + vr.note : ''));
    }
  } catch (e) { sh.getRange(row, P.IMGSTAT).setValue('写真の確認でエラー（写真はそのまま）：' + e.message); }
  info.image = String(cur[P.IMGS - 1] || '').split(/\n+/).map(x => x.trim()).filter(x => /^https?:\/\//.test(x))[0] || '';
  let mk;
  try { mk = researchMarket_(key, st, info, jan, condId, APP, cur[P.SRC - 1]); }
  catch (e) { mk = { items: [], checked: 0, med: 0, low: 0, broadLow: 0 }; }   // v96：相場を取れなくても止めず、最低販売価格で進める
  const items = mk.items;
  const found = items.length > 0;
  const res = { total: mk.checked };
  const totals = items.map(it => it._total).filter(n => n > 0).sort((a, b) => a - b);
  const med = mk.med;
  // v105（D）：どの条件でも利益が出ないと確定したら、ここで止める（写真分析・出品文の作成をしない）
  if (opts && opts.early) {
    const stop = earlyStop_(cur, info, mk);
    if (stop) {
      sh.getRange(row, P.NAME).setValue(info.name_ja || cur[P.NAME - 1] || '');
      sh.getRange(row, P.MED).setValue(med || '');
      sh.getRange(row, P.MIN).setValue(mk.low || '');
      sh.getRange(row, P.STATUS).setValue('見送り（早期判定）');
      return { earlyStop: stop };
    }
  }

  // お手本の出品（同じ商品と確認できた中で一番上のもの）
  let ref = null, catId = '', catPath = '';
  if (found) {
    ref = ebay_('get', '/buy/browse/v1/item/' + encodeURIComponent(items[0].itemId), APP);
    catId = String(ref.categoryId || '');
    catPath = ref.categoryPath || '';
  }
  sh.getRange(row, P.SEARCHURL).setValue(mk.url);
  sh.getRange(row, P.MATCHCNT).setValue(items.length + '件／' + mk.checked + '件');

  // 見つからない場合は、eBayにカテゴリを提案してもらう
  if (!catId) {
    const sq = String(q || qs || info.name_ja || raw.title || '').trim();
    if (!sq) throw new Error('商品ページから商品名を読み取れませんでした。商品ページを開き直して、もう一度「eBayへ送る」を押してください');
    const sug = ebay_('get', '/commerce/taxonomy/v1/category_tree/0/get_category_suggestions?q=' + encodeURIComponent(sq), APP);
    const c = (sug.categorySuggestions || [])[0];
    if (!c) throw new Error('カテゴリを決められませんでした（検索語：' + sq + '）。H列にカテゴリIDを入れて、やり直してください。');
    catId = String(c.category.categoryId);
    catPath = (c.categoryTreeNodeAncestors || []).slice().reverse().map(a => a.categoryName).concat([c.category.categoryName]).join(' > ');
  }

  // カテゴリの仕様項目（必須項目）を取得して、AIに渡す
  let aspectGuide = '';
  let requiredAspects = [];
  try {
    const asp = ebay_('get', '/commerce/taxonomy/v1/category_tree/0/get_item_aspects_for_category?category_id=' + catId, APP);
    requiredAspects = (asp.aspects || []).filter(a => a.aspectConstraint && a.aspectConstraint.aspectRequired).map(a => ({
      name: a.localizedAspectName,
      values: (a.aspectValues || []).map(v => v.localizedValue),
      selectionOnly: a.aspectConstraint.aspectMode === 'SELECTION_ONLY',
    }));
    aspectGuide = aspectGuideText_(asp);
  } catch (e) {}

  // 3) タイトル・説明文・仕様を作る
  let refText;
  if (ref) {
    const aspects = (ref.localizedAspects || []).map(a => a.name + ': ' + a.value).join('\n');
    const refDesc = String(ref.description || ref.shortDescription || '')
      .replace(/<style[\s\S]*?<\/style>/gi, '').replace(/<script[\s\S]*?<\/script>/gi, '')
      .replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').slice(0, 1500);
    refText = '【お手本の出品】\nタイトル: ' + (ref.title || '') + '\nカテゴリ: ' + catPath +
      '\n仕様:\n' + aspects + '\n説明文（抜粋）: ' + refDesc;
  } else {
    refText = '【お手本の出品】\neBayには同じ商品の出品がありません。仕入れ先の情報だけで作成してください。\nカテゴリ: ' + catPath;
  }

  API_STAGE_ = '出品文の作成';
  const listing = parseJson_(claude_(key, st.model,
    'あなたはeBayで日本から海外へ販売するセラーの出品文を作るアシスタントです。出力はJSONのみ。\n' +
    '- お手本の出品がある場合は「構成・よく使われるキーワード・仕様項目」の参考にするだけ。文章をそのまま写さず、自分の言葉で書き直す。\n' +
    '- 仕入れ先の情報と矛盾することは書かない。分からないことは書かない。\n' +
    '- タイトルは英語で80文字以内。ブランド・型番・商品の種類など検索されやすい語を前の方に。eBayに同じ商品がない場合は、海外のバイヤーが検索しそうな一般的な英語の言葉を使う。\n' +
    '- overview_en：商品の特徴を英語の短い箇条書きで3〜8個（商品名・シリーズ・型番・付属品・サイズ・日本版であることなど、確かなことだけ）。\n' +
    '- condition_en：仕入れ先の condition_source_ja（状態の説明）だけを、意味を変えずに英語にする。送料・発送・値下げ・購入前のお願い・あいさつ・定型文・注意書きは入れない。追加・誇張しない。状態の記載がなければ空。1000文字以内。\n' +
    '- specifics：このカテゴリの仕様項目を、分かるものはできるだけすべて埋める（必須・推奨だけでなく任意の項目も）。仕入れ先の情報や商品の一般的な事実で確かなものだけ。推測で間違った値は入れない。選択肢がある項目は選択肢から選ぶ。\n' +
    '- セラーのルール（発送・返品など）に従う:\n' + st.rules,
    '【仕入れ先の情報】\n' + JSON.stringify(info) + '\n\n' + refText +
    (aspectGuide ? '\n\n【このカテゴリの仕様項目】\n' + aspectGuide +
      '\n[必須]の項目は必ず入れる。分からない必須項目は、Brandなら "Unbranded"、それ以外は "Does not apply" とする。選択肢がある項目は選択肢から選ぶ。' : '') +
    '\n\n次のJSONで答えてください:\n{"title_en":"","overview_en":["",""],"condition_en":"","specifics":{"項目名（英語）":"値（英語）"}}'));

  const title = String(listing.title_en || '').slice(0, 80);
  listing.specifics = fillRequiredAspects_(listing.specifics || {}, requiredAspects, info);
  const specsText = Object.keys(listing.specifics || {}).map(k => k + ': ' + listing.specifics[k]).join('\n');

  // 4) シートに書き込み
  const set = (c, v) => sh.getRange(row, c).setValue(v);
  set(P.NAME, info.name_ja || cur[P.NAME - 1]);
  // 楽天市場は送料別のことがあるので、送料込みで読み取った金額を優先
  const isRakuten = /item\.rakuten\.co\.jp/.test(String(cur[P.SRC - 1] || ''));
  if (Number(info.price_jpy) > 0 && (!cur[P.COST - 1] || isRakuten)) set(P.COST, Number(info.price_jpy));
  if (!(Number(sh.getRange(row, P.COST).getValue()) > 0)) {
    const guess = guessYen_(String(raw.price || '') + '\n' + String(raw.text || '').slice(0, 3000));
    if (guess > 0) { set(P.COST, guess); cur[P.NOTE - 1] = '仕入れ値はページの文章から推定（' + guess.toLocaleString() + '円）。違っていたらD列を直してください'; }
  }
  const condOk = validCondition_(catId, condId, APP);
  set(P.COND, CONDITIONS.find(c => c.startsWith(String(condOk))) || String(condOk));
  sh.getRange(row, P.COND).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(CONDITIONS).build());
  set(P.REF, found ? (ref.itemWebUrl || items[0].itemWebUrl || '') : '（eBayに同じ商品なし）');
  sh.getRange(row, P.CAT).setNumberFormat('@').setValue(catId);
  set(P.CNT, items.length);
  set(P.MIN, mk.low || '');
  set(P.BLOW, mk.broadLow || '');
  set(P.ACTLIST, JSON.stringify((mk.items || []).map(it => Math.round(it._total * 100) / 100).sort((a, b) => a - b).slice(0, 150)));
  try {
    const dt = sh.getRange(row, P.DATE).getValue();
    const tag = row + '-' + (dt instanceof Date ? dt.getTime() % 100000000 : 0);
    const kwSold = String(info.search_query_full_en || info.search_query_en || '').trim();
    if (kwSold) sh.getRange(row, P.S_LINK).setRichTextValue(SpreadsheetApp.newRichTextValue().setText('eBayでSoldを見る')
      .setLinkUrl(ebaySoldUrl_(kwSold, condId < 3000, 0).replace(/#.*$/, '') + '#ebaytool-prep=' + tag).build());
  } catch (e) {}
  set(P.LOW2, (mk.items || []).length >= 2 ? Math.round(mk.items.map(it => it._total).sort((a, b) => a - b)[1] * 100) / 100 : '');
  set(P.MED, med);
  // 正式計算式＋関税・梱包・外箱：使う配送方法の中で一番利益が出る方法で計算
  const off = official_();
  const cs = calcSettings_();
  const ptype = normType_(cur[P.PTYPE - 1] || info.product_type);
  const pkg = (cur[P.WEIGHT - 1] && cur[P.BOX - 1]) ? null : packagingFromPhotos_(key, st, info, cur, ptype, cs);
  if (pkg) sh.getRange(row, P.PKGNOTE).setValue(pkg.note);
  if (pkg) sh.getRange(row, P.IMGSTAT).setValue(pkg.photoErr ? '写真の確認でエラー（写真はそのまま）：' + pkg.photoErr :
    '写真 ' + pkg.photos + '枚を確認（仕入れ先のページの順番どおり）' + (pkg.suspect && pkg.suspect.length ? '／AIが「この商品の写真ではないかも」と判断：' + pkg.suspect.map(n => n + '枚目').join('、') + '（外さずに残しています）' : ''));
  const weight0 = Number(cur[P.WEIGHT - 1]) || (pkg ? pkg.weight : 0) || Number(info.weight_g) || cs.weight;
  const weight = Number(cur[P.WEIGHT - 1]) ? weight0 : zMeasuredWeight_(catId, weight0);   // v114：梱包の実測で重いほうに補正（F249 オンのとき）
  const boxText = String(cur[P.BOX - 1] || '') || (pkg ? pkg.box : '') || (ptype === 'cd' ? cs.boxCd : /^game/.test(ptype) ? cs.boxGame : cs.boxOther);
  const box = parseBox_(boxText);
  const originText = String(cur[P.ORIGIN - 1] || info.origin || '不明');
  const isJapan = /日本|japan/i.test(originText);
  const isUnknown = !isJapan && /不明|unknown|^$/i.test(originText);
  const zeroDuty = (isJapan || isUnknown) && cs.zeroDutyTypes.indexOf(ptype) >= 0;
  const originRate = zeroDuty ? 0 : (isJapan || isUnknown ? off.tariff : cs.foreignRate);
  const costNow = Number(sh.getRange(row, P.COST).getValue()) || 0;
  const priceEst = Number(med) || 50;
  const plan = bestPlan_(off, cs, catId, priceEst, costNow, weight, box, originRate);
  const plans = allPlans_(off, cs, catId, priceEst, costNow, weight, box, originRate);
  sh.getRange(row, P.PLANS).setValue(JSON.stringify(plans));
  set(P.SHIP, plan ? plan.ship : '');
  sh.getRange(row, P.WEIGHT).setValue(weight);
  sh.getRange(row, P.FRATE).setValue(plan ? plan.f : feeRate_(off, catId, priceEst, cs.method));
  sh.getRange(row, P.FX).setValue(off.rate);
  sh.getRange(row, P.ORIGIN).setValue(originText);
  sh.getRange(row, P.TRATE).setValue(plan ? plan.tRate : originRate);
  sh.getRange(row, P.FIXED).setValue(plan ? plan.fixed : cs.pack);
  sh.getRange(row, P.METHOD).setValue(plan ? plan.method : '送れる方法なし');
  sh.getRange(row, P.BOX).setValue(boxText);
  sh.getRange(row, P.PTYPE).setValue(TYPE_LABELS[ptype] || 'その他')
    .setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(Object.keys(TYPE_LABELS).map(k => TYPE_LABELS[k])).build());
  const S = "'設定'!";
  const rr = String(row);
  sh.getRange(row, P.PPRICE).setFormula('=IF(OR(D' + rr + '="",L' + rr + '=""),"",ROUND((D' + rr + '+L' + rr + '+N(AG' + rr + ')+' + S + '$F$29)/((1-AB' + rr + '-N(AF' + rr + '))*AC' + rr + '),2))');
  sh.getRange(row, P.PROFIT).setFormula('=IF(OR(N' + rr + '="",D' + rr + '=""),"",ROUND(N' + rr + '*AC' + rr + '*(1-AB' + rr + '-N(AF' + rr + '))-D' + rr + '-N(L' + rr + ')-N(AG' + rr + '),0))');
  sh.getRange(row, P.RATE).setFormula('=IF(O' + rr + '="","",O' + rr + '/(N' + rr + '*AC' + rr + '))');
  sh.getRange(row, P.REFUND).setFormula('=IF(O' + rr + '="","",ROUND(O' + rr + '+D' + rr + '/11,0))');
  // 内訳（文章）と、確認用の数式
  sh.getRange(row, P.SHIPTXT, 1, 4).setValues([[plan ? plan.shipText : '送れる配送方法がありません', plan ? plan.fixedText : '',
    plan ? plan.feeText : '', plan ? plan.dutyText + '（原産国：' + originText + '・種類：' + (TYPE_LABELS[ptype] || 'その他') + '）' : '']]);
  sh.getRange(row, P.BD_SALES, 1, 5).setFormulas([[
    '=IF(N' + rr + '="","",ROUND(N' + rr + '*AC' + rr + ',0))',
    '=IF(N' + rr + '="","",ROUND(N' + rr + '*AC' + rr + '*AB' + rr + ',0))',
    '=IF(N' + rr + '="","",ROUND(N' + rr + '*AC' + rr + '*N(AF' + rr + '),0))',
    '=IF(OR(J' + rr + '="",D' + rr + '=""),"",ROUND(J' + rr + '*(1-' + S + '$F$33)*AC' + rr + '*(1-AB' + rr + '-N(AF' + rr + '))-D' + rr + '-N(L' + rr + ')-N(AG' + rr + '),0))',
    '=IF(OR(K' + rr + '="",D' + rr + '=""),"",ROUND(K' + rr + '*(1-' + S + '$B$16/100)*AC' + rr + '*(1-AB' + rr + '-N(AF' + rr + '))-D' + rr + '-N(L' + rr + ')-N(AG' + rr + '),0))']]);
  const shipR = { yen: plan ? plan.ship : null };
  set(P.TITLE, title);
  set(P.DESC, buildDescription_(title, listing.overview_en || [], condLabel_(sh.getRange(row, P.COND).getValue()), listing.condition_en || ''));
  set(P.CONDNOTE, String(listing.condition_en || '').slice(0, 1000));
  set(P.SPECS, specsText);
  if (cur[P.QTY - 1] === '') set(P.QTY, 1);
  sh.getRange(row, P.JAN).setNumberFormat('@').setValue(jan);
  set(P.STATUS, '準備完了（価格を決めてください）');
  set(P.NOTE, [found ? '' : 'eBayに同じ商品がないため、価格は利益重視の価格',
    isUnknown ? '原産国不明（日本製として関税を計算）' : '',
    shipR.yen === null ? '重さ・サイズがどの配送方法にも合いません' : ''].filter(x => x).join('／'));

  return esc_(title) + '<br>' + (found
    ? '勝負できる最安値：$' + (mk.low === '' ? '—' : mk.low.toFixed(2)) + '／相場の中央値：$' + (med === '' ? '—' : med.toFixed(2)) +
      '（比べた相手：' + esc_(mk.pool) + '、' + items.length + '件／確認した ' + mk.checked + '件）<br>' +
      '<a href="' + esc_(mk.url) + '" target="_blank">eBayで検索結果を見る</a>'
    : 'eBayに同じ商品はありませんでした（カテゴリ：' + esc_(catPath) + '）');
}

/* ---------- 出品 ---------- */
function listCheckedItems() {
  run_(() => {
    const sh = prepSheet_();
    const last = sh.getLastRow();
    if (last < 2) throw new Error('「出品作成」シートに商品がありません');
    const ls = listingSettings_();
    const data = sh.getRange(2, 1, last - 1, PREP_HEADERS.length).getValues();
    let ok = 0, ng = 0;
    data.forEach((r, i) => {
      if (r[P.GO - 1] !== true || r[P.STATUS - 1] === '出品済み') return;
      const row = i + 2;
      MANUAL_LIST_ = true;   // v143：あなたが押した出品は、出品停止中でも出す
      try { listRow_(sh, row, ls); ok++; }
      catch (e) { sh.getRange(row, P.NOTE).setValue(e.message); sh.getRange(row, P.GO).setValue(false); ng++; }
    });
    if (!ok && !ng) throw new Error('「出品する」にチェックが入っている行がありません');
    return '出品 ' + ok + '件' + (ng ? '、エラー ' + ng + '件（メモ列を確認してください）' : '');
  });
}

// ルールで価格を決めて、利益が出るなら出品
// 利益が出るかを判定し、出るなら販売価格（N列）を入れる。出ないなら ok:false
//  相場あり：相場の中央値から値引きした価格で、目標利益率以上なら候補
//  相場なし：目標利益率が取れる価格で候補（需要は未確認）
function gateCandidate_(sh, row, ls) {
  SpreadsheetApp.flush();
  const r = sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0];
  const cs = calcSettings_();
  let cost = Number(r[P.COST - 1]); const med = Number(r[P.MED - 1]), low = Number(r[P.MIN - 1]);
  const fx = Number(r[P.FX - 1]) || ls.rate;
  const minProfit = cs.minProfit;
  const bad = reason => ({ ok: false, reason: reason });
  if (!(cost > 0)) { try { const y = zSentCost_(sh, row, r); if (y > 0) cost = y; } catch (e) {} }   // v214：値段が読めなかった品は、商品ページの文から仕入れ値を補う（Yahoo!フリマの「○○円送料無料」も）
  if (!(cost > 0)) {
    sh.getRange(row, P.STATUS).setValue('エラー（準備）');
    sh.getRange(row, P.NOTE).setValue('仕入れ値を読み取れませんでした。D列に仕入れ値（円）を入れて、「受信した商品を準備（やり直し）」を押してください');
    return { ok: false, keep: true, reason: '仕入れ値を読み取れませんでした。「出品作成」シート ' + row + '行目のD列に仕入れ値を入れて、「出品管理」→「受信した商品を準備（やり直し）」を押してください' };
  }
  let plans = {};
  try { plans = JSON.parse(r[P.PLANS - 1] || '{}'); } catch (e) {}
  // 以前の行（計算条件の保存前）は、行に入っている配送方法だけで判定
  if (!Object.keys(plans).length && r[P.SHIP - 1] !== '') {
    plans[String(r[P.METHOD - 1] || '選択中')] = { method: String(r[P.METHOD - 1] || '選択中'), f: Number(r[P.FRATE - 1]) || ls.fee / 100,
      tRate: Number(r[P.TRATE - 1]) || 0, ship: Number(r[P.SHIP - 1]) || 0, fixed: Number(r[P.FIXED - 1]) || 0 };
  }
  const order = cs.prefer.filter(m => plans[m]).concat(Object.keys(plans).filter(m => cs.prefer.indexOf(m) < 0 && cs.methods.indexOf(m) >= 0));
  if (!order.length) return bad('重さ・外箱サイズが、使う配送方法のどれにも合いませんでした');
  const r2 = x => Math.round(x * 100) / 100;
  const profitAt = (pl, price) => Math.round(price * fx * (1 - pl.f - pl.tRate) - cost - pl.ship - pl.fixed);
  const needOf = pl => (cost + pl.ship + pl.fixed + minProfit) / (1 - pl.f - pl.tRate) / fx;

  // ① 最低利益を計算する：発送方法ごとに「利益を維持できる最低販売価格」→ 一番安くできる方法（差が$0.50以内なら優先順）
  const pr = priceRuleSettings_();
  const mins = order.map((m, i) => ({ m: m, i: i, v: Math.ceil(needOf(plans[m]) * 100) / 100 }));
  let best = mins.slice().sort((a, b) => (a.v - b.v > 0.5 ? 1 : b.v - a.v > 0.5 ? -1 : a.i - b.i))[0];
  // v115：$50 未満は SpeedPAK Economy、$50 以上は FedEx便（「追加の設定」F264・F266）
  const forced = zShipPick_(plans, needOf, low, med);
  if (forced) { const fm = mins.find(x => x.m === forced); if (fm) best = fm; }
  const m = best.m, pl = plans[m], minPrice = best.v;
  const low2 = Number(r[P.LOW2 - 1]) || 0;
  const blow = Number(r[P.BLOW - 1]) || 0;

  // 結果を行に書き込む（共通）
  const write = (price, judge, status) => {
    sh.getRange(row, P.SHIP).setValue(pl.ship);
    sh.getRange(row, P.FRATE).setValue(pl.f);
    sh.getRange(row, P.TRATE).setValue(pl.tRate);
    sh.getRange(row, P.FIXED).setValue(pl.fixed);
    sh.getRange(row, P.METHOD).setValue(m);
    sh.getRange(row, P.METHODLABEL).setValue(shipMethodLabel_(m).ja);
    if (pl.shipText) sh.getRange(row, P.SHIPTXT, 1, 4).setValues([[pl.shipText, pl.fixedText || '', pl.feeText || '', r[P.DUTYTXT - 1] || pl.dutyText || '']]);
    sh.getRange(row, P.PRICE).setValue(price);
    sh.getRange(row, P.PR_ECO).setValue(plans['エコノミー'] ? profitAt(plans['エコノミー'], price) : '');
    sh.getRange(row, P.PR_AIR).setValue(plans['エアパケ(US)'] ? profitAt(plans['エアパケ(US)'], price) : '');
    sh.getRange(row, P.MINPRICE).setValue(minPrice);
    sh.getRange(row, P.DIFF).setValue(cmpLow > 0 ? r2(price - cmpLow) : '');
    sh.getRange(row, P.PJUDGE).setValue(judge);
    sh.getRange(row, P.STATUS).setValue(status);
  };
  let soldTxt = '';
  const report = (price, judge, warn) => {
    const profit = profitAt(pl, price);
    const lines = [
      '仕入れ価格：' + cost.toLocaleString() + '円',
      '発送方法：' + shipMethodLabel_(m).ja,
      '送料：' + Math.round(pl.ship).toLocaleString() + '円（梱包・通関など ' + Math.round(pl.fixed).toLocaleString() + '円は別）',
      '最低利益：' + minProfit.toLocaleString() + '円',
      '利益を維持できる最低販売価格：$' + minPrice.toFixed(2),
      'eBay全体の最安値：' + (blow > 0 ? '$' + blow.toFixed(2) : 'なし'),
      'eBay最安値（同じ状態・日本語版などに絞った競合）：' + (low > 0 ? '$' + low.toFixed(2) : 'なし') + (low2 > 0 ? '（2番目 $' + low2.toFixed(2) + '）' : ''),
      '出品中の中央値（参考）：' + (med > 0 ? '$' + med.toFixed(2) : 'なし'),
      'Sold相場：' + (soldTxt || 'データ不足'),
      '推奨販売価格：$' + price.toFixed(2),
      '競争価格との差額：' + (cmpLow > 0 ? (price - cmpLow >= 0 ? '+' : '−') + '$' + Math.abs(price - cmpLow).toFixed(2) + '（Sold相場の範囲内の出品中価格と比べて）' : '—（採用できる競争価格なし）'),
      '想定利益：' + profit.toLocaleString() + '円',
      '判定：' + judge + (warn ? '（' + warn + '）' : ''),
    ];
    return { profit: profit, text: lines.join('／') };
  };

  // 対象の価格帯（$40〜$500）より安い商品は出品しない（高すぎる場合は「高値注意」で人が判断）
  const rc = research24Settings_();

  // 価格判定ルール（Sold優先）：Soldの中央値・分布から現実的な市場価格を出し、Sold相場の範囲内の出品中価格だけを競争価格に使う
  let cmpLow = 0;
  let actList = [];
  try { actList = JSON.parse(r[P.ACTLIST - 1] || '[]').map(Number).filter(n => n > 0); } catch (e) {}
  const act = { low: low, low2: low2, med: med, count: Number(r[P.CNT - 1]) || 0, list: actList };
  const sd = soldDataForRow_(r);
  const lad = soldFirstPrice_(minPrice, sd, act, cs.undercut);
  const judge = lad.step;
  let price = lad.price;
  if (lad.cmp) cmpLow = lad.cmp;
  const so = lad.sold;
  if (so) soldTxt = '中央値 $' + so.median.toFixed(2) + '（' + so.count + '件・外れ値 ' + so.removed + '件を除外・分布 $' + so.min.toFixed(2) + '〜$' + so.max.toFixed(2) +
    '・中央の半分 $' + so.p25.toFixed(2) + '〜$' + so.p75.toFixed(2) + '・出どころ：' + (sd.level === '商品' ? 'この商品のSold検索' : sd.level === 'キーワード' ? 'リサーチ候補のキーワードのSold検索' : '取り込み済みの' + sd.level + 'のSold') + '）';
  if (price < rc.priceMin && lad.status === 'NORMAL' && !ZSENT_) return { ok: false, reason: '見送り：推奨販売価格 $' + price.toFixed(2) + ' が対象の価格帯（$' + rc.priceMin + '〜）より安いため' };
  let status = lad.status;
  let reason = lad.reason;
  if (status === 'NORMAL' && price > rc.priceMax) { status = 'PRICE_REVIEW'; reason = '推奨販売価格が対象の価格帯（〜$' + rc.priceMax + '）を超えています'; }
  // v208：あなたが送った品は、相場との倍率・データ不足では見送り・保留にしない。最低利益（設定 F29）と利益率（追加の設定 F303）を守る値段で出品する
  if (ZSENT_ && !(price > rc.priceMax)) {
    const was = status;
    if (status !== 'NORMAL') { status = 'NORMAL'; price = Math.max(price, minPrice); reason = '送った品のため出品（もとの判定：' + (was === 'HOLD' ? '判定保留' : was) + (reason ? '・' + reason : '') + '）'; }
    if (price < rc.priceMin) { price = rc.priceMin; reason = (reason ? reason + '／' : '') + '価格帯の下限 $' + rc.priceMin + ' にした'; }
    { const p5 = zFloorUsd_(cost + pl.ship + pl.fixed, 1 - pl.f - pl.tRate, 0, fx); if (isFinite(p5) && p5 > price) { price = Math.round(p5 * 100) / 100; reason = (reason ? reason + '／' : '') + '利益率 ' + zMinRate_(price * fx) + '％になる値段 $' + price.toFixed(2) + ' に上げた'; } }   // v210：売値で利益率が変わる
    if (price > rc.priceMax) { status = 'PRICE_REVIEW'; reason = '推奨販売価格が対象の価格帯（〜$' + rc.priceMax + '）を超えています'; }
  }
  write(price, (ZSENT_ ? '【送った品】' : '') + judge, status === 'NORMAL' ? '候補（利益OK）' : status === 'HOLD' ? '判定保留（Soldデータ不足）' : status === 'PRICE_REVIEW' ? 'PRICE_REVIEW（要確認）' : 'DO_NOT_LIST');
  let rp = report(price, judge, status === 'NORMAL' ? '' : reason);
  // v214：送った品は、配送方法の違いなどで利益率・最低利益が少し足りないときも、見送らずに値段を少し上げて出品する
  if (ZSENT_ && status === 'NORMAL') for (let k = 0; k < 5; k++) {
    const r0 = rp.profit / (price * fx) * 100, m0 = zMinRate_(price * fx);
    if (r0 >= m0 && rp.profit >= minProfit) break;
    const up = Math.max((m0 - r0) / 100, (minProfit - rp.profit) / (price * fx), 0) + 0.01;
    price = Math.ceil(price * (1 + up) * 100) / 100;
    if (price > rc.priceMax) break;
    reason = (reason ? reason + '／' : '') + '利益率・最低利益を守るため $' + price.toFixed(2) + ' に上げた';
    write(price, '【送った品】' + judge, '候補（利益OK）');
    rp = report(price, judge, '');
  }
  // 8項目（suggested_price〜price_reason）
  const conf = lad.conf || '低';
  const stLabel = status === 'HOLD' ? '判定保留' : status;
  sh.getRange(row, P.S_MED, 1, 7).setValues([[so ? so.median : '', so ? so.count : 0, so ? so.min : '', so ? so.max : '', conf, stLabel, reason]]);
  sh.getRange(row, P.S_STATUS).setBackground(status === 'NORMAL' ? '#d8f0d8' : status === 'PRICE_REVIEW' || status === 'HOLD' ? '#fef7e0' : '#f8d0d0');
  const eight = 'suggested_price $' + price.toFixed(2) + '／根拠：' + lad.basis + '／price_confidence ' + conf + '／price_status ' + stLabel + '／price_reason ' + reason;
  sh.getRange(row, P.NOTE).setValue(rp.text + '／' + eight);
  if (status === 'DO_NOT_LIST') return { ok: false, reason: 'DO_NOT_LIST：' + reason + '／' + rp.text };
  if (status === 'HOLD') return { ok: false, hold: true, reason: '判定保留：' + reason + '／' + rp.text, price: price };
  if (status === 'PRICE_REVIEW') return { ok: false, hold: true, reason: 'PRICE_REVIEW：' + reason + '／' + rp.text, price: price };
  { const rate0 = rp.profit / (price * fx) * 100, mr = zMinRate_(price * fx); if (rate0 < mr) return { ok: false, reason: '見送り：利益率 ' + rate0.toFixed(1) + '％（' + mr + '％未満）／' + rp.text }; }   // v188：最低利益 1,500円 かつ 利益率 5％以上
  return { ok: true, price: price, profit: rp.profit, rate: rp.profit / (price * fx), summary: rp.text + '／' + eight };
}

/* =====================================================================
 * 価格判定ルール（Sold優先）
 *  1. 現在のActive最安値だけを基準にしない
 *  2. Soldデータ（同じ商品のSold・90日）を最優先する
 *  3. Sold Priceの中央値・価格分布（最小・最大・中央の半分）を確認する
 *  4. 相場から大きく離れた単発価格は外れ値として除外する（robustStats_）
 *  5. Active最安値がSold相場から大きく乖離している場合（設定F104）、その最安値を競争価格として採用しない
 *  6. 仕入れ価格・送料・eBay手数料・広告率5.1%・関税等を考慮した最低販売価格（minPrice）で利益を守る
 *  7. 最低利益を下回る価格は販売価格候補から除外する
 *  8. 他セラーが赤字であると断定しない（「当社のコスト構造では成立しない価格」と表現する）
 *  9. 最安値ではなく、実売データと価格分布から現実的な市場価格（Sold中央値）を算出する
 * 10. 判断に十分なSoldデータがない場合は「判定保留」とする
 * ===================================================================== */
function soldDist_(list) {
  const st = robustStats_(list || []);
  if (!st) return null;
  const a = (list || []).filter(n => n > 0).sort((x, y) => x - y).filter(x => x >= st.min && x <= st.max);
  const q = t => { const pos = (a.length - 1) * t, lo = Math.floor(pos), hi = Math.ceil(pos); return a[lo] + (a[hi] - a[lo]) * (pos - lo); };
  const r2 = x => Math.round(x * 100) / 100;
  return Object.assign({}, st, { p25: r2(q(0.25)), p75: r2(q(0.75)) });
}

function soldFirstPrice_(minPrice, sd, act, undercut) {
  const rule = soldRuleSettings_();
  const r2 = x => Math.round(x * 100) / 100;
  const so = soldDist_(sd && sd.list);
  const actRaw = (act.list && act.list.length ? act.list : [act.low, act.low2].filter(x => x > 0)).slice().sort((a, b) => a - b);
  const base = { low: actRaw[0] || 0, low2: actRaw[1] || 0, med: act.med || 0, n: actRaw.length, sold: so, conf: '低', cmp: 0 };
  const out = o => Object.assign({}, base, o);
  const soldTxt = so ? 'Sold ' + so.count + '件（中央値 $' + so.median.toFixed(2) + '・$' + so.min.toFixed(2) + '〜$' + so.max.toFixed(2) + (so.removed ? '・外れ値 ' + so.removed + '件除外' : '') + '）' : 'Sold不足';

  // Soldが足りない：F102がオフなら、保留にせず出品中の価格で判定（v91）
  if ((!so || so.count < rule.minCount) && !rule.holdIfNoSold) return activeOnlyPrice_(minPrice, actRaw, act, undercut, so, rule);
  // 10. Soldが足りない → 判定保留（F102がオンのとき）
  if (!so || so.count < rule.minCount) {
    return out({ status: 'HOLD', price: minPrice, step: '判定保留：Soldデータ不足',
      basis: soldTxt + '／出品中の価格は参考のみ',
      reason: '判断に十分なSoldデータがありません（外れ値を除いて ' + (so ? so.count : 0) + '件／必要 ' + rule.minCount + '件）。' +
        '「出品作成」シートの「eBayでSoldを見る」→「Soldを送る」でSoldを取り込むと、自動で判定し直します' });
  }
  base.conf = so.count >= 8 && sd.level === '商品' ? '高' : so.count >= 8 || sd.level === '商品' ? '中' : '低';

  // 9. 現実的な市場価格＝Sold中央値（外れ値を除いたあと）
  const market = so.median;

  // 5. 出品中の価格のうち、Sold相場から大きく乖離していないものだけを競争価格に使う
  const band = market * (1 - rule.actGap);
  const valid = actRaw.filter(x => x >= band);
  const dropped = actRaw.filter(x => x < band);
  const under = valid.filter(x => r2(x * (1 - undercut)) < minPrice);     // 当社の最低利益価格より安い出品
  const usable = valid.filter(x => r2(x * (1 - undercut)) >= minPrice);   // 最低利益を守ったまま並べる出品
  const comp = valid.length ? valid[0] : 0;                              // v94：Sold相場の範囲内の競合最安値
  const notes = [];
  if (dropped.length) notes.push('出品中の最安値 $' + dropped[0].toFixed(2) + (dropped.length > 1 ? ' など' + dropped.length + '件' : '') +
    'は、Sold中央値から' + Math.round(rule.actGap * 100) + '%以上離れているため、競争価格として採用しません');

  // 市場価格の候補：Sold中央値。Sold相場の範囲内に、より安い出品中の価格があれば、その少し下
  // 最低利益を守りながら、可能な限り競合最安値を狙う（競合より安くできれば安く。最低販売価格は絶対に下回らない）
  // 競合がいないときも高値売りはしない → 最低販売価格（Sold中央値を超える場合は下の判定へ）
  let target = Math.min(market, minPrice), step = '最低販売価格（競合なし・高値売りしない）';
  if (comp > 0) { target = r2(Math.min(market, comp * (1 - undercut))); step = '競合最安値の少し下'; }
  if (comp > 0 && target < minPrice && minPrice <= market) {
    return out({ status: 'NORMAL', price: minPrice, step: '最低販売価格（競合最安値には合わせない）', cmp: comp,
      basis: soldTxt + '／出品中 ' + actRaw.length + '件（競合最安値 $' + comp.toFixed(2) + '）',
      reason: '競合最安値 $' + comp.toFixed(2) + ' まで下げると最低利益を下回るため合わせず、最低販売価格 $' + minPrice.toFixed(2) + ' を維持します（Sold中央値 $' + market.toFixed(2) + ' の範囲内）' +
        (dropped.length ? '。出品中の最安値 $' + dropped[0].toFixed(2) + ' はSold相場から大きく離れているため、競合として採用していません' : '') });
  }

  // 7・8. 最低利益を下回る価格は候補から外す（「当社のコスト構造では成立しない価格」。他セラーが赤字とは断定しない）
  if (under.length) notes.push('出品中の $' + under[0].toFixed(2) + (under.length > 1 ? ' など' + under.length + '件' : '') + ' は当社のコスト構造では成立しない価格のため、販売価格候補から除外しました');
  const basis = soldTxt + '／出品中 ' + actRaw.length + '件（Sold相場の範囲内 ' + valid.length + '件' + (comp ? '・競合最安値 $' + comp.toFixed(2) : '') + '）';
  const tail = notes.length ? '。' + notes.join('。') : '';

  if (target >= minPrice) {
    return out({ status: 'NORMAL', price: r2(target), step: step, cmp: comp, basis: basis,
      reason: '推奨 $' + r2(target).toFixed(2) + '：' + (comp ? '競合最安値 $' + comp.toFixed(2) + ' の少し下' : '比べられる競合がいないため、高値にせず最低販売価格') + '（最低販売価格 $' + minPrice.toFixed(2) + '・Sold中央値 $' + market.toFixed(2) + '）' + tail });
  }

  // 最低利益を守る価格（minPrice）がSold相場とどれだけ離れているか
  const ratio = minPrice / market;
  const pctTxt = Math.round(ratio * 100) + '%';
  if ((minPrice > so.max && ratio > zMktX_()) || ratio > rule.dnl) {   // v258：相場の1.4倍までは、Soldの最高値をこえても出す
    return out({ status: 'DO_NOT_LIST', price: minPrice, step: '出品しない：当社のコスト構造では成立しない価格帯', cmp: comp, basis: basis,
      reason: '最低利益を守る価格 $' + minPrice.toFixed(2) + ' は Sold中央値 $' + market.toFixed(2) + ' の ' + pctTxt + '（Sold最高 $' + so.max.toFixed(2) + '）。' +
        'この商品の実売価格帯は、当社のコスト構造では成立しない価格です' + tail });
  }
  if (ratio > rule.review) {
    return out({ status: 'PRICE_REVIEW', price: minPrice, step: '要確認：最低利益価格がSold中央値より高い', cmp: comp, basis: basis,
      reason: '最低利益を守る価格 $' + minPrice.toFixed(2) + ' は Sold中央値 $' + market.toFixed(2) + ' の ' + pctTxt + '（' + Math.round(rule.review * 100) + '〜' + Math.round(rule.dnl * 100) + '%）。Soldの範囲内ですが高めのため確認してください' + tail });
  }
  return out({ status: 'NORMAL', price: minPrice, step: '最低利益価格（Sold相場の範囲内）', cmp: comp, basis: basis,
    reason: 'Sold相場に合わせた価格では最低利益を割るため、最低利益を守る価格 $' + minPrice.toFixed(2) + '（Sold中央値の ' + pctTxt + '・Soldの範囲内）にします' + tail });
}

/* =====================================================================
 * v91：Soldを確認できないときの判定（保留にせず、出品中の価格で決める）
 *  ・出品中の同じ商品の価格から外れ値を除き、その中央値を市場価格の目安にする（最安値だけでは決めない）
 *  ・中央値以下で、最低利益を守れる一番安い競合の少し下に合わせる
 *  ・最低利益を下回る価格は候補から除外（「当社のコスト構造では成立しない価格」）
 *  ・出品中の同じ商品もない → 最低利益を守る価格で出品
 *  ・最低利益を守る価格が中央値の150%（F100）を超え、データが3件以上 → 出品しない
 * ===================================================================== */
function activeOnlyPrice_(minPrice, actRaw, act, undercut, so, rule) {
  const r2 = x => Math.round(x * 100) / 100;
  const rs = actRaw.length ? robustStats_(actRaw) : null;
  const kept = rs ? actRaw.filter(x => x >= rs.min && x <= rs.max) : [];
  const n = kept.length;
  const med = rs ? rs.median : 0;
  const base = { low: kept[0] || 0, low2: kept[1] || 0, med: med, n: n, sold: null, conf: '低', cmp: 0 };
  const out = o => Object.assign({}, base, o);
  const soldNote = 'Sold未確認（' + (so ? so.count : 0) + '件）';
  const basis = soldNote + '／出品中 ' + actRaw.length + '件' + (rs && rs.removed ? '（外れ値 ' + rs.removed + '件を除外）' : '') + (med ? '・中央値 $' + med.toFixed(2) : '');
  if (!n) return out({ status: 'NORMAL', price: minPrice, step: '最低販売価格（競合なし・高値売りしない）', basis: basis,
    reason: '比べられる競合がいないため、高値にせず最低販売価格 $' + minPrice.toFixed(2) + ' にします' });
  const usable = kept.filter(x => r2(x * (1 - undercut)) >= minPrice);
  const under = kept.filter(x => r2(x * (1 - undercut)) < minPrice);
  const tail = under.length ? '。出品中の $' + under[0].toFixed(2) + (under.length > 1 ? ' など' + under.length + '件' : '') + ' は当社のコスト構造では成立しない価格のため、販売価格候補から除外しました' : '';
  if (med >= minPrice) {
    // 最低利益を守りながら、可能な限り競合最安値を狙う
    const comp = kept[0];
    const c = r2(comp * (1 - undercut));
    const price = r2(Math.max(minPrice, Math.min(med, c)));
    return out({ status: 'NORMAL', price: price, step: c >= minPrice ? '競合最安値の少し下' : '最低販売価格（競合最安値には合わせない）', cmp: comp, basis: basis,
      reason: soldNote + '。競合最安値 $' + comp.toFixed(2) + (c >= minPrice ? ' の少し下 $' + price.toFixed(2) + ' で、最低利益を確保できます' :
        ' まで下げると最低利益を下回るため合わせず、最低販売価格 $' + minPrice.toFixed(2) + ' を維持します') + '（出品中の中央値 $' + med.toFixed(2) + '）' + tail });
  }
  const ratio = minPrice / med, pctTxt = Math.round(ratio * 100) + '%';
  if (ratio > rule.dnl && n >= 3) return out({ status: 'DO_NOT_LIST', price: minPrice, step: '出品しない：当社のコスト構造では成立しない価格帯', basis: basis,
    reason: '最低利益を守る価格 $' + minPrice.toFixed(2) + ' は、出品中の中央値 $' + med.toFixed(2) + ' の ' + pctTxt + '（出品中 ' + n + '件）。この商品の価格帯は、当社のコスト構造では成立しない価格です' + tail });
  return out({ status: 'NORMAL', price: minPrice, step: '最低利益価格', basis: basis,
    reason: soldNote + 'のため出品中の価格を参考にしました。中央値 $' + med.toFixed(2) + ' では最低利益を割るため、最低利益を守る価格 $' + minPrice.toFixed(2) + '（中央値の ' + pctTxt + '）で出品します' + tail });
}

/* =====================================================================
 * 価格のはしご（最安値 → 2番手 → 中央値）
 *  ・それぞれの価格の少し下（設定F33の%）で、最低利益を確保できる最初の段を選ぶ（最低販売価格より下にはしない）
 *  ・中央値：同じ商品のSOLDが足りていればSOLD中央値、なければ出品中の中央値
 *  ・中央値でも最低利益を確保できない → 少しだけ上なら PRICE_REVIEW、大きく離れていれば DO_NOT_LIST
 *  ・根拠（同じ商品のSOLD・出品中の競合）が足りない → PRICE_REVIEW
 *  ・SOLDが足りない商品は保留（設定F102がオンのとき）
 *  ・提案価格がSOLD中央値の120%（F99）を超えるなら PRICE_REVIEW
 * ===================================================================== */
function ladderPrice_(minPrice, act, sold, undercut) {
  const r2 = x => Math.round(x * 100) / 100;
  // 出品中の同じ商品の価格：極端に高い・安い出品を除いて、最安値・2番手・中央値（参考値）を出す
  const raw = (act.list && act.list.length ? act.list : [act.low, act.low2].filter(x => x > 0)).slice().sort((a, b) => a - b);
  const rs = raw.length ? robustStats_(raw) : null;
  const kept = rs ? raw.filter(x => x >= rs.min && x <= rs.max) : raw;
  const n = kept.length;
  const low = n ? kept[0] : 0, low2 = n >= 2 ? kept[1] : 0;
  const med = rs ? rs.median : (act.med || 0);
  // 信頼度（SOLDがないので最大「中」）：件数と、価格の散らばり（中央値が最安値の1.6倍を超えると偏り）
  const skewed = low > 0 && med > low * 1.6;
  const reliable = n >= 5 && !skewed;
  const conf = n >= 5 && !skewed ? '中' : '低';
  const base = { low: low, low2: low2, med: med, n: n, conf: conf };
  const out = o => Object.assign({}, base, o);

  if (!n) return out({ status: 'PRICE_REVIEW', price: minPrice, step: '保留：相場データなし', cmp: 0, reason: 'eBayに出品中の同じ商品が見つからないため、価格の根拠がありません' });

  // ①〜③ 最安値 → 2番手 → 中央値（参考値）
  const steps = [{ name: '最安値', v: low }];
  if (low2 > 0) steps.push({ name: '2番手', v: low2 });
  if (med > 0 && n >= 3) steps.push({ name: '中央値（参考値）', v: med });
  for (const st of steps) {
    if (st.v >= minPrice) {
      const price = r2(Math.max(minPrice, st.v * (1 - undercut)));
      if (n < 3) return out({ status: 'PRICE_REVIEW', price: price, step: st.name + 'を狙う', cmp: st.v,
        reason: st.name + '（$' + st.v.toFixed(2) + '）で最低利益は確保できますが、出品中の同じ商品が ' + n + '件しかなく、価格の根拠が弱いため保留します' });
      return out({ status: 'NORMAL', price: price, step: st.name + 'を狙う', cmp: st.v, reason: st.name + '（$' + st.v.toFixed(2) + '）の少し下で、最低利益を確保できます' + (reliable ? '' : '（データが少ない・偏りがあるため信頼度は低）') });
    }
  }

  // ④ 最低利益価格が中央値（参考値）を超える
  const ref = n >= 3 ? med : low2 || low;
  const ratio = minPrice / ref;
  const pctTxt = Math.round(ratio * 100) + '%';
  const refTxt = (n >= 3 ? '中央値（参考値）' : '出品中の価格') + ' $' + ref.toFixed(2);
  if (ratio <= 1.2) return out({ status: n >= 3 ? 'NORMAL' : 'PRICE_REVIEW', price: minPrice, step: '通常候補（最低利益価格）', cmp: ref,
    reason: '最低利益価格 $' + minPrice.toFixed(2) + ' は ' + refTxt + ' の ' + pctTxt + '（120%以内）' + (n >= 3 ? '' : '。ただし出品中の同じ商品が少ないため保留') });
  if (ratio <= 1.5) return out({ status: reliable ? 'NORMAL' : 'PRICE_REVIEW', price: minPrice, step: '条件付き候補（最低利益価格）', cmp: ref,
    reason: '最低利益価格 $' + minPrice.toFixed(2) + ' は ' + refTxt + ' の ' + pctTxt + '（120〜150%）。' +
      (reliable ? 'データが十分（' + n + '件・偏りなし）なので出品します' : 'データが少ない・偏りがあるため保留します') });
  if (ratio <= 1.8 || !reliable) return out({ status: 'PRICE_REVIEW', price: minPrice, step: '保留（最低利益価格が相場より高い）', cmp: ref,
    reason: '最低利益価格 $' + minPrice.toFixed(2) + ' は ' + refTxt + ' の ' + pctTxt + (ratio <= 1.8 ? '（150〜180%）' : '（180%以上ですが、データが少ない・偏りがあるため倍率だけで見送りにしません）') });
  return out({ status: 'DO_NOT_LIST', price: minPrice, step: '出品しない：相場から大きく離れている', cmp: ref,
    reason: '最低利益価格 $' + minPrice.toFixed(2) + ' は ' + refTxt + ' の ' + pctTxt + '（180%以上・データ ' + n + '件で偏りなし）。現実的な市場価格から大きく離れています' });
}

// 価格設定ルールの設定
function priceRuleSettings_() {
  const s = sheet_('設定');
  if (s.getRange('E90').getValue() === '') {
    s.getRange('E89').setValue('■ 価格設定ルール（最低利益を守りながら最安値を狙う）').setFontWeight('bold');
    s.getRange('E90:E91').setValues([['「最安値を取れる（A）」とみなす幅（最安値からこの%以内）'], ['「高値注意（D）」とみなす基準（最安値・中央値の高いほうより何%高いか）']]).setFontWeight('bold');
    s.getRange('F90').setValue(0.03).setNumberFormat('0%').setBackground('#fff4dc');
    s.getRange('F91').setValue(0.3).setNumberFormat('0%').setBackground('#fff4dc');
    s.getRange('E92').setValue('推奨販売価格＝利益を維持できる最低販売価格（最低利益は設定F29）。A・B・Cは自動出品の対象、Dは値下げせず「高値注意」で止めます。')
      .setFontColor('#777777').setWrap(true);
  }
  const v = s.getRange('F90:F91').getValues().map(r => r[0]);
  return { nearPct: v[0] === '' ? 0.03 : pct_(v[0]), highPct: v[1] === '' ? 0.3 : pct_(v[1]) };
}

