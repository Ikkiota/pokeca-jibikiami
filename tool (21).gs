function repriceOne_(lsh, lrow, lv, prepMap, key, st, off, cs, pr, me) {
  const itemId = String(lv[LCOL.ID - 1]);
  API_ITEM_ = '価格の見直し・' + itemId;
  const log = repriceSheet_();
  const base = [new Date(), '', itemId, lv[LCOL.TITLE - 1], Number(lv[LCOL.PRICE - 1]) || '', '', '', '', '', cs.minProfit, '', '', '', '', '', '', '', ''];
  const stamp = () => Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm');
  const finish = (code, res, memo, api) => {
    base[1] = res; base[15] = memo || ''; base[16] = code; base[17] = api || '';
    log.appendRow(base);
    const lr = log.getLastRow();
    log.getRange(lr, 3).setNumberFormat('@');
    log.getRange(lr, 17).setBackground(code === 'PRICE_UPDATED' ? '#d8f0d8' : code === 'PRICE_UPDATE_FAILED' ? '#f8d0d0' : code === 'PRICE_UPDATE_SKIPPED' ? '#fef7e0' : '#f4f4f4');
    lsh.getRange(lrow, LCOL.MEMO).setValue('価格の見直し：' + res + '（' + stamp() + '）');
    return res;
  };
  const skip = why => finish('PRICE_UPDATE_SKIPPED', '変更しない（データ不足）', why);

  // 必要なデータ（仕入れ価格・発送方法・重さ・送料の計算条件）。足りなければ変更しない
  const pv = prepMap[itemId];
  if (!pv) return skip('仕入れ価格・発送方法・重さの記録がない出品です（ツール以外で出品した商品など）。最低利益を確かめられないため、価格は変更しません');
  const cost = Number(pv[P.COST - 1]);
  let plans = {};
  try { plans = JSON.parse(pv[P.PLANS - 1] || '{}'); } catch (e) {}
  const weight = Number(pv[P.WEIGHT - 1]) || 0, box = parseBox_(pv[P.BOX - 1]);
  const missing = [!(cost > 0) ? '仕入れ価格' : '', !Object.keys(plans).length ? '発送方法・送料の計算条件' : '', !(weight > 0) ? '重さ' : ''].filter(x => x);
  if (missing.length) return skip(missing.join('・') + 'がないため、最低利益を確かめられません');
  base[6] = cost;

  // 1) eBayの今の価格・状態
  let cur = 0;
  try {
    const it = trading_('GetItem', '<ItemID>' + x_(itemId) + '</ItemID><DetailLevel>ReturnAll</DetailLevel>');
    const item = it.root.getChild('Item', it.ns);
    const status = item.getChild('SellingStatus', it.ns);
    if (!status || status.getChildText('ListingStatus', it.ns) !== 'Active') return finish('NO_CHANGE', '対象外', '出品中ではありません');
    cur = Number(status.getChildText('CurrentPrice', it.ns)) || 0;
  } catch (e) { return skip('eBayから現在価格を取得できませんでした（' + e.message + '）'); }
  if (!(cur > 0)) return skip('現在価格を取得できませんでした');
  base[4] = cur;

  // 2) 発送方法ごとの最低販売価格（今の燃油サーチャージ・為替で送料を計算し直す）
  const fx = off.rate, minProfit = cs.minProfit;
  if (!(fx > 0) || !(minProfit > 0)) return skip('為替レートまたは最低利益の設定を読み取れませんでした');
  const order = cs.prefer.filter(m => plans[m]).concat(Object.keys(plans).filter(m => cs.prefer.indexOf(m) < 0 && cs.methods.indexOf(m) >= 0));
  const live = order.map((m, i) => {
    const sr = shipYen_(off, m, weight, cur, box);
    if (sr.yen === null) return null;
    const pl = Object.assign({}, plans[m], { ship: Math.round(sr.yen) });
    const keep = 1 - pl.f - pl.tRate;
    return keep > 0 ? { m: m, i: i, pl: pl, minPrice: Math.ceil((cost + pl.ship + pl.fixed + minProfit) / keep / fx * 100) / 100 } : null;
  }).filter(x => x);
  if (!live.length) return skip('使える発送方法の送料を計算できませんでした');
  const best = live.slice().sort((a, b) => (a.minPrice - b.minPrice > 0.5 ? 1 : b.minPrice - a.minPrice > 0.5 ? -1 : a.i - b.i))[0];
  const profitAt = price => Math.round(price * fx * (1 - best.pl.f - best.pl.tRate) - cost - best.pl.ship - best.pl.fixed);
  base[7] = shipMethodLabel_(best.m).ja; base[8] = best.pl.ship;

  // 3) 競合（自分の出品は除く）・類似商品の価格
  let raw = {}; try { raw = JSON.parse(pv[P.RAW - 1] || '{}'); } catch (e) {}
  const info = { name_ja: pv[P.NAME - 1], brand: '', model: '', features_ja: '', condition: parseInt(pv[P.COND - 1], 10) >= 3000 ? 'used' : 'new',
    search_query_full_en: String(pv[P.TITLE - 1] || ''), search_query_en: String(pv[P.TITLE - 1] || '').split(/\s+/).slice(0, 8).join(' '), search_query_short_en: '',
    product_type: normType_(pv[P.PTYPE - 1]), japan_limited: false, excludeSeller: me, excludeItemId: itemId, light: true };
  let mk = {};
  try { mk = researchMarket_(key, st, info, String(pv[P.JAN - 1] || '').replace(/\D/g, ''), parseInt(pv[P.COND - 1], 10) || 3000, { kind: 'app', marketplace: 'EBAY_US' }, 'price-review:' + itemId); }
  catch (e) { mk = { error: e.message }; }
  base[11] = mk.broadLow || ''; base[12] = mk.low || ''; base[13] = mk.med || '';
  const items = (mk.items || []).map(x => x._total).filter(x => x > 0).sort((a, b) => a - b);
  const sold = soldDataForRow_(pv);
  const noMarket = !items.length && !(mk.low > 0) && !(sold.list || []).length;

  // 4) 推奨価格（新規出品と同じエンジン）
  let rec, stepTxt, lad = null;
  if (noMarket) {
    // 競合がいない（または取得できなかった）：高値売りはしない → 最低販売価格（変更前に安全チェックで最低利益を確認）
    rec = best.minPrice; stepTxt = '最低販売価格（競合なし・高値売りしない）';
  } else {
    lad = soldFirstPrice_(best.minPrice, sold, { low: Number(mk.low) || 0, low2: items[1] || 0, med: Number(mk.med) || 0, count: items.length, list: items }, cs.undercut);
    rec = Math.max(best.minPrice, Math.round(lad.price * 100) / 100);
    stepTxt = lad.step + '（' + (lad.status === 'HOLD' ? '判定保留' : lad.status) + '）';
    if (lad.cmp) base[12] = lad.cmp;
  }
  rec = Math.round(rec * 100) / 100;
  base[5] = rec; base[14] = stepTxt;
  const tol = Math.max(0.5, cur * 0.01);

  // 5) 現在価格と推奨価格を比べて、変更が必要か判定
  let next = null, why = '';
  if (cur < best.minPrice) {                                                       // ケースD：最低利益を割っている → 値上げ
    next = rec; why = '今の価格 $' + cur.toFixed(2) + ' では最低利益を下回るため、値上げ';
  } else if (cur > rec + tol) {                                                     // ケースC：高すぎる → 値下げ
    if (lad && lad.status === 'HOLD') return skip('Soldデータが足りず、値下げの根拠が不十分なため変更しません（' + lad.reason + '）');
    next = rec; why = '今の価格が推奨価格より高いため、値下げ（' + stepTxt + '）';
  } else {
    return finish('NO_CHANGE', '変更なし', cur <= rec + tol && cur >= best.minPrice ? '今の価格 $' + cur.toFixed(2) + ' は最低販売価格 $' + best.minPrice.toFixed(2) + ' 以上で、推奨価格 $' + rec.toFixed(2) + ' 以下のため、そのまま' : '');
  }

  // 6) 安全チェック（変更直前）
  const after = profitAt(next);
  base[10] = after;
  const checks = [itemId ? '' : '商品ID', cur > 0 ? '' : '現在価格', next > 0 ? '' : '新価格', cost > 0 ? '' : '仕入れ価格', best.pl.ship >= 0 ? '' : '送料', minProfit > 0 ? '' : '最低利益'].filter(x => x);
  if (checks.length) return skip('安全チェック：' + checks.join('・') + 'がそろっていません');
  if (!(after >= minProfit)) return finish('PRICE_UPDATE_SKIPPED', '変更しない（安全チェック）', '変更後の想定利益 ' + after.toLocaleString() + '円が最低利益 ' + minProfit.toLocaleString() + '円を下回るため（新価格 $' + next.toFixed(2) + '）');
  if (Math.abs(next - cur) < 0.01) return finish('NO_CHANGE', '変更なし', '今の価格と同じ');

  // 7) eBayで価格を変更（結果を必ず記録）
  let ack = '';
  try {
    const out = trading_('ReviseInventoryStatus', '<InventoryStatus><ItemID>' + x_(itemId) + '</ItemID><StartPrice>' + next.toFixed(2) + '</StartPrice></InventoryStatus>');
    ack = (out && out.root ? out.root.getChildText('Ack', out.ns) : '') || 'Success';
  } catch (e) {
    return finish('PRICE_UPDATE_FAILED', '❌ 変更失敗', '変更予定 $' + next.toFixed(2) + '／' + why, 'エラー：' + e.message);
  }
  lsh.getRange(lrow, LCOL.PRICE).setValue(next);
  const prep = ss_().getSheetByName('出品作成');
  if (prep && pv._row) prep.getRange(pv._row, P.PRICE).setValue(next);
  return finish('PRICE_UPDATED', next < cur ? '⬇ 値下げ' : '⬆ 値上げ', '$' + cur.toFixed(2) + ' → $' + next.toFixed(2) + '／' + why + '／最低販売価格 $' + best.minPrice.toFixed(2), 'eBay：' + ack);
}

function repriceRun_(limit) {
  const lsh = ss_().getSheetByName('出品一覧');
  if (!lsh || lsh.getLastRow() < 2) return { done: 0 };
  const key = need_('ANTHROPIC_API_KEY');
  const st = getSettings_(), off = official_(), cs = calcSettings_(), pr = priceRuleSettings_(), me = myUsername_();
  const prep = ss_().getSheetByName('出品作成');
  const prepMap = {};
  if (prep && prep.getLastRow() > 1) prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues().forEach((v, i) => {
    if (v[P.ITEMID - 1]) { v._row = i + 2; prepMap[String(v[P.ITEMID - 1])] = v; } });
  const rows = lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues();
  // 最後に見直してから時間がたった順（メモの日時で判断）。在庫0は対象外
  const order = rows.map((v, i) => ({ v: v, row: i + 2, t: (String(v[LCOL.MEMO - 1]).match(/価格の見直し.*?（(\d\d)\/(\d\d) (\d\d):(\d\d)）/) || []) }))
    .filter(x => x.v[LCOL.ID - 1] && Number(x.v[LCOL.QTY - 1]) > 0)
    .map(x => ({ v: x.v, row: x.row, k: x.t.length ? Number(x.t[1] + x.t[2] + x.t[3] + x.t[4]) : 0 }))
    .sort((a, b) => a.k - b.k).slice(0, limit);
  let done = 0, changed = 0;
  const started = Date.now();
  for (const x of order) {
    if (Date.now() - started > 4.5 * 60 * 1000) break;
    try { const r = repriceOne_(lsh, x.row, x.v, prepMap, key, st, off, cs, pr, me); done++; if (/値下げ|値上げ/.test(r)) changed++; }
    catch (e) { repriceSheet_().appendRow([new Date(), '❌ エラー', x.v[LCOL.ID - 1], x.v[LCOL.TITLE - 1], x.v[LCOL.PRICE - 1], '', '', '', '', cs.minProfit, '', '', '', '', '', '', 'PRICE_UPDATE_FAILED', 'エラー：' + e.message]); done++; }
  }
  return { done: done, changed: changed };
}

function repriceAuto() {
  if (zGhCareOn_()) return;   // v246：GitHub がする
  const p = PropertiesService.getScriptProperties();
  const today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd');
  let c = {}; try { c = JSON.parse(p.getProperty('REPRICE_COUNT') || '{}'); } catch (e) {}
  if (c.d !== today) c = { d: today, n: 0 };
  const perDay = Number(sheet_('設定').getRange('F95').getValue()) || 100;
  if (c.n >= perDay) return;
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return;
  try { const r = repriceRun_(Math.min(10, perDay - c.n)); c.n += r.done; p.setProperty('REPRICE_COUNT', JSON.stringify(c)); }
  finally { lock.releaseLock(); }
}

