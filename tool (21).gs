// ページの文章から、それらしい販売価格を探す（「¥3,000」「3,000円」「価格：3000」など）
function guessYen_(text) {
  const t = String(text || '').replace(/[０-９]/g, c => String.fromCharCode(c.charCodeAt(0) - 0xFEE0));
  const cand = [];
  const re = /(?:[¥￥]\s*([\d,]{3,9}))|(?:([\d,]{3,9})\s*円)|(?:(?:価格|販売価格|税込)[：:\s]*([\d,]{3,9}))/g;
  let m;
  while ((m = re.exec(t)) !== null) {
    const n = Number(String(m[1] || m[2] || m[3]).replace(/,/g, ''));
    if (n >= 100 && n <= 3000000) cand.push({ n: n, pos: m.index });
    if (cand.length > 20) break;
  }
  if (!cand.length) return 0;
  // 送料・ポイントの記載を避けるため、最初に出てくる金額を採用
  return cand[0].n;
}


// 価格（最安値・中央値）× 配送方法ごとの、詳しい計算
function calcDetails_(plans, order, tries, cost, fx, minProfit, needOf) {
  const y = x => Math.round(x).toLocaleString() + '円';
  const textBlocks = [], rows = [];
  tries.forEach(t => {
    order.forEach(m => {
      const pl = plans[m];
      const sales = t.price * fx, fee = sales * pl.f, duty = sales * pl.tRate;
      const profit = Math.round(sales - fee - duty - cost - pl.ship - pl.fixed);
      const label = (t.basis.indexOf('最安値で勝負') === 0 ? '最安値の1%下' : '中央値狙い') + ' $' + t.price.toFixed(2) + '・' + m;
      textBlocks.push('【' + label + '】\n' +
        '売上　　：$' + t.price.toFixed(2) + ' × ' + fx.toFixed(2) + '円 ＝ ' + y(sales) + '\n' +
        '手数料　：' + y(sales) + ' × ' + (pl.f * 100).toFixed(2) + '% ＝ −' + y(fee) + (pl.feeText ? '（' + pl.feeText + '）' : '') + '\n' +
        '関税　　：' + y(sales) + ' × ' + (pl.tRate * 100).toFixed(2) + '% ＝ −' + y(duty) + (pl.dutyText ? '（' + pl.dutyText + '）' : '') + '\n' +
        '送料　　：−' + y(pl.ship) + (pl.shipText ? '（' + pl.shipText + '）' : '') + '\n' +
        '固定費　：−' + y(pl.fixed) + (pl.fixedText ? '（' + pl.fixedText + '）' : '') + '\n' +
        '仕入れ値：−' + y(cost) + '\n' +
        '利益　　：' + y(profit) + (profit >= minProfit ? ' ✅' : ' ❌（' + minProfit.toLocaleString() + '円に' + (minProfit - profit).toLocaleString() + '円不足）'));
      rows.push([label, y(sales), '−' + y(fee) + '<br><small>' + esc_(pl.feeText || '') + '</small>', '−' + y(duty) + '<br><small>' + esc_(pl.dutyText || '') + '</small>',
        '−' + y(pl.ship) + '<br><small>' + esc_(pl.shipText || '') + '</small>', '−' + y(pl.fixed) + '<br><small>' + esc_(pl.fixedText || '') + '</small>',
        '−' + y(cost), '<b style="color:' + (profit >= minProfit ? '#188038' : '#d93025') + '">' + y(profit) + '</b>']);
    });
  });
  const needs = order.map(m => m + '：$' + needOf(plans[m]).toFixed(2)).join('、');
  const text = '■ 計算の詳細（利益 ＝ 売上 − 手数料 − 関税 − 送料 − 固定費 − 仕入れ値）\n\n' + textBlocks.join('\n\n') +
    '\n\n■ 利益' + minProfit.toLocaleString() + '円を残すのに必要な価格：' + needs;
  const th = ['価格・配送方法', '売上', '手数料', '関税', '送料', '固定費', '仕入れ値', '利益'];
  const html = '<div style="font-size:13px"><b>計算の詳細</b>（利益 ＝ 売上 − 手数料 − 関税 − 送料 − 固定費 − 仕入れ値）' +
    '<div style="overflow-x:auto"><table border="1" cellpadding="5" style="border-collapse:collapse;margin-top:6px;min-width:760px">' +
    '<tr style="background:#eef">' + th.map(h => '<th>' + h + '</th>').join('') + '</tr>' +
    rows.map(r => '<tr>' + r.map((c, i) => '<td style="vertical-align:top' + (i ? ';text-align:right' : '') + '">' + c + '</td>').join('') + '</tr>').join('') +
    '</table></div><p>利益' + minProfit.toLocaleString() + '円を残すのに必要な価格：' + esc_(needs) + '</p></div>';
  return { text: text, html: html };
}


// 画像つきでClaudeに質問する
function claudeContent_(key, model, system, content) {
  apiBudgetCheck_();
  const res = UrlFetchApp.fetch('https://api.anthropic.com/v1/messages', {
    method: 'post',
    contentType: 'application/json',
    headers: { 'x-api-key': key, 'anthropic-version': '2023-06-01' },
    payload: JSON.stringify(apiBody_({ model: model, max_tokens: 1500, system: system, messages: [{ role: 'user', content: content }] })),
    muteHttpExceptions: true,
  });
  const j = JSON.parse(res.getContentText() || '{}');
  apiRecord_(model, j.usage, res.getResponseCode(), content.filter(c => c.type === 'image').length);
  if (res.getResponseCode() !== 200) throw new Error('Claude API：' + (j.error ? j.error.message : res.getContentText()));
  return (j.content || []).filter(b => b.type === 'text').map(b => b.text).join('\n');
}

// 出品データ（色・柄などの項目）と画像を、仕入れる商品と見比べて「まったく同じ」ものだけを返す
function visualSameCheck_(key, st, info, items) {
  if (!items.length) return new Set();
  const details = items.map(it => {
    let aspects = '', img = (it.image && it.image.imageUrl) || '';
    try {
      const d = ebay_('get', '/buy/browse/v1/item/' + encodeURIComponent(it.itemId), { kind: 'app', marketplace: 'EBAY_US' });
      aspects = (d.localizedAspects || []).filter(a => /color|colour|pattern|theme|character|style|size|material|design|model|features/i.test(a.name))
        .map(a => a.name + ': ' + a.value).join(' / ');
      img = (d.image && d.image.imageUrl) || img;
    } catch (e) {}
    img = String(img).replace(/\/s-l\d+(\.\w+)(\?.*)?$/, '/s-l500$1');   // v107：比較用の画像は500pxで十分（トークンを節約）
    return { it: it, aspects: aspects, img: img };
  });
  const keep = new Set();
  const intro = '仕入れる商品と、eBayの出品を見比べて、色・柄・デザイン・サイズ・種類が「まったく同じ商品」だけを選んでください。' +
    '少しでも色・柄・デザインが違うもの、別のバリエーション、別のキャラクター、別のサイズは除外。状態（中古の傷など）の違いは気にしない。出力はJSONのみ。\n' +
    '【仕入れる商品】' + JSON.stringify({ name: info.name_ja, brand: info.brand, model: info.model, identity: info.identity || {}, features: info.features_ja });
  // 6件ずつまとめて確認
  for (let b = 0; b < details.length; b += 6) {
    const batch = details.slice(b, b + 6);
    const content = [{ type: 'text', text: intro }];
    if (info.image) { content.push({ type: 'text', text: '仕入れる商品の画像：' }); content.push({ type: 'image', source: { type: 'url', url: info.image } }); }
    batch.forEach((d, i) => {
      content.push({ type: 'text', text: '出品' + i + '：' + String(d.it.title || '').slice(0, 120) + (d.aspects ? '（' + d.aspects + '）' : '') });
      if (d.img) content.push({ type: 'image', source: { type: 'url', url: d.img } });
    });
    content.push({ type: 'text', text: '次のJSONで答えてください：{"same":[まったく同じ商品の出品番号の配列]}' });
    try {
      const out = parseJson_(claudeContent_(key, st.model, 'あなたはeBayの相場調査で、商品の同一性を画像で確認するアシスタントです。', content));
      (out.same || []).map(Number).forEach(i => { if (batch[i]) keep.add(batch[i].it.itemId); });
    } catch (e) {
      // 画像で確認できなかったとき（画像が読めないなど）は、この6件はタイトルの判定のまま残す
      batch.forEach(d => keep.add(d.it.itemId));
    }
  }
  return keep;
}


