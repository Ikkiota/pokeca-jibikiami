/* v198：「検索結果を送る」は受け付けてすぐ返す（待たない）。判定は裏で順番に（1分後から自動・0円）
 *  受け付けた検索結果は「フリマの判定待ち」シート（隠し）に1行ずつ入れ、zFleaQueueJob が上から判定して消す */
const FQ_SHEET = 'フリマの判定待ち';
function zFleaQueueSheet_() { const ss = ss_(); let sh = ss.getSheetByName(FQ_SHEET); if (!sh) { sh = ss.insertSheet(FQ_SHEET); sh.getRange(1, 1, 1, 3).setValues([['受け付けた日時', '検索語', 'データ（自動）']]); try { sh.hideSheet(); } catch (e) {} } return sh; }
function zFleaEnqueue_(d, items) {
  const sh = zFleaQueueSheet_(), lk = LockService.getScriptLock(); try { lk.waitLock(20000); } catch (e) {}
  try { sh.appendRow([new Date(), String(d.keyword || ''), JSON.stringify({ d: { site: d.site, keyword: d.keyword, url: d.url }, items: items.slice(0, 150) }).slice(0, 49000)]); } finally { try { lk.releaseLock(); } catch (e) {} }
  try { if (!ScriptApp.getProjectTriggers().some(t => t.getHandlerFunction() === 'zFleaQueueJob')) ScriptApp.newTrigger('zFleaQueueJob').timeBased().after(60 * 1000).create(); } catch (e) {}
  const waiting = Math.max(0, sh.getLastRow() - 1);
  return quickPage_('✅ 受け付けました（裏で判定します）', esc_(d.site + '「' + String(d.keyword || '').slice(0, 40) + '」の ' + items.length + '品') + '<br>判定待ち：' + waiting + '件。1分後から自動で判定して、利益が出る品を「出品候補（0円）」に入れます。<br>このタブは閉じて、次のタブへどうぞ。');
}
function zFleaQueueJob() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'zFleaQueueJob').forEach(t => ScriptApp.deleteTrigger(t));
  zTimed_('zFleaQueueJob', () => {
    const sh = zFleaQueueSheet_(), t0 = Date.now(); let done = 0;
    while (Date.now() - t0 < 4 * 60 * 1000 && (!ZB_DEADLINE_ || Date.now() < ZB_DEADLINE_) && sh.getLastRow() > 1) {
      if (!ZB_MANUAL_ && zTimeLeft_() < 5 * 60) { zLogOnce_('時間の節約', 'フリマの判定待ちは、今日の動作時間が残り少ないので明日に回す（「フリマの判定待ち」シートに残っています）'); return; }
      const v = sh.getRange(2, 1, 1, 3).getValues()[0]; sh.deleteRow(2);
      try { const o = JSON.parse(String(v[2] || '{}')); if (o.d && o.items) zReceiveCardSearch_(o.d, o.items); done++; } catch (e) { zLog_('フリマの検索結果（0円）', '判定できなかった：' + v[1] + '：' + e.message); }
    }
    if (sh.getLastRow() > 1) { try { ScriptApp.newTrigger('zFleaQueueJob').timeBased().after(60 * 1000).create(); } catch (e) {} }
  });
}

