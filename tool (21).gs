const SR = { DATE: 1, RQROW: 2, KW: 3, SITE: 4, TITLE: 5, PRICE: 6, SOLD: 7, SAME: 8, CAP: 9, VERDICT: 10, URL: 11, GO: 12, SENT: 13, THUMB: 14 };
const SR_HEADERS = ['取得日時', 'リサーチ候補の行', 'キーワード', 'サイト', '商品名', '価格（円）', '売り切れ', '同じ商品か（AI）', '仕入れ上限（円）', '判定', '商品ページ', '仕入れ候補へ送る', '送った', 'サムネイル'];

function searchResultSheet_() {
  const ss = ss_();
  let sh = ss.getSheetByName('仕入れ先の検索結果');
  if (sh) return sh;
  sh = ss.insertSheet('仕入れ先の検索結果', 2);
  sh.setTabColor('#e37400');
  sh.getRange(1, 1, 1, SR_HEADERS.length).setValues([SR_HEADERS]).setFontWeight('bold').setBackground('#e8f0f2').setWrap(true);
  [110, 70, 220, 90, 360, 80, 60, 90, 90, 150, 110, 80, 60, 10].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(1);
  sh.hideColumns(SR.THUMB);
  return sh;
}

function receiveSearch_(d) {
  const items = (d.items || []).filter(x => x && x.url);
  if (!items.length) return page_('読み取れませんでした', '検索結果の商品がありませんでした。');
  try { if (zIsCardSearch_(d, items)) return d.auto ? zReceiveCardSearch_(d, items) : zFleaEnqueue_(d, items); } /* v204：まとめて開いたタブ（自動で閉じる）はその場で判定する＝ Google の1日の時間に数えない。ふつうのタブは裏で */ catch (e) { zLog_('フリマの検索結果（0円）', 'エラー：' + e.message); }   // v137：ポケカは AI なしで判定・v198：受け付けてすぐ返し、判定は裏で
  const rq = researchQueueSheet_();
  const rqLast = rq.getLastRow();
  // どのリサーチ候補の検索か（リンクの印 → 日本語の検索語が同じ行）
  let rqRow = 0, rv = null;
  if (d.rq >= 2 && d.rq <= rqLast) { rqRow = d.rq; }
  else if (rqLast > 1 && d.keyword) {
    const ja = rq.getRange(2, RQ.JA, rqLast - 1, 1).getValues().map(r => String(r[0]).trim());
    const i = ja.indexOf(String(d.keyword).trim());
    if (i >= 0) rqRow = i + 2;
  }
  // リサーチ候補に無い検索：その場でリサーチ候補を作り、eBayの相場を調べて仕入れ上限を出す
  let autoRq = '';
  if (!rqRow && d.keyword) {
    try { rqRow = researchFromSourceKeyword_(String(d.keyword)); autoRq = '「リサーチ候補」に自動で追加して、eBayの相場を調べました。'; }
    catch (e) { autoRq = '仕入れ上限を自動で計算できませんでした（' + e.message + '）。'; }
  }
  if (rqRow) rv = rq.getRange(rqRow, 1, 1, RQ_HEADERS.length).getValues()[0];
  const kwEn = rv ? String(rv[RQ.KW - 1] || '') : '';
  const kwJa = rv ? String(rv[RQ.JA - 1] || '') : String(d.keyword || '');
  const cap = rv ? Number(rv[RQ.MAXCOST - 1]) || 0 : 0;

  // AIが同じ商品だけを選ぶ（タイトルで判定。色・柄・サイズ・版が違うものは除外）
  const key = need_('ANTHROPIC_API_KEY');
  const st = getSettings_();
  let same = null;
  try {
    const lines = items.map((x, i) => i + '. ' + String(x.title || '').slice(0, 100) + ' | ' + (x.price ? x.price + '円' : '価格不明') + (x.sold ? ' | 売り切れ' : ''));
    const out = parseJson_(claude_(key, st.model,
      'あなたはeBay輸出の仕入れ担当です。検索結果の中から、探している商品とまったく同じ商品（モデル・色・柄・サイズ・版が同じ）だけを選びます。' +
      'まとめ売り・セット・部品だけ・箱だけ・別の商品・ジャンク（探している商品がジャンクでない場合）は除外。タイトルで判断できないものは除外。出力はJSONのみ。',
      '【探している商品】' + (kwEn ? kwEn + '／' : '') + kwJa + '\n\n【検索結果】\n' + lines.join('\n') + '\n\n{"same":[同じ商品の番号の配列]}'));
    same = new Set((out.same || []).map(Number));
  } catch (e) {}

  const now = new Date();
  const rows = items.map((x, i) => {
    const isSame = same ? same.has(i) : true;
    const ok = isSame && !x.sold && x.price > 0 && cap > 0 && x.price <= cap;
    const verdict = x.sold ? '売り切れ' : !isSame ? '別の商品' : !(x.price > 0) ? '価格不明' : !cap ? '上限が未計算' :
      ok ? '✅ 上限以内' : '❌ 上限を' + (x.price - cap).toLocaleString() + '円超え';
    return { v: [now, rqRow || '', kwJa, d.site || '', x.title || '', x.price || '', x.sold ? '売り切れ' : '', isSame ? '同じ' : '別', cap || '', verdict, x.url, false, '', x.thumb || ''], ok: ok, isSame: isSame, price: x.price || 0 };
  }).sort((a, b) => (b.ok - a.ok) || (b.isSame - a.isSame) || (a.price - b.price));

  const sh = searchResultSheet_();
  const start = sh.getLastRow() + 1;
  sh.getRange(start, 1, rows.length, SR_HEADERS.length).setValues(rows.map(r => r.v));
  sh.getRange(start, SR.GO, rows.length, 1).insertCheckboxes();
  sh.getRange(start, SR.URL, rows.length, 1).setRichTextValues(rows.map(r => [SpreadsheetApp.newRichTextValue().setText('開く').setLinkUrl(String(r.v[SR.URL - 1])).build()]));
  sh.getRange(start, SR.PRICE, rows.length, 1).setNumberFormat('#,##0');
  sh.getRange(start, SR.CAP, rows.length, 1).setNumberFormat('#,##0');
  rows.forEach((r, i) => sh.getRange(start + i, SR.VERDICT).setBackground(r.ok ? '#d8f0d8' : /別の商品|売り切れ/.test(r.v[SR.VERDICT - 1]) ? '#f4f4f4' : '#fde7e7'));
  sh.getRange(start, 1, 1, SR_HEADERS.length).setBorder(true, null, null, null, null, null, '#1a73e8', SpreadsheetApp.BorderStyle.SOLID_MEDIUM);

  // リサーチ候補の行にも、一番安い「上限以内」の価格を書く
  const okRows = rows.filter(r => r.ok);
  if (rqRow && okRows.length) {
    const best = okRows[0];
    const cur = Number(rq.getRange(rqRow, RQ.BESTSRC).getValue()) || 0;
    if (!cur || best.price < cur) {
      rq.getRange(rqRow, RQ.BESTSRC).setValue(best.price);
      rq.getRange(rqRow, RQ.VERDICT).setValue('✅ 上限以内（' + d.site + '）').setBackground('#d8f0d8');
    }
  }

  const sameCnt = rows.filter(r => r.isSame).length;
  // ✅の商品（安い順に最大N件）を自動で「仕入れ候補」へ送り、1分後に自動で処理（設定でオン／オフ）
  let autoMsg = '';
  const ac = autoSearchSettings_();
  if (ac.on && okRows.length) {
    const urls = okRows.slice().sort((a, b) => a.price - b.price).slice(0, ac.max).map(r => String(r.v[SR.URL - 1]));
    const idx = [];
    const all = sh.getRange(2, 1, sh.getLastRow() - 1, SR_HEADERS.length).getValues();
    for (let i = all.length - 1; i >= 0 && idx.length < urls.length; i--) {
      if (urls.indexOf(String(all[i][SR.URL - 1])) >= 0 && all[i][SR.SENT - 1] !== '済' && idx.indexOf(i) < 0) idx.push(i);
    }
    const sent = sendSearchRowsToIntake_(sh, idx);
    if (sent.added) scheduleIntakeSoon_();
    autoMsg = '<br><br><b>✅の商品のうち ' + sent.added + '件を自動で「仕入れ候補」に追加し、1分後に自動で判定を始めます</b>' +
      (sent.skipped ? '（すでに仕入れ候補・出品中のため ' + sent.skipped + '件は追加しませんでした）' : '') +
      (listingSettings_().autoList ? '。利益1,500円以上なら、そのまま出品します。' : '。設定B15をオンにすると、出品まで自動になります。');
  }
  const list = okRows.slice(0, 10).map(r => '<li>' + esc_(r.v[SR.TITLE - 1]) + ' — <b>' + Number(r.price).toLocaleString() + '円</b> ' +
    '<a href="' + esc_(r.v[SR.URL - 1]) + '" target="_blank">開く</a></li>').join('');
  return page_(okRows.length ? '✅ 仕入れ上限以内の商品が ' + okRows.length + '件 見つかりました' : '受け取りました（上限以内の商品はありませんでした）',
    esc_(d.site) + 'の検索結果 ' + items.length + '件のうち、同じ商品 ' + sameCnt + '件、仕入れ上限' + (cap ? '（' + cap.toLocaleString() + '円）' : '') + '以内 ' + okRows.length + '件。' +
    (autoRq ? '<br>' + esc_(autoRq) : '') +
    (rqRow ? '' : '<br><span style="color:#b00">※仕入れ上限が分からなかったため、自動では進めませんでした。</span>') +
    (list ? '<ol>' + list + '</ol>' : '') + autoMsg +
    (autoMsg ? '' : '<br>一覧は「仕入れ先の検索結果」シートにあります。仕入れたい商品は、リンクを開いて「eBayへ送る」を押すか、シートでチェックして「チェックした検索結果を仕入れ候補に送る」を押してください。'));
}

// チェックした検索結果を「仕入れ候補」シートへ（メルカリは元の大きい写真を、写真の番号順に探して入れる）
function menuSendSearchToIntake() {
  run_(() => {
    const sh = searchResultSheet_();
    const last = sh.getLastRow();
    if (last < 2) throw new Error('「仕入れ先の検索結果」シートに商品がありません');
    const vals = sh.getRange(2, 1, last - 1, SR_HEADERS.length).getValues();
    const idx = [];
    vals.forEach((v, i) => { if (v[SR.GO - 1] === true && v[SR.SENT - 1] !== '済') idx.push(i); });
    const r = sendSearchRowsToIntake_(sh, idx);
    if (r.added) scheduleIntakeSoon_();
    return r.added + '件を「仕入れ候補」に送りました（1分後に自動で判定を始めます）' + (r.skipped ? '。すでに仕入れ候補・出品中のため ' + r.skipped + '件は送りませんでした' : '');
  });
}


/* =====================================================================
 * 24時間リサーチ（ゲームソフト中心）
 *  1時間ごとに少しずつ：
 *   ① キーワードを増やす：「リサーチの種」から具体的なタイトルをAIが提案／売れた商品の関連キーワード
