  sh.getRange('A1').setNote('発送のときに量った重さ（梱包込み）を、eBay商品IDといっしょに入れて、メニュー「0円の自動化」→「梱包の実測を反映する」を押してください。');
  return sh;
}
function zSpecApply_() {
  const sh = zSpecSheet_(), prep = prepSheet_();
  const n = sh.getLastRow() - 1;
  if (n < 1) return { rows: 0, cats: 0 };
  const pv = prep.getLastRow() > 1 ? prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues() : [];
  const v = sh.getRange(2, 1, n, ZS_HEAD.length).getValues();
  const stats = {};
  v.forEach((r, i) => {
    const id = String(r[1] || '').trim(), g = Number(r[2]) || 0;
    if (!id || !(g > 0)) return;
    const pi = pv.findIndex(x => String(x[P.ITEMID - 1]) === id);
    if (pi >= 0) {
      const est = Number(pv[pi][P.WEIGHT - 1]) || 0, cat = String(pv[pi][P.CAT - 1] || '');
      sh.getRange(i + 2, 5, 1, 4).setValues([[pi + 2, cat, est || '', est ? g - est : '']]);
      if (!(r[0] instanceof Date)) sh.getRange(i + 2, 1).setValue(new Date());
      if (cat) (stats[cat] = stats[cat] || []).push(g);
    } else sh.getRange(i + 2, 9).setValue('「出品作成」にこの商品IDがない');
  });
  const out = {};
  Object.keys(stats).forEach(c => { const a = stats[c].sort((x, y) => x - y); out[c] = { n: a.length, med: a[Math.floor(a.length / 2)], max: a[a.length - 1] }; });
  PropertiesService.getScriptProperties().setProperty('ZS_STATS', JSON.stringify(out));
  // 統計のシート
  const ss = ss_(); let st = ss.getSheetByName('カテゴリ別の実測'); if (!st) st = ss.insertSheet('カテゴリ別の実測');
  st.clear();
  st.getRange(1, 1, 1, 4).setValues([['カテゴリID', '件数', '量った重さの中央値g', 'いちばん重いg']]).setFontWeight('bold').setBackground('#e8f0fe');
  const rows = Object.keys(out).map(c => [c, out[c].n, out[c].med, out[c].max]);
  if (rows.length) st.getRange(2, 1, rows.length, 4).setValues(rows);
  return { rows: v.filter(r => Number(r[2]) > 0).length, cats: rows.length };
}
