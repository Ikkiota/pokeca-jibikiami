function zFindModel_(M, key, num, grade) { return M.idx[String(key).toLowerCase() + '|' + grade] || (num ? M.idx[String(num).toLowerCase() + '|' + grade] : null); }
// eBayの英語のタイトル → 型番・鑑定・名前
function zCardFromEbayTitle_(title) {
  const t = String(title || '');
  const cn = zCardNo_(t);
  if (!cn.num) return null;
  const graded = zGraded_(t);
  const gm = graded ? (t.match(/\b(PSA|BGS|CGC|ARS)\s*(\d{1,2}(\.5)?)\b/i) || []) : [];
  const grade = graded ? (gm[1] ? gm[1].toUpperCase() + gm[2] : '鑑定品') : '未鑑定';
