/* =====================================================================
 * SpeedPAK Economy 料金の毎月自動更新
 *  eBay SpeedPAK Economy の料金表（Excel）を読み込み、「送料マスタ」シートを更新
 *  料金が変わったらメールでお知らせ。燃油サーチャージの確認も毎月リマインド
 * ===================================================================== */
/* ---------- xlsx の読み込み（追加サービス不要：zipを展開してXMLを読む） ---------- */
function xmlUnescape_(s) {
  return String(s).replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&apos;/g, "'").replace(/&amp;/g, '&');
}
function colIndex_(ref) {           // "AC12" → 28（A=0）
  const letters = String(ref).replace(/\d+/g, '');
  let n = 0;
  for (let i = 0; i < letters.length; i++) n = n * 26 + (letters.charCodeAt(i) - 64);
  return n - 1;
}
// files: { 'xl/workbook.xml': 文字列, ... } → { シート名: 行の配列（各行は値の配列） }
function xlsxSheetsFromXml_(files) {
  const get = name => files[name] || files['/' + name] || '';
  const shared = [];
  const ss = get('xl/sharedStrings.xml');
  if (ss) (ss.match(/<si>[\s\S]*?<\/si>/g) || []).forEach(si => {
    shared.push(xmlUnescape_((si.match(/<t[^>]*>([\s\S]*?)<\/t>/g) || []).map(t => t.replace(/<[^>]+>/g, '')).join('')));
  });
  const rels = {};
  (get('xl/_rels/workbook.xml.rels').match(/<Relationship [^>]*>/g) || []).forEach(r => {
    const id = (r.match(/Id="([^"]+)"/) || [])[1], tg = (r.match(/Target="([^"]+)"/) || [])[1];
    if (id && tg) rels[id] = tg.replace(/^\//, '').replace(/^(?!xl\/)/, 'xl/');
  });
  const out = {};
  (get('xl/workbook.xml').match(/<sheet [^>]*>/g) || []).forEach(sh => {
    const name = xmlUnescape_((sh.match(/name="([^"]*)"/) || [])[1] || '');
    const rid = (sh.match(/r:id="([^"]+)"/) || [])[1];
    const xml = get(rels[rid] || '');
    const rows = [];
    (xml.match(/<row[\s\S]*?<\/row>/g) || []).forEach(rw => {
      const rn = Number((rw.match(/<row[^>]* r="(\d+)"/) || [])[1]) - 1;
      const row = [];
      (rw.match(/<c [^>]*?(?:\/>|>[\s\S]*?<\/c>)/g) || []).forEach(c => {
        const ref = (c.match(/ r="([A-Z]+\d+)"/) || [])[1];
        const t = (c.match(/ t="([^"]+)"/) || [])[1];
        let v = null;
        if (t === 'inlineStr') v = xmlUnescape_((c.match(/<t[^>]*>([\s\S]*?)<\/t>/g) || []).map(x => x.replace(/<[^>]+>/g, '')).join(''));
        else {
          const m = c.match(/<v>([\s\S]*?)<\/v>/);
          if (m) v = t === 's' ? shared[Number(m[1])] : (t === 'str' ? xmlUnescape_(m[1]) : (isNaN(Number(m[1])) ? m[1] : Number(m[1])));
        }
        if (ref && v !== null && v !== '') row[colIndex_(ref)] = v;
      });
      rows[rn] = row;
    });
    out[name] = rows;
  });
  return out;
}
// 料金表の読み取り：「Weight (kg) Up to」の見出し行を探し、
//  ・見出しが JPY の2列組（重量, 料金, 重量, 料金…）→ { JPY: {kg: 円} }
//  ・見出しが国コード（DE, AT…）→ { DE: {kg: 円}, ... }
function parseRateGrid_(rows) {
  const out = {};
  let hdr = null;
  rows.forEach(row => {
    if (!row) return;
    const first = row.findIndex(v => v !== undefined && v !== null);
    if (first < 0) return;
    if (/^weight/i.test(String(row[first]))) { hdr = row.map(v => String(v || '').trim()); return; }
    if (!hdr) return;
    // 国コード形式
    const codeCols = hdr.map((h, j) => /^[A-Z]{2}$/.test(h) ? j : -1).filter(j => j >= 0);
    if (codeCols.length >= 3) {
      const kg = Number(row[first]);
      if (!(kg > 0)) return;
      codeCols.forEach(j => { const v = Number(row[j]); if (v > 0) (out[hdr[j]] = out[hdr[j]] || {})[kg] = v; });
      return;
    }
    // JPY の2列組
    hdr.forEach((h, j) => {
      if (h !== 'JPY') return;
      const kg = Number(row[j - 1]), v = Number(row[j]);
      if (kg > 0 && v > 0) (out.JPY = out.JPY || {})[kg] = v;
    });
  });
  return out;
}

