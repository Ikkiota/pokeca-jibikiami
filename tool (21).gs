  trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(itemId) + '</ItemID>' +
    '<Description><![CDATA[' + desc.replace(/]]>/g, ']]&gt;') + ']]></Description>' +
    (eps.length ? '<PictureDetails>' + eps.map(u => '<PictureURL>' + x_(u) + '</PictureURL>').join('') + '</PictureDetails>' : '') +
    (specs.length ? '<ItemSpecifics>' + specs.map(v => '<NameValueList><Name>' + x_(v[0]) + '</Name><Value>' + x_(v[1]) + '</Value></NameValueList>').join('') + '</ItemSpecifics>' : '') +
    (condNote && conditionNoteAllowed_(cond) ? '<ConditionDescription>' + x_(condNote) + '</ConditionDescription>' : '') +
    '</Item>');

  sh.getRange(row, P.DESC).setValue(desc);
  sh.getRange(row, P.SPECS).setValue(specs.map(v => v[0] + ': ' + v[1]).join('\n'));
  sh.getRange(row, P.CONDNOTE).setValue(condNote);
  sh.getRange(row, P.IMGSTAT).setValue('eBayを更新：' + (eps.length ? '写真 ' + eps.length + '枚（順番どおり）・' : '写真はそのまま・') + 'Item specifics ' + specs.length + '項目（' +
    Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）');
  return { pics: eps.length, specs: specs.length };
}

function menuReviseListing() {
  run_(() => {
    const sh = SpreadsheetApp.getActiveSheet();
    if (sh.getName() !== '出品作成') throw new Error('「出品作成」シートで、更新したい行を選んでから押してください');
    const key = need_('ANTHROPIC_API_KEY');
    const st = getSettings_();
    const rg = sh.getActiveRange();
    const msgs = [];
    for (let r = rg.getRow(); r < rg.getRow() + rg.getNumRows() && msgs.length < 5; r++) {
      if (r < 2) continue;
      try { const o = reviseListingRow_(sh, r, key, st, { pictures: true }); msgs.push(r + '行目：写真' + o.pics + '枚・項目' + o.specs + '個を更新'); }
      catch (e) { msgs.push(r + '行目：' + e.message); }
    }
    return msgs.join('／');
  });
}


/* ---------- これまでの出品を、すべて新しい形式に自動で更新 ----------
 *  15分ごとに4件ずつ：テンプレートの説明文・Item specifics（できるだけすべて）・状態の説明（切り抜き）
 *  写真は、仕入れ先ページでボタンを押して最新にした商品だけ入れ替える（古い写真で上書きしないため）
 *  全部終わったら自動で止まる
 */
function upgradeAllListings() {
  if (zGhCareOn_()) { const p = PropertiesService.getScriptProperties(); if (p.getProperty('ZGHC_UPGRADE') === 'done') { stopUpgrade_(); p.deleteProperty('ZGHC_UPGRADE'); } else p.setProperty('ZGHC_UPGRADE', '1'); return; }   // v246：GitHub がする（終わったらここで止める）
  const sh = ss_().getSheetByName('出品作成');
  if (!sh || sh.getLastRow() < 2) return stopUpgrade_();
  const key = need_('ANTHROPIC_API_KEY');
  const st = getSettings_();
  const vals = sh.getRange(2, 1, sh.getLastRow() - 1, PREP_HEADERS.length).getValues();
  const todo = [];
  vals.forEach((v, i) => {
    if (String(v[P.STATUS - 1]) !== '出品済み' || !String(v[P.ITEMID - 1] || '').trim()) return;
    if (/^(eBayを更新|更新エラー)/.test(String(v[P.IMGSTAT - 1] || ''))) return;
    todo.push(i + 2);
  });
  if (!todo.length) return stopUpgrade_();
  const started = Date.now();
  todo.slice(0, 4).forEach(row => {
    if (Date.now() - started > 4.5 * 60 * 1000) return;
    const stat = String(sh.getRange(row, P.IMGSTAT).getValue() || '');
    try { reviseListingRow_(sh, row, key, st, { pictures: /^写真を最新に更新/.test(stat) }); }
    catch (e) {
      // 同じ商品で何度も失敗しないように記録（直したら、このセルを消せばもう一度対象になる）
      sh.getRange(row, P.IMGSTAT).setValue('更新エラー：' + e.message + '（直したらこのセルを消すと、もう一度自動で更新します）');
    }
  });
}

function stopUpgrade_() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'upgradeAllListings').forEach(t => ScriptApp.deleteTrigger(t));
}

function enableUpgradeAll() {
  stopUpgrade_();
  ScriptApp.newTrigger('upgradeAllListings').timeBased().everyMinutes(15).create();
  SpreadsheetApp.getUi().alert('設定しました。15分ごとに4件ずつ、これまでに出品した商品を新しい形式（テンプレートの説明文・Item specifics・状態の説明）に自動で更新します。全部終わったら自動で止まります。\n\n' +
    '写真は、仕入れ先ページで「eBayへ送る」を押して最新にした商品だけ入れ替えます（そのときは押した瞬間に更新されます）。');
}


