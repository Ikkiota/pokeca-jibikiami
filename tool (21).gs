  ['まとめ買い', 'combine,combined,bundle,multiple items,more than one', 'Thank you for your interest in our items! Please let us know which items you would like, and we will check them for you.', 'まとめ買いの相談'],
  ['発送の日数', 'how long,how many days,ship to my country,international shipping', 'Thank you for your message. The estimated delivery date is shown on the listing page for your address. We ship from Japan with tracking.', '届くまでの日数（約束しない）'],
];
const ZT_HUMAN = /refund|return|damaged|broken|wrong item|not received|never received|missing|cancel|dispute|scam|counterfeit|chargeback|paypal|outside ebay|whatsapp|email me|phone/i;
function zTplSheet_() {
  const ss = ss_(); let sh = ss.getSheetByName('返信テンプレ');
  if (sh) return sh;
