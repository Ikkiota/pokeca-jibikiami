    // 一度自動で「使う」にした型番を、あなたが外した → その判断を優先して、自動では戻さない
    if (!use && /自動で「使う」に/.test(memo)) { sh.getRange(row, ZM.MEMO).setValue('自分で外した（自動では戻さない）／' + memo); manualOff = true; }
    if (!use && !manualOff && ((ss.ownAlways && ownN > 0) || (score >= ss.score && (!low || low >= zs.minUsd)))) {
      sh.getRange(row, ZM.USE).setValue(true); sh.getRange(row, ZM.MEMO).setValue('自動で「使う」に（点数 ' + score + (ownN ? '・自分の店で売れた ' + ownN : '') + (sold ? '・eBayで売れた ' + sold : '') + '）'); on++;
    } else if (use && !keep && ss.dropBelow > 0 && score < ss.dropBelow && !ownN && !sold) {
