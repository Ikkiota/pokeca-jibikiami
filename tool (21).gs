  sh.getRange('F5').setValue(21);
  sh.getRange('G2:G5').setValues([['配達完了になった注文に、お礼を自動で送ります'], ['英語で入力'],
    ['【日本語訳】こんにちは！荷物が無事に届いていますように😊 ご購入本当にありがとうございました。商品を気に入っていただけたらうれしいです！ご質問やご不明な点があれば、いつでもお気軽にご連絡ください。改めてありがとうございました！\n差し込み：{name} 名前、{item} 商品名、{signature} 署名'],
    ['エアパケなど追跡の反映が遅いとき用の目安']]).setFontColor('#777777').setWrap(true).setVerticalAlignment('top');
  sh.getRange('E1:G5').setBackground('#f4fbf6');
  sh.setColumnWidth(5, 150).setColumnWidth(6, 360).setColumnWidth(7, 300);
}

function sendArrivalMessages_() {
  const sh = amSheetIfAny_();
  if (!sh) return { enabled: false, sent: 0 };
  ensureArrivalSettings_(sh);
  if (sh.getRange('F2').getValue() !== true) return { enabled: false, sent: 0 };

  const p = PropertiesService.getScriptProperties();
  let since = p.getProperty('ARRIVAL_MSG_SINCE');
  if (!since) { p.setProperty('ARRIVAL_MSG_SINCE', new Date().toISOString()); return { enabled: true, sent: 0 }; }
  const sinceD = new Date(new Date(since).getTime() - 48 * 3600 * 1000);
  const subject = String(sh.getRange('F3').getValue() || 'We hope you enjoy your item!');
  const template = String(sh.getRange('F4').getValue() || DEFAULT_ARRIVAL_BODY);
  const fallbackDays = Number(sh.getRange('F5').getValue()) || 21;
  const signature = getSettings_().signature;
  const logged = new Set(amLog_(sh).filter(r => r[0] === '到着後').map(r => String(r[AL.ORDER - 1])));
  const now = new Date();
  const iso = d => d.toISOString();
  let sent = 0;

  for (let page = 1; page <= 5 && sent < 10; page++) {
    const out = trading_('GetOrders',
      '<CreateTimeFrom>' + iso(new Date(now.getTime() - 75 * 86400000)) + '</CreateTimeFrom><CreateTimeTo>' + iso(now) + '</CreateTimeTo>' +
      '<OrderRole>Seller</OrderRole><OrderStatus>Completed</OrderStatus>' +
      '<Pagination><EntriesPerPage>100</EntriesPerPage><PageNumber>' + page + '</PageNumber></Pagination>');
    const ns = out.ns;
    const arr = out.root.getChild('OrderArray', ns);
    const orders = arr ? arr.getChildren('Order', ns) : [];
    for (const o of orders) {
      if (sent >= 10) break;
      const orderId = o.getChildText('OrderID', ns);
      if (!orderId || logged.has(orderId)) continue;
      const shippedT = o.getChildText('ShippedTime', ns);
      if (!shippedT) continue;                                   // まだ発送していない
      const shipped = new Date(shippedT);
      if (shipped < sinceD) continue;                             // オンにする前に発送した注文は対象外
      const sss = o.getChild('ShippingServiceSelected', ns);
      const pkg = sss ? sss.getChild('ShippingPackageInfo', ns) : null;
      const actual = pkg ? pkg.getChildText('ActualDeliveryTime', ns) : '';
      const estMax = pkg ? pkg.getChildText('EstimatedDeliveryTimeMax', ns) : '';
      let when = '', why = '';
      if (actual) { when = new Date(actual); why = '配達完了'; }
      else if (estMax && now > new Date(new Date(estMax).getTime() + 86400000)) { when = new Date(estMax); why = 'お届け予定日を過ぎた'; }
      else if (now > new Date(shipped.getTime() + fallbackDays * 86400000)) { when = now; why = '発送から' + fallbackDays + '日経過'; }
      if (!when) continue;

      const buyer = o.getChildText('BuyerUserID', ns) || '';
      const addr = o.getChild('ShippingAddress', ns);
      const name = String((addr && addr.getChildText('Name', ns)) || buyer).trim().split(/\s+/)[0] || buyer;
      const txs = o.getChild('TransactionArray', ns);
      const tx = txs ? txs.getChildren('Transaction', ns)[0] : null;
      const item = tx ? tx.getChild('Item', ns) : null;
      const itemId = item ? item.getChildText('ItemID', ns) : '';
      const title = item ? item.getChildText('Title', ns) : '';
      const body = template.replace(/\{name\}/g, name).replace(/\{item\}/g, title).replace(/\{signature\}/g, signature);
      const row = ['到着後', orderId, when, buyer, title, '', '', '', '', ''];
      try {
        try { sendMemberMsg_(itemId, buyer, subject, body, 'General'); }
        catch (e) {
          // 絵文字が受け付けられない場合は、絵文字を外して送り直す
          const plain = body.replace(/[\u{1F000}-\u{1FFFF}\u{2600}-\u{27BF}\u{FE0F}]/gu, '').replace(/ +\n/g, '\n');
          if (plain === body) throw e;
          sendMemberMsg_(itemId, buyer, subject, plain, 'General');
        }
        row[7] = '送信済み'; row[8] = amStamp_() + '（' + why + '）';
        sent++;
      } catch (e) {
        row[7] = 'エラー'; row[8] = e.message;
      }
      sh.appendRow(row);
      logged.add(orderId);
    }
    const pr = out.root.getChild('PaginationResult', ns);
    const totalPages = pr ? Number(pr.getChildText('TotalNumberOfPages', ns)) || 1 : 1;
    if (page >= totalPages) break;
  }
  return { enabled: true, sent: sent };
}


/* =====================================================================
 * 売れた商品の横展開と、国内の販売ページのAI検索
 *  ① 売れたら：その商品を「リサーチ候補」に自動追加（同じ商品の再出品用）
 *  ② 毎朝：売れた商品から、同じシリーズ・別サイズ・別モデルのキーワードをAIが提案して追加
 *  ③ 毎朝：「◎ 狙い目」の行は、AIがウェブ検索で国内の販売ページ（URL・価格・在庫）を探し、仕入れ上限と比べる
 * ===================================================================== */
function addSoldToResearch_(title, itemId, orderId) {
  if (!title) return;
  const sh = researchQueueSheet_();
  const last = sh.getLastRow();
  const kws = last > 1 ? sh.getRange(2, RQ.KW, last - 1, 1).getValues().map(r => String(r[0]).trim().toLowerCase()) : [];
  const kw = String(title).replace(/\s+/g, ' ').trim().slice(0, 120);
  if (kws.indexOf(kw.toLowerCase()) >= 0) return;
  // 出品時の状態（新品／中古）を出品作成シートから
  let cond = '';
  const prep = ss_().getSheetByName('出品作成');
  if (prep && prep.getLastRow() > 1) {
    const r = prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues().find(x => String(x[P.ITEMID - 1]) === itemId);
    if (r) cond = parseInt(String(r[P.COND - 1]), 10) < 3000 ? '新品' : '中古';
  }
  sh.appendRow([kw, cond, '売れた商品（注文 ' + orderId + '）']);
  sh.getRange(sh.getLastRow(), 1, 1, 3).setBackground('#e8f0fe');
}

function expandRelatedKeywords_(limit) {
  const sh = researchQueueSheet_();
  const last = sh.getLastRow();
  if (last < 2) return 0;
  const key = need_('ANTHROPIC_API_KEY');
  const st = getSettings_();
  const rows = sh.getRange(2, 1, last - 1, RQ_HEADERS.length).getValues();
  const existing = new Set(rows.map(r => String(r[RQ.KW - 1]).trim().toLowerCase()));
  let done = 0;
  rows.forEach((r, i) => {
    if (done >= limit) return;
    if (!/^売れた商品/.test(String(r[RQ.MEMO - 1])) || r[RQ.EXPANDED - 1] === '済') return;
    const out = parseJson_(claude_(key, st.model,
      'あなたはeBay輸出のリサーチのアシスタントです。売れた商品から、次に仕入れて売れそうな「同じシリーズ・別サイズ・別モデル・別カラー」のeBay検索キーワードを提案します。出力はJSONのみ。',
      '売れた商品：' + r[RQ.KW - 1] + '\n実在する可能性が高いものだけを、最大4つ。eBayの出品タイトルに近い英語で。\n{"keywords":[{"kw":"","why":"提案の理由（日本語・短く）"}]}'));
    (out.keywords || []).slice(0, 4).forEach(k => {
      const kw = String(k.kw || '').trim();
      if (!kw || existing.has(kw.toLowerCase())) return;
      sh.appendRow([kw, r[RQ.COND - 1] || '', '関連（' + String(r[RQ.KW - 1]).slice(0, 40) + ' から提案）：' + (k.why || '')]);
      sh.getRange(sh.getLastRow(), 1, 1, 3).setBackground('#f3e8fd');
      existing.add(kw.toLowerCase());
    });
    sh.getRange(i + 2, RQ.EXPANDED).setValue('済');
    done++;
  });
  return done;
}

// Claude のウェブ検索を使って質問する
function claudeWebSearch_(key, model, system, user) {
  const call = m => UrlFetchApp.fetch('https://api.anthropic.com/v1/messages', {
    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    headers: { 'x-api-key': key, 'anthropic-version': '2023-06-01' },
    payload: JSON.stringify(apiBody_({ model: m, max_tokens: 3000, system: system,
      tools: [{ type: 'web_search_20250305', name: 'web_search', max_uses: 5, user_location: { type: 'approximate', country: 'JP' } }],
      messages: [{ role: 'user', content: user }] })),
  });
  apiBudgetCheck_();
  let res = call(model);
  if (res.getResponseCode() !== 200) {
    try { apiRecord_(model, JSON.parse(res.getContentText() || '{}').usage, res.getResponseCode()); } catch (e) {}
    model = 'claude-sonnet-5';
    res = call(model);   // ウェブ検索に対応していないモデルのとき
  }
  const j = JSON.parse(res.getContentText() || '{}');
  apiRecord_(model, j.usage, res.getResponseCode());
  if (res.getResponseCode() !== 200) throw new Error('Claude API：' + (j.error ? j.error.message : res.getContentText()));
  return (j.content || []).filter(b => b.type === 'text').map(b => b.text).join('\n');
}

function findSourcesRow_(sh, row, key, st) {
  const v = sh.getRange(row, 1, 1, RQ_HEADERS.length).getValues()[0];
  const kw = String(v[RQ.KW - 1] || '').trim();
  if (!kw) return false;
  const ja = String(v[RQ.JA - 1] || kw);
  const wantNew = String(v[RQ.COND - 1]) === '新品';
  const out = parseJson_(claudeWebSearch_(key, st.model,
    'あなたは日本からeBayへ輸出するセラーの仕入れ担当です。ウェブ検索で、日本国内の通販サイト・中古ショップ・フリマで、指定された商品とまったく同じ商品（モデル・色・柄・サイズが同じ）の「商品ページ」を探します。' +
    knownShopsHint_() +
    'これまで知らなかった中古ゲームショップ・レトロゲーム専門店・中古ショップの通販サイトも、積極的に探してください。' +
    'eBay・海外サイトは除外。検索結果のページやカテゴリー一覧ではなく、個別の商品ページのURLだけ。価格と在庫は、ページや検索結果に書かれている内容だけを使い、推測しない。分からなければ null／「不明」。出力はJSONのみ。',
    '探す商品：' + kw + '\n日本語の名前：' + ja + '\n状態：' + (wantNew ? '新品' : '中古（新品でも可）') +
    '\n最大6件。次のJSONで答えてください：{"sources":[{"shop":"店名","url":"商品ページのURL","price_jpy":数値またはnull,"stock":"在庫あり／在庫なし／不明","condition":"新品／中古","origin":"生産国（書いてあれば）","note":"サイズ選択が必要など"}]}'));
  const list = (out.sources || []).filter(x => /^https?:\/\//.test(String(x.url || '')) && !/ebay\./i.test(String(x.url)));
  try { recordShops_(list); } catch (e) {}
  const lines = list.map(x => x.shop + '｜' + (x.price_jpy ? Number(x.price_jpy).toLocaleString() + '円' : '価格不明') + '｜' + (x.stock || '不明') + '｜' + (x.condition || '') +
    (x.origin ? '｜生産国：' + x.origin : '') + (x.note ? '｜' + x.note : ''));
  const text = lines.length ? lines.join('\n') : '見つかりませんでした（「仕入れ先で探す」のリンクから手で探してください）';
  const rich = SpreadsheetApp.newRichTextValue().setText(text);
  let pos = 0;
  list.forEach((x, i) => { rich.setLinkUrl(pos, pos + lines[i].length, x.url); pos += lines[i].length + 1; });
  sh.getRange(row, RQ.SOURCES).setRichTextValue(rich.build());
  const inStock = list.filter(x => Number(x.price_jpy) > 0 && !/なし|売り切れ|sold/i.test(String(x.stock)));
  const best = inStock.length ? Math.min.apply(null, inStock.map(x => Number(x.price_jpy))) : '';
  const maxCost = Number(v[RQ.MAXCOST - 1]);
  sh.getRange(row, RQ.BESTSRC).setValue(best);
  const verdict = best === '' ? '国内の在庫・価格が不明' : !(maxCost > 0) ? '仕入れ上限が未計算' : best <= maxCost ? '✅ 上限以内（仕入れOK）' : '❌ 上限を' + (best - maxCost).toLocaleString() + '円超え';
  sh.getRange(row, RQ.VERDICT).setValue(verdict).setBackground(/✅/.test(verdict) ? '#d8f0d8' : /❌/.test(verdict) ? '#f8d0d0' : '#f4f4f4');
  return true;
}

function findSourcesForHot_(limit) {
  const sh = researchQueueSheet_();
  const last = sh.getLastRow();
  if (last < 2) return 0;
  const key = need_('ANTHROPIC_API_KEY');
  const st = getSettings_();
  const rows = sh.getRange(2, 1, last - 1, RQ_HEADERS.length).getValues();
  let done = 0;
  for (let i = 0; i < rows.length && done < limit; i++) {
    const r = rows[i];
    if (!/狙い目|検討/.test(String(r[RQ.JUDGE - 1])) || r[RQ.SOURCES - 1]) continue;
    try { if (findSourcesRow_(sh, i + 2, key, st)) done++; } catch (e) { sh.getRange(i + 2, RQ.NOTE).setValue('国内検索エラー：' + e.message); }
  }
  return done;
}

function menuFindSources() {
  run_(() => {
    const sh = SpreadsheetApp.getActiveSheet();
    if (sh.getName() !== 'リサーチ候補') throw new Error('「リサーチ候補」シートで、探したい行を選んでから押してください');
