function ebaySoldUrl_(kw, wantNew, row) {
  return 'https://www.ebay.com/sch/i.html?_nkw=' + encodeURIComponent(kw).replace(/%20/g, '+') +
    '&LH_Sold=1&LH_Complete=1&_ipg=240&LH_ItemCondition=' + (wantNew ? '3' : '4') + (row ? '#ebaytool-rq=' + row : '');
}

