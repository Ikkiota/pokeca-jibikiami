function translateRow_(sh, row) {
  const v = sh.getRange(row, 1, 1, MSG_HEADERS.length).getValues()[0];
  if (v[COL.STATUS - 1] === '送信済み') return '送信済みのため変更しませんでした';
  const ja = String(v[COL.REPLY_JA - 1] || '').trim();
  if (!ja) return '日本語訳が空です';
  const en = jaToEnReply_(ja, v[COL.BUYER - 1], v[COL.MSG - 1]);
  sh.getRange(row, COL.REPLY).setValue(en);
  const note = '日本語訳から英文を作り直しました（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）' +
    (v[COL.OK - 1] === true ? '。送信予定の文も更新済み' : '。内容を確認して「送信OK」にチェック');
  sh.getRange(row, COL.NOTE).setValue(note);
  if (v[COL.OK - 1] !== true) sh.getRange(row, COL.STATUS).setValue('下書き済み（確認してください）');
  return 'OK';
}

