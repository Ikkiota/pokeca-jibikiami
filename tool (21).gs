  return { mk: mk, cap: cap };
}

/* ---------- ルールで絞る（無料）：型番が合う・鑑定が合う・まとめ売りでない・上限以内 ---------- */
function zRuleCheck_(title, priceYen, rows) {
  const t = zNorm_(title);
  if (Z_JUNK.test(t)) return { ok: false, why: 'まとめ売り・オリパ・海外版など（対象外の言葉）' };
  if (zNotSingle_(t)) return { ok: false, why: 'パック・BOX・デッキ（カード1枚ではない）' };   // v135
  if (Z_HARD_DAMAGE.test(t)) return { ok: false, why: 'ジャンク・折れ・破れ・水濡れ（状態が悪すぎる）' };   // v172
  const dmgR = Z_DAMAGED.test(t), dsetR = zDamagedSettings_();
  if (dmgR && !dsetR.on) return { ok: false, why: '傷・難あり（「追加の設定」F297 がオフ）' };
  const cn = zCardNo_(t);
  if (!cn.num) return { ok: false, why: 'カードの番号が書いていない（ルールで判断できない）' };
  const g = zGraded_(t);
  const hit = rows.filter(x => x.r[ZM.USE - 1] === true).find(x => {
    const k = zCardNo_(x.r[ZM.KEY - 1]);
    if (k.num !== cn.num) return false;
    if (k.set && cn.set && k.set.toLowerCase() !== cn.set.toLowerCase()) return false;
    const rg = !/未鑑定/.test(String(x.r[ZM.GRADE - 1] || '未鑑定'));
    return rg === g;
  });
  if (!hit) return { ok: false, why: 'カード型番リスト（使う）に同じ番号・同じ鑑定の行がない' };
  const cap = Math.floor((Number(hit.r[ZM.CAP - 1]) || 0) * (dmgR ? dsetR.rate : 1));   // v172：傷・難ありは上限も下げる（ざっくり）
  if (!(cap > 0)) return { ok: false, why: '仕入れ上限がまだ計算されていない（' + hit.r[ZM.KEY - 1] + '）', hit: hit };
  if (!(priceYen > 0)) return { ok: false, why: '値段が分からない', hit: hit };
  if (priceYen > Math.round(cap * zCapTol_())) return { ok: false, why: '上限 ' + cap.toLocaleString() + '円を ' + (priceYen - cap).toLocaleString() + '円こえる', hit: hit };
  if (priceYen < cap * 0.1) return { ok: false, why: '安すぎる（相場の1割未満。カード1枚ではない・別のカードの可能性）', hit: hit };   // v135
  return { ok: true, why: '✅ ' + hit.r[ZM.KEY - 1] + '・上限 ' + cap.toLocaleString() + '円以内', hit: hit };
}
// ルールで通った品を「仕入れ候補」へ（重複は入れない・1日の上限まで）→ 1分後に今までの判定
function zToIntake_(items, site) {
  const st = zSettings_();
  if (!st.toIntake || !items.length) return { added: 0, skipped: 0, capped: 0 };
  const intake = intakeSheet_();
  const known = new Set();
  if (intake.getLastRow() > 1) intake.getRange(2, IN.URL, intake.getLastRow() - 1, 1).getValues().forEach(r => known.add(String(r[0]).split('?')[0]));
  const lsh = ss_().getSheetByName('出品一覧');
  if (lsh && lsh.getLastRow() > 1) lsh.getRange(2, LCOL.SRC_URL, lsh.getLastRow() - 1, 1).getValues().forEach(r => known.add(String(r[0]).split('?')[0]));
  const prep = prepSheet_();
  if (prep.getLastRow() > 1) prep.getRange(2, P.SRC, prep.getLastRow() - 1, 1).getValues().forEach(r => known.add(String(r[0]).split('?')[0]));
  let added = 0, skipped = 0, capped = 0;
  items.forEach(it => {
    const u = String(it.url).split('?')[0];
    if (known.has(u)) { skipped++; return; }
    if (zDayCount_('intake', 0) >= st.dayCap) { capped++; return; }
    const mid = (u.match(/\/item\/(m\d+)/) || [])[1];
    let imgs = [];
    try { imgs = mid ? mercariImages_(mid) : []; } catch (e) {}
    intake.appendRow([it.url, it.title, it.price, it.cond || '中古', '', '', '', imgs.join('\n'), '0円の自動化で見つけた（' + site + '）［国内送料込み］：' + it.why + (it.desc ? '／' + String(it.desc).slice(0, 1500) : '')]);
    intake.getRange(intake.getLastRow(), IN.GO).insertCheckboxes().setValue(true);
    known.add(u); added++; zDayCount_('intake', 1);
  });
  if (added) try { scheduleIntakeSoon_(); } catch (e) {}
  return { added: added, skipped: skipped, capped: capped };
}

/* ---------- ① メルカリのお知らせメールを読む（Gmailだけ・メルカリのサイトは自動で見に行かない） ---------- */
const ZFM_Q = 'from:mercari newer_than:3d';
function zfmStrip_(html) {
  return String(html || '').replace(/<style[\s\S]*?<\/style>/gi, ' ').replace(/<script[\s\S]*?<\/script>/gi, ' ').replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&yen;|&#165;/g, '¥').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/[ \t]+/g, ' ');
}
function zfmParse_(html) {
  let dec = String(html || '').replace(/&amp;/g, '&');
  for (let i = 0; i < 2; i++) { try { dec = dec.replace(/%[0-9A-Fa-f]{2}/g, m => decodeURIComponent(m)); } catch (e) { break; } }
  const items = [], seen = {};
  const rx = /jp\.mercari\.com\/item\/(m\d{8,13})/gi;
  let m;
  while ((m = rx.exec(dec)) !== null) {
    const id = m[1];
    if (seen[id]) continue;
    seen[id] = 1;
    const at = m.index, win = dec.slice(Math.max(0, at - 300), at + 1800);
    let title = '';
    const am = win.match(new RegExp('<a[^>]*' + id + '[^>]*>([\\s\\S]*?)<\\/a>', 'i'));
    if (am) title = zfmStrip_(am[1]).trim();
    if (!title) { const im = win.match(/alt="([^"]{6,200})"/i); if (im) title = zfmStrip_(im[1]).trim(); }
    if (!title) { const after = zfmStrip_(dec.slice(at, at + 1200)).split(/\n/).map(x => x.trim()).filter(x => x && !/^https?:|mercari\.com/.test(x) && !/^[¥￥]?\s*[\d,]+\s*円?$/.test(x)); if (after.length) title = after[0]; }
    const txt = zfmStrip_(dec.slice(at, at + 1800));
    const pm = txt.match(/[¥￥]\s*([\d,]{3,9})/) || txt.match(/([\d,]{3,9})\s*円/);
    items.push({ url: 'https://jp.mercari.com/item/' + id, title: title.slice(0, 200), price: pm ? Number(pm[1].replace(/,/g, '')) : 0 });
  }
  return items;
}
function zMailTick_() {
  const p = PropertiesService.getScriptProperties();
  let done = []; try { done = JSON.parse(p.getProperty('ZFM_DONE') || '[]'); } catch (e) {}
  const M = zModelRows_();
  const res = { mails: 0, items: 0, pass: 0, sent: 0, skip: 0, why: {} };
  let threads = [];
  try { threads = GmailApp.search(ZFM_Q, 0, 30); } catch (e) { return { err: 'Gmailを読めませんでした：' + e.message }; }
  const pass = [], news = {};
  threads.forEach(th => th.getMessages().forEach(msg => {
    const id = msg.getId();
    if (done.indexOf(id) >= 0) return;
    done.push(id);
    const subj = String(msg.getSubject() || ''), plain = String(msg.getPlainBody() || '').slice(0, 400);
    if (!/新着|検索条件|保存した|新しく出品|お探しの/.test(subj + ' ' + plain)) return;   // 取引のお知らせなどは読まない
    res.mails++;
    zfmParse_(msg.getBody()).forEach(it => {
      res.items++;
      it.price = it.price > 0 ? it.price + zDomShip_({ url: it.url, text: '', freeShip: false, box: zIsSealedBox_(zNorm_(it.title)) }).yen : 0;   // v122：沖縄までの送料（メルカリの着払い・不明は上限）
      const c = zRuleCheck_(it.title, it.price, M.rows.concat(slAsModelRows_()));   // v125：売れた実績の型番も
      if (c.hit && c.hit.row) news[c.hit.row] = (news[c.hit.row] || 0) + 1;
      if (c.ok) { pass.push(Object.assign(it, { why: c.why, hit: c.hit })); res.pass++; } else { res.why[c.why.replace(/（.*$/, '')] = (res.why[c.why.replace(/（.*$/, '')] || 0) + 1; }
    });
  }));
  if (done.length > 600) done = done.slice(-600);
  p.setProperty('ZFM_DONE', JSON.stringify(done));
  const stamp = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm');
  Object.keys(news).forEach(row => { try { M.sh.getRange(Number(row), ZM.NEWS).setValue('🔔 ' + stamp + '（メール ' + news[row] + '品）'); M.sh.getRange(Number(row), ZM.SAVED).setValue(true); } catch (e) {} });
  // v150：通った品は「出品候補（0円）」へ（あなたが GO を付けたときだけ出品する。今までは仕入れ候補へ直接送っていた）
  const known = kwKnownUrls_();
  const rows = pass.filter(it => !known.has(String(it.url).split('?')[0])).map(it => { const h = it.hit ? it.hit.r : [];
    return [false, '', new Date(), 'メルカリのお知らせメール', it.title, it.price, Number(h[ZM.CAP - 1]) || '', Number(h[ZM.LOW - 1]) || '', h[ZM.KEY - 1] || '', h[ZM.GRADE - 1] || '', it.why, 'メルカリ', it.url, it.cond || '中古', '']; });
  res.skip = pass.length - rows.length;
  if (rows.length) { const ad = zKcAppend_(kcSheet_(), rows); res.sent = ad.added.length; res.skip += ad.dup; }
  return res;
}

