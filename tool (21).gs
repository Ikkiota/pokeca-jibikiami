/* =====================================================================
 * 仕入れ候補の入力 → 出品までのパイプライン（半自動）
 *  ① 仕入れ候補を入力（「仕入れ候補」シート）
 *  ② Claudeが商品情報を解析
 *  ③ eBay APIで市場調査（出品を1件ずつ確認）
 *  ④ 価格・競合を分析（勝負できる最安値・中央値・日本のセラー）
 *  ⑤ 利益計算（手数料・送料・関税・DDP手数料・梱包）
 *  ⑥ 出品タイトル生成　⑦ Description生成　⑧ Category / Item Specifics生成
 *  ⑨ 価格決定（最安値の1%下 → 中央値 → 利益1,500円以上だけ候補）
 *  ⑩ 人間が最終確認（「出品作成」シートで「出品する」にチェック）
 *  ⑪ eBay APIで出品（「出品管理」→「チェックした商品を出品」）
 * ===================================================================== */
const IN = { URL: 1, NAME: 2, COST: 3, COND: 4, JAN: 5, WEIGHT: 6, ORIGIN: 7, IMGS: 8, MEMO: 9, GO: 10, STATUS: 11, RESULT: 12 };
const IN_HEADERS = ['仕入れURL', '商品名（日本語でOK）', '仕入れ値（円・送料込み）', '状態', 'JANコード（任意）', '梱包込みの重さg（任意）',
  '原産国（任意）', '画像URL（1行に1つ・任意）', '商品の説明・メモ（任意）', '処理する', '処理状況', '結果'];

function intakeSheet_() {
  const ss = ss_();
  let sh = ss.getSheetByName('仕入れ候補');
  if (sh) return sh;
  sh = ss.insertSheet('仕入れ候補', 1);
  sh.setTabColor('#e37400');
  sh.getRange(1, 1, 1, IN_HEADERS.length).setValues([IN_HEADERS]).setFontWeight('bold').setBackground('#e8f0f2').setWrap(true);
  [IN.URL, IN.NAME, IN.COST, IN.COND].forEach(c => sh.getRange(1, c).setBackground('#fff4dc'));
  [220, 260, 110, 80, 110, 100, 90, 240, 260, 70, 110, 420].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(1);
  sh.getRange(2, IN.COND, 500, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['中古', '新品', 'ジャンク']).build());
  sh.getRange(2, IN.GO, 500, 1).insertCheckboxes();
  sh.getRange(2, IN.JAN, 500, 1).setNumberFormat('@');
  sh.getRange(2, IN.IMGS, 500, 2).setWrap(true);
  sh.getRange('A1').setNote('黄色の列（仕入れURL・商品名・仕入れ値・状態）を入れて「処理する」にチェック → メニュー「仕入れ候補を処理する」。' +
    '画像URLがない場合、出品前に「出品作成」シートのF列に画像URLを入れるか、仕入れ先ページで「eBayへ送る」を使ってください。');
  return sh;
}

function processIntake_(limit) {
  const sh = intakeSheet_();
  const last = sh.getLastRow();
  if (last < 2) return { ok: 0, rej: 0, err: 0 };
  const rows = sh.getRange(2, 1, last - 1, IN_HEADERS.length).getValues();
  const prep = prepSheet_();
  const ls = listingSettings_();
  let ok = 0, rej = 0, err = 0;
  const started = Date.now();
  for (let i = 0; i < rows.length && ok + rej + err < limit; i++) {
    const v = rows[i], row = i + 2;
    if (v[IN.GO - 1] !== true || String(v[IN.STATUS - 1]).match(/^(候補|見送り|処理済み|出品済み|エラー|画像取得失敗|保留|処理中)/)) continue;   // v200：エラー・処理中の行を何度も判定し直さない（同じ品が「出品作成」に何十行も増え、AI のお金もかかっていた）
    // URLだけ入っている行：許可されたサイトなら、ページを読んで商品名・価格・説明・画像を自動で入れる
    if (String(v[IN.URL - 1] || '').trim() && (!String(v[IN.NAME - 1] || '').trim() || !(toYen_(v[IN.COST - 1]) > 0) || !String(v[IN.IMGS - 1] || '').trim())) {
      sh.getRange(row, IN.STATUS).setValue('ページを読み取り中…');
      SpreadsheetApp.flush();
      const fr = fetchSourceInfo_(String(v[IN.URL - 1]).trim());
      if (fr.title && !String(v[IN.NAME - 1] || '').trim()) { v[IN.NAME - 1] = fr.title; sh.getRange(row, IN.NAME).setValue(fr.title); }
      if (fr.price && !(toYen_(v[IN.COST - 1]) > 0)) { v[IN.COST - 1] = fr.price; sh.getRange(row, IN.COST).setValue(fr.price); }
      if (fr.description && !String(v[IN.MEMO - 1] || '').trim()) { v[IN.MEMO - 1] = fr.description.slice(0, 3000); sh.getRange(row, IN.MEMO).setValue(v[IN.MEMO - 1]); }
      if (fr.images.length && !String(v[IN.IMGS - 1] || '').trim()) { v[IN.IMGS - 1] = fr.images.join('\n'); sh.getRange(row, IN.IMGS).setValue(v[IN.IMGS - 1]); }
      if (fr.note) sh.getRange(row, IN.RESULT).setValue(fr.note);
    }
    if (!String(v[IN.NAME - 1] || '').trim()) { sh.getRange(row, IN.STATUS, 1, 2).setValues([['エラー', '商品名を読み取れませんでした（' + (sh.getRange(row, IN.RESULT).getValue() || 'B列に商品名を入れてください') + '）']]); err++; continue; }
    // 画像の確認：開けて画像として使えるものだけ（最大24枚・順番どおり）。1枚もなければ出品しない
    const usable = usableImages_(String(v[IN.IMGS - 1] || '').split(/\n+/).map(x => x.trim()).filter(x => /^https?:\/\//.test(x)));
    if (!usable.length) {
      sh.getRange(row, IN.STATUS, 1, 2).setValues([['画像取得失敗', '使える画像を取得できなかったため、出品していません。' +
        (/mercari|paypayfleamarket|amazon|fril\.jp|rakuma|auctions\.yahoo/.test(String(v[IN.URL - 1])) ? 'このサイトは規約上、URLだけでは読み取れません。商品ページで「eBayへ送る」を押してください（コピー＆ペーストは不要です）' : '商品ページで「eBayへ送る」を押すと、画像を取得できます')]]);
      sh.getRange(row, IN.STATUS).setBackground('#f8d0d0');
      err++; continue;
    }
    v[IN.IMGS - 1] = usable.join('\n');
    sh.getRange(row, IN.IMGS).setValue(v[IN.IMGS - 1]);
    if (Date.now() - started > 4.5 * 60 * 1000) break;
    sh.getRange(row, IN.STATUS).setValue('処理中…');
    SpreadsheetApp.flush();
    try {
      // ① 入力内容を「出品作成」シートに受け渡し
      const cond = String(v[IN.COND - 1] || '中古');
      const yen = toYen_(v[IN.COST - 1]);
      if (!(yen > 0)) throw new Error('C列の仕入れ値を数字で入れてください（例：3000）');
      const wg = toYen_(v[IN.WEIGHT - 1]);
      const text = ['商品名：' + v[IN.NAME - 1], '状態：' + cond, v[IN.JAN - 1] ? 'JANコード：' + v[IN.JAN - 1] : '',
        v[IN.ORIGIN - 1] ? '原産国：' + v[IN.ORIGIN - 1] : '', v[IN.WEIGHT - 1] ? '重さ：' + v[IN.WEIGHT - 1] + 'g（梱包込み）' : '',
        '仕入れ値：' + yen + '円', '商品の説明：' + (v[IN.MEMO - 1] || '')].filter(x => x).join('\n');
      const r = new Array(PREP_HEADERS.length).fill('');
      r[P.DATE - 1] = new Date(); r[P.SRC - 1] = v[IN.URL - 1] || ''; r[P.NAME - 1] = v[IN.NAME - 1];
      r[P.COST - 1] = yen; r[P.IMGS - 1] = String(v[IN.IMGS - 1] || '');
      r[P.STATUS - 1] = '受信'; r[P.GO - 1] = false;
      r[P.RAW - 1] = JSON.stringify({ title: v[IN.NAME - 1], price: yen + '円', text: text });
      if (wg > 0) r[P.WEIGHT - 1] = wg;
      if (v[IN.ORIGIN - 1]) r[P.ORIGIN - 1] = v[IN.ORIGIN - 1];
      prep.appendRow(r);
      const prow = prep.getLastRow();
      prep.getRange(prow, P.GO).insertCheckboxes();

      // ②〜⑧ 解析・市場調査・分析・利益計算・タイトル・説明文・カテゴリと仕様
      const rqm = String(v[IN.MEMO - 1] || '').match(/［RQ:([^］]+)］/);
      if (rqm) prep.getRange(prow, P.RQREF).setValue(rqm[1]);
      const pr0 = zPrepare_(prep, prow);   // v120：トレカは0円の判定
      if (pr0 && pr0.earlyStop) { archiveRejected_(prep, prow, pr0.earlyStop); sh.getRange(row, IN.STATUS, 1, 2).setValues([['見送り', pr0.earlyStop]]); sh.getRange(row, IN.STATUS).setBackground('#f4f4f4'); rej++; continue; }
      // ⑨ 価格決定と候補の判定
      const g = gateCandidate_(prep, prow, ls);
      if (!g.ok && g.hold) {
        sh.getRange(row, IN.STATUS, 1, 2).setValues([['保留', g.reason + '／「出品作成」' + prow + '行目']]);
        sh.getRange(row, IN.STATUS).setBackground('#fef7e0');
        ok++;
      } else if (!g.ok && g.keep) {
        sh.getRange(row, IN.STATUS, 1, 2).setValues([['エラー', g.reason]]);
        sh.getRange(row, IN.STATUS).setBackground('#f8d0d0');
        err++;
      } else if (!g.ok) {
        archiveRejected_(prep, prow, g.reason, g.detailText);
        const cd = CALC_DETAIL_LAST_;
        sh.getRange(row, IN.STATUS, 1, 2).setValues([['見送り', g.reason + (cd ? '（詳細：「計算の詳細」シート ' + cd.row + '行目）' : '')]]).setBackground(null);
        sh.getRange(row, IN.STATUS).setBackground('#f4f4f4');
        rej++;
      } else {
        const goOk = /^キーワード検索（0円/.test(String(v[IN.MEMO - 1] || ''));   // v184：出品候補（0円）で あなたが GO を付けた品は、出品停止中・設定B15 オフでも出品する（GO＝出品の指示）
        if (ls.autoList || goOk) {
          const m0 = MANUAL_LIST_; if (goOk) MANUAL_LIST_ = true;
          try {
            const itemId = listRow_(prep, prow, ls);
            sh.getRange(row, IN.STATUS, 1, 2).setValues([['出品済み', 'eBay商品ID ' + itemId + '／' + g.summary]]);
            sh.getRange(row, IN.STATUS).setBackground('#c6e7c6');
          } catch (e) {
            prep.getRange(prow, P.STATUS).setValue('候補（出品エラー）');
            prep.getRange(prow, P.NOTE).setValue(zLockNote_(e.message));
            sh.getRange(row, IN.STATUS, 1, 2).setValues([['候補（出品エラー）', e.message + '／「出品作成」' + prow + '行目']]);
            sh.getRange(row, IN.STATUS).setBackground('#fde7e7');
          } finally { MANUAL_LIST_ = m0; }
        } else {
          sh.getRange(row, IN.STATUS, 1, 2).setValues([['候補', g.summary + '／「出品作成」' + prow + '行目で確認して「出品する」にチェック（設定B15をオンにすると自動で出品）']]);
          sh.getRange(row, IN.STATUS).setBackground('#d8f0d8');
        }
        ok++;
      }
    } catch (e) {
      sh.getRange(row, IN.STATUS, 1, 2).setValues([['エラー', e.message]]);
      sh.getRange(row, IN.STATUS).setBackground('#f8d0d0');
      err++;
    }
  }
  return { ok: ok, rej: rej, err: err };
}

