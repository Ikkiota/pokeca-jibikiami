    else { const sh = prepSheet_(), n = sh.getLastRow() - 1; if (n > 0) sh.getRange(2, 1, n, PREP_HEADERS.length).getValues().forEach(r => { if (String(r[P.STATUS - 1]) === '出品済み' && String(r[P.IMGS - 1] || '').split(/\n+/).some(u => Z_BANNER_RX.test(u))) targets.push(String(r[P.ITEMID - 1])); }); }
