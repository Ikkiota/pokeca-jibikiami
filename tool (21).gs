// 番号がない品：eBay の出品から番号を探す（0円）
function slFindNum_(o) {
  if (!o.en) return '';
  const graded = o.grade !== '未鑑定';
  const q = ['Pokemon', o.en.replace(/ (ex|EX|GX|V)$/, ' $1'), o.rar && o.rar !== 'Promo' ? o.rar : (o.rar === 'Promo' ? 'Promo' : ''), o.set, 'Japanese'].filter(x => x).join(' ');
  const mk = zMarket_(q, '', '', graded);
  const key = o.en.split(' & ')[0].replace(/^Mega /, '').replace(/ (ex|EX|GX|V|VMAX|VSTAR|LV\.X)$/, '').toLowerCase();
  const cnt = {}; let tot = 0;
  (mk.items || []).forEach(tt => {
    if (!/japan/i.test(tt) || /chinese|korean|english/i.test(tt) || tt.toLowerCase().indexOf(key) < 0) return;
    let c = zCardNo_(tt.replace(/(\d{1,3})\s*\/\s*(SV|SM|XY|BW|DP|S|M)\s?P\b/gi, (a, n, s) => n + '/' + s.toUpperCase() + '-P'));
    if (!c.num) return;
    if (o.set && c.set && c.set.toLowerCase() !== o.set.toLowerCase()) return;
    cnt[c.num] = (cnt[c.num] || 0) + 1; tot++;
  });
  const top = Object.keys(cnt).sort((a, b) => cnt[b] - cnt[a])[0];
  if (top && cnt[top] >= 3 && cnt[top] / tot >= 0.7) { o.note.push('番号は eBay の出品から（' + cnt[top] + '／' + tot + '件が同じ）'); return top; }
