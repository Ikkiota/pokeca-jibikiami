/* ---------- 出品ポリシーの取得 ---------- */
function fetchPolicies() {
  run_(() => {
    ensureListingSettings_();
    const out = trading_('GetUserPreferences', '<ShowSellerProfilePreferences>true</ShowSellerProfilePreferences>');
    const ns = out.ns;
    const pref = out.root.getChild('SellerProfilePreferences', ns);
    const sup = pref ? pref.getChild('SupportedSellerProfiles', ns) : null;
    const list = sup ? sup.getChildren('SupportedSellerProfile', ns) : [];
    if (!list.length) throw new Error('出品ポリシー（ビジネスポリシー）が見つかりません。eBayのセラーハブで配送・返品・支払いのポリシーを作成してください。');
    const items = list.map(p => {
      const cg = p.getChild('CategoryGroup', ns);
      return { type: p.getChildText('ProfileType', ns), name: p.getChildText('ProfileName', ns) || '', id: String(p.getChildText('ProfileID', ns)),
        isDefault: !!(cg && cg.getChildText('IsDefault', ns) === 'true') };
    });
    CacheService.getScriptCache().remove('LIVE_POLICIES');
    const s = sheet_('設定');
    // B12〜B14が空、またはeBayにないIDなら、デフォルト（なければ最初）を入れる
    const fill = (cell, t) => { const cur = String(s.getRange(cell).getValue() || '').trim(); if (cur && items.some(x => x.type === t && x.id === cur)) return;
      const d = items.find(x => x.type === t && x.isDefault) || items.find(x => x.type === t); s.getRange(cell).setNumberFormat('@').setValue(d ? d.id : ''); };
    fill('B12', 'SHIPPING'); fill('B13', 'RETURN_POLICY'); fill('B14', 'PAYMENT');
    renderPolicyList_(items);
    return 'ポリシーを ' + items.length + '件 取得しました。「設定」シートの17行目からの一覧で、使うポリシーにチェックを入れてください';
  });
}

