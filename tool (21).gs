      s.getRange('F310').insertCheckboxes().setValue(true); s.getRange('F311').setValue(150).setBackground('#fff4dc'); s.getRange('F312').setValue(150).setBackground('#fff4dc'); s.getRange('F313').insertCheckboxes().setValue(true);
