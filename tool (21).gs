function accountGuard_(what) { /* 別アカウントのツールの「出品アカウントの確認」。このツールでは使わない */ }
function menuUi_() { return SpreadsheetApp.getUi(); }
function mailOut_(to, subject, body, opt) { return opt ? MailApp.sendEmail(to, subject, body, opt) : MailApp.sendEmail(to, subject, body); }
function apSheet_(name, index) {
  const ss = ss_();
  let sh = ss.getSheetByName(name);
  if (sh) return { sh: sh, created: false };
  sh = index != null ? ss.insertSheet(name, index) : ss.insertSheet(name);
  return { sh: sh, created: true };
}
function rwHash_(o) {
  const b = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, JSON.stringify(o), Utilities.Charset.UTF_8);
  return b.map(x => ((x + 256) % 256).toString(16).padStart(2, '0')).join('');
}
// 燃油サーチャージの毎日の自動取得（11時台）
