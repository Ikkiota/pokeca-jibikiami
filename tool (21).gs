/* =====================================================================
 * 出品中の商品の価格の自動見直し（新規出品と同じ価格ルール）
 *  「最低利益を絶対に下回らない範囲で、Sold相場から現実的な市場価格を出す」（新規出品と同じ soldFirstPrice_。Soldが足りなければ変更しない）
 *  ・対象：ツールで出品した商品（仕入れ値・重さ・梱包サイズ・手数料率がそろっているもの）
 *    データがそろっていない出品は、最低利益を確かめられないので変更しない（「価格の見直し」シートに記録）
 *  ・競合は自分の出品を除いて確認。送料は今の燃油サーチャージ・為替で計算し直す
 *  ・変更前に安全チェック：変更後の想定利益が最低利益以上でなければ、絶対に変更しない
 *  ・D（高値注意）でも、最低販売価格までは下げる（それ以下には下げない）
 *  ・今の価格だと最低利益を割る場合は、最低利益を維持できる価格まで上げる
 * ===================================================================== */
function decidePrice_(minPrice, blow, low, med, pr) {
  const refHigh = Math.max(low || 0, med || 0, blow || 0);
  if (blow > 0 && minPrice <= blow) return { price: minPrice, cmpLow: blow, judge: minPrice <= blow * (1 - pr.nearPct) ? 'B：全体の最安値より安くできる' : 'A：全体の最安値を取れる' };
  if (low > 0 && minPrice <= low * (1 - pr.nearPct)) return { price: minPrice, cmpLow: low, judge: 'B：最安値より安くできる（絞った競合）' };
  if (low > 0 && minPrice <= low) return { price: minPrice, cmpLow: low, judge: 'A：最安値を取れる（絞った競合）' };
  if (refHigh > 0 && minPrice > refHigh * (1 + pr.highPct)) return { price: minPrice, cmpLow: low || blow, judge: 'D：高値注意（最低利益を維持）', high: true };
  return { price: minPrice, cmpLow: low || blow, judge: 'C：最安値にすると最低利益を割る（最低利益を維持）' };
}

