  let prepData = '';
  try {
    const ps = ss.getSheetByName('出品作成');
    if (ps && ps.getLastRow() > 1) {
      const pv = ps.getRange(2, 1, ps.getLastRow() - 1, PREP_HEADERS.length).getValues().find(v => String(v[P.ITEMID - 1]) === itemId);
      if (pv) prepData = JSON.stringify({ 出品日: pv[P.DATE - 1], 英語タイトル: pv[P.TITLE - 1], 商品名: pv[P.NAME - 1], 状態: pv[P.COND - 1], カテゴリ: pv[P.CAT - 1],
        仕入れ値: pv[P.COST - 1], 重さg: pv[P.WEIGHT - 1], 外箱: pv[P.BOX - 1], 発送方法: pv[P.METHOD - 1], 送料円: pv[P.SHIP - 1], 販売価格: pv[P.PRICE - 1],
        sold中央値: pv[P.S_MED - 1], sold件数: pv[P.S_COUNT - 1], 仕入れURL: pv[P.SRC - 1] });
    }
  } catch (e) {}
  const raw = {}; LIST_HEADERS.forEach((h, i) => { raw[h] = r[i] instanceof Date ? Utilities.formatDate(r[i], 'Asia/Tokyo', 'yyyy/MM/dd HH:mm') : r[i]; });
  const siteName = (/mercari/.test(src) ? 'メルカリ' : /paypayfleamarket/.test(src) ? 'Yahoo!フリマ' : /auctions\.yahoo/.test(src) ? 'ヤフオク' : /amazon/.test(src) ? 'Amazon' :
    ((src.match(/^https?:\/\/([^\/]+)/) || [])[1] || '').replace(/^www\./, ''));
