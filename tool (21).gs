function zNegotiation_(path, body) {
  const opt = body ? { method: 'post', contentType: 'application/json', payload: JSON.stringify(body) } : { method: 'get' };   // find_eligible_items は GET・send_offer_to_interested_buyers は POST
  const res = UrlFetchApp.fetch(EBAY_API + '/sell/negotiation/v1/' + path, { method: opt.method, contentType: opt.contentType, payload: opt.payload, muteHttpExceptions: true,
    headers: { Authorization: 'Bearer ' + getToken_('user'), 'X-EBAY-C-MARKETPLACE-ID': 'EBAY_US', Accept: 'application/json' } });
  const code = res.getResponseCode(), txt = res.getContentText();
  if (code >= 300) throw new Error('Negotiation API ' + code + '：' + txt.slice(0, 200));
  return txt ? JSON.parse(txt) : {};
}
function zSendOffersToWatchers_() {
  const out = { eligible: 0, sent: 0, skipFloor: 0, skipNoData: 0, failed: 0 };
  const items = []; let offset = 0;
  for (let k = 0; k < 10; k++) { const r = zNegotiation_('find_eligible_items?limit=200&offset=' + offset); (r.eligibleItems || []).forEach(x => items.push(String(x.listingId))); if (!r.next || !(r.eligibleItems || []).length) break; offset += 200; }
  out.eligible = items.length; if (!items.length) return out;
  const prep = prepSheet_(), n = prep.getLastRow() - 1, pmap = {};
  if (n > 0) prep.getRange(2, 1, n, PREP_HEADERS.length).getValues().forEach(v => { const id = String(v[P.ITEMID - 1] || '').trim(); if (id) pmap[id] = v; });
  const price = {}; try { const l = listSheet_(); l.getRange(2, 1, l.getLastRow() - 1, LIST_HEADERS.length).getValues().forEach(v => { price[String(v[LCOL.ID - 1]).trim()] = Number(v[LCOL.PRICE - 1]) || 0; }); } catch (e) {}
  const pct = zOfferWatchPct_(), log = offerLogSheet_(), t0 = Date.now();
  for (const id of items) {
    if (Date.now() - t0 > 4 * 60 * 1000) break;
    const pv = pmap[id], cur = price[id] || (pv ? Number(pv[P.PRICE - 1]) : 0); const when = new Date();
    if (!pv || !(cur > 0)) { out.skipNoData++; continue; }
    const floor = zOfferFloor_(pv);
    if (!(floor > 0)) { out.skipNoData++; continue; }
    const offer = Math.round(Math.max(floor, cur * (1 - pct / 100)) * 100) / 100;
    if (!(offer <= cur * 0.95)) { out.skipFloor++; continue; }   // 5％以上の値引きにならない（最低利益を守ると値引きできない）
    try {
      zNegotiation_('send_offer_to_interested_buyers', { allowCounterOffer: false, message: 'Thank you for watching! Special offer for you from Japan.', offerDuration: { unit: 'DAY', value: 2 },
        offeredItems: [{ listingId: id, price: { currency: 'USD', value: offer.toFixed(2) }, quantity: 1 }] });
      out.sent++; log.appendRow([when, id, String(pv[P.TITLE - 1] || '').slice(0, 40), 'ウォッチしている人', offer, cur, floor, 'こちらからオファーを送った', '✅ 送った（2日間有効・カウンターなし）']);
    } catch (e) { out.failed++; log.appendRow([when, id, String(pv[P.TITLE - 1] || '').slice(0, 40), 'ウォッチしている人', offer, cur, floor, 'こちらからオファーを送った', '❌ ' + String(e.message).slice(0, 150)]); }
  }
  return out;
