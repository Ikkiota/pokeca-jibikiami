  zTimed_('zOfferAllListingsJob', () => { try { const r = zOfferAllListings_(); zLog_('オファーを全部オン（出品一覧）', JSON.stringify(r)); if (r.more) ScriptApp.newTrigger('zOfferAllListingsJob').timeBased().after(60 * 1000).create(); } catch (e) { zLog_('オファーを全部オン（出品一覧）', 'エラー：' + e.message); } });
