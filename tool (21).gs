            const ext = /^https:\/\//i.test(String(u)) ? String(u) : '';   // v175：明るさ補正のURL（外のサービス）は eBay が読めないことがあるので、元の写真のURLにする
            if (!ext) throw new Error('写真の' + (i + 1) + '枚目をeBayにアップロードできませんでした（URL方式：' + e.message + '／直接アップロード：' + e2.message + '）。写真URL：' + u);
            full = ext; PIC_EXT_.push(i + 1);
            if (/SAXException|prolog/i.test(String(e.message) + String(e2.message))) TRADING_PIC_DEAD_ = true;   // v183
            if (PIC_EXT_.length === 1) try { zLog_('写真のアップロード', 'eBayの写真サーバーが受け付けなかったので、写真のURLをそのまま使う（URL方式：' + String(e.message).slice(0, 300) + '／直接：' + String(e2.message).slice(0, 200) + '）'); } catch (x) {}
          }
