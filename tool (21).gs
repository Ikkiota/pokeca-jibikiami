const AM = 'automsg';
const AM_LOG_HEADER_ROW = 13;
const AM_LOG_START = 14;
const AL = { TYPE: 1, ORDER: 2, DATE: 3, BUYER: 4, ITEM: 5, CARRIER: 6, TRACK: 7, RESULT: 8, NOTE: 9, NOTRACK: 10 };
