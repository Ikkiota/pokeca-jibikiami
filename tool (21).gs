    if (x) { sh.getRange(x.row, ZM.TIMES).setValue((Number(x.r[ZM.TIMES - 1]) || 0) + 1); return; }
    const r = new Array(ZM_HEAD.length).fill('');
    r[ZM.USE - 1] = !!o.use; r[ZM.KEY - 1] = o.key; r[ZM.EN - 1] = o.en || ''; r[ZM.JA - 1] = o.ja || ''; r[ZM.GRADE - 1] = o.grade || '未鑑定';
    r[ZM.CNT - 1] = o.count || ''; r[ZM.LOW - 1] = o.low || ''; r[ZM.CAP - 1] = o.cap || ''; r[ZM.FOUND - 1] = new Date(); r[ZM.TIMES - 1] = 1; r[ZM.CHECKED - 1] = o.low ? new Date() : '';
    r[ZM.MEMO - 1] = o.memo || '追加候補（自動で見つけた）'; r[ZM.SAVED - 1] = false; r[ZM.KEEP - 1] = false;
    const L = zLinks_(r);
    sh.appendRow(r);
    const row = sh.getLastRow();
    sh.getRange(row, ZM.USE).insertCheckboxes().setValue(!!o.use);
    sh.getRange(row, ZM.SAVED).insertCheckboxes().setValue(false);
    sh.getRange(row, ZM.KEEP).insertCheckboxes().setValue(false);
    sh.getRange(row, ZM.MERC, 1, 2).setFormulas([['=HYPERLINK("' + L[0] + '","メルカリ")', '=HYPERLINK("' + L[1] + '","Yahoo!フリマ")']]);
    idx[k] = { row: row, r: r };
    added++;
  });
  return added;
}
// 1行の相場と上限を確かめ直す
function zModelRecheck_(sh, x) {
  const r = x.r, cn = zCardNo_(r[ZM.KEY - 1]), graded = !/未鑑定/.test(String(r[ZM.GRADE - 1] || '未鑑定'));
  const q = ['Pokemon', String(r[ZM.EN - 1] || ''), cn.num, cn.set, graded ? r[ZM.GRADE - 1] : '', 'Japanese'].filter(v => v).join(' ');
  const mk = zMarket_(q, cn.num, cn.set, graded);
