/* =====================================================================
 * 燃油サーチャージの自動取得（FedEx・DHL）
 *  取得元（新しいものを使う）：
 *   ① オレンジコネックス（SpeedPAK）からの改定のお知らせメール → 既存の仕組みが正式シートに反映（1時間ごと）
 *   ② 公式ページ（FedEx：fedex.com の割増金のページ／DHL：MyDHL+ の燃油サーチャージのページ）を毎日読み、読み取れたとき
 *      DHLは公式の率にSpeedPAKの燃油割引（正式シートの値・料金表では25%）を掛ける
 *  どちらも取れないとき：最後に取れた率を使い続け（0%にはしない）、10日以上更新がなければメールでお知らせ
 *  まったく取れていないとき：F191・F192 の手入力。それも空なら、FedEx・DHLは計算に使わない
 * ===================================================================== */
const IC_FUEL_URLS = { fx: 'https://www.fedex.com/ja-jp/shipping/surcharges.html', dh: 'https://mydhl.express.dhl/jp/ja/ship/surcharges.html' };
function icFuelAuto_() {
  const out = {};
  let off = null; try { off = official_(); } catch (e) {}
  // ① 正式シート（オレンジコネックスのお知らせから自動反映）と、その反映日
  const applied = { FedEx: 0, DHL: 0 };
  try {
    const sh = ss_().getSheetByName('燃油サーチャージ');
    if (sh && sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, 6).getValues().forEach(r => {
      if (r[5] !== '反映済み' || !(r[4] instanceof Date)) return;
      String(r[2]).split('、').forEach(svc => { if (applied[svc] != null && r[4].getTime() > applied[svc]) applied[svc] = r[4].getTime(); });
    });
  } catch (e) {}
  const disc = off && off.dhl && off.dhl.fuelDisc != null ? off.dhl.fuelDisc : 0.25;
  if (off && off.fedex && off.fedex.sur > 0) out.fx = { rate: off.fedex.sur, src: '正式シート（オレンジコネックスのお知らせ）', at: applied.FedEx };
  if (off && off.dhl && off.dhl.sur > 0) out.dh = { rate: Math.round(off.dhl.sur * (1 - disc) * 10000) / 10000, src: '正式シート（オレンジコネックスのお知らせ）×SpeedPAKの割引' + Math.round(disc * 100) + '%', at: applied.DHL };
  // ② 公式ページで読み取れた率（より新しければこちら）
  let web = {}; try { web = JSON.parse(PropertiesService.getScriptProperties().getProperty('IC_FUEL_WEB') || '{}'); } catch (e) {}
  if (web.fx && (!out.fx || web.fx.at > (out.fx.at || 0))) out.fx = { rate: web.fx.rate, src: 'FedEx公式ページ（' + web.fx.period + '）', at: web.fx.at };
  if (web.dh && (!out.dh || web.dh.at > (out.dh.at || 0))) out.dh = { rate: Math.round(web.dh.rate * (1 - disc) * 10000) / 10000, src: 'DHL公式ページ（' + web.dh.period + '）×SpeedPAKの割引' + Math.round(disc * 100) + '%', at: web.dh.at };
  return out;
}
// 公式ページを読んで、今の率を取り出す（ページが画面を開いたあとに読み込む作りだと、読み取れないことがある）
function icFuelReadWeb_(key) {
  const url = IC_FUEL_URLS[key];
  let allow = false; try { allow = robotsAllow_(url); } catch (e) {}
  if (!allow) return { ok: false, why: 'robots.txt で読み取りが許可されていない' };
  let res; try { res = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true, headers: { 'User-Agent': 'Mozilla/5.0 (compatible; ebay-tool fuel check; once a day)' } }); } catch (e) { return { ok: false, why: '通信エラー：' + e.message }; }
  if (res.getResponseCode() !== 200) return { ok: false, why: 'HTTP ' + res.getResponseCode() };
  const text = (typeof domHtmlText_ === 'function' ? domHtmlText_(res.getContentText()) : res.getContentText().replace(/<[^>]+>/g, ' ')).slice(0, 12000);
  if (!/%|％/.test(text)) return { ok: false, why: 'ページに率が載っていない（画面を開いたあとに読み込む作りのため）' };
  try {
    const j = parseJson_(claude_(need_('ANTHROPIC_API_KEY'), getSettings_().model,
      'あなたは運送会社の燃油サーチャージのページを読む担当です。日本発の国際輸出（エクスプレス）に今日適用される燃油サーチャージの率を答えます。書いていないことは推測しない。出力はJSONのみ。',
      '今日：' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd') + '\nページ：' + url + '\n\n' + text + '\n\n{"rate_percent":数値またはnull,"period":"適用期間","confident":true/false}'));
    if (j && j.confident === true && Number(j.rate_percent) > 0 && Number(j.rate_percent) < 80) return { ok: true, rate: Number(j.rate_percent) / 100, period: String(j.period || '') };
    return { ok: false, why: '今日の率を確実に読み取れない' };
  } catch (e) { return { ok: false, why: 'Claudeの読み取りでエラー：' + e.message }; }
}
// 毎日：お知らせメールの確認（既存）→ 公式ページ → 表示を更新 → 古ければお知らせ
function icFuelDaily() {
  try { if (typeof fuelScanMail_ === 'function') { fuelScanMail_(); fuelApplyDue_(); } } catch (e) {}
  const p = PropertiesService.getScriptProperties();
  let web = {}; try { web = JSON.parse(p.getProperty('IC_FUEL_WEB') || '{}'); } catch (e) {}
  const notes = {};
  ['fx', 'dh'].forEach(k => { const r = icFuelReadWeb_(k); if (r.ok) web[k] = { rate: r.rate, period: r.period, at: Date.now() }; else notes[k] = r.why; });
  p.setProperty('IC_FUEL_WEB', JSON.stringify(web));
  try { OFFICIAL_CACHE_ = null; } catch (e) {}
  icSettings_._fuel = null;
  const a = icFuelAuto_();
  const s = sheet_('設定'), d = t => t ? Utilities.formatDate(new Date(t), 'Asia/Tokyo', 'yyyy/MM/dd') : '日付不明';
  const show = (row, x, k, name) => {
    s.getRange('G' + row).setValue(x ? '自動：' + (Math.round(x.rate * 1000) / 10) + '%（' + x.src + '・' + d(x.at) + '）' + (notes[k] ? '／公式ページは読めず：' + notes[k] : '') : '自動で取得できていません' + (notes[k] ? '（' + notes[k] + '）' : '') + '。F' + row + 'に手入力すると使います').setFontColor(x ? '#188038' : '#b00020');
  };
  show(191, a.fx, 'fx', 'FedEx'); show(192, a.dh, 'dh', 'DHL');
  // 10日以上更新がない（FedExは毎週改定）・まったく取れない → 週に1回お知らせ
  const stale = [['FedEx', a.fx], ['DHL', a.dh]].filter(([n, x]) => !x || !x.at || Date.now() - x.at > 10 * 86400000);
  const wk = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-ww');
  if (stale.length && typeof rwTick !== 'function' && p.getProperty('IC_FUEL_WARN') !== wk) {   // v138からは「配送料金の監視」がお知らせする
    p.setProperty('IC_FUEL_WARN', wk);
    try { mailOut_(Session.getEffectiveUser().getEmail(), '【燃油サーチャージ】' + stale.map(x => x[0]).join('・') + 'の率が自動で更新できていません',
      stale.map(([n, x]) => '・' + n + '：' + (x ? '最後に取れた率 ' + (Math.round(x.rate * 1000) / 10) + '%（' + x.src + '・' + d(x.at) + '）を使い続けています' : 'まだ一度も取れていません（' + n + 'は送料の計算に使っていません）')).join('\n') +
      '\n\nオレンジコネックスからの燃油サーチャージのお知らせメールがGmailに届いていれば、自動で反映されます。届いていない場合は、SpeedPAKの管理画面の今の率を「設定」F191（FedEx）・F192（DHL）に入れてください。\n' + ss_().getUrl()); } catch (e) {}
  }
  try { icTablesAutoRefresh_(false); } catch (e) {}
  try { if (typeof rtAutoSync_ === 'function') rtAutoSync_(); } catch (e) {}
  return a;
}
function menuIcFuelNow() { run_(() => { icEnsureFuelTrigger_(); const a = icFuelDaily(); return '燃油サーチャージ：FedEx ' + (a.fx ? (Math.round(a.fx.rate * 1000) / 10) + '%（' + a.fx.src + '）' : '取得できず') + '／DHL ' + (a.dh ? (Math.round(a.dh.rate * 1000) / 10) + '%（' + a.dh.src + '）' : '取得できず') + '。詳しくは「設定」G191・G192'; }); }

