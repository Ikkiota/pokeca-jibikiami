  const idx = {};
  rows.forEach((r, i) => { const cn = zCardNo_(r[ZM.KEY - 1]); [String(r[ZM.KEY - 1]).toLowerCase() + '|' + String(r[ZM.GRADE - 1] || '未鑑定'), cn.num ? cn.num.toLowerCase() + '|' + String(r[ZM.GRADE - 1] || '未鑑定') : ''].filter(k => k).forEach(k => { if (!idx[k]) idx[k] = { row: i + 2, r: r }; }); });
