function speedpakMaster_() {
  const sh = ss_().getSheetByName('送料マスタ');
  if (!sh || sh.getLastRow() <= SPM_TOP) return null;
  const hdr = sh.getRange(SPM_TOP, 1, 1, sh.getLastColumn()).getValues()[0];
  const data = sh.getRange(SPM_TOP + 1, 1, sh.getLastRow() - SPM_TOP, hdr.length).getValues();
  const out = { EU: {} };
  hdr.forEach((h, j) => {
    if (j === 0 || !h) return;
    const m = String(h).match(/^(US|UK|AU|EU:([A-Z]{2}))$/);
    if (!m) return;
    const list = data.filter(r => Number(r[0]) > 0 && Number(r[j]) > 0).map(r => [Number(r[0]), Number(r[j])]);
    if (m[2]) out.EU[m[2]] = list; else out[m[1]] = list;
  });
  return out;
}

function speedpakUpdate_() {
  const sh = speedpakSheet_();
  const stamp = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm');
  const fresh = {}, notes = [];
  SP_SOURCES.forEach((src, i) => {
    const row = 5 + i;
    const url = String(sh.getRange(row, 2).getValue() || src.url).trim();
    try {
      const res = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });
      if (res.getResponseCode() !== 200) throw new Error('ダウンロードできませんでした（' + res.getResponseCode() + '）。リンクが古くなっている可能性があります');
      const blob = res.getBlob().setContentType('application/zip');
      const files = {};
      Utilities.unzip(blob).forEach(b => { if (/\.xml$|\.rels$/.test(b.getName())) files[b.getName().replace(/^\//, '')] = b.getDataAsString('UTF-8'); });
      const sheets = xlsxSheetsFromXml_(files);
      const name = Object.keys(sheets).find(n => / EN$/.test(n) && !/surcharge|non-48/i.test(n)) || Object.keys(sheets)[0];
      const grid = parseRateGrid_(sheets[name] || []);
      if (src.key === 'EU') {
        const codes = Object.keys(grid).filter(k => /^[A-Z]{2}$/.test(k));
        if (codes.length < 20) throw new Error('EUの国別料金を読み取れませんでした（' + codes.length + 'か国）');
        codes.forEach(c => fresh['EU:' + c] = grid[c]);
      } else {
        if (!grid.JPY || Object.keys(grid.JPY).length < 20) throw new Error('料金を読み取れませんでした');
        fresh[src.key] = grid.JPY;
      }
      sh.getRange(row, 3, 1, 2).setValues([[stamp, '取り込みOK（' + name + '）']]).setFontColor('#188038');
    } catch (e) {
      sh.getRange(row, 3, 1, 2).setValues([[stamp, 'エラー：' + e.message]]).setFontColor('#d93025');
      notes.push(src.label + '：' + e.message);
    }
  });

  // 今の値と比べる
  const old = {};
  if (sh.getLastRow() > SPM_TOP) {
    const hdr = sh.getRange(SPM_TOP, 1, 1, sh.getLastColumn()).getValues()[0];
    const data = sh.getRange(SPM_TOP + 1, 1, sh.getLastRow() - SPM_TOP, hdr.length).getValues();
    hdr.forEach((h, j) => { if (j && h) { old[h] = {}; data.forEach(r => { if (Number(r[0]) > 0 && r[j] !== '') old[h][Number(r[0]) / 1000] = Number(r[j]); }); } });
  }
  const cols = ['US', 'UK', 'AU'].concat(Object.keys(fresh).filter(k => /^EU:/.test(k)).sort());
  const merged = {};
  cols.forEach(c => merged[c] = fresh[c] || (old[c] ? old[c] : null));   // 失敗したものは前の値のまま
  const changes = [];
  Object.keys(fresh).forEach(c => {
    if (!old[c] || !Object.keys(old[c]).length) return;
    Object.keys(fresh[c]).forEach(kg => {
      const a = old[c][Number(kg)], b = fresh[c][kg];
      if (a !== undefined && a !== b) changes.push(c.replace('EU:', '') + ' ' + kg + 'kg：' + a + '円 → ' + b + '円');
    });
  });

  // 書き込み
  const kgs = {};
  cols.forEach(c => merged[c] && Object.keys(merged[c]).forEach(k => kgs[Number(k)] = 1));
  const weights = Object.keys(kgs).map(Number).sort((a, b) => a - b);
  if (sh.getLastRow() >= SPM_TOP) sh.getRange(SPM_TOP, 1, sh.getLastRow() - SPM_TOP + 1, Math.max(sh.getLastColumn(), 1)).clearContent();
  const header = ['重量（g）まで'].concat(cols);
  const body = weights.map(kg => [Math.round(kg * 1000)].concat(cols.map(c => merged[c] && merged[c][kg] !== undefined ? merged[c][kg] : '')));
  sh.getRange(SPM_TOP, 1, 1, header.length).setValues([header]).setFontWeight('bold').setBackground('#e8f0f2');
  if (body.length) sh.getRange(SPM_TOP + 1, 1, body.length, header.length).setValues(body).setNumberFormat('#,##0');
  sh.getRange(SPM_TOP - 1, 1).setValue('最終更新：' + stamp + (changes.length ? '（' + changes.length + '件の料金変更）' : '（変更なし）')).setFontWeight('bold');
  sh.setFrozenRows(SPM_TOP);
  return { changes: changes, errors: notes };
}

