    const idx = {}; S.rows.forEach(x => idx[slKey_(x.r[SL.SET - 1], x.r[SL.NUM - 1], x.r[SL.GRADE - 1])] = x.row);
    items.forEach(o => { const row = idx[slKey_(o.set, o.num, o.grade)]; if (row && o.en) ssh.getRange(row, SL_EN_COL).setValue(o.en); });
