/* ---------- 文字の整理・カードの番号 ---------- */
function zNorm_(s) { return String(s || '').replace(/[！-～]/g, c => String.fromCharCode(c.charCodeAt(0) - 0xFEE0)).replace(/　/g, ' ').replace(/[‐－―−]/g, '-').trim(); }
// カードの番号（例：186/165・001/SV-P）とシリーズ記号（例：SV2a）
function zCardNo_(text) {
  const t = zNorm_(text);
  const m = t.match(/(?:^|[^\d])(\d{1,3})\s*\/\s*(\d{2,3}|S-P|SV-P|SM-P|XY-P|BW-P|M-P|SVP|SP)(?![\d])/i);
  const num = m ? (('00' + m[1]).slice(-3) + '/' + String(m[2]).toUpperCase().replace(/^(\d{2})$/, '0$1')) : '';
  const sm = t.match(/(?:^|[^A-Za-z0-9])((?:SV|SM|SJ|S|M)\d{1,2}[a-zA-Z]{0,2}\+?)(?![A-Za-z0-9])/i);
  const set = sm ? sm[1].replace(/^(SV|SM|SJ|S|M)/i, x => x.toUpperCase()) : '';   // 大文字・小文字は比べるときに区別しない
  return { num: num, set: set, key: num ? (set ? set + ' ' + num : num) : '' };
}
function zGraded_(text) { return /\b(PSA|BGS|CGC|ARS|SGC|TAG)\s*\d{1,2}(\.5)?\b(?!\s*(相当|級|クラス|レベル))|鑑定品|鑑定済/i.test(zNorm_(text)); }   // v202：「PSA10相当」は鑑定品ではない
// 仕入れの対象にしない言葉（まとめ・オリパ・プロキシ・空箱など）
const Z_JUNK = /[2-9２-９]枚セット|[0-9０-９]+枚組|中国語|韓国語|簡体字|繁体字|PSA\s*\d+\s*相当|まとめ|セット売り|ロット|大量|引退|オリパ|オリジナルパック|プロキシ|proxy|空箱|ケースのみ|スリーブ|デッキ|ファイル|バインダー|lot\b|bundle|custom|fan\s?made|orica|replica|海外版|英語版|韓国版|中国版|簡体|繁体/i;

/* ---------- eBayの相場（無料のBrowse API・6時間使い回す）→ 仕入れ上限 ---------- */
const Z_MK_MEM = {};   // v122：同じ実行の中での使い回し
function zMarketKey_(q, num, set, graded) { return 'ZMK:' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, [q, num, set, graded ? 1 : 0].join('|'))).slice(0, 40); }
function zMarketPath_(q) { return '/buy/browse/v1/item_summary/search?limit=100&category_ids=183454&q=' + encodeURIComponent(q) + '&filter=' + encodeURIComponent('buyingOptions:{FIXED_PRICE}'); }
function zMarket_(q, num, set, graded) {
  const ck = zMarketKey_(q, num, set, graded);
  if (Z_MK_MEM[ck]) return Z_MK_MEM[ck];
  const c = CacheService.getScriptCache(); const hit = c.get(ck); if (hit) return (Z_MK_MEM[ck] = JSON.parse(hit));
  const hdr = { 'X-EBAY-C-ENDUSERCTX': 'contextualLocation=country%3DUS%2Czip%3D10001' };
  let items = [];
  try {
    const r = ebay_('get', zMarketPath_(q), { kind: 'app', marketplace: 'EBAY_US', headers: hdr });
    items = r.itemSummaries || [];
  } catch (e) { return { count: 0, low: 0, err: String(e.message).slice(0, 80), items: [] }; }
  return zMarketStore_(ck, zMarketParse_(items, num, set, graded));
}
function zMarketStore_(ck, out) { Z_MK_MEM[ck] = out; try { CacheService.getScriptCache().put(ck, JSON.stringify(out), 21600); } catch (e) {} return out; }
// v122：まとめて同時に取りに行く（キャッシュにないものだけ）
function zMarketMany_(reqs) {
  const c = CacheService.getScriptCache(), todo = [], seen = {};
  reqs.forEach(x => { const ck = zMarketKey_(x.q, x.num, x.set, x.graded); if (seen[ck] || Z_MK_MEM[ck]) return; seen[ck] = 1; const hit = c.get(ck); if (hit) { Z_MK_MEM[ck] = JSON.parse(hit); return; } todo.push(Object.assign({ ck: ck }, x)); });
  if (!todo.length) return 0;
  let tok = ''; try { tok = getToken_('app'); } catch (e) { return 0; }
  for (let i = 0; i < todo.length; i += 20) {
    const part = todo.slice(i, i + 20);
    let res = [];
    try { res = UrlFetchApp.fetchAll(part.map(x => ({ url: EBAY_API + zMarketPath_(x.q), method: 'get', muteHttpExceptions: true,
      headers: { Authorization: 'Bearer ' + tok, Accept: 'application/json', 'X-EBAY-C-MARKETPLACE-ID': 'EBAY_US', 'X-EBAY-C-ENDUSERCTX': 'contextualLocation=country%3DUS%2Czip%3D10001' } }))); } catch (e) { return i; }
    res.forEach((r, k) => { if (r.getResponseCode() !== 200) return; try { zMarketStore_(part[k].ck, zMarketParse_(JSON.parse(r.getContentText()).itemSummaries || [], part[k].num, part[k].set, part[k].graded)); } catch (e) {} });
  }
  return todo.length;
}
function zMarketParse_(items, num, set, graded) {
  const same = items.filter(it => {
    const t = String(it.title || '');
    const cn = zCardNo_(t);
    if (num && cn.num !== num) return false;
    if (set && cn.set && cn.set.toLowerCase() !== set.toLowerCase()) return false;
    if (!/japan/i.test(t)) return false;
    if (Z_JUNK.test(t)) return false;
    return graded ? zGraded_(t) : !zGraded_(t);
  }).map(it => { const p = Number(it.price && it.price.value) || 0; const so = (it.shippingOptions || []).find(o => o.shippingCost); return p + (so ? Number(so.shippingCost.value) || 0 : 0); })
    .filter(x => x > 0).sort((a, b) => a - b);
  return { count: same.length, low: same.length ? same[0] : 0, med: same.length ? same[Math.floor(same.length / 2)] : 0, list: same.map(x => Math.round(x * 100) / 100), items: items.map(it => String(it.title || '')).slice(0, 100),
    prices: items.map(it => Number(it.price && it.price.value) || 0).slice(0, 100) };
}
// eBayの最安（送料込み）から、最低利益を守れる仕入れ上限（円）
function zCap_(lowUsd, loose) {
  if (!(lowUsd > 0)) return 0;
  const off = official_(), cs = Object.assign({}, calcSettings_());
  if (loose) cs.undercut = 0;   // v153：候補はゆるめ（値下げ分を引かない）。最低利益・利益率は今までどおり（「設定」のまま）
  const price = Math.round(lowUsd * (1 - cs.undercut) * 100) / 100;
  let plan = bestPlan_(off, cs, '183454', price, 0, Z_CARD_W, parseBox_(Z_CARD_BOX), off.tariff);
  try { const sr = zShipRule_(); if (sr.on) { const all = allPlans_(off, cs, '183454', price, 0, Z_CARD_W, parseBox_(Z_CARD_BOX), off.tariff); const pick = price < sr.border ? all['エコノミー'] : (all['FedEx'] || all['DHL']); if (pick) plan = pick; } } catch (e) {}   // v115
  if (!plan) return 0;
  const needP = Math.max(cs.minProfit, Math.ceil(price * off.rate * zMinRate_(price * off.rate) / 100));   // v188：最低利益 1,500円 かつ 利益率 5％以上
  return Math.max(0, Math.floor(price * off.rate * (1 - plan.f - plan.tRate) - plan.ship - plan.fixed - needP));
}

