 * ===================================================================== */
function zOfferWatchPct_() {
  try { const s = addSettingsSheet_(); if (s.getRange('E308').getValue() === '') { s.getRange('E308').setValue('ウォッチしている人に送るオファーの値引き（％）：最低利益・利益率を割るときは、割らない額まで').setFontWeight('bold'); s.getRange('F308').setValue(10).setBackground('#fff4dc'); }
    const v = Number(s.getRange('F308').getValue()); return v >= 5 && v <= 40 ? v : 10; } catch (e) { return 10; }
}
function zOfferAllListings_() {
  const out = { checked: 0, on: 0, already: 0, failed: 0, more: false };
  const log = offerLogSheet_(), done = {};
  if (log.getLastRow() > 1) log.getRange(2, 2, log.getLastRow() - 1, 8).getValues().forEach(r => { if (/✅/.test(String(r[7])) && /オファーをオン|すでにオン/.test(String(r[6]))) done[String(r[0]).trim()] = true; });
  const l = listSheet_(); if (l.getLastRow() < 2) return out;
  const ids = l.getRange(2, 1, l.getLastRow() - 1, LIST_HEADERS.length).getValues().filter(v => String(v[LCOL.ID - 1] || '').trim() && Number(v[LCOL.QTY - 1]) > 0).map(v => ({ id: String(v[LCOL.ID - 1]).trim(), t: String(v[LCOL.TITLE - 1] || '').slice(0, 40) })).filter(x => !done[x.id]);
  const t0 = Date.now();
  for (const x of ids) {
    if (Date.now() - t0 > 4 * 60 * 1000) { out.more = true; break; }
    out.checked++; const when = new Date();
    try {
      const st = offerItemState_(x.id);
      if (!st.active) continue;
      if (st.on) { out.already++; log.appendRow([when, x.id, x.t, '', '', st.price, '', 'すでにオン', '✅ 確認済み']); continue; }
      trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(x.id) + '</ItemID>' + offerXmlNew_(st.price, st.price) + '</Item>');
      if (!offerItemState_(x.id).on) throw new Error('オンにしたあと確かめたら、オファーがオフのままだった');
      out.on++; log.appendRow([when, x.id, x.t, '', '', st.price, '', 'オファーをオン', '✅ 確認済み']);
    } catch (e) { out.failed++; log.appendRow([when, x.id, x.t, '', '', '', '', 'オファーをオン', '❌ ' + String(e.message).slice(0, 150)]); }
  }
  return out;
}
