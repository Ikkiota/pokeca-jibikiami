// すでに国際エアパケットで出品中の品 → SpeedPAK Economy に（v141）
//  ・お客様に見える Item specifics「Shipping Method」を SpeedPAK Economy に直す（ほかの項目はそのまま）
//  ・配送ポリシー：国別送料 v2（レートテーブル）が使えればそれ、なければ Economy 用のポリシー、どちらもなければ今のまま
//  ・Economy の送料で計算し直し、最低利益を割る品は最低利益を守れる値段に上げる
//  ・1回5分まで。残りは1分後に自動で続ける
function zFixAirListings_() {
  const mp = methodPolicies_(), p = PropertiesService.getScriptProperties();
  const sh = prepSheet_(), n = sh.getLastRow() - 1;
  if (n < 1) return { done: 0, failed: 0, raised: 0, notes: [], more: false };
  const v = sh.getRange(2, 1, n, PREP_HEADERS.length).getValues();
  const off = official_(), cs = calcSettings_(), started = Date.now();
  let done = 0, failed = 0, raised = 0, more = false; const notes = [];
  let skip = {}; try { skip = JSON.parse(p.getProperty('FIXAIR_FAIL') || '{}'); } catch (e) {}
  const ns = XmlService.getNamespace('urn:ebay:apis:eBLBaseComponents');
  for (let i = 0; i < v.length; i++) {
    const r = v[i], row = i + 2, itemId = String(r[P.ITEMID - 1] || '').trim();
    if (!itemId || String(r[P.STATUS - 1]) !== '出品済み' || !/エアパケ/.test(String(r[P.METHOD - 1] || '')) || skip[itemId]) continue;
    if (Date.now() - started > 5 * 60 * 1000) { more = true; break; }
    try {
      const fx = Number(r[P.FX - 1]) || off.rate, cost = Number(r[P.COST - 1]) || 0, price = Number(r[P.PRICE - 1]) || 0;
      const w = Number(r[P.WEIGHT - 1]) || Z_CARD_W, box = parseBox_(r[P.BOX - 1] || Z_CARD_BOX), cat = String(r[P.CAT - 1] || '183454');
      let dm = { yen: 0 }; try { let raw = {}; try { raw = JSON.parse(r[P.RAW - 1] || '{}'); } catch (e) {} dm = zDomForRow_(r, raw, false); } catch (e) {}
      const pl = (allPlans_(off, Object.assign({}, cs, { methods: ['エコノミー'] }), cat, price, cost, w, box, off.tariff) || {})['エコノミー'];
      if (!pl) throw new Error('SpeedPAK Economy の送料を計算できない（重さ・大きさ）');
      const fixed = (Number(pl.fixed) || 0) + (Number(dm.yen) || 0);
      const profit = Math.round(price * fx * (1 - pl.f - pl.tRate) - cost - pl.ship - fixed);
      let newPrice = price;
      if (profit < cs.minProfit) newPrice = Math.ceil((cost + pl.ship + fixed + cs.minProfit) / (1 - pl.f - pl.tRate) / fx * 100) / 100;
      // 配送ポリシー（v2 → Economy 用 → 今のまま）
      const r2 = r.slice(); r2[P.METHOD - 1] = 'エコノミー'; r2[P.SHIP - 1] = pl.ship; r2[P.PRICE - 1] = newPrice;
      let pol = null, polXml = ''; try { const rt = rtPolicyForRow_(r2); if (rt) { pol = rt.id; polXml = rt.xml || ''; } } catch (e) {}
      if (!pol && mp.eco.id) pol = mp.eco.id;
      // Item specifics：今の項目を読んで「Shipping Method」だけ入れ替える
      const gi = trading_('GetItem', '<ItemID>' + x_(itemId) + '</ItemID><IncludeItemSpecifics>true</IncludeItemSpecifics><DetailLevel>ReturnAll</DetailLevel>');
      const item = gi.root.getChild('Item', gi.ns);
      const nvl = item && item.getChild('ItemSpecifics', gi.ns) ? item.getChild('ItemSpecifics', gi.ns).getChildren('NameValueList', gi.ns) : [];
      const specs = nvl.map(e => ({ n: e.getChildText('Name', gi.ns), v: e.getChildren('Value', gi.ns).map(x => x.getText()) })).filter(o => o.n && !/^shipping method$/i.test(o.n));
      specs.push({ n: 'Shipping Method', v: [shipMethodLabel_('エコノミー').en] });
      const specXml = '<ItemSpecifics>' + specs.slice(0, 45).map(o => '<NameValueList><Name>' + x_(o.n) + '</Name>' + o.v.slice(0, 30).map(x => '<Value>' + x_(x) + '</Value>').join('') + '</NameValueList>').join('') + '</ItemSpecifics>';
      trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(itemId) + '</ItemID>' + (newPrice !== price ? '<StartPrice>' + newPrice.toFixed(2) + '</StartPrice>' : '') + specXml +
        (pol ? '<SellerProfiles><SellerShippingProfile><ShippingProfileID>' + x_(pol) + '</ShippingProfileID></SellerShippingProfile></SellerProfiles>' + polXml : '') + '</Item>');
      sh.getRange(row, P.METHOD).setValue('エコノミー');
      sh.getRange(row, P.METHODLABEL).setValue(shipMethodLabel_('エコノミー').ja);
      sh.getRange(row, P.SHIP).setValue(pl.ship);
      if (newPrice !== price) { sh.getRange(row, P.PRICE).setValue(newPrice); raised++; }
      sh.getRange(row, P.NOTE).setValue(String(r[P.NOTE - 1] || '') + '／エアパケ → SpeedPAK Economy に直した（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd') + (pol ? '' : '・配送ポリシーは今のまま') + (newPrice !== price ? '・最低利益を守るため $' + price + ' → $' + newPrice : '・利益 ' + profit.toLocaleString() + '円') + '）');
      done++;
    } catch (e) { failed++; skip[itemId] = 1; notes.push(String(r[P.TITLE - 1] || '').slice(0, 30) + '：' + String(e.message).slice(0, 120)); }
  }
  p.setProperty('FIXAIR_FAIL', JSON.stringify(skip));
  if (more) { try { runSoon_('zFixAirContinue'); } catch (e) {} }
  zLog_('エアパケ → Economy', '直した ' + done + '件（値段を上げた ' + raised + '件）・できなかった ' + failed + '件' + (more ? '・続きは1分後に自動' : '') + (notes.length ? '：' + notes.slice(0, 5).join('／') : ''));
  return { done: done, failed: failed, raised: raised, notes: notes, more: more };
}
function zFixAirContinue() { ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'zFixAirContinue').forEach(t => ScriptApp.deleteTrigger(t)); try { zFixAirListings_(); } catch (e) { zLog_('エアパケ → Economy', 'エラー：' + e.message); } }
