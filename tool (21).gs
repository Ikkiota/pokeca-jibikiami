/* ---------- 仕入れリスト ---------- */
const PL_HEADERS = ['注文日時', '注文ID', '商品ID', '商品', '販売額（$）', '仕入れ値（円）', '仕入れURL', '利益目安（円）', '仕入れ済み', 'メモ'];

function purchaseListSheet_() {
  const ss = ss_();
  let sh = ss.getSheetByName('仕入れリスト');
  if (sh) return sh;
  sh = ss.insertSheet('仕入れリスト');
  sh.getRange(1, 1, 1, PL_HEADERS.length).setValues([PL_HEADERS]).setFontWeight('bold').setBackground('#e8f0f2');
  sh.setFrozenRows(1);
  [120, 140, 110, 360, 90, 100, 260, 100, 80, 220].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.getRange('A:A').setNumberFormat('yyyy/mm/dd hh:mm');
  sh.getRange('B:C').setNumberFormat('@');
  sh.getRange('E:E').setNumberFormat('#,##0.00');
  sh.getRange('F:F').setNumberFormat('#,##0');
  sh.getRange('H:H').setNumberFormat('#,##0');
  return sh;
}

function syncPurchaseList_() {
  const sh = ss_().getSheetByName('仕入れリスト') || purchaseListSheet_();
  const ls = listingSettings_();
  const last = sh.getLastRow();
  const have = new Set(last > 1 ? sh.getRange(2, 1, last - 1, 3).getValues().map(r => r[1] + '|' + r[2]) : []);

  // 出品一覧から、商品IDごとの仕入れURLと仕入れ値
  const src = {};
  const lsh = ss_().getSheetByName('出品一覧');
  if (lsh && lsh.getLastRow() > 1) {
    lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues().forEach(r => {
      src[String(r[LCOL.ID - 1])] = { url: r[LCOL.SRC_URL - 1], cost: Number(r[LCOL.COST - 1]) || 0 };
    });
  }

  const res = ebay_('get', '/sell/fulfillment/v1/order?limit=50&filter=' +
    encodeURIComponent('orderfulfillmentstatus:{NOT_STARTED|IN_PROGRESS}'));
  const orders = (res.orders || []).filter(o => o.orderPaymentStatus === 'PAID')
    .sort((a, b) => new Date(a.creationDate) - new Date(b.creationDate));
  let added = 0;
  orders.forEach(o => {
    if (o.cancelStatus && o.cancelStatus.cancelState && o.cancelStatus.cancelState !== 'NONE_REQUESTED') return;
    (o.lineItems || []).forEach(li => {
      const k = o.orderId + '|' + li.legacyItemId;
      if (have.has(k)) return;
      const s2 = src[String(li.legacyItemId)] || { url: '', cost: 0 };
      if (!s2.url) { try { const u = zSrcUrlOf_(String(li.legacyItemId), ''); if (u) s2.url = u; } catch (e) {} }   // v236：出品一覧にURLがなければ出品作成から
      const total = Number(li.total && li.total.value) || Number(li.lineItemCost && li.lineItemCost.value) || 0;
      const profit = s2.cost ? Math.round(total * ls.rate * (1 - ls.fee / 100) - s2.cost - ls.ship) : '';
      sh.appendRow([new Date(o.creationDate), String(o.orderId), String(li.legacyItemId), li.title || '', total,
        s2.cost || '', s2.url || '', profit, false, s2.url ? '' : '出品一覧に仕入れURLがありません']);
      try { addSoldToResearch_(li.title || '', String(li.legacyItemId), String(o.orderId)); } catch (e) {}
      try { zSoldMail_(o, li, s2, total, profit); } catch (e) { try { urgentOrderCheck_(String(li.legacyItemId), li.title || '', s2.url || '', String(o.orderId)); } catch (e2) {} }   // v236：売れるたびに仕入れ先のURLをGmailへ（今までの至急メールもこの1通にまとめた）
      const lr = sh.getLastRow();
      sh.getRange(lr, 9).insertCheckboxes();
      sh.getRange(lr, 1, 1, PL_HEADERS.length).setBackground('#fff4dc');
      have.add(k);
      added++;
    });
  });
  return { added: added };
}

function menuSyncPurchaseList() {
  run_(() => {
    const r = syncPurchaseList_();
    purchaseListSheet_().activate();
    return '仕入れリストに ' + r.added + '件 追加しました';
  });
}

// 仕入れ済みにチェックしたら、行の色を戻す
function onEditPurchaseList_(e) {
  const r = e.range, sh = r.getSheet();
  if (sh.getName() !== '仕入れリスト' || r.getColumn() !== 9 || r.getRow() < 2) return false;
  sh.getRange(r.getRow(), 1, 1, PL_HEADERS.length).setBackground(r.getValue() === true ? null : '#fff4dc');
  return true;
}


/* =====================================================================
 * 在庫アラート（朝8時・昼12時・夜20時に自動作成）
 *  ダブルチェック：
 *   ① eBay側 … 出品中の商品の在庫数を自動で取り込み直し、在庫0・売れた商品を検出
 *   ② 仕入れ先側 … 「eBayへ送る」ボタンで確認した結果（売り切れ・値上がり）を集計
 *  在庫がなくなったもの・対応が必要なものだけを「在庫アラート」シートにピックアップ
 * ===================================================================== */
const ALERT_HOURS = [0, 6, 12, 18];
const STALE_DAYS = 3; // この日数以上、仕入れ先を確認していない商品を「未確認」として表示

function stockReport() { // 時間指定の自動実行から呼ばれる
  if (zGhCareOn_()) return;   // v246：GitHub がする
  try { stockReport_(); } catch (e) { Logger.log(e); }
  try { startAutoStockRound_(); } catch (e) { Logger.log(e); }
}

function menuStockReport() {
  run_(() => {
    const r = stockReport_();
    ss_().getSheetByName('在庫アラート').activate();
    return '在庫アラートを作成しました（売り切れ ' + r.soldOut + '件・eBay在庫0 ' + r.ebayZero + '件・仕入れ待ち ' + r.toBuy + '件）';
  });
}

function stockReport_() {
  const ss = ss_();
  const notes = [];

  // ① eBay側：最新の在庫数を取り込み直す
  try { importListings_(); } catch (e) { notes.push('eBayの在庫の取り込みに失敗：' + e.message); }
  try { syncPurchaseList_(); } catch (e) { notes.push('仕入れリストの更新に失敗：' + e.message); }
  try { refreshProfit_(); } catch (e) { notes.push('利益計算の更新に失敗：' + e.message); }

  const lsh = ss.getSheetByName('出品一覧');
  const rows = lsh && lsh.getLastRow() > 1 ? lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues() : [];
  const now = Date.now();
  const fmt = d => d instanceof Date ? Utilities.formatDate(d, 'Asia/Tokyo', 'MM/dd HH:mm') : '未確認';
  const pick = r => [String(r[LCOL.ID - 1]), r[LCOL.TITLE - 1], r[LCOL.QTY - 1], r[LCOL.SRC_URL - 1] || '（仕入れURLなし）',
    fmt(r[LCOL.CHECKED - 1]), r[LCOL.SRC_STATE - 1] || ''];

  const soldOut = [], ebayZero = [], priceUp = [], stale = [];
  rows.forEach(r => {
    const state = String(r[LCOL.SRC_STATE - 1] || '');
    const qty = Number(r[LCOL.QTY - 1]) || 0;
    const checked = r[LCOL.CHECKED - 1];
    if (state.indexOf('売り切れ') >= 0) soldOut.push(pick(r));            // ② 仕入れ先で売り切れ
    else if (qty === 0) ebayZero.push(pick(r));                          // ① eBayで在庫0（売れた等）
    if (state.indexOf('値上がり') >= 0) priceUp.push(pick(r));
    if (qty > 0 && r[LCOL.SRC_URL - 1] && (!(checked instanceof Date) || now - checked.getTime() > STALE_DAYS * 86400000)) stale.push(pick(r));
  });
  stale.sort((a, b) => (a[4] === '未確認' ? -1 : 0) - (b[4] === '未確認' ? -1 : 0));
  // 在庫管理：確認が必要な商品（売り切れやすい順）と、安全装置
  const inv = inventoryRound_(lsh, rows);

  // 仕入れが必要な注文
  const toBuy = [];
  const psh = ss.getSheetByName('仕入れリスト');
  if (psh && psh.getLastRow() > 1) {
    psh.getRange(2, 1, psh.getLastRow() - 1, PL_HEADERS.length).getValues().forEach(r => {
      if (r[8] !== true) toBuy.push([String(r[2]), r[3], '', r[6] || '（仕入れURLなし）', fmt(r[0]), '注文 ' + r[1] + '／利益目安 ' + (r[7] === '' ? '—' : Number(r[7]).toLocaleString() + '円')]);
    });
  }

  // シートに書き出し
  let sh = ss.getSheetByName('在庫アラート');
  if (!sh) { sh = ss.insertSheet('在庫アラート', 0); sh.setTabColor('#d93025'); }
  sh.clear();
  sh.getRange('A1').setValue('在庫アラート　' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm') + ' 更新')
    .setFontSize(14).setFontWeight('bold');
  sh.getRange('A2').setValue('🔴 仕入れ先で売り切れ ' + soldOut.length + '件　⚠️ eBayで在庫0 ' + ebayZero.length +
    '件　🛒 仕入れ待ちの注文 ' + toBuy.length + '件　🟡 仕入れ値が上がった ' + priceUp.length + '件　⏰ ' + STALE_DAYS + '日以上未確認 ' + stale.length + '件')
    .setFontWeight('bold');
  if (notes.length) sh.getRange('A3').setValue(notes.join('／')).setFontColor('#d93025');

  const head = ['商品ID', 'タイトル', 'eBay在庫', '仕入れURL', '最終確認', '状態・メモ'];
  let row = 5;
  const section = (title, color, help, list) => {
    sh.getRange(row, 1).setValue(title + '（' + list.length + '件）').setFontWeight('bold').setFontSize(12).setFontColor(color);
    sh.getRange(row, 3).setValue(help).setFontColor('#777777');
    row++;
    if (!list.length) { sh.getRange(row, 1).setValue('なし').setFontColor('#999999'); row += 2; return; }
    sh.getRange(row, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#eeeeee');
    sh.getRange(row + 1, 1, list.length, head.length).setValues(list);
    sh.getRange(row + 1, 1, list.length, 1).setNumberFormat('@');
    row += list.length + 2;
  };
  section('🔴 仕入れ先で売り切れ', '#d93025', 'eBayの在庫は0にしてあります。別の仕入れ先を探すか、出品を終了してください', soldOut);
  section('🛒 仕入れが必要な注文', '#e37400', '売れた商品です。仕入れURLから購入し、「仕入れリスト」で「仕入れ済み」にチェック', toBuy);
  section('⚠️ eBayで在庫0', '#b06000', '売れて在庫がなくなった商品など。仕入れ先に在庫があれば、在庫数を戻せます', ebayZero);
  section('🟡 仕入れ値が上がった', '#b08000', '利益が減っている可能性があります。eBayの価格を見直してください', priceUp);
  section('🔎 在庫の確認が必要（売り切れやすい順）', '#1a73e8', inv.hours + '時間以上確認していない商品です。仕入れURLを開いて「eBayへ送る」を押すと、在庫確認が完了します', inv.toCheck.slice(0, 60));
  if (inv.paused.length) section('⏸ 安全のため一時停止（eBayの在庫を0に）', '#5f6368', inv.safeHours + '時間以上確認できなかったフリマ仕入れの商品です。在庫を確認できれば自動で戻ります', inv.paused);

  [110, 380, 70, 280, 100, 360].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(2);

  // メール通知（オンにしている場合、対応が必要なものがあるときだけ）
  try { inventoryMail_(inv, soldOut, toBuy); } catch (e) {}
  if (false && prop_('ALERT_EMAIL') === 'on' && (soldOut.length || toBuy.length || ebayZero.length)) {
    try {
      const body = [
        '在庫アラート（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）', '',
        '🔴 仕入れ先で売り切れ：' + soldOut.length + '件',
        '🛒 仕入れが必要な注文：' + toBuy.length + '件',
        '⚠️ eBayで在庫0：' + ebayZero.length + '件',
        '🟡 仕入れ値が上がった：' + priceUp.length + '件', '',
        soldOut.concat(toBuy).slice(0, 15).map(r => '・' + r[1] + '\n　' + r[3]).join('\n'), '',
        'スプレッドシート：' + ss.getUrl()].join('\n');
      MailApp.sendEmail(Session.getEffectiveUser().getEmail(), '【eBay在庫アラート】売り切れ ' + soldOut.length + '件・仕入れ待ち ' + toBuy.length + '件', body);
    } catch (e) {}
  }
  return { soldOut: soldOut.length, ebayZero: ebayZero.length, toBuy: toBuy.length };
}

function enableStockReport() {
  const ui = SpreadsheetApp.getUi();
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'stockReport').forEach(t => ScriptApp.deleteTrigger(t));
  ALERT_HOURS.forEach(h => ScriptApp.newTrigger('stockReport').timeBased().atHour(h).everyDays(1).inTimezone('Asia/Tokyo').create());
  const r = ui.alert('メール通知', '売り切れや仕入れ待ちがあるとき、Gmailにもお知らせを送りますか？', ui.ButtonSet.YES_NO);
  PropertiesService.getScriptProperties().setProperty('ALERT_EMAIL', r === ui.Button.YES ? 'on' : 'off');
  try { inventorySettings_(); sheet_('設定').getRange('F66').setValue('eBayの出品を終了する'); } catch (e) {}
  try { stockReport_(); } catch (e) {}
  try { startAutoStockRound_(); } catch (e) {}
  ui.alert('設定しました。6時間ごと（0時・6時・12時・18時ごろ）に在庫管理を行い、「在庫アラート」シートを更新します。続けて、自動で読める仕入れ先を1件ずつ確認し、売り切れ（2回確認）ならeBayの出品を取り下げて「取り下げ記録」に残します。在庫切れが見つかったときは、すぐにメールでお知らせします。' +
    (r === ui.Button.YES ? '\n対応が必要なものがあるときは、メールでもお知らせします。' : ''));
}

function disableStockReport() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'stockReport').forEach(t => ScriptApp.deleteTrigger(t));
  SpreadsheetApp.getUi().alert('在庫アラートの自動作成をやめました。');
}


/* =====================================================================
 * 利益計算（正式 ebay の計算式に準拠）
 *  利益 ＝（売上$）× 為替 ×（1 − 手数料率）− 仕入れ値 − 送料（円）− その他経費
 *  手数料率 ＝ カテゴリー別eBay手数料 ＋ 海外手数料 ＋ ペイオニア ＋ PL ＋ 3%（On時）
 *  還付込み利益 ＝ 利益 ＋ 仕入れ値 ÷ 11（消費税還付）
 *  手数料率・為替・送料表は「正式 ebay の計算式」シートから毎回読み込みます
 * ===================================================================== */
const PF_TOP = 18;
const PF = { DATE: 1, ORDER: 2, ITEM: 3, TITLE: 4, SALES: 5, CAT: 6, FRATE: 7, RATE: 8, COST: 9, WEIGHT: 10, SHIP: 11,
             OTHER: 12, SALES_J: 13, FEE_J: 14, PROFIT: 15, MARGIN: 16, REFUND: 17, STATE: 18, MEMO: 19 };
const PF_HEADERS = ['注文日時', '注文ID', '商品ID', '商品', '売上（$）', 'カテゴリID', '手数料率（正式）', '為替（円/$）',
  '仕入れ値（円）', '重量（g）', '送料（円）', 'その他経費（円）', '売上（円）', '手数料（円）', '利益（円）', '利益率',
  '還付込み利益（円）', '状態', 'メモ'];
const L_ = c => { let t = ''; while (c > 0) { const m = (c - 1) % 26; t = String.fromCharCode(65 + m) + t; c = Math.floor((c - 1) / 26); } return t; };

function profitSheet_() {
  const ss = ss_();
  let sh = ss.getSheetByName('利益計算');
  if (sh && sh.getRange(PF_TOP, PF.CAT).getValue() === 'カテゴリID') return sh;
  let old = {};
  if (sh) { old = oldProfitInputs_(sh); ss.deleteSheet(sh); }   // 以前の形式から入力値を引き継いで作り直す
  sh = ss.insertSheet('利益計算');
  sh.setTabColor('#188038');
  sh.getRange('A1').setValue('利益計算（正式 ebay の計算式）').setFontSize(14).setFontWeight('bold');
  sh.getRange('D1').setValue('黄色の列（手数料率・為替・仕入れ値・重量・送料・その他経費）は手で直せます。重量を直したら「利益計算を更新」で送料が再計算されます。')
    .setFontColor('#777777');

  const head = ['月', '件数', '売上（円）', '手数料（円）', '仕入れ（円）', '送料（円）', 'その他（円）', '利益（円）', '利益率', '還付込み利益（円）'];
  sh.getRange(3, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#e6f4ea');
  const D = '$A$' + (PF_TOP + 1) + ':$A';
  const col = c => '$' + L_(c) + '$' + (PF_TOP + 1) + ':$' + L_(c);
  for (let i = 0; i < 12; i++) {
    const r = 4 + i;
    sh.getRange(r, 1).setFormula('=DATE(YEAR(TODAY()),MONTH(TODAY())-' + i + ',1)');
    const cond = D + ',">="&$A' + r + ',' + D + ',"<"&EDATE($A' + r + ',1)';
    sh.getRange(r, 2).setFormula('=COUNTIFS(' + cond + ')');
    [[3, PF.SALES_J], [4, PF.FEE_J], [5, PF.COST], [6, PF.SHIP], [7, PF.OTHER], [8, PF.PROFIT], [10, PF.REFUND]].forEach(([c, src]) =>
      sh.getRange(r, c).setFormula('=SUMIFS(' + col(src) + ',' + cond + ')'));
    sh.getRange(r, 9).setFormula('=IF(C' + r + '=0,"",H' + r + '/C' + r + ')');
  }
  sh.getRange(16, 1).setValue('12か月合計').setFontWeight('bold');
  [2, 3, 4, 5, 6, 7, 8, 10].forEach(c => sh.getRange(16, c).setFormula('=SUM(' + L_(c) + '4:' + L_(c) + '15)'));
  sh.getRange(16, 9).setFormula('=IF(C16=0,"",H16/C16)');
  sh.getRange('A4:A15').setNumberFormat('yyyy年m月');
  sh.getRange('C4:H16').setNumberFormat('#,##0');
  sh.getRange('J4:J16').setNumberFormat('#,##0');
  sh.getRange('I4:I16').setNumberFormat('0.0%');
  sh.getRange('A16:J16').setBackground('#f1f3f4').setFontWeight('bold');

  sh.getRange(PF_TOP - 1, 1).setValue('注文ごとの明細（直近90日）').setFontWeight('bold').setFontSize(12);
  sh.getRange(PF_TOP, 1, 1, PF_HEADERS.length).setValues([PF_HEADERS]).setFontWeight('bold').setBackground('#e8f0f2').setWrap(true);
  [PF.FRATE, PF.RATE, PF.COST, PF.WEIGHT, PF.SHIP, PF.OTHER].forEach(c => sh.getRange(PF_TOP, c).setBackground('#fff4dc'));
  [120, 140, 110, 300, 75, 80, 80, 70, 85, 70, 80, 85, 85, 85, 85, 65, 95, 70, 220].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(PF_TOP);

  const prof = sh.getRange(PF_TOP + 1, PF.PROFIT, 2000, 1);
  const refund = sh.getRange(PF_TOP + 1, PF.REFUND, 2000, 1);
  const monthProfit = sh.getRange('H4:H16');
  sh.setConditionalFormatRules([
    SpreadsheetApp.newConditionalFormatRule().whenNumberLessThan(0).setBackground('#f8d0d0').setRanges([prof, refund, monthProfit]).build(),
    SpreadsheetApp.newConditionalFormatRule().whenNumberGreaterThan(0).setBackground('#d8f0d8').setRanges([prof, refund, monthProfit]).build(),
  ]);
  PropertiesService.getScriptProperties().setProperty('PROFIT_OLD_INPUTS', JSON.stringify(old));
  return sh;
}

// v16形式の利益計算シートから、手入力の値を取り出す
function oldProfitInputs_(sh) {
  const out = {};
  const last = sh.getLastRow();
  if (last <= PF_TOP) return out;
  sh.getRange(PF_TOP + 1, 1, last - PF_TOP, 16).getValues().forEach(r => {
    if (r[1]) out[String(r[1])] = { rate: r[6], cost: r[7], ship: r[8], other: r[9], memo: r[15] };
  });
  return out;
}

function refreshProfit_() {
  const sh = profitSheet_();
  const off = official_();
  const cs = calcSettings_();

  // 手入力の値を注文IDごとに退避（以前の形式からの引き継ぎも含む）
  const keep = JSON.parse(prop_('PROFIT_OLD_INPUTS') || '{}');
  PropertiesService.getScriptProperties().deleteProperty('PROFIT_OLD_INPUTS');
  const last = sh.getLastRow();
  if (last > PF_TOP) {
    sh.getRange(PF_TOP + 1, 1, last - PF_TOP, PF_HEADERS.length).getValues().forEach(r => {
      keep[String(r[PF.ORDER - 1])] = { cat: r[PF.CAT - 1], frate: r[PF.FRATE - 1], rate: r[PF.RATE - 1], cost: r[PF.COST - 1],
        weight: r[PF.WEIGHT - 1], ship: r[PF.SHIP - 1], other: r[PF.OTHER - 1], memo: r[PF.MEMO - 1], auto: r[PF.MEMO - 1] === '' };
    });
  }

  // 商品IDごとの仕入れ値・カテゴリ・重量（出品一覧・仕入れリスト・出品作成から）
  const costOf = {}, catOf = {}, weightOf = {}, dutyRateOf = {};
  const lsh = ss_().getSheetByName('出品一覧');
  if (lsh && lsh.getLastRow() > 1) lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues()
    .forEach(r => { if (Number(r[LCOL.COST - 1]) > 0) costOf[String(r[LCOL.ID - 1])] = Number(r[LCOL.COST - 1]); });
  const psh = ss_().getSheetByName('仕入れリスト');
  if (psh && psh.getLastRow() > 1) psh.getRange(2, 1, psh.getLastRow() - 1, PL_HEADERS.length).getValues()
    .forEach(r => { if (Number(r[5]) > 0 && !costOf[String(r[2])]) costOf[String(r[2])] = Number(r[5]); });
  const prep = ss_().getSheetByName('出品作成');
  if (prep && prep.getLastRow() > 1) prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues().forEach(r => {
    const id = String(r[P.ITEMID - 1] || '');
    if (!id) return;
    if (r[P.CAT - 1]) catOf[id] = String(r[P.CAT - 1]);
    if (Number(r[P.WEIGHT - 1]) > 0) weightOf[id] = Number(r[P.WEIGHT - 1]);
    dutyRateOf[id] = r[P.TRATE - 1] === '' ? undefined : Number(r[P.TRATE - 1]) / (/エコノミー|DHL|FedEx/.test(String(r[P.METHOD - 1])) ? 1.021 : 1);
    if (!costOf[id] && Number(r[P.COST - 1]) > 0) costOf[id] = Number(r[P.COST - 1]);
  });

  // 直近90日の注文
  const since = new Date(Date.now() - 90 * 24 * 3600 * 1000).toISOString();
  const orders = [];
  for (let offset = 0, page = 0; page < 10; page++, offset += 200) {
    const res = ebay_('get', '/sell/fulfillment/v1/order?limit=200&offset=' + offset + '&filter=' +
      encodeURIComponent('creationdate:[' + since + '..]'));
    (res.orders || []).forEach(o => orders.push(o));
    if (!res.next || !(res.orders || []).length) break;
  }

  const has = v => v !== undefined && v !== null && v !== '';
  const rows = [];
  orders.forEach(o => {
    if (o.orderPaymentStatus !== 'PAID' && o.orderPaymentStatus !== 'PARTIALLY_REFUNDED') return;
    if (o.cancelStatus && o.cancelStatus.cancelState === 'CANCELED') return;
    const ps = o.pricingSummary || {};
    const itemPrice = Number(ps.priceSubtotal && ps.priceSubtotal.value) || 0;
    const sales = itemPrice + (Number(ps.deliveryCost && ps.deliveryCost.value) || 0);   // 販売価格＋送料$
    const items = o.lineItems || [];
    const itemIds = items.map(li => String(li.legacyItemId));
    const firstId = itemIds[0] || '';
    const k = keep[String(o.orderId)] || {};
    const memo = [];

    // カテゴリ（手入力 → 出品作成 → eBayから取得）
    let cat = has(k.cat) ? String(k.cat) : (catOf[firstId] || '');
    if (!cat && firstId) {
      try { cat = String(ebay_('get', '/buy/browse/v1/item/get_item_by_legacy_id?legacy_item_id=' + firstId, { kind: 'app', marketplace: 'EBAY_US' }).categoryId || ''); }
      catch (e) {}
    }
    const autoF = feeRate_(off, cat, itemPrice, cs.method);
    if (!cat || off.catMap[cat] === undefined) memo.push('カテゴリ手数料は既定の' + (off.defaultFee * 100).toFixed(1) + '%');
    const weight = has(k.weight) ? Number(k.weight) : (weightOf[firstId] || cs.weight);
    const shipR = shipYen_(off, cs.method, weight, sales);
    const autoCost = itemIds.reduce((sum, id, i) => sum + (costOf[id] || 0) * (Number(items[i].quantity) || 1), 0);
    if (!has(k.cost) && !autoCost) memo.push('仕入れ値を入力してください');
    if (shipR.yen === null) memo.push(weight + 'gは' + cs.method + 'で送れません');
    // 重量を手で変えた場合は送料を再計算。送料だけ手で直した場合はその値を使う
    const weightChanged = has(k.weight) && has(k.ship) && k.weight !== '' && Math.round(shipYen_(off, cs.method, Number(k.weight), sales).yen || 0) !== Number(k.ship);
    const ship = has(k.ship) && !weightChanged ? k.ship : (shipR.yen === null ? '' : Math.round(shipR.yen));
    // その他経費の初期値：梱包材＋（米国向けなら）関税・通関手数料
    const fsi = (o.fulfillmentStartInstructions || [])[0];
    const country = fsi && fsi.shippingStep && fsi.shippingStep.shipTo && fsi.shippingStep.shipTo.contactAddress
      ? fsi.shippingStep.shipTo.contactAddress.countryCode : '';
    const itemDuty = dutyRateOf[firstId] !== undefined && !isNaN(dutyRateOf[firstId]) ? dutyRateOf[firstId] : off.tariff;
    const du = dutyParts_(off, cs, cs.method, Number(has(k.cost) ? k.cost : autoCost) || 0, itemDuty, itemPrice);
    const autoOther = country === 'US' ? Math.round(itemPrice * off.rate * du.tRate + du.fixed) : cs.pack;
    if (!has(k.other)) memo.push(country === 'US' ? 'その他経費＝関税・通関・梱包' : 'その他経費＝梱包');

    rows.push([
      new Date(o.creationDate), String(o.orderId), itemIds.join(', '), items.map(li => li.title).join(' / '),
      sales, cat, has(k.frate) ? k.frate : autoF, has(k.rate) ? k.rate : off.rate,
      has(k.cost) ? k.cost : (autoCost || ''), weight, ship, has(k.other) ? k.other : autoOther,
      '', '', '', '', '', o.orderFulfillmentStatus === 'FULFILLED' ? '発送済み' : '未発送',
      (k.memo && !k.auto) ? k.memo : memo.join('／')
    ]);
  });
  rows.sort((a, b) => b[0] - a[0]);

  if (last > PF_TOP) sh.getRange(PF_TOP + 1, 1, last - PF_TOP, PF_HEADERS.length).clearContent();
  if (rows.length) {
    sh.getRange(PF_TOP + 1, 1, rows.length, PF_HEADERS.length).setValues(rows);
    const f = [];
    for (let i = 0; i < rows.length; i++) {
      const r = PF_TOP + 1 + i;
      const c = n => L_(n) + r;
      f.push([
        '=IF(' + c(PF.SALES) + '="","",ROUND(' + c(PF.SALES) + '*' + c(PF.RATE) + ',0))',
        '=IF(' + c(PF.SALES_J) + '="","",ROUND(' + c(PF.SALES_J) + '*' + c(PF.FRATE) + ',0))',
        '=IF(' + c(PF.COST) + '="","",' + c(PF.SALES_J) + '-' + c(PF.FEE_J) + '-' + c(PF.COST) + '-N(' + c(PF.SHIP) + ')-N(' + c(PF.OTHER) + '))',
        '=IF(OR(' + c(PF.PROFIT) + '="",' + c(PF.SALES_J) + '=0),"",' + c(PF.PROFIT) + '/' + c(PF.SALES_J) + ')',
        '=IF(' + c(PF.PROFIT) + '="","",ROUND(' + c(PF.PROFIT) + '+' + c(PF.COST) + '/11,0))']);
    }
    sh.getRange(PF_TOP + 1, PF.SALES_J, rows.length, 5).setFormulas(f);
    const body = n => sh.getRange(PF_TOP + 1, n, rows.length, 1);
    body(PF.DATE).setNumberFormat('yyyy/mm/dd hh:mm');
    body(PF.ORDER).setNumberFormat('@');
    body(PF.CAT).setNumberFormat('@');
    body(PF.SALES).setNumberFormat('#,##0.00');
    body(PF.FRATE).setNumberFormat('0.00%');
    body(PF.RATE).setNumberFormat('0.00');
    [PF.COST, PF.WEIGHT, PF.SHIP, PF.OTHER, PF.SALES_J, PF.FEE_J, PF.PROFIT, PF.REFUND].forEach(n => body(n).setNumberFormat('#,##0'));
    body(PF.MARGIN).setNumberFormat('0.0%');
    [PF.FRATE, PF.RATE, PF.COST, PF.WEIGHT, PF.SHIP, PF.OTHER].forEach(n => body(n).setBackground('#fffaf0'));
  }
  return { count: rows.length };
}

function menuProfit() {
  run_(() => {
    const r = refreshProfit_();
    profitSheet_().activate();
    return '直近90日の注文 ' + r.count + '件 で利益を計算しました';
  });
}


/* =====================================================================
 * 正式 ebay の計算式（Googleスプレッドシート）の読み込みと計算
 * ===================================================================== */
const OFFICIAL_ID_DEFAULT = '1J5q8dhNQ-8AN6uwBfErNCUJyrauoYhwx34Y8gQ2L0ok';
const SHIP_METHODS = ['エアパケ(US)', 'エアパケ(EU)', 'EMS', '印刷物書留', '書状書留', 'エコノミー', 'FedEx', 'DHL'];
const JP_POST_METHODS = ['エアパケ(US)', 'エアパケ(EU)', 'EMS', '印刷物書留', '書状書留'];
let OFFICIAL_CACHE_ = null;

// 設定シートの E7:F10 に「正式計算式」の設定を用意
function calcSettings_() {
  const s = sheet_('設定');
  if (s.getRange('E7').getValue() === '') {
    s.getRange('E7').setValue('■ 正式 ebay の計算式').setFontWeight('bold');
    s.getRange('E8:E10').setValues([['計算式シートのID'], ['配送方法'], ['重量が分からないときの重量（g）']]).setFontWeight('bold');
    s.getRange('F8').setValue(OFFICIAL_ID_DEFAULT);
    s.getRange('F9').setValue(SHIP_METHODS[0])
      .setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(SHIP_METHODS).build());
    s.getRange('F10').setValue(500);
    s.getRange('E11').setValue('手数料率・為替・送料表は、正式 ebay の計算式シートから読み込みます。数字を変えたいときは、そちらのシートを直してください。')
      .setFontColor('#777777').setWrap(true);
    s.setColumnWidth(5, 220).setColumnWidth(6, 260);
    s.getRange('F8:F10').setBackground('#fff4dc');
  }
  ensureCostSettings_(s);
  ensureFedexZoneSetting_(s);
  ensureZeroDutySetting_(s);
  ensureMinProfitSetting_(s);
  ensurePricingSettings_(s);
  ensureShipPreferSetting_(s);
  ensureAdSettings_(s);
  const v = s.getRange('F8:F10').getValues().map(x => x[0]);
  const c = s.getRange('F14:F20').getValues().map(x => x[0]);
  const methods = String(c[6] || '').split(/[,、，\s]+/).map(x => x.trim()).filter(x => SHIP_METHODS.indexOf(x) >= 0);
  return {
    id: String(v[0] || OFFICIAL_ID_DEFAULT).trim(),
    method: SHIP_METHODS.indexOf(v[1]) >= 0 ? v[1] : SHIP_METHODS[0],
    weight: Number(v[2]) || 500,
    foreignRate: pct_(c[0]), clearance: Number(c[1]) || 0, pack: Number(c[2]) || 0,
    boxCd: String(c[3] || ''), boxGame: String(c[4] || ''), boxOther: String(c[5] || ''),
    methods: zShipMethods_(methods.length ? methods : ['エアパケ(US)', 'エコノミー', 'FedEx', 'DHL']),   // v115：エアパケなし・FedExを入れる（「追加の設定」F265・F266）
    fedexZoneF: !/Zone E/.test(String(s.getRange('F23').getValue())),
    zeroDutyTypes: String(s.getRange('F26').getValue() || '').split(/[,、・，\s]+/).map(normType_).filter(x => x && x !== 'other'),
    minProfit: Number(s.getRange('F29').getValue()) || 1500,
    prefer: zShipMethods_(String(s.getRange('F36').getValue() || 'エコノミー,エアパケ(US)').split(/[,、，\s]+/).map(x => x.trim()).filter(x => SHIP_METHODS.indexOf(x) >= 0)),
    outlierGap: Number(s.getRange('F32').getValue()) || 20,
    undercut: pct_(s.getRange('F33').getValue() === '' ? 0.01 : s.getRange('F33').getValue()),
  };
}

// 設定シートの E13:F21 に「関税・梱包・外箱」の設定を用意
function ensureCostSettings_(s) {
  if (s.getRange('E13').getValue() !== '') return;
  s.getRange('E13').setValue('■ 関税・梱包・外箱').setFontWeight('bold');
  s.getRange('E14:E20').setValues([['関税率（日本以外の原産国）'], ['通関手数料（日本郵便・1件・円）'], ['梱包材の費用（1件・円）'],
    ['外箱サイズ：CD（縦x横x高さ cm）'], ['外箱サイズ：ゲーム'], ['外箱サイズ：その他'], ['候補の計算に使う配送方法']]).setFontWeight('bold');
  s.getRange('F14').setValue(0.30).setNumberFormat('0%');
  s.getRange('F15:F16').setValues([[300], [200]]);
  s.getRange('F17:F19').setValues([['20x15x5'], ['25x20x8'], ['30x25x10']]);
  s.getRange('F20').setValue('エアパケ(US),エコノミー,FedEx,DHL');
  s.getRange('E21').setValue('日本製の関税率は、正式 ebay の計算式シートの「関税率」（L4）を使います。日本以外（中国製など）の税率・通関手数料は目安なので、Zonosの見積もりツールなどで確認して直してください。' +
    '候補は、ここに並べた配送方法の中で一番利益が出る方法で計算します。').setFontColor('#777777').setWrap(true);
  s.getRange('F14:F20').setBackground('#fff4dc');
  s.getRange('F9').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(SHIP_METHODS).build());
}

// FedExの料金地域（正式シートは米国西部＝Zone E。米国のほとんどの州は Zone F）
function ensureFedexZoneSetting_(s) {
  if (s.getRange('E23').getValue() !== '') return;
  s.getRange('E23').setValue('FedExの料金地域').setFontWeight('bold');
  s.getRange('F23').setValue('Zone F（米国その他・カナダ）').setBackground('#fff4dc')
    .setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Zone F（米国その他・カナダ）', 'Zone E（米国西部）']).build());
  s.getRange('E24').setValue('Zone E（西部）はカリフォルニア・ワシントン・オレゴン・ネバダ・アリゾナ・ユタ・アイダホ。それ以外の州は Zone F で、1〜2%高くなります（SpeedPAK via FedEx 料金表 2026/10/01）。')
    .setFontColor('#777777').setWrap(true);
}

function parseBox_(t) {
  const n = String(t || '').split(/[x×*\s]+/i).map(Number).filter(v => v > 0);
  if (n.length < 3) return { l: 0, w: 0, h: 0 };
  n.sort((a, b) => b - a);   // 一番長い辺を「長さ」に
  return { l: n[0], w: n[1], h: n[2] };
}

function pct_(x) {
  if (x === '' || x === null || x === undefined) return 0;
  if (typeof x === 'number') return x > 1 ? x / 100 : x;
  const t = String(x).trim();
  const n = parseFloat(t.replace('%', ''));
  if (isNaN(n)) return 0;
  return t.indexOf('%') >= 0 || n > 1 ? n / 100 : n;
}

function official_() {
  if (OFFICIAL_CACHE_) return OFFICIAL_CACHE_;
  const cs = calcSettings_();
  let book;
  try { book = SpreadsheetApp.openById(cs.id); }
  catch (e) { throw new Error('正式 ebay の計算式シートを開けませんでした。「設定」シートのF8（計算式シートのID）を確認してください'); }
  const calc = book.getSheetByName('計算式');
  if (!calc) throw new Error('正式 ebay の計算式に「計算式」シートがありません');
  const top = calc.getRange('B2:L4').getValues();
  const r4 = top[2];
  const off = {
    rate: Number(top[0][0]) || 150,
    buyerShip: Number(top[0][1]) || 0,
    intl: pct_(r4[5]), payoneer: pct_(r4[6]), pl: pct_(r4[7]),
    plus3: /^on/i.test(String(r4[8]).trim()),
    stamp: pct_(r4[9]), tariff: pct_(r4[10]),
    defaultFee: 0.127,
  };
  // 送料表
  const ship = book.getSheetByName('送料');
  if (!ship) throw new Error('正式 ebay の計算式に「送料」シートがありません');
  const sv = ship.getRange('A1:M89').getValues();
  const tbl = (r1, r2, cw, cp) => {
    const out = [];
    for (let r = r1; r <= r2; r++) {
      const w = Number(sv[r - 1][cw]), y = Number(sv[r - 1][cp]);
      if (w > 0 && y > 0) out.push([w, y]);
    }
    return out;
  };
  off.ship = {
    'エアパケ(US)': tbl(2, 21, 8, 9),
    'エアパケ(EU)': tbl(2, 21, 1, 2),
    'EMS': tbl(23, 64, 1, 2),
    '印刷物書留': tbl(66, 89, 1, 2),
    '書状書留': tbl(2, 7, 11, 12),
  };
  const eco = book.getSheetByName('エコノミー送料');
  if (eco) {
    off.ship['エコノミー'] = eco.getRange('C10:D75').getValues().filter(r => Number(r[0]) > 0 && Number(r[1]) > 0).map(r => [Number(r[0]), Number(r[1])]);
    off.ecoSurcharge = pct_(eco.getRange('G11').getValue());
  } else {
    off.ship['エコノミー'] = [];
    off.ecoSurcharge = 0;
  }
  // FedEx・DHL（正式シートの送料計算をそのまま再現するための値）
  const col2 = (sh, r1, r2) => sh.getRange(r1, 3, r2 - r1 + 1, 2).getValues().filter(r => Number(r[0]) > 0 && Number(r[1]) > 0).map(r => [Number(r[0]), Number(r[1])]);
  const fx = book.getSheetByName('FedEx 送料');
  if (fx) {
    const t = fx.getRange('D3:F3').getValues()[0];
    off.fedex = { table: col2(fx, 21, 108), sur: pct_(t[0]), per500: Number(t[1]) || 0, disc: pct_(t[2]) };
  }
  const dh = book.getSheetByName('DHL\u3000送料') || book.getSheetByName('DHL 送料');
  if (dh) {
    const t = dh.getRange('D3:J3').getValues()[0];   // D:サーチャージ E:割引 F:割増 G:Cpass割引 H:- I:Regulatory J:Duty Tax Paid
    off.dhl = { table: col2(dh, 21, 77), sur: pct_(t[0]), fuelDisc: pct_(t[1]), per500: Number(t[2]) || 0, disc: pct_(t[3]), regulatory: t[5] === true, dutyPaid: t[6] === true };
  }
  off.mpf = Number(calc.getRange('L8').getValue()) || 0;
  if (off.fedex && cs.fedexZoneF) off.fedex.table = FEDEX_FICP_ZONE_F.map(r => r.slice());
  const sp = speedpakMaster_();
  if (sp && sp.US && sp.US.length) off.ship['エコノミー'] = sp.US;
  off.speedpak = sp;
  // カテゴリー手数料一覧（3〜7行目：ベース手数料・割引の条件、8行目以降：カテゴリ番号）
  const catSh = book.getSheetByName('カテゴリー手数料一覧');
  off.catMap = {};
  off.catParams = [];
  if (catSh) {
    const lastCol = Math.min(catSh.getLastColumn(), 26);
    off.catParams = catSh.getRange(3, 2, 5, lastCol - 1).getValues();
    const lastRow = catSh.getLastRow();
    if (lastRow >= 8) {
      catSh.getRange(8, 2, lastRow - 7, lastCol - 1).getValues().forEach(row => {
        row.forEach((v, j) => { if (v !== '' && v !== null) { const key = String(v).trim(); if (off.catMap[key] === undefined) off.catMap[key] = j; } });
      });
    }
  }
  OFFICIAL_CACHE_ = off;
  return off;
}

// カテゴリー別のeBay手数料（高額商品の割引も反映）
function catFee_(off, catId, price) {
  const j = off.catMap[String(catId || '').trim()];
  if (j === undefined) return off.defaultFee;
  const p = off.catParams;
  const num = v => typeof v === 'number' && !isNaN(v);
  const base = p[0][j], t1 = p[1][j], r1 = p[2][j], t2 = p[3][j], r2 = p[4][j];
  if (num(t2) && num(r2) && price >= t2) return r2;
  if (num(t1) && price >= t1) return num(r1) ? r1 : 0;
  return num(base) ? base : off.defaultFee;
}

// 手数料率の合計（EMS・印刷物書留・書状書留はペイオニアを掛け算で反映＝正式シートと同じ）
function feeRate_(off, catId, price, method) {
  if (zTbOn_()) return Z_TB.fee + Z_TB.ad;   // v256：教科書の見積の式（eBay手数料15%＋広告2.2%）
  const a = catFee_(off, catId, price) + off.intl + off.pl + (off.plus3 ? 0.03 : 0);
  const mult = ['EMS', '印刷物書留', '書状書留'].indexOf(method) >= 0;
  return mult ? 1 - (1 - a) * (1 - off.payoneer) : a + off.payoneer;
}

// 重量・外箱サイズから送料（円）。送れない重さ・サイズなら yen: null
//  関税は含めない（dutyParts_ で別に計算）
function shipYen_(off, method, weightG, priceUsd, box) {
  box = box || { l: 0, w: 0, h: 0 };
  const vol = box.l * box.w * box.h;
  if (method === 'FedEx' || method === 'DHL') {
    const d = method === 'FedEx' ? off.fedex : off.dhl;
    if (!d || !d.table.length) return { yen: null };
    if (method === 'FedEx' && box.l && (box.l > 274 || box.l + 2 * box.w + 2 * box.h > 330)) return { yen: null };
    const w = Math.max(weightG, Math.ceil(vol / 5));                 // 容積重量（÷5000kg）
    const key = w <= 20000 ? Math.ceil(w / 500) * 500 : Math.ceil(w / 1000) * 1000;
    const hit = d.table.find(r => r[0] >= key);
    if (!hit) return { yen: null };
    const base = hit[1];
    const applied = Math.max(weightG, vol / 8);
    const extra = Math.ceil(Math.floor(applied * 10) / 10 / 500) * d.per500;
    // DHL：燃油サーチャージは現在25%割引（SpeedPAK via DHL 料金表 2026/10/01）＝正式シートのE3
    const sur = method === 'FedEx' ? (base + extra) * d.sur : (base + extra) * d.sur * (1 - (d.fuelDisc || 0)) * (1 - d.disc);
    const disc = -(base + sur) * d.disc;
    const y = x => Math.round(x).toLocaleString() + '円';
    const fuelNote = method === 'FedEx' ? '×' + (d.sur * 100).toFixed(2) + '%' : '×' + (d.sur * 100).toFixed(2) + '%×（1−割引' + Math.round((d.fuelDisc || 0) * 100) + '%）';
    return { yen: base + sur + disc + extra,
      text: method + '：実重量' + weightG + 'g・容積重量' + Math.ceil(vol / 5) + 'g（' + (box.l ? box.l + '×' + box.w + '×' + box.h + 'cm÷5000' : '外箱なし') + '）→ ' + key + 'g区分の基本料金 ' + y(base) +
        (extra ? '＋割増 ' + y(extra) : '') + '＋燃油サーチャージ ' + y(sur) + '（' + fuelNote + '）' + (disc ? '－割引 ' + y(-disc) : '') + ' ＝ ' + y(base + sur + disc + extra) };
  }
  if (method === 'エコノミー') {
    // Orange Connex Economy（米国）の条件：商品価格1,200ドルまで・長さ66cmまで・長さ＋2×(幅＋高さ)≦274cm・25kgまで
    if ((priceUsd || 0) > 1200) return { yen: null };
    if (box.l && (box.l > 66 || box.l + 2 * (box.w + box.h) > 274)) return { yen: null };
    const w = Math.max(weightG, vol / 8);
    const hit = (off.ship['エコノミー'] || []).find(r => r[0] >= w);
    if (!hit) return { yen: null };
    const fuel = Math.round(hit[1] * off.ecoSurcharge);
    return { yen: hit[1] + fuel,
      text: 'エコノミー（SpeedPAK Economy 米国）：実重量' + weightG + 'g・容積重量' + Math.round(vol / 8) + 'g（' + (box.l ? box.l + '×' + box.w + '×' + box.h + 'cm÷8000' : '外箱なし') + '）→ ' +
        hit[0] + 'g区分の基本料金 ' + hit[1].toLocaleString() + '円＋燃油サーチャージ ' + fuel.toLocaleString() + '円（' + (off.ecoSurcharge * 100).toFixed(1) + '%）＝ ' + (hit[1] + fuel).toLocaleString() + '円' };
  }
  // 国際エアパケット：2kgまで・長さ60cmまで・長さ＋幅＋厚さ90cmまで（日本郵便 公式サイト）
  if ((method === 'エアパケ(US)' || method === 'エアパケ(EU)') && box.l && (box.l > 60 || box.l + box.w + box.h > 90)) return { yen: null };
  const t = off.ship[method] || [];
  const hit = t.find(r => r[0] >= weightG);
  if (!hit) return { yen: null };
  return { yen: hit[1] * (1 - off.stamp),
    text: method + '（日本郵便）：' + weightG + 'g → ' + hit[0] + 'g区分の料金 ' + hit[1].toLocaleString() + '円' +
      (off.stamp ? '×（1−割引切手' + Math.round(off.stamp * 100) + '%）' : '') + ' ＝ ' + Math.round(hit[1] * (1 - off.stamp)).toLocaleString() + '円' };
}

// 関税（米国向けDDP）と固定費。tRate＝販売価格に掛かる率、fixed＝金額で掛かる費用（円）
//  日本郵便・エコノミー：販売価格 × 関税率（＋日本郵便は通関手数料）
//  FedEx・DHL：正式シートと同じく 仕入れ値 × 関税率 × 1.021（＋DHL手数料・MPF）
//  関税は「申告価格＝販売価格（送料を除く）」に掛かる（DHL・エコノミーの公式料金表より）
//  ・エコノミー：関税×1.021（関税処理手数料2.1%）＋米国輸入通関手数料245円
//  ・DHL：関税×1.021＋現地税金元払い請求手数料（関税の2%・最低850円）＋規制手数料1.38ドル（米国向けDDPは必須）
//  ・FedEx（FICP）：関税×1.021＋商業貨物税関使用料（簡易通関）2.77ドル×1.021（SpeedPAK via FedEx 料金表 2026/10/01）
//    個人宅向け配達料・地域外配達料・輸入手続き手数料は FICP は無料
const DDP_FEES = { ecoClearanceYen: 245, dutyProcessing: 0.021, dhlDutyTaxPaidRate: 0.02, dhlDutyTaxPaidMinYen: 850, dhlRegulatoryUsd: 1.38,
                   fedexMpfUsd: 2.77 };
function dutyParts_(off, cs, method, cost, originRate, priceUsd) {
  let tRate = 0, fixed = cs.pack;
  const F = DDP_FEES;
  const parts = ['梱包材 ' + cs.pack + '円'];
  const y = x => Math.round(x).toLocaleString() + '円';
  if (JP_POST_METHODS.indexOf(method) >= 0) { tRate = originRate; fixed += cs.clearance; parts.push('通関手数料（Zonos）' + y(cs.clearance)); }
  else if (method === 'エコノミー') { tRate = originRate * (1 + F.dutyProcessing); fixed += F.ecoClearanceYen; parts.push('米国輸入通関手数料 ' + y(F.ecoClearanceYen)); }
  else if (method === 'DHL') {
    tRate = originRate * (1 + F.dutyProcessing);
    const duty = (priceUsd || 0) * off.rate * originRate;
    const dtp = Math.max(duty * F.dhlDutyTaxPaidRate, F.dhlDutyTaxPaidMinYen), reg = F.dhlRegulatoryUsd * off.rate;
    fixed += dtp + reg;
    parts.push('現地税金元払い手数料 ' + y(dtp) + '（関税の2%・最低850円）', '規制手数料 ' + y(reg) + '（$' + F.dhlRegulatoryUsd + '）');
  }
  else if (method === 'FedEx') {
    tRate = originRate * (1 + F.dutyProcessing);
    const mpf = F.fedexMpfUsd * off.rate * (1 + F.dutyProcessing);
    fixed += mpf;
    parts.push('税関使用料 ' + y(mpf) + '（$' + F.fedexMpfUsd + '×1.021）');
  }
  else {
    fixed += Math.round(cost * originRate * 1.021) + off.mpf * off.rate;
  }
  const dutyTxt = originRate ? '関税 ' + (originRate * 100).toFixed(1) + '%' + (tRate !== originRate ? '×1.021（関税処理手数料）' : '') + '＝販売価格の' + (tRate * 100).toFixed(2) + '%' : '関税 0%';
  if (zTbOn_()) return { tRate: Z_TB.duty, fixed: Math.round(fixed), text: parts.join('＋') + ' ＝ ' + y(fixed), dutyText: '教科書の見積：関税（米国向け）15%（販売価格の15%）' };   // v256
  return { tRate: tRate, fixed: Math.round(fixed), text: parts.join('＋') + ' ＝ ' + y(fixed), dutyText: dutyTxt };
}

// 使う配送方法の中で、一番利益が出るものを選ぶ
function bestPlan_(off, cs, catId, priceUsd, cost, weightG, box, originRate) {
  let best = null;
  cs.methods.forEach(m => {
    const sr = shipYen_(off, m, weightG, priceUsd, box);
    if (sr.yen === null) return;
    const f = feeRate_(off, catId, priceUsd, m);
    const d = dutyParts_(off, cs, m, cost, originRate, priceUsd);
    const profit = priceUsd * off.rate * (1 - f - d.tRate) - cost - sr.yen - d.fixed;
    if (!best || profit > best.profit) best = { method: m, f: f, ship: Math.round(sr.yen), tRate: d.tRate, fixed: d.fixed, profit: profit,
      shipText: sr.text || '', fixedText: d.text || '', dutyText: d.dutyText || '', feeText: feeText_(off, catId, priceUsd, m) };
  });
  return best;
}


// 注文IDを指定して、発送後メッセージを手動で送る（自動で送られなかったとき用）
function sendShipMessageForOrder() {
  const ui = SpreadsheetApp.getUi();
  const res = ui.prompt('発送後メッセージを送る', '注文ID（例：12-34567-89012）を入力してください。\\neBayのセラーハブの注文詳細や「利益計算」シートのB列で確認できます。', ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return;
  const orderId = res.getResponseText().trim();
  if (!orderId) return;
  try {
    const sh = autoMsgSheet_();
    const o = ebay_('get', '/sell/fulfillment/v1/order/' + encodeURIComponent(orderId));
    const t = findTracking_(orderId);
    if (!t) {
      const ok = ui.alert('追跡番号が見つかりません', 'eBayにこの注文の追跡番号が登録されていません。\\n追跡なしの文面（B10）で送りますか？', ui.ButtonSet.YES_NO);
      if (ok !== ui.Button.YES) return;
    }
    const r = sendShipMsg_(sh, o, t ? t.number : '', t ? t.carrier : '');
    const b = orderBasics_(o);
    // 記録：既存の行があれば更新、なければ追加
    const data = amLog_(sh);
    const idx = data.findIndex(x => x[0] === '発送後' && String(x[AL.ORDER - 1]) === orderId);
    const row = ['発送後', orderId, t && t.shippedDate ? new Date(t.shippedDate) : new Date(), b.buyer, b.itemTitle,
      r.carrier, t ? t.number : '', '送信済み', amStamp_() + '（手動で送信）', ''];
    if (idx >= 0) sh.getRange(AM_LOG_START + idx, 1, 1, row.length).setValues([row]);
    else sh.appendRow(row);
    ui.alert('送信しました', b.buyer + ' さんに発送後メッセージを送りました' + (t ? '（追跡番号：' + t.number + '）' : '（追跡なし）') + '。', ui.ButtonSet.OK);
  } catch (e) {
    ui.alert('エラー：' + e.message);
  }
}


