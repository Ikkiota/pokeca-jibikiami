  const pts = [], miss = [];
  let prev = 0;
  rtWeights_(rs.maxKg).forEach(g => {
    const us = rtUsYen_(prev + 1, st);          // 米国向けは軽いほうで（差が大きくなる＝安全側）
    let mx = null;
    ccs.forEach(cc => { const n = rtNeedUsd_(cc, cat, g, null, us, fx, st); if (n === null) { if (miss.indexOf(cc) < 0) miss.push(cc); return; } const v = n.usd / (1 - (rs.fee || 0.22)); if (mx === null || v > mx) mx = v; });   // v162：送料にかかる手数料の分を上乗せ
    if (mx !== null) pts.push([(prev + 1) / 1000, mx]);
