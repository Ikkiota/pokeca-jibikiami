/* ---------- 価格帯・利益で、リサーチ候補をしぼる ---------- */
// eBayで同じタイトルの出品状況をさっと確かめる（1回の検索）
function quickMarketCheck_(kw) {
  const hdr = { 'X-EBAY-C-ENDUSERCTX': 'contextualLocation=country%3DUS%2Czip%3D10001' };
  let items = [];
  try {
    const r = ebay_('get', '/buy/browse/v1/item_summary/search?limit=50&q=' + encodeURIComponent(kw) + '&filter=' + encodeURIComponent('buyingOptions:{FIXED_PRICE}'),
      { kind: 'app', marketplace: 'EBAY_US', headers: hdr });
    items = r.itemSummaries || [];
  } catch (e) {}
  const tot = items.map(it => {
    const p = Number(it.price && it.price.value) || 0;
    const so = (it.shippingOptions || []).find(o => o.shippingCost);
    return p + (so ? Number(so.shippingCost.value) || 0 : 0);
  }).filter(n => n > 0).sort((a, b) => a - b);
  const med = tot.length ? quantileSimple_(tot, 0.5) : 0;
  const jp = items.filter(it => it.itemLocation && it.itemLocation.country === 'JP').length;
  return {
    count: tot.length, median: med, jp: jp,
    ok: cfg => tot.length >= 3 && med >= cfg.priceMin && med <= cfg.priceMax,
    text: cfg => '出品 ' + tot.length + '件・中央値 $' + med.toFixed(2) + '・日本から ' + jp + '件' +
      (tot.length < 3 ? '（出品が少なく需要不明）' : med < cfg.priceMin ? '（安すぎる）' : med > cfg.priceMax ? '（高すぎる）' : ''),
  };
}
function quantileSimple_(arr, q) {
  const pos = (arr.length - 1) * q, lo = Math.floor(pos), hi = Math.ceil(pos);
  return arr[lo] + (arr[hi] - arr[lo]) * (pos - lo);
}

// 外した候補の置き場（非表示）
function skipSheet_() {
  const ss = ss_();
  let sh = ss.getSheetByName('リサーチ見送り');
  if (sh) return sh;
  sh = ss.insertSheet('リサーチ見送り');
  sh.getRange(1, 1, 1, 7).setValues([['日時', 'キーワード', '理由', '勝負できる最安値$', '仕入れ上限（円）', '同じ商品の出品数', '日本のセラー数']]).setFontWeight('bold');
  sh.hideSheet();
  return sh;
}
function skipKeyword_(kw, reason, qc) {
  skipSheet_().appendRow([new Date(), kw, reason, qc && qc.median ? qc.median : '', '', qc ? qc.count : '', qc ? qc.jp : '']);
}
function skippedKeywords_() {
  const sh = ss_().getSheetByName('リサーチ見送り');
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 2, sh.getLastRow() - 1, 1).getValues().map(r => String(r[0]).trim().toLowerCase());
}

// 調べ終わった行のうち、利益が出なさそうなものを「リサーチ見送り」へ移す（下の行から消すので、行番号はずれない）
function pruneResearchQueue_(sh) {
  const last = sh.getLastRow();
  if (last < 2) return 0;
  const vals = sh.getRange(2, 1, last - 1, RQ_HEADERS.length).getValues();
  const skip = skipSheet_();
  let n = 0;
  for (let i = vals.length - 1; i >= 0; i--) {
    const v = vals[i];
    const judge = String(v[RQ.JUDGE - 1] || '');
    if (!(v[RQ.DATE - 1] instanceof Date)) continue;                     // まだ調べていない行は残す
    if (/^×/.test(String(v[RQ.DEMAND - 1] || ''))) { /* 需要不足は外す */ }
    else if (/狙い目|検討/.test(judge)) continue;
    if (/^売れた商品/.test(String(v[RQ.MEMO - 1])) && !/価格帯外/.test(judge)) continue;   // 自分のお店で売れた商品は、価格帯の外でなければ残す
    skip.appendRow([new Date(), v[RQ.KW - 1], judge + '（' + String(v[RQ.MEMO - 1] || '').slice(0, 60) + '）', v[RQ.LOW - 1], v[RQ.MAXCOST - 1], v[RQ.COUNT - 1], v[RQ.JPSELL - 1]]);
    sh.deleteRow(i + 2);
    n++;
  }
  return n;
}

/* ---------- 仕入れ先の開拓 ----------
 *  AIのウェブ検索で見つかったお店を「仕入れ先リスト」に貯める。よく見つかるお店ほど上に来て、
 *  次の検索で優先して確認し、「仕入れ先で探す」のリンクにも追加する（Googleのサイト内検索）
 */
function shopSheet_() {
  const ss = ss_();
  let sh = ss.getSheetByName('仕入れ先リスト');
  if (sh) return sh;
  sh = ss.insertSheet('仕入れ先リスト');
  sh.getRange(1, 1, 1, 7).setValues([['お店の名前', 'ドメイン', '見つかった回数', '最後に見つけた日時', '最後に見つけた価格（円）', '例の商品ページ', '使う']]).setFontWeight('bold').setBackground('#e8f0f2');
  [180, 200, 90, 120, 110, 300, 50].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(1);
  return sh;
}
function domainOf_(url) { const m = String(url || '').match(/^https?:\/\/([^\/?#]+)/i); return m ? m[1].replace(/^www\./, '').toLowerCase() : ''; }
function recordShops_(list) {
  const skipDomains = /mercari|paypayfleamarket|amazon\.|rakuten|ebay|google|yahoo\.co\.jp\/search/;
  const sh = shopSheet_();
  const last = sh.getLastRow();
  const vals = last > 1 ? sh.getRange(2, 1, last - 1, 7).getValues() : [];
  list.forEach(x => {
    const d = domainOf_(x.url);
    if (!d || skipDomains.test(d)) return;
    const i = vals.findIndex(v => String(v[1]) === d);
    if (i >= 0) {
      vals[i][2] = (Number(vals[i][2]) || 0) + 1; vals[i][3] = new Date(); if (x.price_jpy) vals[i][4] = Number(x.price_jpy); vals[i][5] = x.url;
      sh.getRange(i + 2, 3, 1, 4).setValues([[vals[i][2], vals[i][3], vals[i][4], vals[i][5]]]);
    } else {
      const row = [String(x.shop || d), d, 1, new Date(), x.price_jpy ? Number(x.price_jpy) : '', x.url, true];
      sh.appendRow(row);
      sh.getRange(sh.getLastRow(), 7).insertCheckboxes().setValue(true);
      vals.push(row);
    }
  });
}
function topShops_(n) {
  const sh = ss_().getSheetByName('仕入れ先リスト');
  if (!sh || sh.getLastRow() < 2) return [];
  return sh.getRange(2, 1, sh.getLastRow() - 1, 7).getValues().filter(v => v[1] && v[6] === true)
    .sort((a, b) => (Number(b[2]) || 0) - (Number(a[2]) || 0)).slice(0, n).map(v => ({ name: String(v[0]).slice(0, 12), domain: String(v[1]) }));
}
function knownShopsHint_() {
  const shops = topShops_(8);
  return shops.length ? 'これまでに見つかった仕入れ先（優先して確認）：' + shops.map(x => x.name + '（' + x.domain + '）').join('、') + '。' : '';
}


// いまある候補も、価格帯（$40〜$500）と判定で整理する
function menuPruneResearch() {
  run_(() => {
    const sh = researchQueueSheet_();
    const cfg = research24Settings_();
    const last = sh.getLastRow();
    if (last >= 2) {
      const vals = sh.getRange(2, RQ.PRICE, last - 1, 1).getValues();
      vals.forEach((r, i) => {
        const p = Number(r[0]);
        if (p > 0 && (p < cfg.priceMin || p > cfg.priceMax)) sh.getRange(i + 2, RQ.JUDGE).setValue('価格帯外（$' + cfg.priceMin + '〜$' + cfg.priceMax + '）');
      });
    }
    const n = pruneResearchQueue_(sh);
    return n + '件を「リサーチ見送り」に移しました。残っているのは、まだ調べていない行と、狙い目・検討の行です';
  });
}


