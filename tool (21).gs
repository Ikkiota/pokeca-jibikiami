/* =====================================================================
 * 燃油サーチャージの自動反映（Gmail）
 *  オレンジコネックスから届く「燃油サーチャージ改定のお知らせ」メールを読み取り、
 *  発効日時になったら、正式 ebay の計算式シートの率を自動で書き換える
 *   ・eBay SpeedPAK Economy → 「エコノミー送料」G11
 *   ・Ship via DHL → 「DHL 送料」D3　・Ship via FedEx → 「FedEx 送料」D3
 * ===================================================================== */
// オレンジコネックスの燃油サーチャージ改定のお知らせを読み取る
function parseFuelNotice_(text) {
  const t = String(text || '').replace(/\r/g, '').replace(/[　 ]+/g, ' ');
  if (!/燃油サーチャージ|Fuel Surcharge/i.test(t)) return null;
  const rate = t.match(/改定後の料率\s*[：:]\s*([\d.]+)\s*[%％]/);
  const eff = t.match(/発効日時\s*[：:]\s*(\d{4})\s*年\s*(\d{1,2})\s*月\s*(\d{1,2})\s*日\s*(?:(\d{1,2})\s*[:：]\s*(\d{2}))?/);
  if (!rate || !eff) return null;
  const svc = (t.match(/サービス名\s*[：:]\s*([^\n]+)/) || [])[1] || '';
  const services = [];
  if (/SpeedPAK\s*Economy/i.test(svc || t)) services.push('SpeedPAK Economy');
  if (/via\s*DHL/i.test(svc)) services.push('DHL');
  if (/via\s*FedEx/i.test(svc)) services.push('FedEx');
  const d = new Date(Date.UTC(+eff[1], +eff[2] - 1, +eff[3], (+eff[4] || 0) - 9, +eff[5] || 0)); // 日本時間→UTC
  return { rate: Number(rate[1]) / 100, effective: d, services: services, serviceText: svc.trim() };
}

