    s.getRange('E103').setValue('オン：迷ったら保留（おすすめ）。オフ：出品中の同じ商品が3件以上あれば、出品中の価格（最安値→2番手→中央値）で判定します。').setFontColor('#777777').setWrap(true);
  }
  if (s.getRange('E98').getValue() === '') {
    s.getRange('E97').setValue('■ SOLDの歯止め（price_status）').setFontWeight('bold');
    s.getRange('E98:E100').setValues([['判定に必要な同じ商品のSOLDの件数（90日）'], ['PRICE_REVIEWにする：提案価格がSOLD中央値の何倍を超えたら'], ['DO_NOT_LISTにする：最低利益を守る価格がSOLD中央値の何倍を超えたら']]).setFontWeight('bold');
    s.getRange('F98:F100').setValues([[3], [1.2], [1.5]]).setBackground('#fff4dc');
    s.getRange('E101').setValue('NORMALだけが自動出品・自動の価格見直しの対象です。SOLDが足りない商品はPRICE_REVIEW（要確認）になります。最低利益を守る価格がSOLDの最高値を超える場合もDO_NOT_LISTです。')
      .setFontColor('#777777').setWrap(true);
  }
  if (s.getRange('E104').getValue() === '') {
    s.getRange('E104').setValue('出品中の最安値を競争価格に使わない：Sold中央値より何%以上安いとき').setFontWeight('bold');
    s.getRange('F104').setValue(0.3).setNumberFormat('0%').setBackground('#fff4dc');
    s.getRange('E105').setValue('価格判定ルール（v88〜）：Soldを最優先。Sold中央値と価格分布（外れ値を除外）から市場価格を出し、Sold相場から大きく離れた出品中の最安値は競争価格に使いません。最低利益を下回る価格は候補から除外し、「当社のコスト構造では成立しない価格」と表示します。Soldが足りない商品は常に「判定保留」です（F102の設定にかかわらず）。')
      .setFontColor('#777777').setWrap(true);
  }
  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('V91_SOLD_OPTIONAL')) {
    s.getRange('F102').setValue(false);
    s.getRange('E103').setValue('オフ（v91の既定）：Soldを確認できない商品も保留にせず、出品中の価格（外れ値を除いた中央値）を基準に判定・出品します。オン：Soldが足りない商品は判定保留にします。').setFontColor('#777777').setWrap(true);
    s.getRange('E105').setValue('価格判定ルール：Soldがある商品はSoldを最優先（中央値・分布・外れ値除外・Soldと乖離した最安値は競争価格に使わない）。Soldがない商品は、F102がオフなら出品中の価格の中央値を基準に判定します。どちらも最低利益を下回る価格は候補から除外し、「当社のコスト構造では成立しない価格」と表示します。')
      .setFontColor('#777777').setWrap(true);
    props.setProperty('V91_SOLD_OPTIONAL', '1');
  }
  const v = s.getRange('F98:F100').getValues().map(r => Number(r[0]));
  const g = s.getRange('F104').getValue();
  return { minCount: v[0] || 3, review: Math.max(v[1] || 1.2, zMktX_()), dnl: Math.max(v[2] || 1.5, zMktX_()), actGap: g === '' ? 0.3 : pct_(g), holdIfNoSold: s.getRange('F102').getValue() === true };
}

// 合計価格の一覧から、外れ値を除いた統計（8件以上：四分位範囲の1.5倍の外、少ないとき：中央値の±35%の外を除く）
function robustStats_(vals) {
  const a = vals.filter(n => n > 0).sort((x, y) => x - y);
  if (!a.length) return null;
  const q = (arr, t) => { const pos = (arr.length - 1) * t, lo = Math.floor(pos), hi = Math.ceil(pos); return arr[lo] + (arr[hi] - arr[lo]) * (pos - lo); };
  const med0 = q(a, 0.5);
  let lo, hi;
  if (a.length >= 8) { const q1 = q(a, 0.25), q3 = q(a, 0.75), iqr = q3 - q1; lo = q1 - 1.5 * iqr; hi = q3 + 1.5 * iqr; } else { lo = med0 * 0.65; hi = med0 * 1.35; }
  const k = a.filter(x => x >= lo && x <= hi);
  if (!k.length) return null;
  return { count: k.length, removed: a.length - k.length, median: Math.round(q(k, 0.5) * 100) / 100, min: k[0], max: k[k.length - 1] };
}

// v89：Soldを送ったあと、「まとめ判定の結果」の同じ商品の行を書き換える
function updateBatchResultAfterSold_(tag, g, msgHtml) {
  if (!tag) return;
  const bs = ss_().getSheetByName('まとめ判定の結果');
