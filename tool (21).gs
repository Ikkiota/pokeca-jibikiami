/* ========== AI下書き ========== */
function draftReplies_(limit) {
  if (msgFreeOn_()) return draftRepliesFree_(limit);   // v114：無料の下書き（Googleの翻訳＋返信テンプレ）
  const key = prop_('ANTHROPIC_API_KEY');
  if (!key) return { drafted: 0, noKey: true };
  const st = getSettings_();
  const sh = sheet_('メッセージ');
  const last = sh.getLastRow();
  if (last < 2) return { drafted: 0 };
  const data = sh.getRange(2, 1, last - 1, MSG_HEADERS.length).getValues();

  const system =
    'あなたはeBayセラーの返信文を下書きするアシスタントです。\n' +
    '- バイヤーと同じ言語で返信する（通常は英語）。丁寧で簡潔に。\n' +
    '- 以下のセラーのルールに従う。ルールにない返金・返品・値引き・発送日・補償などは絶対に約束しない。\n' +
    '- 情報が足りず判断できない点は推測せず、reply の先頭に「[要確認: 〇〇]」と日本語で書く。\n' +
    '- reply は2000文字以内。最後に署名「' + st.signature + '」をつける。\n\n' +
    'セラーのルール：\n' + st.rules + '\n\n' +
    '出力は次のJSONのみ（前後に何も書かない）：\n' +
    '{"buyer_ja":"バイヤーの最新メッセージの日本語訳","reply":"送信する返信文","reply_ja":"返信文の日本語訳"}';

  let drafted = 0;
  for (let i = 0; i < data.length && drafted < limit; i++) {
    const r = data[i], row = i + 2;
    if (!String(r[COL.STATUS - 1]).startsWith('新着') || r[COL.REPLY - 1]) continue;
    try {
      const buyer = r[COL.BUYER - 1];
      let msgs;
      try {
        const conv = ebay_('get', '/commerce/message/v1/conversation/' + encodeURIComponent(r[COL.CONV - 1]) +
          '?conversation_type=FROM_MEMBERS&limit=10');
        msgs = (conv.messages || []).slice().sort((a, b) => new Date(a.createdDate) - new Date(b.createdDate));
      } catch (e) {
        msgs = [{ senderUsername: buyer, createdDate: '', messageBody: r[COL.MSG - 1] }];
      }
      const history = msgs.map(m => (m.senderUsername === buyer ? 'Buyer' : 'Seller(me)') +
        ' [' + m.createdDate + ']: ' + m.messageBody).join('\n\n');
      const user = '商品ID: ' + r[COL.ITEM - 1] + '\n件名: ' + r[COL.TITLE - 1] +
        '\n\n会話履歴（古い順）:\n' + history + '\n\n最新のバイヤーのメッセージへの返信を作成してください。';

      const out = parseJson_(claude_(key, st.model, system, user));
      sh.getRange(row, COL.MSG_JA, 1, 3).setValues([[out.buyer_ja || '', out.reply || '', out.reply_ja || '']]);
      sh.getRange(row, COL.STATUS).setValue('下書き済み（確認してください）');
      sh.getRange(row, COL.NOTE).setValue(String(out.reply).includes('[要確認') ? '要確認の項目があります' : '');
      drafted++;
    } catch (e) {
      sh.getRange(row, COL.NOTE).setValue('下書きエラー：' + e.message);
    }
  }
  return { drafted: drafted };
}

