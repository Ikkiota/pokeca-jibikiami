  for (let i = 0; i < v.length; i++) {
    const r = v[i], row = i + 2, itemId = String(r[P.ITEMID - 1] || '').trim(), src = String(r[P.SRC - 1] || ''), note = String(r[P.NOTE - 1] || '');
    if (!itemId || String(r[P.STATUS - 1]) !== '出品済み' || !/rakuten|shopping\.yahoo/i.test(src) || /写真を増やした/.test(note)) continue;
    if (Date.now() - t0 > 4.5 * 60 * 1000) { more = true; break; }
    try {
      const cur = String(r[P.IMGS - 1] || '').split(/\n+/).map(x => x.trim()).filter(x => /^https?:\/\//.test(x));
      const all = zMergePhotos_(zPagePhotos_(src), cur);
      if (all.length <= cur.length) { same++; sh.getRange(row, P.NOTE).setValue(note + '／写真を増やした（ページの写真も ' + all.length + '枚で同じ）'); continue; }
      const eps = uploadPictures_(all);
