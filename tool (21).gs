}
// Yahoo! のページは「人が見る速さ」：どの仕事からでも、前のアクセスから20秒以上あけて開く（v558 のまね）
function zYahooFetch_(url) {
  const pp = PropertiesService.getScriptProperties(), last = Number(pp.getProperty('ZYS_LAST') || 0), w = 30000 - (Date.now() - last);   // v225：Yahoo! のページは前のアクセスから30秒以上あける
  if (w > 0) Utilities.sleep(Math.min(w, 35000));
