  sh.hideColumns(8);
  return sh;
}

// ① 新しいお知らせメールを探して「燃油サーチャージ」シートに予定として記録
function fuelScanMail_() {
  const sh = fuelLogSheet_();
  const last = sh.getLastRow();
  const seen = new Set(last > 1 ? sh.getRange(2, 8, last - 1, 1).getValues().map(r => String(r[0])) : []);
  const threads = GmailApp.search('(orangeconnex OR オレンジコネックス OR "Orange Connex") 燃油サーチャージ newer_than:120d', 0, 30);
  let added = 0;
  threads.forEach(th => th.getMessages().forEach(m => {
    const id = m.getId();
    if (seen.has(id)) return;
    const n = parseFuelNotice_(m.getPlainBody());
    if (!n) return;
    const svcs = n.services.length ? n.services : ['SpeedPAK Economy'];
    sh.appendRow([m.getDate(), m.getSubject(), svcs.join('、'), n.rate, n.effective, '予定', n.serviceText, id]);
    seen.add(id);
    added++;
  }));
  return added;
}

// ② 発効日時を過ぎた予定を、正式シートに反映
function fuelApplyDue_() {
  const sh = fuelLogSheet_();
  const last = sh.getLastRow();
  if (last < 2) return [];
  const rows = sh.getRange(2, 1, last - 1, FUEL_LOG_HEADERS.length).getValues();
  const book = SpreadsheetApp.openById(calcSettings_().id);
  const now = new Date();
  const applied = [];
  // 同じサービスは、発効済みの中で一番新しいものだけを反映
  const latest = {};
  rows.forEach((r, i) => {
    if (r[5] !== '予定' || !(r[4] instanceof Date) || r[4] > now) return;
    String(r[2]).split('、').forEach(svc => {
      if (!latest[svc] || r[4] > latest[svc].r[4]) latest[svc] = { r: r, i: i };
    });
  });
  Object.keys(latest).forEach(svc => {
    const tg = FUEL_TARGETS[svc];
    const { r } = latest[svc];
    if (!tg) return;
    const target = tg.sheet.map(n => book.getSheetByName(n)).find(x => x);
    if (!target) return;
    const cell = target.getRange(tg.cell);
    const before = cell.getValue();
    cell.setValue(r[3]);
    applied.push(svc + '：' + (Math.round(pct_(before) * 1000) / 10) + '% → ' + (Math.round(r[3] * 1000) / 10) + '%');
  });
  // 反映したもの・古くなった予定の状態を更新
  rows.forEach((r, i) => {
    if (r[5] !== '予定' || !(r[4] instanceof Date) || r[4] > now) return;
    const isLatest = String(r[2]).split('、').some(svc => latest[svc] && latest[svc].i === i);
    sh.getRange(i + 2, 6).setValue(isLatest ? '反映済み' : '新しいお知らせで上書き');
    if (isLatest) sh.getRange(i + 2, 7).setValue('反映：' + Utilities.formatDate(now, 'Asia/Tokyo', 'MM/dd HH:mm'));
  });
  if (applied.length) OFFICIAL_CACHE_ = null;
  return applied;
}

function fuelSurchargeCheck() { // 1時間ごとの自動実行
  try {
    const added = fuelScanMail_();
    const applied = fuelApplyDue_();
    if (added || applied.length) {
      const sh = fuelLogSheet_();
      const pending = sh.getLastRow() > 1 ? sh.getRange(2, 1, sh.getLastRow() - 1, FUEL_LOG_HEADERS.length).getValues().filter(r => r[5] === '予定') : [];
      const body = ['燃油サーチャージの自動反映', '',
        added ? '新しいお知らせを ' + added + '件 見つけました。' : '',
        applied.length ? '正式シートに反映しました：\n・' + applied.join('\n・') : '',
        pending.length ? '反映待ち：\n・' + pending.map(r => r[2] + ' ' + (Math.round(r[3] * 1000) / 10) + '%（' + Utilities.formatDate(r[4], 'Asia/Tokyo', 'yyyy/MM/dd HH:mm') + ' 発効）').join('\n・') : '',
        '', 'スプレッドシート：' + ss_().getUrl()].filter(x => x !== '').join('\n');
      MailApp.sendEmail(Session.getEffectiveUser().getEmail(), '【燃油サーチャージ】' + (applied.length ? '正式シートに反映しました' : '改定のお知らせを登録しました'), body);
    }
  } catch (e) { Logger.log(e); }
}

