    sh.getRange(1, 1, 1, 19).setValues([['取り下げ日時', '結果', '商品ID', 'タイトル', 'eBay価格', '通貨', '取り下げ前の在庫数', 'ウォッチ数', '仕入れ値（円）',
      '仕入れURL', '仕入れ先', '確認方法', '判断の理由', '前回の在庫確認', 'eBay出品ページ', 'SKU', '出品一覧のメモ', '出品時のデータ（出品作成）', '元データ（出品一覧の行）']]).setFontWeight('bold').setBackground('#e8f0f2');
    [120, 110, 120, 300, 70, 50, 80, 70, 90, 240, 100, 140, 320, 110, 200, 120, 220, 360, 300].forEach((w, i) => sh.setColumnWidth(i + 1, w));
    sh.setFrozenRows(1);
  }
  const itemId = String(r[LCOL.ID - 1]);
