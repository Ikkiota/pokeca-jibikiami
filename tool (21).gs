/* ---------- v164：出品中の商品の海外送料を直す（押したときだけ・中身を見せて確認してから） ----------
 *  総点検で「送料が足りない」と出た商品（今までの方法で出品したもの）について、配送サービスごとに
 *  その送り先の国でいちばん高い実費（手数料・広告費込み）まで海外送料を上げる。下げることはしない。商品の値段は変えない
 * ------------------------------------------------------------------------------------------------ */
function rtListingFixPlan_(itemId, r) {
  const st = icSettings_(), rs = rtSettings_();
  const w = Number(r[P.WEIGHT - 1]) || 0, box = parseBox_(r[P.BOX - 1]);
  const us = Number(r[P.SHIP - 1]) || 0, fx = Number(r[P.FX - 1]) || Number(official_().rate) || 150, price = Number(r[P.PRICE - 1]) || 0;
  const feeR = Math.max(rs.fee, Number(r[P.FRATE - 1]) || 0), step = st.step || 0.5;
  let highUsd = 200; try { highUsd = shipRuleSettings_().highUsd; } catch (e) {}
  const res = trading_('GetItem', '<ItemID>' + x_(itemId) + '</ItemID><DetailLevel>ReturnAll</DetailLevel>');
  const ns = res.ns, item = res.root.getChild('Item', ns);
  const sp = item.getChild('SellerProfiles', ns), shp = sp && sp.getChild('SellerShippingProfile', ns), pid = shp ? String(shp.getChildText('ShippingProfileID', ns) || '') : '';
  const sd = item.getChild('ShippingDetails', ns);
  const exc = sd ? sd.getChildren('ExcludeShipToLocation', ns).map(e => e.getText()) : [];
  const ships = rtShipCountries_().filter(cc => exc.indexOf(cc) < 0 && exc.indexOf(String(IC_COUNTRIES[cc][5])) < 0);
  const changes = [], cant = [];
  (sd ? sd.getChildren('InternationalShippingServiceOption', ns) : []).forEach(o => {
    const prio = Number(o.getChildText('ShippingServicePriority', ns)) || 0, cur = Number(o.getChildText('ShippingServiceCost', ns)) || 0;
    const ccs = [];
    o.getChildren('ShipToLocation', ns).map(e => e.getText()).forEach(loc => { (/^[A-Z]{2}$/.test(loc) ? [loc] : (rtRegionCountries_(loc, ships) || [])).forEach(cc => { if (ships.indexOf(cc) >= 0 && ccs.indexOf(cc) < 0) ccs.push(cc); }); });
    let need = 0, at = '';
    ccs.forEach(cc => {
      const c = icCountryCost_(cc, w, box, Object.assign({}, st, { highOnly: price >= highUsd }));
      if (!c) { cant.push(cc); return; }
      const v = Math.max(0, (c.yen - us) / fx / (1 - feeR));
      if (v > need) { need = v; at = cc; }
    });
    const nv = Math.ceil(need / step - 1e-9) * step;
    if (prio && nv > cur + 0.004) changes.push({ prio: prio, service: o.getChildText('ShippingService', ns), from: cur, to: nv, at: at, n: ccs.length });
  });
  return { itemId: itemId, pid: pid, changes: changes, cant: cant, v2: pid && (pid === rs.pol || pid === rs.polHi) };
}
