/* ---------- 出品のとき：この商品で v2 を使えるか（全部の国で足りるか）を確かめる ---------- */
function rtPolicyForRow_(r) {
  const rs = rtSettings_();
  rtLastWhy_ = '';
  if (!rs.on || !rs.pol) return null;
  const res = rtCheckRow_(r, rs);
  if (!res.ok) { rtLastWhy_ = res.why; return null; }
  return res;
}
let rtLastWhy_ = '';
function rtCheckRow_(r, rs) {
  rs = rs || rtSettings_();
  let live = null; try { live = JSON.parse(PropertiesService.getScriptProperties().getProperty('RT_LIVE') || 'null'); } catch (e) {}
  if (!live || live.id !== (rs.tableId || live.id)) return { ok: false, why: 'レートテーブルの金額がまだ入っていない' };
  if (Date.now() - live.at > 40 * 86400000) return { ok: false, why: 'レートテーブルの金額が40日以上前のまま' };
  const w = Number(r[P.WEIGHT - 1]) || 0;
  if (!(w > 0)) return { ok: false, why: '重さが空' };
  if (w > rs.maxKg * 1000) return { ok: false, why: '重さが上限（' + rs.maxKg + 'kg）を超える' };
  const box = parseBox_(r[P.BOX - 1]);
  const fx = Number(r[P.FX - 1]) || Number(official_().rate) || 150, us = Number(r[P.SHIP - 1]) || 0;
  const priceUsd = Number(r[P.PRICE - 1]) || 0;
  if (!(us > 0)) return { ok: false, why: '海外送料（L列）が空（出品の準備がまだ。米国向けの送料が分からないと差を計算できない）' };
  if (!(priceUsd > 0)) return { ok: false, why: '販売価格（N列）が空' };
  let highUsd = 200; try { highUsd = shipRuleSettings_().highUsd; } catch (e) {}
  const isFed = /FedEx/i.test(String(r[P.METHOD - 1] || ''));   // v115：FedEx便の商品は「高額品（速い便）」のポリシー
  const high = priceUsd >= highUsd || isFed;
  if (high && !rs.polHi) return { ok: false, why: '高額品の配送ポリシーがない' };
  if (isFed) { const fid = methodPolicies_().fed.id; if (!fid || PropertiesService.getScriptProperties().getProperty('RT_HI_FED') !== fid) return { ok: false, why: 'FedEx便の商品：v2の高額品のポリシーの米国の配送が FedEx 用になっていない（FedEx用のポリシーを選んで「④」を押し直す）' }; }
  const st = icSettings_();
  // eBay が使う重さ：実際の重さと、容積重量（縦×横×高さ÷4000）の重いほう
  // v162：eBayが容積重量を使わない場合でも足りるよう、実際の重さだけで確かめる（安全側）
  const kg = w / 1000;
  const feeR = Math.max(rs.fee || 0.22, Number(r[P.FRATE - 1]) || 0);
  const k = live.unit === 'lb' ? kg * RT_LB : kg;
  let fbk = null; try { fbk = JSON.parse(PropertiesService.getScriptProperties().getProperty('RT_FALLBACK') || 'null'); } catch (e) {}
  if (!fbk || !fbk.fb) return { ok: false, why: '配送ポリシーの定額の送料がまだ分からない（「④」をもう一度押してください）' };
  if (fbk.openNoRate && fbk.openNoRate.length) return { ok: false, why: '送料表に料金がない国（' + fbk.openNoRate.join('・') + '）から買える状態なので v2 を使わない（元の配送ポリシーの除外国に入れて「④」）' };
  const cats = high ? ['EXPEDITED'] : [fbk.eco || 'ECONOMY', 'EXPEDITED'];
  const short = [];
  // v159：レートテーブルの行に入っていない国は、ポリシーの定額の送料で足りるかを確かめる
  const ships = rtShipCountries_();
  const ecoSet = fbk.ecoCcs ? new Set(fbk.ecoCcs) : null;
  const canBuy = (cat, cc) => cat === 'EXPEDITED' || !ecoSet || ecoSet.has(cc);   // v164：安い便を選べない国は確かめなくてよい
  cats.forEach(cat => {
    const covered = new Set([].concat.apply([], live.rates.filter(x => x.cat === cat).map(x => x.ccs)));
    const flat = Number(fbk.fb[cat]);
    ships.filter(cc => !covered.has(cc) && canBuy(cat, cc)).forEach(cc => {
      const n0 = rtNeedUsd_(cc, cat, w, box, us, fx, st); const n = n0 && { usd: n0.usd / (1 - feeR) };
      if (n === null) { short.push(cc + '（' + (RT_LABEL[cat] || cat) + 'で送れない）'); return; }
      if (!(flat >= 0) || flat + 0.005 < Math.ceil(n.usd * 100) / 100) short.push(cc + '（' + (RT_LABEL[cat] || cat) + '・定額：$' + (flat >= 0 ? flat.toFixed(2) : '?') + ' < $' + n.usd.toFixed(2) + '）');
    });
  });
  cats.forEach(cat => {
    live.rates.filter(x => x.cat === cat).forEach(x => {
      const charge = x.a + x.b * k;
      x.ccs.filter(cc => canBuy(cat, cc)).forEach(cc => {
        const n0 = rtNeedUsd_(cc, cat, w, box, us, fx, st); const n = n0 && { usd: n0.usd / (1 - feeR) };
        if (n === null) { short.push(cc + '（' + (RT_LABEL[cat] || cat) + 'で送れない）'); return; }
        if (charge + 0.005 < Math.ceil(n.usd * 100) / 100) short.push(cc + '（' + (RT_LABEL[cat] || cat) + '：$' + charge.toFixed(2) + ' < $' + n.usd.toFixed(2) + '）');
      });
    });
  });
  if (short.length) return { ok: false, why: 'レートテーブルの送料が足りない国：' + short.slice(0, 4).join('・') + (short.length > 4 ? ' ほか' + (short.length - 4) + 'か国' : '') };
  return { ok: true, id: high ? rs.polHi : rs.pol, high: high, xml: rtPackageXml_(w, box), note: '国別送料 v2' + (high ? '・高額品' : '') };
}
// 荷物の重さ・大きさ（レートテーブルの重さの計算に使う。ポンド・オンス・インチ。端数は切り上げ）
function rtPackageXml_(weightG, box) {
  const oz = Math.ceil(weightG / 28.3495);
  const inch = v => Math.max(1, Math.ceil(v / 2.54));
  return '<ShippingPackageDetails><MeasurementUnit>English</MeasurementUnit>' +
    (box && box.l ? '<PackageDepth unit="inches">' + inch(box.h) + '</PackageDepth><PackageLength unit="inches">' + inch(box.l) + '</PackageLength><PackageWidth unit="inches">' + inch(box.w) + '</PackageWidth>' : '') +
    '<WeightMajor unit="lbs">' + Math.floor(oz / 16) + '</WeightMajor><WeightMinor unit="oz">' + (oz % 16) + '</WeightMinor></ShippingPackageDetails>';
}

/* ---------- 料金・燃油が変わったら、自動で入れ直す（毎日11時台：icTablesAutoRefresh_ のあと） ---------- */
function rtAutoSync_() {
  const rs = rtSettings_();
  if (!rs.tableId || !rs.pol) return 'skip';
  const p = PropertiesService.getScriptProperties();
  try {
    const r = rtSync_();
    if (r.changed) {
      const subj = '【国別送料 v2】eBayのレートテーブルの金額を入れ直しました（' + r.changed + '行）';
      const body = ['燃油サーチャージ・料金・為替が変わったので、eBayのレートテーブル「' + rs.name + '」の金額を入れ直しました。', '',
        r.plan.rates.filter(x => !x.skip).slice(0, 30).map(x => '・' + (RT_LABEL[x.cat] || x.cat) + '：' + (x.regions || []).join('・') + ' → 基本 $' + x.u.a.toFixed(2) + '＋1' + r.plan.unit + 'あたり $' + x.u.b.toFixed(2)).join('\n'), '',
        '詳しくは「レートテーブル（eBayに入れた金額）」シート', ss_().getUrl()].join('\n');
      if (typeof rwQueue_ === 'function') { rwQueue_('料金変更', 'RTSYNC|' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd'), subj, body); rwFlush_(); }
    }
    p.deleteProperty('RT_SYNC_ERR');
    try { rtAutoFix_(); } catch (e) {}
    return 'ok';
  } catch (e) {
    // 入れ直せないときは、出品で v2 を使わない（古い金額のまま出品しない）
    try { const live = JSON.parse(p.getProperty('RT_LIVE') || 'null'); if (live) { live.at = 0; p.setProperty('RT_LIVE', JSON.stringify(live)); } } catch (x) {}
    if (p.getProperty('RT_SYNC_ERR') !== String(e.message).slice(0, 200)) {
      p.setProperty('RT_SYNC_ERR', String(e.message).slice(0, 200));
      const subj = '【国別送料 v2】レートテーブルの金額を入れ直せませんでした';
      const body = 'エラー：' + e.message + '\n\n直るまで、新しい出品は今までの方法（5グループ＋商品ごとの送料）で出品します。\n' + ss_().getUrl();
      if (typeof rwQueue_ === 'function') { rwQueue_('取得失敗', 'RTERR|' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd'), subj, body); rwFlush_(); }
    }
    return 'error';
  }
}

/* ---------- テスト：今の準備中の商品で、v2 を使えるか ---------- */
function menuRtCheckRows() {
  run_(() => {
    const sh = prepSheet_();
    if (sh.getLastRow() < 2) return '出品作成シートに商品がありません';
    const n = Math.min(200, sh.getLastRow() - 1);
    const all = sh.getRange(2, 1, n, PREP_HEADERS.length).getValues();
    const rs = rtSettings_();
    const rows = [];
    all.forEach((r, i) => {
      if (!String(r[P.TITLE - 1] || r[P.NAME - 1] || '').trim() || String(r[P.STATUS - 1] || '') === '出品済み') return;
      const w = Number(r[P.WEIGHT - 1]) || 0;
      const c = w > 0 ? rtCheckRow_(r, rs) : { ok: false, why: '重さ（AA列）が空' };
      rows.push([i + 2, String(r[P.TITLE - 1] || r[P.NAME - 1] || '').slice(0, 60), w || '', String(r[P.BOX - 1] || ''), Number(r[P.PRICE - 1]) || '',
        c.ok ? (c.high ? '✅ v2・高額品（速い便だけ）' : '✅ v2（安い便＋速い便）') : '↩ 今までの方法', c.ok ? '' : c.why, w > 0 && w < 30 ? '重さが軽すぎるかも（梱包込みの重さか確かめる）' : '']);
    });
    const g = apSheet_('国別送料 v2 の確認'), out = g.sh;
    out.clear();
    out.getRange(1, 1).setValue('出品作成の商品で、国別送料 v2 を使えるか（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm') + '・eBayは変えていない）').setFontWeight('bold');
    const head = ['出品作成の行', '商品', '重量（g）', '外箱サイズ（cm）', '販売価格（$）', '結果', '理由', '気になる点'];
    out.getRange(2, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#e8f0fe');
    if (rows.length) {
      out.getRange(3, 1, rows.length, head.length).setValues(rows);
      rows.forEach((r, i) => out.getRange(i + 3, 6).setBackground(/^✅/.test(r[5]) ? '#d8f0d8' : '#fff4dc'));
    }
    [80, 340, 80, 110, 90, 200, 420, 260].forEach((w, i) => out.setColumnWidth(i + 1, w));
    out.activate();
    const okN = rows.filter(r => /^✅/.test(r[5])).length;
    return rows.length + '商品を確かめました：v2 ' + okN + '件・今までの方法 ' + (rows.length - okN) + '件（「国別送料 v2 の確認」シート）';
  });
}
/* =====================================================================
 * v162：国別送料の総点検（送料の赤字がないか）
 *  A eBayに実際に入っているレートテーブルの金額 × 送る国ぜんぶ × 重さ（50gごと・区分のいちばん軽いところ）
 *  B v2の配送ポリシー（ある・レートテーブルにつながっている・除外国・表にない国の定額）
 *  C 出品中の商品（出品作成シートで出品済み・重さあり）：eBayの今の送料 × 国ごとの今の実費
 *  D 設定（重さの単位・燃油サーチャージ・金額の更新日）
 *  考え方：海外の送料 ≧（その国の実費 − 米国向けの送料）÷ 為替 ÷（1 − 手数料・広告費の率）
 *  直すのは手で（出品中の商品の送料は勝手に変えない）。結果は「国別送料の総点検」シート
 * ===================================================================== */
function rtAudit_(opt) {
  opt = opt || {};
  const started = Date.now();
  const rs = rtSettings_(), st = icSettings_();
  let off = {}; try { OFFICIAL_CACHE_ = null; off = official_(); } catch (e) {}
  const fx = Number(off.rate) || 150, fee = rs.fee;
  const F = [];   // [重要度, 区分, 対象, 内容, 不足（$）, 直し方]
  const add = (sev, area, who, what, short, fix) => F.push([sev, area, who, what, short == null ? '' : Math.round(short * 100) / 100, fix || '']);
  const sum = { checked: 0, table: 0, listings: 0, listingsShort: 0 };
  const shortItems = [];
  rtLoadExcluded_();
  const ships = rtShipCountries_();
  let fbk0 = null; try { fbk0 = JSON.parse(PropertiesService.getScriptProperties().getProperty('RT_FALLBACK') || 'null'); } catch (e) {}
  const ecoSet = fbk0 && fbk0.ecoCcs ? new Set(fbk0.ecoCcs) : null;
  const canBuy = (cat, cc) => cat === 'EXPEDITED' || !ecoSet || ecoSet.has(cc);
  const weights = []; for (let g = 1; g <= rs.maxKg * 1000; g += 50) weights.push(g);
  const unitK = g => rs.unit === 'lb' ? g / 1000 * RT_LB : g / 1000;
  // D 設定
  if (st.fxFuel == null || st.dhFuel == null) add('赤字の危険', '設定', 'FedEx・DHLの燃油サーチャージ', '燃油サーチャージが取れていない（速い便の実費が分からない）', null, '「設定」F191・F192 を確かめる');
  [['FedEx', st.fuelInfo && st.fuelInfo.fx], ['DHL', st.fuelInfo && st.fuelInfo.dh]].forEach(([n, x]) => { if (x && x.at && Date.now() - x.at > 10 * 86400000) add('注意', '設定', n + 'の燃油サーチャージ', '最後に更新されてから ' + Math.floor((Date.now() - x.at) / 86400000) + '日たっている', null, '新しい率を「設定」に入れる'); });
  if (!(off.ecoSurcharge >= 0)) add('注意', '設定', 'SpeedPAK Economy', 'SpeedPAKの燃油サーチャージが分からない', null, '「送料表・燃油サーチャージ」→ SpeedPAK料金を更新');
  // A レートテーブル
  let table = null, liveRates = [], noRateList = [];
  const polExcl = [];
  const covered = { ECONOMY: new Set(), STANDARD: new Set(), EXPEDITED: new Set() };
  if (rs.tableId || rs.pol) {
    try { table = ebay_('get', '/sell/account/v2/rate_table/' + encodeURIComponent(rtTableId_(rs))); }
    catch (e) { add('赤字の危険', 'レートテーブル', rs.name, 'eBayから読めない：' + e.message, null, '「設定」F211・F216 を確かめる'); }
  }
  if (table) {
    let plan = null;
    try { plan = rtPlan_(table, rs); } catch (e) { add('赤字の危険', 'レートテーブル', rs.name, '中身を確かめられない：' + e.message, null, ''); }
    if (plan) {
      plan.bad.forEach(b => add('赤字の危険', 'レートテーブル', rs.name, b, null, ''));
      noRateList = plan.noRate.slice();
      plan.rates.filter(x => !x.skip).forEach(x => {
        const cur = x.cur || {};
        const a = Number(cur.shippingCost && cur.shippingCost.value), b = Number(cur.additionalCost && cur.additionalCost.value) || 0;
        if (!(a >= 0)) { add('赤字の危険', 'レートテーブル', (x.regions || []).join('・').slice(0, 60), '金額が入っていない', null, '「③」を押す'); return; }
        liveRates.push({ cat: x.cat, ccs: x.ccs, a: a, b: b });
        x.ccs.forEach(cc => {
          covered[x.cat] && covered[x.cat].add(cc);
          if (!canBuy(x.cat === 'STANDARD' ? 'ECONOMY' : x.cat, cc)) return;
          let worst = null, cant = 0;
          weights.forEach(g => {
            const us = rtUsYen_(g, st), n = rtNeedUsd_(cc, x.cat, g, null, us, fx, st);
            sum.checked++;
            if (!n) { cant++; return; }
            const need = n.usd / (1 - fee), charge = a + b * unitK(g);
            if (!worst || charge - need < worst.m) worst = { m: charge - need, g: g, need: need, charge: charge, method: n.m };
          });
          sum.table++;
          if (cant) add('赤字の危険', 'レートテーブル', IC_COUNTRIES[cc][0] + '（' + cc + '）・' + RT_LABEL[x.cat], 'この便で送れない重さがあるのに、バイヤーが選べる', null, '「④」を押し直す（送れない国では選べないようにする）');
          if (worst && worst.m < -0.005) add('赤字の危険', 'レートテーブル', IC_COUNTRIES[cc][0] + '（' + cc + '）・' + RT_LABEL[x.cat], worst.g + 'g で eBayの送料 $' + worst.charge.toFixed(2) + ' ＜ 必要 $' + worst.need.toFixed(2) + '（' + worst.method + '）', -worst.m, '「③」を押して金額を入れ直す');
        });
      });
    }
  } else if (rs.on) add('赤字の危険', 'レートテーブル', rs.name, 'F210がオンなのにレートテーブルがない', null, '');
  // B v2 の配送ポリシー
  const flat = {};
  [[rs.pol, '国別送料 v2'], [rs.polHi, '国別送料 v2・高額品']].forEach(([id, label]) => {
    if (!id) { if (rs.on) add('赤字の危険', '配送ポリシー', label, 'ポリシーIDが空', null, '「④」を押す'); return; }
    let pol = null; try { pol = ebay_('get', '/sell/account/v1/fulfillment_policy/' + encodeURIComponent(id)); } catch (e) { add('赤字の危険', '配送ポリシー', label, 'eBayから読めない：' + e.message, null, '「④」を押し直す'); return; }
    polExcl.push(new Set(((pol.shipToLocations || {}).regionExcluded || []).map(x => String(x.regionName))));
    const intl = (pol.shippingOptions || []).find(o => o.optionType === 'INTERNATIONAL');
    if (!intl) { add('赤字の危険', '配送ポリシー', label, '海外向けの配送がない', null, '「④」を押し直す'); return; }
    if (table && String(intl.rateTableId || '') !== String(table.rateTableId || rs.tableId)) add('赤字の危険', '配送ポリシー', label, 'レートテーブル（' + rs.name + '）につながっていない', null, '「④」を押し直す');
    (intl.shippingServices || []).forEach(sv => { const c = Number(sv.shippingCost && sv.shippingCost.value) || 0; const cat = /Expedited|Express|Priority|FedEx|DHL/i.test(sv.shippingServiceCode) ? 'EXPEDITED' : 'ECONOMY'; flat[cat] = flat[cat] == null ? c : Math.min(flat[cat], c); });
  });
  // 送料表に料金がない国（ロシアなど）が、v2のポリシーで送らない国に入っているか
  if (noRateList.length) {
    const open = noRateList.filter(cc => !polExcl.length || polExcl.some(set => !set.has(cc)));
    if (open.length) add('赤字の危険', 'レートテーブル', open.join('・'), '送料表に料金がない国がレートテーブルに入っていて、v2のポリシーでも送らない国になっていない（この国の注文は送料が足りない）', null, '「④」を押し直す（v2のポリシーで送らない国に入れる）');
    else add('OK', 'レートテーブル', noRateList.join('・'), '送料表に料金がない国は、v2のポリシーで送らない国になっている', null, '');
  }
  ['ECONOMY', 'EXPEDITED'].forEach(cat => {
    if (flat[cat] == null) return;
    const out = ships.filter(cc => !covered[cat].has(cc) && !(cat === 'ECONOMY' && covered.STANDARD.has(cc)) && canBuy(cat, cc));
    if (out.length && !(flat[cat] >= 0)) add('赤字の危険', '配送ポリシー（定額）', RT_LABEL[cat], '表にない ' + out.length + 'か国の定額が分からない', null, '「④」を押し直す');
    let bad = [];
    out.forEach(cc => {
      let worst = null;
      weights.forEach(g => { const n = rtNeedUsd_(cc, cat, g, null, rtUsYen_(g, st), fx, st); if (!n) { worst = { m: -999, g: g, need: NaN, cant: true }; return; } if (worst && worst.cant) return; const need = n.usd / (1 - fee); if (!worst || flat[cat] - need < worst.m) worst = { m: flat[cat] - need, g: g, need: need }; });
      if (worst && worst.m < -0.005) bad.push([cc, worst]);
    });
    bad.sort((x, y) => x[1].m - y[1].m).slice(0, 20).forEach(([cc, w]) => add('赤字の危険', '配送ポリシー（定額）', IC_COUNTRIES[cc][0] + '（' + cc + '）・' + RT_LABEL[cat], w.cant ? 'この便で送れない重さがあるのに、バイヤーが選べる' : 'レートテーブルにない国。' + w.g + 'g で定額 $' + flat[cat].toFixed(2) + ' ＜ 必要 $' + w.need.toFixed(2), w.cant ? null : -w.m, w.cant ? '「④」を押し直す（送れない国では選べないようにする）' : 'eBayのレートテーブルにこの国（地域）を足して ②→③→④'));
    if (bad.length > 20) add('赤字の危険', '配送ポリシー（定額）', 'ほか ' + (bad.length - 20) + 'か国', '', null, '');
    if (out.length && !bad.length) add('OK', '配送ポリシー（定額）', RT_LABEL[cat] + '：表にない ' + out.length + 'か国', '定額 $' + flat[cat].toFixed(2) + ' で足りる（ただし高めなので売れにくい）', null, 'レートテーブルに地域を足すと安くなる');
  });
  // C 出品中の商品
  if (opt.listings !== false) {
    const sh = prepSheet_();
    const n = Math.max(0, sh.getLastRow() - 1);
    const rows = n ? sh.getRange(2, 1, n, PREP_HEADERS.length).getValues() : [];
    let highUsd = 200; try { highUsd = shipRuleSettings_().highUsd; } catch (e) {}
    for (let i = 0; i < rows.length; i++) {
      const r = rows[i], itemId = String(r[P.ITEMID - 1] || '').trim();
      if (!itemId || String(r[P.STATUS - 1]) !== '出品済み') continue;
      if (Date.now() - started > 4.5 * 60 * 1000) { add('注意', '出品中の商品', '時間切れ', 'ここから先の商品はまだ確かめていない（もう一度押すと続きではなく最初から確かめます）', null, ''); break; }
      const w = Number(r[P.WEIGHT - 1]) || 0, box = parseBox_(r[P.BOX - 1]);
      const us = Number(r[P.SHIP - 1]) || 0, rfx = Number(r[P.FX - 1]) || fx, price = Number(r[P.PRICE - 1]) || 0;
      const feeR = Math.max(fee, Number(r[P.FRATE - 1]) || 0);
      const who = '行' + (i + 2) + '・' + itemId + '・' + String(r[P.TITLE - 1] || '').slice(0, 30);
      if (!(w > 0)) { add('要確認', '出品中の商品', who, '重さ（AA列）が空なので確かめられない', null, '重さを入れて、もう一度点検'); continue; }
      let item;
      try { const res = trading_('GetItem', '<ItemID>' + x_(itemId) + '</ItemID><DetailLevel>ReturnAll</DetailLevel>'); item = res.root.getChild('Item', res.ns); item._ns = res.ns; }
      catch (e) { add('要確認', '出品中の商品', who, 'eBayから読めない：' + String(e.message).slice(0, 80), null, ''); continue; }
      const ns = item._ns;
      const ss = item.getChild('SellingStatus', ns);
      if (ss && ss.getChildText('ListingStatus', ns) !== 'Active') continue;
      sum.listings++;
      const sp = item.getChild('SellerProfiles', ns), shp = sp && sp.getChild('SellerShippingProfile', ns), pid = shp ? String(shp.getChildText('ShippingProfileID', ns) || '') : '';
      const sd = item.getChild('ShippingDetails', ns);
      const exc = sd ? sd.getChildren('ExcludeShipToLocation', ns).map(e => e.getText()) : [];
      const shipTo = ships.filter(cc => exc.indexOf(cc) < 0 && exc.indexOf(String(IC_COUNTRIES[cc][5])) < 0);
      const short = [];
      if (pid && (pid === rs.pol || pid === rs.polHi)) {
        const cats = pid === rs.polHi ? ['EXPEDITED'] : ['ECONOMY', 'EXPEDITED'];
        cats.forEach(cat => shipTo.filter(cc => canBuy(cat, cc)).forEach(cc => {
          const n0 = rtNeedUsd_(cc, cat, w, box, us, rfx, st); if (!n0) { short.push([cc, cat, null]); return; }
          const need = n0.usd / (1 - feeR);
          const rows2 = liveRates.filter(x => (x.cat === cat || (cat === 'ECONOMY' && x.cat === 'STANDARD')) && x.ccs.indexOf(cc) >= 0);
          const charge = rows2.length ? Math.min.apply(null, rows2.map(x => x.a + x.b * unitK(w))) : flat[cat];
          if (charge == null || charge + 0.005 < need) short.push([cc, cat, need - (charge || 0)]);
        }));
      } else {
