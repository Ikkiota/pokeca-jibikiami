}


/* =====================================================================
 * 注文の手数料の内訳（eBay Finances API）
 *  eBayが実際に差し引いた手数料を、種類ごとに表示する
 *  ※ 使うには「③④ eBay連携」をやり直して、手数料の内訳を見る権限を追加する必要があります
 * ===================================================================== */
const FEE_NAMES = {
  FINAL_VALUE_FEE: '落札手数料（変動分）', FINAL_VALUE_FEE_FIXED_PER_ORDER: '落札手数料（注文ごとの固定分）',
  INTERNATIONAL_FEE: '海外手数料', AD_FEE: '広告費', BELOW_STANDARD_FEE: '基準未満セラーの追加手数料',
  HIGH_ITEM_NOT_AS_DESCRIBED_FEE: '説明と異なる商品の追加手数料', REGULATORY_OPERATING_FEE: '規制運用手数料',
  INSERTION_FEE: '出品手数料', FINAL_VALUE_SHIPPING_FEE: '送料にかかる落札手数料', PAYMENT_PROCESSING_FEE: '決済手数料',
};

function feeBreakdown_(orderId) {
  const url = 'https://apiz.ebay.com/sell/finances/v1/transaction?filter=' +
    encodeURIComponent('orderId:{' + orderId + '}') + '&limit=50';
  let res;
  try { res = ebay_('get', url); }
  catch (e) {
    if (/403|insufficient|scope|権限/i.test(e.message)) {
      throw new Error('手数料の内訳を見る権限がまだありません。メニュー「③ eBay連携：認証ページを開く」「④ 戻り先URLを登録」をもう一度行ってください。');
    }
    throw e;
  }
  const txs = (res.transactions || []).filter(t => t.transactionType === 'SALE');
  if (!txs.length) throw new Error('この注文の売上データが見つかりませんでした（注文IDを確認してください）');
  const fees = {};
  let total = 0, sale = 0;
  txs.forEach(t => {
    sale += Number(t.totalFeeBasisAmount && t.totalFeeBasisAmount.value) || 0;
    (t.orderLineItems || []).forEach(li => (li.marketplaceFees || []).forEach(f => {
      const v = Number(f.amount && f.amount.value) || 0;
      fees[f.feeType] = (fees[f.feeType] || 0) + v;
      total += v;
    }));
    // 注文単位の手数料（固定分など）が別枠で返る場合
    (t.orderLevelFees || t.marketplaceFees || []).forEach(f => {
      const v = Number(f.amount && f.amount.value) || 0;
      fees[f.feeType] = (fees[f.feeType] || 0) + v;
      total += v;
    });
  });
  const totalFeeReported = txs.reduce((a, t) => a + (Number(t.totalFeeAmount && t.totalFeeAmount.value) || 0), 0);
  return { fees: fees, total: total || totalFeeReported, reported: totalFeeReported, basis: sale, amount: txs[0].amount, raw: txs };
}

function showFeeBreakdown() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.prompt('手数料の内訳', '注文ID（例：10-15012-83482）を入力してください。', ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;
  const orderId = r.getResponseText().trim();
  if (!orderId) return;
  try {
    const b = feeBreakdown_(orderId);
    const pct = v => b.basis ? ' （手数料の対象額の ' + (v / b.basis * 100).toFixed(2) + '%）' : '';
