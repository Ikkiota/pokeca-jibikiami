/* =====================================================================
 * v144：リサーチのテスト（今から指定の時刻まで、1時間ごとに自動でリサーチ → 通った品は「出品候補（0円）」へ）
 *  ・前の検索が終わっていれば、次の定時（毎時20分ごろ）に新しく始める。途中なら続きを待つ
 *  ・出品はしない（GO は自分で）。指定の時刻を過ぎたら自動で終わる
 * ===================================================================== */
function zKwTestTick_() {
  const p = PropertiesService.getScriptProperties(), until = Number(p.getProperty('KW_TEST_UNTIL') || 0);
  if (!until) return;
  if (Date.now() > until) { p.deleteProperty('KW_TEST_UNTIL'); zLog_('リサーチのテスト', '終わりの時刻になったのでテストを終えた'); return; }
  let run = {}; try { run = JSON.parse(p.getProperty('KW_RUN') || '{}'); } catch (e) {}
  if (run.at && !run.stop) return;   // 前の検索がまだ途中
  const last = Number(p.getProperty('KW_TEST_LAST') || 0);
  if (Date.now() - last < 45 * 60 * 1000) return;
  p.setProperty('KW_TEST_LAST', String(Date.now()));
  const r = kwSearchRun_(true);
  zLog_('リサーチのテスト', '新しくリサーチを始めた：' + JSON.stringify(r));
}
function menuKwTestUntil() {
  const ui = SpreadsheetApp.getUi();
  const res = ui.prompt('リサーチのテスト', '何時まで続けますか？（0〜23の数字。例：22）\n1時間ごとに自動でリサーチして、通った品を「出品候補（0円）」に入れます。出品はしません。', ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return;
  const h = parseInt(res.getResponseText(), 10);
  if (!(h >= 0 && h <= 23)) { ui.alert('0〜23の数字で入れてください'); return; }
  const now = new Date(), ymd = Utilities.formatDate(now, 'Asia/Tokyo', 'yyyy-MM-dd');
  let until = new Date(ymd + 'T' + ('0' + h).slice(-2) + ':00:00+09:00').getTime();
  if (until <= Date.now()) until += 86400000;
