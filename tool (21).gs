// 1回の呼び出しの記録（usage＝APIの返したトークン数）
function apiRecord_(model, usage, code, images) {
  try {
    const u = usage || {};
    const pr = apiPrice_(model);
    const inTok = Number(u.input_tokens) || 0, outTok = Number(u.output_tokens) || 0;
    const cw = Number(u.cache_creation_input_tokens) || 0, cr = Number(u.cache_read_input_tokens) || 0;
    const ws = Number(u.server_tool_use && u.server_tool_use.web_search_requests) || 0;
    const cost = (inTok * pr.in + cw * pr.in * 1.25 + cr * pr.in * 0.1 + outTok * pr.out) / 1e6 + ws * 0.01;
    const fn = apiCaller_();
    const stage = API_STAGE_ && fn === 'prepareRow_' ? API_STAGE_ : (API_STAGE_NAMES[fn] || fn || '不明');
    if (fn === 'prepareRow_') API_STAGE_ = '';
    // 合計（今日・今月）
    const lock = LockService.getScriptLock();
    const got = lock.tryLock(3000);
    try {
      const t = apiTotals_();
      t.day = (t.day || 0) + cost; t.month = (t.month || 0) + cost; t.dayCalls = (t.dayCalls || 0) + 1;
      PropertiesService.getScriptProperties().setProperty('API_COST', JSON.stringify(t));
      try { sheet_('設定').getRange('F119:F120').setValues([[Math.round(t.day * 10000) / 10000], [Math.round(t.month * 10000) / 10000]]); } catch (e) {}
    } finally { if (got) lock.releaseLock(); }
    // 1行ずつ記録
    const ss = ss_();
    let sh = ss.getSheetByName('API使用量');
    if (!sh) {
      sh = ss.insertSheet('API使用量');
      sh.getRange(1, 1, 1, 13).setValues([['日時', '工程', '関数', 'モデル', '入力トークン', '出力トークン', 'キャッシュ書込', 'キャッシュ読込', 'Web検索', '画像の枚数', '料金（ドル）', '商品（仕入れURL・商品ID）', '結果']])
        .setFontWeight('bold').setBackground('#e8f0f2');
      [120, 190, 150, 170, 90, 90, 90, 90, 70, 80, 90, 260, 70].forEach((w, i) => sh.setColumnWidth(i + 1, w));
      sh.setFrozenRows(1);
    }
    sh.appendRow([new Date(), stage, fn, model, inTok, outTok, cw, cr, ws, images || 0, Math.round(cost * 1e6) / 1e6, API_ITEM_ || '', code === 200 ? 'OK' : 'エラー ' + code]);
    if (sh.getLastRow() > 30000) sh.deleteRows(2, 5000);
  } catch (e) { Logger.log(e); }
}

// メニュー：工程別・商品別に集計
