function zFastPicsOn_() { return false; }   // v170：写真のURLをそのまま渡す方法は使わない（いつも1枚ずつアップロード）   // v165：写真のURLをそのまま渡すのはやめる（eBayが取り込めず、写真なしで出品された）。今までどおり1枚ずつアップロード
// eBayの同じカード：3件以上あれば「安い方から2番目」、なければ最安
function zLooseBase_(mk) {   // v152：3件以上あれば中央値、2件なら2番目、1件なら最安
  const l = (mk && mk.list) || [];
  if (l.length >= 3 && mk.med > 0) return Math.min(Math.max(mk.med, l[1] || 0), (mk.low || l[0] || 0) * 1.5 || Infinity);   // v192：中央値が最安の1.5倍を超えるときは1.5倍まで（別のカード・高い出品が混ざって上限が高くなりすぎるのを防ぐ）
  return l.length >= 2 && l[1] > 0 ? l[1] : (mk.low || 0);
}
