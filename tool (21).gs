/* ---------- ウェブアプリ（ボタンからの受け取り口） ---------- */
function doGet(e) {
  if (e && e.parameter && e.parameter.page === 'inventory') {
    if (e.parameter.token !== prop_('SEND_TOKEN')) return page_('開けませんでした', '在庫管理画面のリンクが正しくありません。メニュー「在庫管理画面を開く」から開いてください。');
    return HtmlService.createHtmlOutput(INVENTORY_HTML.replace('__TOKEN__', JSON.stringify(prop_('SEND_TOKEN'))))
      .setTitle('在庫管理').addMetaTag('viewport', 'width=device-width, initial-scale=1');
  }
  return page_('eBayツール', '受け取り口は動いています。仕入れ先の商品ページで「eBayへ送る」ボタンを使ってください。');
}

function doPost(e) {
  if (!e || !e.parameter || !e.parameter.token || e.parameter.token !== prop_('SEND_TOKEN')) {
    return page_('送信できませんでした', '合言葉が一致しません。メニュー「送信ボタンを作る」でボタンを作り直してください。');
  }
  let d;
  try { d = JSON.parse(e.parameter.data); } catch (err) { return page_('送信できませんでした', 'データを読み取れませんでした。'); }
  if (/^gh/.test(String(d.kind || ''))) return zGhPost_(d);   // v227：GitHubの地引網（Yahoo!フリマ・ヤフオクのページを GitHub が開いて送ってくる）
  if (d.kind === 'search') return receiveSearch_(d);
  if (d.kind === 'ebaysold') return receiveEbaySold_(d);
  if (d.queue) return queueReceive_(d);
  if (!d.now) return queueReceive_(d, true);   // v193：「eBayへ送る」も受け付けてすぐ返す。判定・出品は裏で（1分後から自動・タブを開いて待たなくてよい）

  // すでに出品中の商品の仕入れ先ページなら、在庫チェックを行う
  try {
    const hit = findListingBySource_(d.url);
    if (hit) return stockCheck_(hit, d);
  } catch (err) {
    return page_('在庫チェックでエラー', esc_(err.message));
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  let sh, row;
  try {
    sh = prepSheet_();
    const priceNum = Number(String(d.price || '').replace(/[^\d.]/g, '')) || '';
    const r = new Array(PREP_HEADERS.length).fill('');
    r[P.DATE - 1] = new Date(); r[P.SRC - 1] = d.url || ''; r[P.NAME - 1] = d.title || '';
    r[P.COST - 1] = priceNum; r[P.IMGS - 1] = (d.images || []).join('\n'); r[P.STATUS - 1] = '受信';
    r[P.RAW - 1] = JSON.stringify({ title: d.title, price: d.price, text: String(d.text || '').slice(0, 20000), pc: Number(d.pc) || 0, im: d.im || '', inote: d.inote || '', got: (d.images || []).length });
    photoLog_({ stage: '受信', url: d.url, method: d.im, page: d.pc, got: (d.images || []).length, sheet: (d.images || []).length, reason: d.inote || '' });
    r[P.GO - 1] = false;
    if (d.queue) r[P.STATUS - 1] = 'まとめ判定待ち';
    // 同じ商品をもう一度送ったときは、二重に追加しない（まとめ判定待ちの重複）
    if (d.queue && sh.getLastRow() > 1) {
      const dup = sh.getRange(2, P.SRC, sh.getLastRow() - 1, 1).getValues().map(x => String(x[0]).split('?')[0]).indexOf(String(d.url || '').split('?')[0]);
      if (dup >= 0 && /まとめ判定待ち/.test(String(sh.getRange(dup + 2, P.STATUS).getValue()))) {
        return quickPage_('この商品はすでに受け付けています', 'まとめ判定待ち：' + queueCount_() + '件');
      }
    }
    sh.appendRow(r);
    row = sh.getLastRow();
    sh.getRange(row, P.GO).insertCheckboxes();
  } finally {
    lock.releaseLock();
  }
  if (d.queue) {
    scheduleBatchSoon_();
    try { batchJudge(); } catch (e) { scheduleBatchSoon_(); }
    return quickPage_('✅ 受け付けました', esc_(d.title || '') + '<br>判定・出品を始めました。結果は「まとめ判定の結果」シートに入ります。このタブは閉じて、次の商品へどうぞ。');
  }

  try {
    const pr0 = zPrepare_(sh, row);   // v120：トレカは0円の判定
    if (pr0 && pr0.earlyStop) { archiveRejected_(sh, row, pr0.earlyStop); return page_('⏸ 候補にしませんでした', esc_(pr0.earlyStop) + '<br><br>このタブは閉じてOKです。'); }
    const s = typeof pr0 === 'string' ? pr0 : esc_((pr0 && pr0.note) || '');
    const ls = listingSettings_();
    const g = gateCandidate_(sh, row, ls);
    if (!g.ok) {
      if (g.hold) return page_('⏳ 保留（eBayに相場データなし）', s + '<br><br>' + esc_(g.reason) + '<br><br>「出品作成」シート ' + row + '行目で確認してください。このタブは閉じてOKです。');
      if (g.keep) return page_('✏ 仕入れ値を入れてください', s + '<br><br>' + esc_(g.reason));
      archiveRejected_(sh, row, g.reason, g.detailText);
      const cd = CALC_DETAIL_LAST_;
      return page_('⏸ 候補にしませんでした', s + '<br><br>' + esc_(g.reason) +
        (cd ? '<br><br><a href="' + esc_(cd.url) + '" target="_blank">計算の詳細を見る（「計算の詳細」シート ' + cd.row + '行目）</a>' : '') + '<br><br>このタブは閉じてOKです。');
    }
    if (ls.autoList) {
      try {
        const itemId = listRow_(sh, row, ls);
        return page_('🎉 出品しました', s + '<br><br>' + esc_(g.summary) +
          '<br><a href="https://www.ebay.com/itm/' + itemId + '" target="_blank">eBayで出品を見る</a><br><br>このタブは閉じてOKです。');
      } catch (e) {
        sh.getRange(row, P.STATUS).setValue('候補（出品エラー）');
        sh.getRange(row, P.NOTE).setValue(zLockNote_(e.message));
        return page_('出品候補に追加しました（出品エラー）', s + '<br><br>' + esc_(e.message));
      }
    }
    return page_('✅ 出品候補に追加しました', s + '<br><br>' + esc_(g.summary) +
      '<br><br>「出品作成」シートで内容を確認して、「出品する」にチェックを入れてください。このタブは閉じてOKです。');
  } catch (err) {
    sh.getRange(row, P.STATUS).setValue('エラー（準備）');
    sh.getRange(row, P.NOTE).setValue(err.message);
    return page_('シートに追加しました（一部エラー）', esc_(err.message) + '<br><br>内容を確認して、メニュー「受信した商品を準備（やり直し）」を試してください。');
  }
}

function page_(title, body) {
