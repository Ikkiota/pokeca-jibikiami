/* ---------- ⑥ お客さまへのメッセージを無料で（Googleの翻訳＋返信テンプレ・送るのはあなた） ---------- */
const ZT_HEAD = ['場面', '使う言葉（英語・カンマ区切り）', '返信（英語）', '日本語訳（メモ）'];
const ZT_DEFAULT = [
  ['お礼（到着）', 'received,arrived,got it,got the card,came today', 'Thank you very much for your message and for your purchase! We are glad to hear that the item arrived safely. We hope you enjoy it. If you have a moment, we would really appreciate your feedback.', '到着のお礼'],
