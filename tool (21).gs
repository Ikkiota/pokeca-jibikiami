  const ui = SpreadsheetApp.getUi();
  if (ui.alert('国際エアパケットで出品中の品を直します', '「出品作成」で発送方法がエアパケの出品中の品を、SpeedPAK Economy に直します。\n・お客様に見える「Shipping Method」を SpeedPAK Economy に\n・配送ポリシーは国別送料 v2（なければ Economy 用・どちらもなければ今のまま）\n・送料が上がって最低利益を割る品は、最低利益を守れる値段に上げる\n\n進めますか？', ui.ButtonSet.OK_CANCEL) !== ui.Button.OK) return;
