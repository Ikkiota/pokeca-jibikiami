/* ---------- 検索結果 → 仕入れ候補（共通）。二重に追加しない ---------- */
function sendSearchRowsToIntake_(sh, idxList) {
  const vals = sh.getRange(2, 1, sh.getLastRow() - 1, SR_HEADERS.length).getValues();
  const intake = intakeSheet_();
  const known = new Set();
  if (intake.getLastRow() > 1) intake.getRange(2, IN.URL, intake.getLastRow() - 1, 1).getValues().forEach(r => known.add(String(r[0]).split('?')[0]));
  const lsh = ss_().getSheetByName('出品一覧');
  if (lsh && lsh.getLastRow() > 1) lsh.getRange(2, LCOL.SRC_URL, lsh.getLastRow() - 1, 1).getValues().forEach(r => known.add(String(r[0]).split('?')[0]));
  let added = 0, skipped = 0;
  idxList.forEach(i => {
    const v = vals[i];
    if (!v) return;
    const url = String(v[SR.URL - 1] || '');
    if (known.has(url.split('?')[0])) { sh.getRange(i + 2, SR.SENT).setValue('済（重複）'); skipped++; return; }
    const mid = (url.match(/\/item\/(m\d+)/) || [])[1];
    let imgs = mid ? mercariImages_(mid) : [];
    if (!imgs.length && v[SR.THUMB - 1]) imgs = [String(v[SR.THUMB - 1])];
    const cond = v[SR.SITE - 1] === 'Amazon' ? '新品' : '中古';
    const memo = '検索結果から自動追加（' + v[SR.SITE - 1] + '）' + (mid ? '' : '。写真は検索結果の小さい画像なので、出品前に商品ページで「eBayへ送る」を押すと正しい写真になります');
    let rqKw = '';
    try { const rr = Number(v[SR.RQROW - 1]); if (rr >= 2) rqKw = String(researchQueueSheet_().getRange(rr, RQ.KW).getValue() || ''); } catch (e) {}
    intake.appendRow([url, v[SR.TITLE - 1], v[SR.PRICE - 1], cond, '', '', '', imgs.join('\n'), memo + (rqKw ? '［RQ:' + rqKw + '］' : '')]);
    intake.getRange(intake.getLastRow(), IN.GO).insertCheckboxes().setValue(true);
    sh.getRange(i + 2, SR.SENT).setValue('済');
    sh.getRange(i + 2, SR.GO).setValue(false);
    known.add(url.split('?')[0]);
    added++;
  });
  return { added: added, skipped: skipped };
}

