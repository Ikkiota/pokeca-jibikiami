}

/* ---------- ⑤ 梱包の実測を反映する（量った重さ → カテゴリごとの統計 → これからの見積もりを重いほうに補正） ---------- */
const ZS_HEAD = ['日付', 'eBay商品ID', '量った重さ（g・梱包込み）', '量った外箱（cm）', '出品作成の行（自動）', 'カテゴリID（自動）', '見積もりの重さg（自動）', '差g（自動）', 'メモ'];
function zSpecSheet_() {
