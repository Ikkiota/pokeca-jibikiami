/* ===================== ここから ratetable.gs ===================== */
/* =====================================================================
 * ratetable.gs ― eBayの送料レートテーブル「国別送料 v2」（安い便と速い便・v153）
 *  ・eBayのレートテーブル（重さ別：基本料金＋重さあたりの料金）を、送料表（FedEx・DHL・EMS・国際エアパケット・SpeedPAK Economy）から計算して入れる
 *    安い便（ECONOMY / STANDARD）＝ SpeedPAK Economy・国際エアパケット・EMS のいちばん安いもの
 *    速い便（EXPEDITED）       ＝ FedEx・DHL の安いほう
 *  ・金額は「米国向けの送料との差」（米国向けの送料は商品価格に含めているため。今までの国別送料と同じ考え方）
 *  ・どの重さでも、実際の送料より安くならない直線にする（赤字を防ぐ側）。多めになる分はシートに出す
 *  ・レートテーブルの「形」（国・地域と便）は eBay の画面でしか作れない。金額は API（Account API v2 updateShippingCost）でツールが入れる
 *  ・出品のたびに、その商品の重さ・大きさで全部の国を確かめ、1か国でも足りなければ今までの方法（5グループ＋商品ごとの送料）で出品する
 *  ・配送ポリシーは新しく2つ作る（今のポリシー・出品中の商品は変えない）
 * ===================================================================== */
const RT_METHODS = { ECONOMY: ['SpeedPAK', '国際エアパケット', 'EMS'], STANDARD: ['SpeedPAK', '国際エアパケット', 'EMS'], EXPEDITED: ['FedEx', 'DHL'] };
const RT_LABEL = { ECONOMY: '安い便（エコノミー）', STANDARD: '安い便（スタンダード）', EXPEDITED: '速い便（エクスプレス）' };
const RT_LB = 2.20462;

function rtSettings_() {
  const s = sheet_('設定');
  if (s.getRange('E210').getValue() === '') {
    s.getRange('E209').setValue('■ eBayの送料レートテーブル（国別送料 v2・安い便と速い便）').setFontWeight('bold');
    s.getRange('E210:F216').setValues([
      ['出品で「国別送料 v2」（レートテーブル）を使う', false],
      ['レートテーブルID（eBayの画面で作ったもの。ツールが名前で探して入れる）', ''],
      ['配送ポリシーID：国別送料 v2（安い便＋速い便・ツールが作成）', ''],
      ['配送ポリシーID：国別送料 v2・高額品（速い便だけ・ツールが作成）', ''],
      ['レートテーブルの重さの単位（kg または lb。eBayの画面の表示に合わせる）', 'kg'],
      ['レートテーブルで出品する重さの上限（kg。これより重い商品は今までの5グループ）', 2],
      ['レートテーブルの名前（eBayの画面で付けた名前）', '国別送料 v2']]);
    s.getRange('E210:E216').setFontWeight('bold');
    s.getRange('F210').insertCheckboxes().setValue(false);
    s.getRange('F211:F213').setNumberFormat('@');
  }
  if (s.getRange('E217').getValue() === '') {   // v162
    s.getRange('E217:F217').setValues([['海外の送料にかかるeBayの手数料・広告費の率（送料にも手数料がかかるので、その分を上乗せ）', 0.22]]);
    s.getRange('E217').setFontWeight('bold'); s.getRange('F217').setNumberFormat('0.0%');
  }
  const v = s.getRange('F210:F217').getValues().map(r => r[0]);
  let fee = Number(String(v[7]).replace('%', '')); if (!(fee > 0)) fee = 0.22; if (fee > 1) fee = fee / 100; fee = Math.min(0.5, Math.max(0.1, fee));
  return { fee: fee, on: v[0] === true, tableId: String(v[1] || '').trim(), pol: String(v[2] || '').trim(), polHi: String(v[3] || '').trim(),
