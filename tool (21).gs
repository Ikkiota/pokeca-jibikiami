    const score = Math.round((ownN * 5 + sold * 2 + cnt * 0.2) * 10) / 10;
    sh.getRange(row, ZMX.OWN, 1, 2).setValues([[ownN || '', score]]);
    const low = Number(r[ZM.LOW - 1]) || 0, use = r[ZM.USE - 1] === true, keep = r[ZM.KEEP - 1] === true;
    const memo = String(r[ZM.MEMO - 1] || '');
