  const started = Date.now(), list = [], rowsOf = [];
  let left = 0;
  v.forEach((r, i) => {
    const cell = String(r[0] || '').trim();
    if (!cell || String(r[1] || '')) return;
    if (Date.now() - started > 150 * 1000) { left++; return; }
    // v132：1つのセルにまとめて貼っても、1行ずつ読む
    cell.split(/\r?\n/).map(x => x.trim()).filter(x => x).forEach(line => {
