/* v187：毎日100品は「ちゃんと利益が出て、売れる見込みがある品」だけ選ぶ
 *  売れる見込み（カード型番リストの数字）：
 *   3＝自分の店で売れた / eBay で90日に2枚以上売れた　2＝eBay で90日に1枚売れた
 *   1＝売れた記録はまだないが、eBay に同じカードが 3〜40件出品されている（買う人がいる市場。多すぎる型番は売れにくいので外す）
 *   0＝型番リストにない・様子見・除外 → 自動では GO しない（自分で GO するのは自由）
 *  利益：仕入れ上限より「追加の設定」F302 円（初めは 300円）以上安い品だけ。出品のときに最低利益 1,500円を今までどおり確かめる */
function zDaily100Buffer_() {
  const s = addSettingsSheet_();
  if (s.getRange('E302').getValue() === '') { s.getRange('E302').setValue('毎日100品：仕入れ上限より何円以上安い品だけ GO するか（利益の余裕）').setFontWeight('bold'); s.getRange('F302').setValue(300).setBackground('#fff4dc'); }
  const v = Number(s.getRange('F302').getValue()); return v >= 0 ? v : 300;
}
function zSellMap_() {
  const map = {};
  try {
    const sh = zModelSheetX_(), n = sh.getLastRow() - 1; if (n < 1) return map;
    sh.getRange(2, 1, n, ZMX.SLINK).getValues().forEach(r => {
      const num = zCardNo_(String(r[ZM.KEY - 1] || '')).num; if (!num) return;
      const memo = String(r[ZM.MEMO - 1] || ''); if (/様子見|除外|自動で外した|重複/.test(memo)) return;
      const k = num.toLowerCase() + '|' + (/未鑑定/.test(String(r[ZM.GRADE - 1] || '未鑑定')) ? 'u' : 'g');
      const own = Number(r[ZMX.OWN - 1]) || 0, sold = Number(r[ZMX.SOLD - 1]) || 0, cnt = Number(r[ZM.CNT - 1]) || 0;
      const t = (own >= 1 || sold >= 2) ? 3 : sold >= 1 ? 2 : (cnt >= 3 && cnt <= 40) ? 1 : 0;
      if (!map[k] || map[k] < t) map[k] = t;
    });
  } catch (e) {}
  return map;
}
function zSellTier_(map, lk) { return lk && map[lk] ? map[lk] : 0; }

/* v188：最低の利益率（「追加の設定」F303・初めは 5％）。最低利益（「設定」F29・1,500円）と両方を満たす品だけ出品候補・出品にする */
function zMinRate_(saleYen) {
  const base = zMinRateBase_();
  if (!(saleYen > 0)) return base;
  let v = base; zRateTiers_().forEach(t => { if (saleYen >= t.yen && t.rate > v) v = t.rate; });   // v210：高額商品は利益率を高く
  return v;
}
/* v210：高額商品の利益率（追加の設定 F307）。書き方「売値（円）:利益率（％）」をカンマで区切る。例 15000:10,45000:15 → 売値 15,000円以上は10％、45,000円以上は15％ */
function zRateTiers_() {
  if (zRateTiers_._c) return zRateTiers_._c;
  let txt = '15000:10,45000:15';
  try { const s = addSettingsSheet_(); if (s.getRange('E307').getValue() === '') { s.getRange('E307').setValue('高額商品の最低の利益率（売値（円）:利益率（％）をカンマ区切り。例 15000:10,45000:15）').setFontWeight('bold'); s.getRange('F307').setValue(txt).setBackground('#fff4dc'); }
    const x = String(s.getRange('F307').getValue() || '').trim(); if (x) txt = x; } catch (e) {}
  zRateTiers_._c = txt.split(/[,、，\s]+/).map(a => { const m = a.split(/[:：]/); return { yen: Number(String(m[0]).replace(/[^\d.]/g, '')), rate: Number(String(m[1] || '').replace(/[^\d.]/g, '')) }; }).filter(t => t.yen > 0 && t.rate >= 0);
  return zRateTiers_._c;
}
/* v210：最低利益と（売値で決まる）最低の利益率の両方を満たす一番安い値段（$） */
function zFloorUsd_(C, keep, minProfit, fx) {
  let p = 0;
  for (let k = 0; k < 5; k++) { const mr = zMinRate_(p * fx) / 100; if (!(keep - mr > 0)) return Infinity; const q = Math.max((C + minProfit) / keep / fx, C / (keep - mr) / fx); if (Math.abs(q - p) < 0.005) { p = q; break; } p = q; }
  return Math.ceil(p * 100) / 100 + 0.01;
}
function zMinRateBase_() {
  if (zMinRate_._c != null) return zMinRate_._c;
  let v = 5;
  try { const s = addSettingsSheet_(); if (s.getRange('E303').getValue() === '') { s.getRange('E303').setValue('最低の利益率（％）：最低利益と両方を満たす品だけ候補・出品にする').setFontWeight('bold'); s.getRange('F303').setValue(5).setBackground('#fff4dc'); }
    const x = Number(s.getRange('F303').getValue()); if (x >= 0) v = x; } catch (e) {}
  zMinRate_._c = v; return v;
}

/* v189：商品名に番号がない品（例「ナンジャモ SAR SV4a」）を、カード型番リストの「シリーズ＋日本語のカード名（＋レアリティ）」で1枚に決める
 *  1枚に決まらないとき（同じシリーズに同じ名前のカードが複数）は今までどおり「カードの番号が分からない」 */
function zNumByName_(text) {
  const t = zNorm_(text), set = zSetFrom_(t), name = kwJaName_(t);
  if (!name) return null;
  if (!zNumByName_._ix) {
    const ix = {}, all = [];
    try { zModelRows_().rows.forEach(x => { const r = x.r, key = String(r[ZM.KEY - 1] || '').trim(), cn = zCardNo_(key); const ja = zNorm_(String(r[ZM.JA - 1] || '')); if (!cn.num || !ja) return;
      if (!/未鑑定/.test(String(r[ZM.GRADE - 1] || '未鑑定'))) return;   // v218：鑑定品の行は使わない
      const o = { num: cn.num, set: cn.set, ja: ja, en: String(r[ZM.EN - 1] || ''), key: key };
      all.push(o);   // v218：シリーズの書いていない型番（例 Charizard 137/103）も、シリーズなしの照合に使う
      if (cn.set) { const k = cn.set.toLowerCase(); (ix[k] = ix[k] || []).push(o); } }); } catch (e) {}
    zNumByName_._ix = ix; zNumByName_._all = all;
  }
  // v218：レアリティと番号の関係（SAR・SR・UR・HR・AR・CHR・CSR・SSR は番号が分母より大きい／RR・RRR・R は分母以下）で候補をしぼる
  const rm = t.match(/(?:^|[^A-Za-z])(SAR|SSR|CSR|CHR|UR|HR|SR|AR|RRR|RR)(?![A-Za-z])/i), rr = rm ? rm[1].toUpperCase() : '';
  const over = x => { const m = String(x.num).match(/^(\d+)\/(\d+)$/); return m ? Number(m[1]) > Number(m[2]) : null; };
  const byRar = c => { if (!rr) return c; const want = /^(RR|RRR)$/.test(rr) ? false : true; const c2 = c.filter(x => over(x) === want); return c2; };
  const uniq = c => { const seen = {}; return c.filter(x => seen[x.num] ? false : (seen[x.num] = 1)); };
  if (set.code) {
    let c = uniq((zNumByName_._ix[set.code.toLowerCase()] || []).filter(x => x.ja.indexOf(name) >= 0));
    if (c.length > 1 && rr) { const c2 = c.filter(x => new RegExp('(^|[^A-Za-z])' + rr + '([^A-Za-z]|$)').test(x.en + ' ' + x.ja)); if (c2.length) c = c2; }
    if (c.length > 1 && rr) { const c3 = byRar(c); if (c3.length) c = c3; }   // v218
    if (c.length === 1) return { num: c[0].num, set: c[0].set, key: c[0].set + ' ' + c[0].num, how: 'シリーズ＋カード名' };
    return null;
  }
  // v218：シリーズが分からないときは「カード名＋レアリティ」で、型番リスト全体から1枚に決まるときだけ使う（決まらなければ今までどおり）
  if (!rr) return null;
  //   別のカードと取り違えないよう、ex・V・VMAX・VSTAR・GX・EX・BREAK・メガ の付き方が商品名と型番リストで同じものだけ
  const sig = s => { const o = []; String(s).replace(/(?<![A-Za-z0-9])(VMAX|VSTAR|GX|BREAK|ex|EX|V)(?![A-Za-z0-9])/g, (m0, a) => { o.push(a); return m0; }); if (/メガ|(?<![A-Za-z0-9])M(?=[ァ-ヶー])/.test(s)) o.push('メガ'); return o.filter((x, i) => o.indexOf(x) === i).sort().join(','); };
  const ts = sig(t.replace(/\b(SV|SM|S|M)\d{1,2}[a-zA-Z]{0,2}\b/g, ' '));
  const c = uniq(byRar((zNumByName_._all || []).filter(x => (x.ja === name || x.ja.indexOf(name) >= 0) && sig(x.en + ' ' + x.ja) === ts)));
  if (c.length !== 1) return null;
  return { num: c[0].num, set: c[0].set || '', key: c[0].set ? c[0].set + ' ' + c[0].num : c[0].num, how: 'カード名＋レアリティ' };
}

// v191：フリマの検索語ごとの結果（商品の数・候補に入った数・日時）。検索語ごとに1つ覚える（30日たったら消す）
function zFleaKey_(q) { return 'FLS_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, q, Utilities.Charset.UTF_8)).slice(0, 16); }
function zFleaStatAll_() {
  const all = PropertiesService.getScriptProperties().getProperties(), m = {}, old = Date.now() - 30 * 86400000;
  Object.keys(all).forEach(k => { if (k.indexOf('FLS_') !== 0) return; const v = String(all[k]).split('|'); const at = Number(v[2]) || 0; if (at < old) { try { PropertiesService.getScriptProperties().deleteProperty(k); } catch (e) {} return; } m[v[3] || k] = { n: Number(v[0]) || 0, ok: Number(v[1]) || 0, at: at }; });
  return m;
}
function zFleaStat_(q, n, ok) { if (!q) return; try { PropertiesService.getScriptProperties().setProperty(zFleaKey_(q), [n, ok, Date.now(), q.replace(/\|/g, ' ')].join('|')); } catch (e) {} }

