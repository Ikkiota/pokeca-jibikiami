// メルカリなどの検索語から、リサーチ候補の行を作って、その場で相場を調べる（仕入れ上限を出す）
function researchFromSourceKeyword_(ja) {
  const key = need_('ANTHROPIC_API_KEY');
  const st = getSettings_();
  const rq = researchQueueSheet_();
  const last = rq.getLastRow();
  // 同じ日本語の検索語の行があれば、それを使う
  if (last > 1) {
    const jas = rq.getRange(2, RQ.JA, last - 1, 1).getValues().map(r => String(r[0]).trim());
    const i = jas.indexOf(String(ja).trim());
    if (i >= 0 && Number(rq.getRange(i + 2, RQ.MAXCOST).getValue()) > 0) return i + 2;
  }
  const out = parseJson_(claude_(key, st.model, 'あなたは日本からeBayへ輸出するセラーのリサーチ担当です。出力はJSONのみ。',
    '日本のフリマで使った検索語：' + ja + '\nこの商品をeBay USで探すための、出品タイトルに近い英語のキーワードを1つ作ってください（作品名・機種・Japanese/Japanなど）。\n{"kw":""}'));
  const kw = String(out.kw || '').trim();
  if (!kw) throw new Error('英語のキーワードを作れませんでした');
  rq.appendRow([kw, '中古', 'メルカリなどの検索から自動作成（' + ja + '）']);
  const row = rq.getLastRow();
  rq.getRange(row, RQ.JA).setValue(ja);
  rq.getRange(row, 1, 1, 3).setBackground('#e8f0fe');
  researchOne_(rq, row, key, st, official_(), calcSettings_());
  if (!(Number(rq.getRange(row, RQ.MAXCOST).getValue()) > 0)) throw new Error('eBayで同じ商品が見つからないか、利益が出る仕入れ値がありませんでした');
  return row;
}


