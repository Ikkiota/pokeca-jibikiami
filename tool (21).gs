  const note = String(condNote || '').trim();
  const block = '<div style="margin:0 16px 14px 16px;background:#ffffff;border-radius:10px;border:2px solid #c9a227;">' +
    '<div style="padding:12px 16px 4px 16px;font-size:12px;letter-spacing:2px;color:#9a7a14;font-weight:bold;">YOUR CARD</div>' +
    '<div style="padding:0 16px 10px 16px;font-size:18px;font-weight:bold;color:#1f1f1f;line-height:1.35;">' + esc2_(title) + '</div>' +
    (tr ? '<table style="width:100%;border-collapse:collapse;font-size:14px;">' + tr + '</table>' : '') +
    (note ? '<div style="margin:10px 16px 0 16px;padding:10px 12px;background:#fff6f6;border-left:4px solid #c8102e;border-radius:6px;font-size:14px;"><b style="color:#c8102e;">Condition notes:</b> ' + esc2_(note) + '</div>' : '') +
