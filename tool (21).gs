// it: { url, text, freeShip, shopShip, box }
function zDomShip_(it) {
  const ds = zDomSettings_(), u = String(it.url || ''), t = String(it.text || '');
  const cap = it.box ? ds.small : ds.thin;
  if (/paypayfleamarket\.yahoo\.co\.jp/.test(u)) return { yen: 0, note: 'Yahoo!フリマは全国一律で送料込み' };
  if (/jp\.mercari\.com\/item\//.test(u)) {
    if (/着払い|購入者負担|送料別/.test(t)) return { yen: cap, note: 'メルカリ・着払い：沖縄までの送料の上限 ' + cap + '円を足した' };
    if (/送料込み|出品者負担/.test(t) || !ds.mercUnknownUpper) return { yen: 0, note: 'メルカリ・送料込み（全国一律）' };
    return { yen: cap, note: 'メルカリ・送料の負担者が分からないので上限 ' + cap + '円を足した' };
  }
  // ショップ（Yahoo!ショッピングなど）
  const okiExtra = /沖縄|離島/.test(t) && /(除く|別途|追加|対象外)/.test(t);
  if (it.freeShip && !okiExtra) return { yen: 0, note: '送料無料（沖縄も対象とみなす）' };
  const y = Math.max(cap, Number(it.shopShip) || 0);
  return { yen: y, note: (it.freeShip ? '送料無料だが沖縄・離島は別' : '送料あり') + '：沖縄までの送料の見込み ' + y + '円を足した' };
}
function zDomForRow_(r, raw, box) {
  const text = String((raw && raw.text) || '');
  if (/［国内送料込み］/.test(text)) return { yen: 0, note: '仕入れ値に沖縄までの送料を入れてある' };
  return zDomShip_({ url: r[P.SRC - 1], text: text, freeShip: /送料無料/.test(text), shopShip: 0, box: box });
}
