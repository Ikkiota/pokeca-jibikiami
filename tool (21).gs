/* =====================================================================
 * v166：出品の写真をできるだけ増やす（仕入れ先の、その商品の写真だけ）
 *  ・楽天・Yahoo!ショッピングの API の写真は1〜3枚だけ → 商品ページの「商品の写真」（ページに書かれた商品データの写真）を全部使う
 *    ※ ページ内のほかの商品・バナー・ロゴの写真は使わない（商品データに書かれた写真と og:image だけ）
 *  ・GO のとき：ページの写真＋APIの写真（同じ写真は1枚に）で出品
 *  ・ボタン「出品中のカードの写真を増やす」：出品中の楽天・Yahoo!ショッピングの品の写真を、ページから全部取り直して入れ直す（増えるときだけ・順番どおり・1枚目は明るさ補正）
 *  ・メルカリは今までどおり、写真を全部（最大20枚）
 * ===================================================================== */
function zPagePhotos_(url) {
  url = String(url || '');
  if (!/item\.rakuten\.co\.jp|store\.shopping\.yahoo\.co\.jp|shopping\.yahoo\.co\.jp/i.test(url)) return [];
  try { if (!robotsAllow_(url)) return []; } catch (e) {}
  let html = '';
  try { const r = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true, headers: { 'Accept-Language': 'ja,en;q=0.8' } }); if (r.getResponseCode() !== 200) return []; html = r.getContentText(); } catch (e) { return []; }
  const out = [], add = u => { u = String(u || '').trim(); if (!u || Z_BANNER_RX.test(u)) return; /* v176：海外購入（Buyee など）・バナー・ロゴは入れない */ if (u.indexOf('//') === 0) u = 'https:' + u; u = u.replace(/^http:/, 'https:').replace(/[?&]_ex=\d+x\d+/, '').replace(/\?$/, ''); if (/^https:\/\//.test(u) && out.indexOf(u) < 0) out.push(u); };
  (html.match(/<script[^>]+application\/ld\+json[^>]*>[\s\S]*?<\/script>/gi) || []).forEach(blk => {
    try { const j = JSON.parse(blk.replace(/^<script[^>]*>|<\/script>$/gi, '').trim());
      (Array.isArray(j) ? j : [j]).forEach(o => (o['@graph'] || [o]).forEach(pr => { if (!pr || !/Product/i.test(String(pr['@type']))) return; const im = pr.image; (Array.isArray(im) ? im : [im]).forEach(x => add(x && x.url ? x.url : x)); })); } catch (e) {}
  });
  const og = (html.match(/<meta[^>]+property=["']og:image["'][^>]+content=["']([^"']+)/i) || [])[1]; if (og) add(og);
  try { return zDropBanners_(out.slice(0, 24)); } catch (e) { return out.slice(0, 24); }   // v180
}
// 写真をまとめる（同じファイル名は1枚に・ページの写真の順番を先に）
function zMergePhotos_(a, b) {
  a = (a || []).filter(u => !Z_BANNER_RX.test(String(u))); b = (b || []).filter(u => !Z_BANNER_RX.test(String(u)));   // v176
  const out = [], seen = {}, key = u => String(u).split('?')[0].replace(/^https?:\/\/[^\/]+/, '').replace(/\/(?:_ex=\d+x\d+|thumbnail)\b/, '').toLowerCase().split('/').pop();
  (a || []).concat(b || []).map(x => String(x || '').trim()).filter(x => /^https?:\/\//.test(x)).forEach(u => { const k = key(u); if (seen[k]) return; seen[k] = 1; out.push(u); });
  return out.slice(0, 24);
}
function zMorePhotos_() {
  const sh = prepSheet_(), n = sh.getLastRow() - 1;
