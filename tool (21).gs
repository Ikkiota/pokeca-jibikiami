// 以前の「購入後メッセージ」「発送後メッセージ」シートから、設定と記録を引き継いで削除
function migrateOldAutoMsg_(sh) {
  const ss = ss_();
  const rows = [];
  const pm = ss.getSheetByName('購入後メッセージ');
  if (pm) {
    sh.getRange('B2').setValue(pm.getRange('B1').getValue() === true);
    if (pm.getRange('B2').getValue()) sh.getRange('B3').setValue(pm.getRange('B2').getValue());
    if (pm.getRange('B3').getValue()) sh.getRange('B4').setValue(pm.getRange('B3').getValue());
    if (pm.getLastRow() > 5) pm.getRange(6, 1, pm.getLastRow() - 5, 6).getValues().forEach(r => {
      if (r[0] !== '') rows.push(['購入後', String(r[0]), r[1], r[2], r[3], '', '', r[4], r[5], '']);
    });
  }
  const smSheet = ss.getSheetByName('発送後メッセージ');
  if (smSheet) {
    sh.getRange('B7').setValue(smSheet.getRange('B1').getValue() === true);
    if (smSheet.getRange('B2').getValue()) sh.getRange('B8').setValue(smSheet.getRange('B2').getValue());
    if (smSheet.getRange('B3').getValue()) sh.getRange('B9').setValue(smSheet.getRange('B3').getValue());
    if (smSheet.getRange('A4').getValue() !== '' && smSheet.getRange('B4').getValue()) sh.getRange('B10').setValue(smSheet.getRange('B4').getValue());
    if (Number(smSheet.getRange('E1').getValue()) > 0) sh.getRange('B11').setValue(Number(smSheet.getRange('E1').getValue()));
    if (smSheet.getLastRow() > 5) smSheet.getRange(6, 1, smSheet.getLastRow() - 5, 9).getValues().forEach(r => {
      if (r[0] !== '') rows.push(['発送後', String(r[0]), r[1], r[2], r[3], r[4], String(r[5] || ''), r[6], r[7], r[8] === true]);
    });
  }
  if (rows.length) {
    sh.getRange(AM_LOG_START, 1, rows.length, AL_HEADERS.length).setValues(rows);
    rows.forEach((r, i) => {
      if (r[AL.RESULT - 1] === '追跡番号待ち' || r[AL.RESULT - 1] === '確認待ち') {
        sh.getRange(AM_LOG_START + i, AL.NOTRACK).insertCheckboxes().setValue(r[AL.NOTRACK - 1] === true);
      } else {
        sh.getRange(AM_LOG_START + i, AL.NOTRACK).setValue('');
      }
    });
  }
  if (pm) ss.deleteSheet(pm);
  if (smSheet) ss.deleteSheet(smSheet);
}

function openAutoMsgSheet() {
  const sh = autoMsgSheet_();
  ensureArrivalSettings_(sh);
  sh.activate();
  SpreadsheetApp.getActive().toast('B2（購入後）・B7（発送後）にチェックを入れると、それぞれオンになります', 'eBayツール', 8);
}

function amLog_(sh) {
  const last = sh.getLastRow();
  return last >= AM_LOG_START ? sh.getRange(AM_LOG_START, 1, last - AM_LOG_START + 1, AL_HEADERS.length).getValues() : [];
}

function orderBasics_(o) {
  const buyer = o.buyer ? o.buyer.username : '';
  const addr = o.buyer && o.buyer.buyerRegistrationAddress;
  const name = String((addr && addr.fullName) || buyer).trim().split(/\s+/)[0] || buyer;
  const li = (o.lineItems || [])[0] || {};
  const itemTitle = (o.lineItems || []).map(x => x.title).join(' / ');
  return { buyer: buyer, name: name, itemId: li.legacyItemId, itemTitle: itemTitle };
}

function sendMemberMsg_(itemId, buyer, subject, body, qType) {
  if (!buyer || !itemId) throw new Error('バイヤー名または商品IDが取得できませんでした');
  trading_('AddMemberMessageAAQToPartner',
    '<ItemID>' + x_(itemId) + '</ItemID>' +
    '<MemberMessage>' +
    '<Body>' + x_(body.slice(0, 2000)) + '</Body>' +
    '<QuestionType>' + qType + '</QuestionType>' +
    '<RecipientID>' + x_(buyer) + '</RecipientID>' +
    '<Subject>' + x_(String(subject).slice(0, 100)) + '</Subject>' +
    '</MemberMessage>');
}

const amStamp_ = () => Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm');

/* ---------- 購入後 ---------- */
function amSheetIfAny_() {
  const ss = ss_();
  const sh = ss.getSheetByName('自動メッセージ');
  if (sh) return sh;
  // 以前のシートが残っていれば、自動で統合してから続行
  if (ss.getSheetByName('購入後メッセージ') || ss.getSheetByName('発送後メッセージ')) return autoMsgSheet_();
  return null;
}

function sendPurchaseMessages_() {
  const sh = amSheetIfAny_();
  if (!sh || sh.getRange('B2').getValue() !== true) return { enabled: false, sent: 0 };

  const p = PropertiesService.getScriptProperties();
  let since = p.getProperty('ORDER_MSG_SINCE');
  if (!since) { p.setProperty('ORDER_MSG_SINCE', new Date().toISOString()); return { enabled: true, sent: 0 }; }

  const subject = sh.getRange('B3').getValue() || 'Thank you for your purchase!';
  const template = String(sh.getRange('B4').getValue() || '');
  if (!template.trim()) throw new Error('購入後メッセージの本文（B4）が空です');
  const signature = getSettings_().signature;
  const logged = new Set(amLog_(sh).filter(r => r[0] === '購入後').map(r => String(r[AL.ORDER - 1])));

  const res = ebay_('get', '/sell/fulfillment/v1/order?limit=50&filter=' + encodeURIComponent('creationdate:[' + since + '..]'));
  const orders = (res.orders || []).slice().sort((a, b) => new Date(a.creationDate) - new Date(b.creationDate));
  let sent = 0;
  for (const o of orders) {
    if (sent >= 10) break;
    if (logged.has(String(o.orderId))) continue;
    if (o.orderPaymentStatus !== 'PAID') continue;
    if (o.cancelStatus && o.cancelStatus.cancelState && o.cancelStatus.cancelState !== 'NONE_REQUESTED') continue;
    const b = orderBasics_(o);
    const body = template.replace(/\{name\}/g, b.name).replace(/\{item\}/g, b.itemTitle).replace(/\{signature\}/g, signature);
    const row = ['購入後', String(o.orderId), new Date(o.creationDate), b.buyer, b.itemTitle, '', '', '', '', ''];
    try { sendMemberMsg_(b.itemId, b.buyer, subject, body, 'General'); row[7] = '送信済み'; row[8] = amStamp_(); sent++; }
    catch (e) { row[7] = 'エラー'; row[8] = e.message; }
    sh.appendRow(row);
    logged.add(String(o.orderId));
  }
  return { enabled: true, sent: sent };
}

/* ---------- 発送後 ---------- */
/* ---------- 配送会社の判定（今後使う4つの発送方法に対応） ----------
 *  ・日本郵便 …… eBay内でスキャン／手入力（配送会社が「その他」でも番号の形で判定）
 *  ・DHL ………… 外部サイトからアップロード
 *  ・FedEx ……… 外部サイトからアップロード
 *  ・eBay SpeedPAK … 外部サイトからアップロード（Orange Connex）
 */
function isJapanPostNumber_(num) {
  return /^[A-Z]{2}\d{9}JP$/i.test(String(num || '').replace(/\s/g, ''));
}

// 配送会社コードと番号の形から、4つの発送方法のどれかを判定
function detectCarrier_(code, num) {
  const c = String(code || '').toLowerCase().replace(/[\s_-]/g, '');
  const n = String(num || '').replace(/\s/g, '').toUpperCase();
  if (/speedpak|orange|oconnex|^oc$|ebayspeed/.test(c)) return 'speedpak';
  if (/fedex|fdx/.test(c)) return 'fedex';
  if (/dhl/.test(c)) return 'dhl';
  if (/japan|jppost|jpost|yubin|ems/.test(c) || isJapanPostNumber_(n)) return /^EJ/.test(n) ? 'jpems' : 'jp';
  if (/ups/.test(c)) return 'ups';
  if (/usps/.test(c)) return 'usps';
  // 配送会社が「その他」などのときは番号の形で判定
  if (/^\d{10}$/.test(n)) return 'dhl';                 // DHL Express：10桁
  if (/^\d{12}$|^\d{15}$/.test(n)) return 'fedex';      // FedEx：12桁・15桁
  if (/^(SP|OC|EB)[A-Z0-9]{8,}$/.test(n)) return 'speedpak';
  return 'other';
}

function carrierName_(code, num) {
  const k = detectCarrier_(code, num);
  return { jp: 'Japan Post', jpems: 'Japan Post (EMS)', dhl: 'DHL Express', fedex: 'FedEx', speedpak: 'eBay SpeedPAK',
           ups: 'UPS', usps: 'USPS' }[k] || (code || 'Other');
}

function trackingUrl_(code, num) {
  const k = detectCarrier_(code, num);
  const n = encodeURIComponent(String(num || '').replace(/\s/g, ''));
  if (k === 'jp' || k === 'jpems') return 'https://trackings.post.japanpost.jp/services/srv/search/?requestNo1=' + n + '&locale=en';
  if (k === 'dhl') return 'https://www.dhl.com/global-en/home/tracking/tracking-express.html?tracking-id=' + n;
  if (k === 'fedex') return 'https://www.fedex.com/fedextrack/?trknbr=' + n;
  if (k === 'ups') return 'https://www.ups.com/track?tracknum=' + n;
  if (k === 'usps') return 'https://tools.usps.com/go/TrackConfirmAction?tLabels=' + n;
  return 'https://t.17track.net/en#nums=' + n;   // eBay SpeedPAK などは17TRACKで追跡
}

function findTracking_(orderId) {
  const f = ebay_('get', '/sell/fulfillment/v1/order/' + encodeURIComponent(orderId) + '/shipping_fulfillment');
  const list = (f.fulfillments || []).filter(x => x.shipmentTrackingNumber)
    .sort((a, b) => new Date(b.shippedDate || 0) - new Date(a.shippedDate || 0));
  return list.length ? { number: String(list[0].shipmentTrackingNumber).replace(/\s/g, ''),
                         carrier: list[0].shippingCarrierCode || '', shippedDate: list[0].shippedDate } : null;
}
function uploadTracking_(orderId, number) {
  if (!isJapanPostNumber_(number)) throw new Error('日本郵便の番号の形ではないため、eBayへの登録はしていません');
  trading_('CompleteSale',
    '<OrderID>' + x_(orderId) + '</OrderID><Shipped>true</Shipped>' +
    '<Shipment><ShipmentTrackingDetails>' +
    '<ShipmentTrackingNumber>' + x_(number) + '</ShipmentTrackingNumber>' +
    '<ShippingCarrierUsed>JapanPost</ShippingCarrierUsed>' +
    '</ShipmentTrackingDetails></Shipment>');
}

function sendShipMsg_(sh, o, tracking, carrierCode) {
  const b = orderBasics_(o);
  const signature = getSettings_().signature;
  let body, carrier;
  if (tracking) {
    body = String(sh.getRange('B9').getValue() || '');
    if (!body.trim()) throw new Error('発送後メッセージの本文（B9）が空です');
    carrier = carrierName_(carrierCode, tracking);
    body = body.replace(/\{carrier\}/g, carrier).replace(/\{tracking\}/g, tracking).replace(/\{tracking_url\}/g, trackingUrl_(carrierCode, tracking));
  } else {
    body = String(sh.getRange('B10').getValue() || '');
    if (!body.trim()) throw new Error('追跡なしの本文（B10）が空です');
    carrier = '（追跡なし）';
  }
  body = body.replace(/\{name\}/g, b.name).replace(/\{item\}/g, b.itemTitle).replace(/\{signature\}/g, signature);
  sendMemberMsg_(b.itemId, b.buyer, sh.getRange('B8').getValue() || 'Your item has been shipped!', body, 'Shipping');
  return { carrier: carrier };
}

function noteShipMethods_(sh) {
  if (sh.getRange('C6').getValue() !== '') return;
  sh.getRange('C6').setValue('発送方法：日本郵便（eBay内でスキャン／手入力）、DHL・FedEx・eBay SpeedPAK（外部サイトから追跡番号をアップロード）。' +
    'どの方法でも、eBayの注文に追跡番号が入れば5分以内に自動送信します。').setFontColor('#777777').setWrap(true);
}

function sendShipMessages_() {
  const sh = amSheetIfAny_();
  if (sh) noteShipMethods_(sh);
  if (!sh || sh.getRange('B7').getValue() !== true) return { enabled: false, sent: 0, waiting: 0 };

  const p = PropertiesService.getScriptProperties();
  let since = p.getProperty('SHIP_MSG_SINCE');
  if (!since) { p.setProperty('SHIP_MSG_SINCE', new Date().toISOString()); return { enabled: true, sent: 0, waiting: 0 }; }
  const waitHours = Number(sh.getRange('B11').getValue()) || 24;
  let sent = 0, waiting = 0;

  // A) 追跡番号待ち・確認待ちの行
  const data = amLog_(sh);
  const logged = new Set(data.filter(r => r[0] === '発送後').map(r => String(r[AL.ORDER - 1])));
  for (let i = 0; i < data.length && sent < 10; i++) {
    const r = data[i], row = AM_LOG_START + i;
    if (r[0] !== '発送後') continue;
    const status = r[AL.RESULT - 1];
    if (status !== '追跡番号待ち' && status !== '確認待ち') continue;
    try {
      let tracking = String(r[AL.TRACK - 1] || '').replace(/\s/g, '').toUpperCase();
      let carrierCode = '', note = '';
      if (tracking) {
        try { uploadTracking_(r[AL.ORDER - 1], tracking); note = 'eBayにも追跡番号を登録'; }
        catch (e) { note = 'eBayへの番号登録はできませんでした：' + e.message; }
      } else {
        const t = findTracking_(r[AL.ORDER - 1]);
        if (t) { tracking = t.number; carrierCode = t.carrier; }
      }
      const confirmed = r[AL.NOTRACK - 1] === true;
      if (!tracking && !confirmed) {
        const waited = (Date.now() - new Date(r[AL.DATE - 1]).getTime()) / 3600000;
        if (waited >= waitHours && status !== '確認待ち') {
          sh.getRange(row, AL.RESULT).setValue('確認待ち').setBackground('#ffe08a');
          sh.getRange(row, AL.NOTE).setValue('追跡番号が入りませんでした。G列に番号を入れるか、J列にチェックで追跡なし送信');
          sh.getRange(row, AL.NOTRACK).setBackground('#ffe08a');
        }
        waiting++;
        continue;
      }
      const o = ebay_('get', '/sell/fulfillment/v1/order/' + encodeURIComponent(r[AL.ORDER - 1]));
      const res = sendShipMsg_(sh, o, tracking, carrierCode);
      sh.getRange(row, AL.CARRIER, 1, 4).setValues([[res.carrier, tracking, '送信済み', amStamp_() + (note ? '（' + note + '）' : '')]]);
      sh.getRange(row, AL.TRACK, 1, 4).setBackground(null);
      sent++;
    } catch (e) {
      sh.getRange(row, AL.NOTE).setValue('エラー：' + e.message);
    }
  }

  // B) 新しく発送済みになった注文
  const res = ebay_('get', '/sell/fulfillment/v1/order?limit=50&filter=' +
    encodeURIComponent('lastmodifieddate:[' + since + '..],orderfulfillmentstatus:{FULFILLED|IN_PROGRESS}'));
  for (const o of (res.orders || [])) {
    if (sent >= 10) break;
    if (logged.has(String(o.orderId))) continue;
    if (new Date(o.creationDate) < new Date(Date.now() - 60 * 24 * 3600 * 1000)) continue;
    const t = findTracking_(o.orderId);
    if (!t && o.orderFulfillmentStatus !== 'FULFILLED') continue;
    // 発送日はeBay上で0時などに丸められることがあるため、オンにした時刻の2日前までは対象にする
    if (t && t.shippedDate && new Date(t.shippedDate) < new Date(new Date(since).getTime() - 48 * 3600 * 1000)) { logged.add(String(o.orderId)); continue; }
    const b = orderBasics_(o);
    if (t) {
      const row = ['発送後', String(o.orderId), t.shippedDate ? new Date(t.shippedDate) : new Date(), b.buyer, b.itemTitle, '', t.number, '', '', ''];
      try { const r2 = sendShipMsg_(sh, o, t.number, t.carrier); row[5] = r2.carrier; row[7] = '送信済み'; row[8] = amStamp_(); sent++; }
      catch (e) { row[7] = 'エラー'; row[8] = e.message; }
      sh.appendRow(row);
    } else {
      sh.appendRow(['発送後', String(o.orderId), new Date(), b.buyer, b.itemTitle, '', '', '追跡番号待ち',
        'G列に追跡番号を入れると追跡つきで送信（' + waitHours + '時間入らなければ「確認待ち」）', false]);
      const lr = sh.getLastRow();
      sh.getRange(lr, AL.TRACK).setBackground('#fff4dc');
      sh.getRange(lr, AL.NOTRACK).insertCheckboxes();
      waiting++;
    }
    logged.add(String(o.orderId));
  }
  return { enabled: true, sent: sent, waiting: waiting };
}

function menuAutoMessages() {
  run_(() => {
    const sh = autoMsgSheet_();
    if (sh.getRange('B2').getValue() !== true && sh.getRange('B7').getValue() !== true) {
      throw new Error('「自動メッセージ」シートのB2（購入後）かB7（発送後）にチェックを入れてから実行してください');
    }
    const a = sendPurchaseMessages_();
    const b = sendShipMessages_();
    return '購入後 ' + a.sent + '件・発送後 ' + b.sent + '件 送信しました' + (b.waiting ? '（追跡番号待ち・確認待ち ' + b.waiting + '件）' : '');
  });
}


/* =====================================================================
 * 在庫管理（無在庫向け）
 *  ① 在庫チェック：出品中の商品の仕入れ先ページで「eBayへ送る」を押すと、
 *     売り切れならeBayの在庫を0に、再入荷なら1に戻し、仕入れ値の変化も記録
 *  ② 仕入れリスト：eBayで売れた注文を、仕入れURL・仕入れ値・利益目安つきで一覧化
 * ===================================================================== */

// 仕入れURLを比較用の形にそろえる（同じ商品なら同じ文字列になる）
function srcKey_(u) {
  u = String(u || '').trim();
  if (!u) return '';
  let m;
  if ((m = u.match(/amazon\.[^\/]+\/.*?(?:dp|gp\/product|gp\/aw\/d)\/([A-Z0-9]{10})/i))) return 'amazon:' + m[1].toUpperCase();
  if ((m = u.match(/mercari\.com\/(?:[a-z]{2}\/)?(?:item|shops\/product)\/([A-Za-z0-9]+)/i))) return 'mercari:' + m[1];
  if ((m = u.match(/paypayfleamarket\.yahoo\.co\.jp\/item\/([A-Za-z0-9]+)/i))) return 'yfleama:' + m[1];
  if ((m = u.match(/auctions\.yahoo\.co\.jp\/.*?\/([a-z]?\d{6,})/i))) return 'yauc:' + m[1];
  if ((m = u.match(/suruga-ya\.jp\/product\/(?:detail|other)\/([A-Za-z0-9]+)/i))) return 'suruga:' + m[1];
  if ((m = u.match(/netoff\.co\.jp\/detail\/([A-Za-z0-9]+)/i))) return 'netoff:' + m[1];
  if ((m = u.match(/netmall\.hardoff\.co\.jp\/product\/([A-Za-z0-9]+)/i))) return 'offmall:' + m[1];
  if ((m = u.match(/diskunion\.net\/.*?detail\/([A-Za-z0-9]+)/i))) return 'diskunion:' + m[1];
  if ((m = u.match(/item\.rakuten\.co\.jp\/([^\/?#]+)\/([^\/?#]+)/i))) return 'rakuten:' + m[1].toLowerCase() + '/' + m[2].toLowerCase();
  if ((m = u.match(/books\.rakuten\.co\.jp\/rb\/(\d+)/i))) return 'rbooks:' + m[1];
  if ((m = u.match(/(?:item\.)?fril\.jp\/(?:item\/)?([a-z0-9]{16,})/i))) return 'rakuma:' + m[1].toLowerCase();
  return u.replace(/[?#].*$/, '').replace(/\/+$/, '').replace(/^https?:\/\/(www\.)?/i, '').toLowerCase();
}

function findListingBySource_(url) {
  const key = srcKey_(url);
  if (!key) return null;
  const sh = ss_().getSheetByName('出品一覧');
  if (!sh || sh.getLastRow() < 2) return null;
  const vals = sh.getRange(2, 1, sh.getLastRow() - 1, LIST_HEADERS.length).getValues();
  for (let i = 0; i < vals.length; i++) {
    if (vals[i][LCOL.SRC_URL - 1] && srcKey_(vals[i][LCOL.SRC_URL - 1]) === key) return { row: i + 2, r: vals[i] };
  }
  return null;
}

function judgeAvailability_(key, st, d) {
  if (zAvailFree_()) return zAvailRule_(d);   // v122：AIなし（ページの文字で判断）
  return parseJson_(claude_(key, st.model,
    'あなたは日本の通販・フリマの商品ページを見て、今この商品を購入できるかを判定するアシスタントです。出力はJSONのみ。',
    '表示価格: ' + (d.price || '') + '\nページの文章:\n' + String(d.text || '').slice(0, 6000) +
    '\n仕入れ先URL: ' + (d.url || '') + '\n' + SITE_HINTS +
    '\n\n「売り切れ」「SOLD」「SOLD OUT」「在庫切れ」「品切れ」「在庫なし」「入荷待ち」「入荷お知らせ」「現在お取り扱いできません」「取引中」「出品停止」などがあれば購入できません。' +
    'カートに入れられない・予約のみの場合も購入できないと判断します。\n' +
    '次のJSONで答えてください:\n{"available":true または false,"reason_ja":"判断の理由（短く）","price_jpy":数値またはnull}'));
}

/* =====================================================================
 * v105：APIの節約
 * ===================================================================== */
// E：在庫確認のときに写真が変わっていれば、写真だけeBayに反映（AIは使わない）
function refreshPhotosIfChanged_(itemId, d) {
  const imgs = (d.images || []).filter(u => /^https?:\/\//.test(u)).slice(0, 24);
  if (!imgs.length) return '';
  const sh = ss_().getSheetByName('出品作成');
  if (!sh || sh.getLastRow() < 2) return '';
  const vals = sh.getRange(2, 1, sh.getLastRow() - 1, PREP_HEADERS.length).getValues();
  const i = vals.findIndex(v => String(v[P.ITEMID - 1]) === itemId);
  if (i < 0) return '';
  const base = u => String(u).split('?')[0];
  const before = String(vals[i][P.IMGS - 1] || '').split(/\n+/).map(x => x.trim()).filter(x => /^https?:\/\//.test(x));
  if (before.map(base).join('\n') === imgs.map(base).join('\n')) return '写真は前回と同じため、eBayの出品はそのまま（AIは使っていません）';
  const eps = uploadPictures_(imgs);
  trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(itemId) + '</ItemID><PictureDetails>' + eps.map(u => '<PictureURL>' + x_(u) + '</PictureURL>').join('') + '</PictureDetails></Item>');
  sh.getRange(i + 2, P.IMGS).setValue(imgs.join('\n'));
  sh.getRange(i + 2, P.IMGSTAT).setValue('写真を最新に更新：' + eps.length + '枚（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '・写真だけ差し替え）');
  return 'eBayの写真を最新に差し替えました：' + before.length + '枚 → ' + eps.length + '枚（出品文はそのまま）';
}

// E：14日以内に判定した同じ商品か（見送り済み → 判定しない／出品済み → 判定しない／判定済みの行 → その行を使う）
function reuseJudged_(sh, row) {
  const v = sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0];
  const key = srcKey_(v[P.SRC - 1]);
  if (!key) return null;
  const since = Date.now() - 14 * 86400000;
  const cost = Number(v[P.COST - 1]) || 0;
  const fmt = d => d instanceof Date ? Utilities.formatDate(d, 'Asia/Tokyo', 'MM/dd HH:mm') : '';
  // 見送り記録（同じ仕入れ値のときだけ。値下がりしていれば判定し直す）
  if (!ZSENT_) try {   /* v208：送った品は、前に見送った品でも判定し直す（見送りにしないため） */
    const log = ss_().getSheetByName('見送り記録');
    if (log && log.getLastRow() > 1) {
      const n = Math.min(3000, log.getLastRow() - 1);
      const lv = log.getRange(log.getLastRow() - n + 1, 1, n, 7).getValues();
      for (let k = lv.length - 1; k >= 0; k--) {
        const x = lv[k];
        if (!(x[0] instanceof Date) || x[0].getTime() < since) continue;
        if (srcKey_(x[1]) !== key) continue;
        if (cost && Number(x[3]) && cost < Number(x[3])) break;          // 値下がり → 判定し直す
        return { skip: '14日以内（' + fmt(x[0]) + '）に見送り済みの商品のため、判定し直していません：' + String(x[6]).slice(0, 200) + '（仕入れ値が下がったときは自動で判定し直します）', label: '⏸ 見送り（判定済み）' };
      }
    }
  } catch (e) {}
  // 出品作成のほかの行
  const last = sh.getLastRow();
  if (last < 3) return null;
  const all = sh.getRange(2, 1, last - 1, PREP_HEADERS.length).getValues();
  for (let k = all.length - 1; k >= 0; k--) {
    const r = all[k], rr = k + 2;
    if (rr === row || srcKey_(r[P.SRC - 1]) !== key) continue;
    const st2 = String(r[P.STATUS - 1] || '');
    if (/まとめ判定待ち|判定中|準備中/.test(st2)) continue;
    const dt = r[P.DATE - 1];
    if (!(dt instanceof Date) || dt.getTime() < since) continue;
    if (String(r[P.ITEMID - 1] || '').trim()) return { skip: 'この商品はすでに出品済みです（出品作成 ' + rr + '行目・eBay商品ID ' + r[P.ITEMID - 1] + '）。判定し直していません', label: '🔁 出品済み' };
    if (!String(r[P.TITLE - 1] || '').trim() || !String(r[P.PLANS - 1] || '').trim()) continue;   // 判定が終わっていない行は使わない
    // 判定済みの行を使う：仕入れ値・写真だけ新しくして、利益の判定（AIなし）からやり直す
    if (cost) sh.getRange(rr, P.COST).setValue(cost);
    if (String(v[P.IMGS - 1] || '').trim()) sh.getRange(rr, P.IMGS).setValue(v[P.IMGS - 1]);
    sh.getRange(rr, P.STATUS).setValue('受信');
    sh.getRange(rr, P.NOTE).setValue('14日以内（' + fmt(dt) + '）に判定済みの商品のため、相場・出品文などは前の結果を使い、利益の判定だけやり直しました');
    return { useRow: rr < row ? rr : rr - 1 };
  }
  return null;
}

// D：利益が出ないと確定したか（いちばん有利な条件＝軽い重さ・関税なし・固定費なし・手数料は低め で計算しても、出品しないルールに当たる）
function earlyStop_(cur, info, mk) {
  if (ZSENT_) return '';   // v208：送った品は、早い段階で見送りにしない
  try {
    const cost = Number(cur[P.COST - 1]) || 0;
    if (!(cost > 0)) return '';
    const rule = soldRuleSettings_();
    const off = official_(), cs = calcSettings_();
    const totals = (mk.items || []).map(it => it._total).filter(x => x > 0).sort((a, b) => a - b);
    const sd = soldDataForRow_(cur);
    const so = soldDist_(sd && sd.list);
    const useSold = so && so.count >= rule.minCount;
    if (!useSold && rule.holdIfNoSold) return '';                       // Sold待ちで保留になる設定のときは止めない
    const rs = totals.length ? robustStats_(totals) : null;
    if (!useSold && !(rs && rs.count >= 3)) return '';                  // 比べる相場が足りないときは止めない（通常どおり判定）
    const ref = useSold ? so.median : rs.median;
    const w = Math.max(30, Math.round((Number(info.weight_g) || 0) * 0.5));
    let minOpt = Infinity;
    cs.methods.forEach(m => {
      const sr = shipYen_(off, m, w, ref, null);
      if (sr.yen === null) return;
      const f = Math.max(0, feeRate_(off, '', ref, m) - 0.03);
      const keep = 1 - f;
      if (keep > 0) minOpt = Math.min(minOpt, (cost + Math.max(0, sr.yen) + cs.minProfit) / keep / off.rate);
    });
    if (!isFinite(minOpt)) return '';
    const r2 = x => '$' + x.toFixed(2);
    if (useSold && (minOpt > so.max || minOpt / so.median > rule.dnl))
      return '見送り：いちばん有利な条件で計算しても、最低利益を守る価格（' + r2(minOpt) + '以上）がSold相場（中央値 ' + r2(so.median) + '・最高 ' + r2(so.max) + '）から大きく離れています（当社のコスト構造では成立しない価格帯）';
    if (!useSold && minOpt / rs.median > rule.dnl)
      return '見送り：いちばん有利な条件で計算しても、最低利益を守る価格（' + r2(minOpt) + '以上）が出品中の同じ商品の中央値 ' + r2(rs.median) + '（' + rs.count + '件）の' + Math.round(rule.dnl * 100) + '%を超えています（当社のコスト構造では成立しない価格帯）';
    return '';
  } catch (e) { return ''; }
}

function stockCheck_(hit, d, opts) {
  opts = opts || {};
  API_ITEM_ = String(d.url || '') + '（在庫確認・' + String(hit.r[LCOL.ID - 1]) + '）';
  const key = need_('ANTHROPIC_API_KEY');
  const st = getSettings_();
  let reviseMsg = '';
  // v105（E）：写真が変わったときだけ、写真を差し替える（出品文はAIで作り直さない）
  if (!opts.auto) try { reviseMsg = refreshPhotosIfChanged_(String(hit.r[LCOL.ID - 1]), d); }
  catch (e) { reviseMsg = 'eBayの写真の更新でエラー：' + e.message; }
  const sh = listSheet_();
  const r = hit.r, row = hit.row;
  const itemId = String(r[LCOL.ID - 1]);
  const qty = Number(r[LCOL.QTY - 1]) || 0;
  const oldCost = Number(r[LCOL.COST - 1]) || 0;

  let j = judgeAvailability_(key, st, d);
  const method = opts.method || '「eBayへ送る」ボタン';
  // v122：ページの文字から判断できないときは、何も変えない（要目視）
  if (j.available === null) {
    sh.getRange(row, LCOL.SRC_STATE).setValue('要目視：ページの文字から在庫を判断できない（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）').setBackground('#fef7e0');
    stockLog_(r, method, '🟡 要目視', j.reason_ja || '', d.url);
    LAST_STOCK_ = { result: 'review', reason: j.reason_ja || '', state: '要目視' };
    return page_('🟡 在庫を判断できませんでした', esc_(j.reason_ja || '') + '<br>eBayの出品は変えていません。仕入れ先のページを目で確かめてください。');
  }
  // 自動確認で売り切れと判断したときは、時間をおいてページを読み直し、もう一度判定（2回とも売り切れのときだけ取り下げ）
  if (j.available === false && typeof opts.confirm === 'function') {
    let j2 = null;
    try { const d2 = opts.confirm(); if (d2) j2 = judgeAvailability_(key, st, d2); } catch (e) {}
    if (!j2 || j2.available !== false) {
      const why = '1回目は売り切れ（' + (j.reason_ja || '') + '）、2回目は' + (j2 ? '在庫あり（' + (j2.reason_ja || '') + '）' : '読み直せず') + '。判定が分かれたため、変更していません。仕入れ先ページを目で確認してください';
      sh.getRange(row, LCOL.SRC_STATE).setValue('要目視：判定が分かれた（' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）').setBackground('#fef7e0');
      stockLog_(r, method, '⚠ 要目視（変更なし）', why, d.url);
      LAST_STOCK_ = { result: 'review', reason: why };
      return page_('⚠ 判定が分かれました', esc_(why));
    }
    j = Object.assign({}, j, { reason_ja: '1回目：' + (j.reason_ja || '') + '／2回目：' + (j2.reason_ja || '') });
  }

  const newCost = Number(String(d.price || '').replace(/[^\d.]/g, '')) || Number(j.price_jpy) || 0;
  const msgs = [];
  let state;

  if (j.available === false) {
    try { stockOutAlarm_(r[LCOL.TITLE - 1], itemId, d.url, j.reason_ja); } catch (e) {}
    if (inventorySettings_().endOnSoldOut) {
      try {
        trading_('EndFixedPriceItem', '<ItemID>' + x_(itemId) + '</ItemID><EndingReason>NotAvailable</EndingReason>');
        sh.getRange(row, LCOL.QTY).setValue(0);
        state = '売り切れ → eBayの出品を取り下げました';
        recordDelisting_(r, '🛑 取り下げ', method, j.reason_ja, d.url);
        sh.getRange(row, LCOL.MEMO).setValue(String(r[LCOL.MEMO - 1] || '') + (r[LCOL.MEMO - 1] ? '／' : '') + '【取り下げ ' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '】' + (j.reason_ja || '仕入れ先で売り切れ'));
      } catch (e) {
        state = '売り切れ → 出品の取り下げでエラー：' + e.message;
        recordDelisting_(r, '⚠ 取り下げエラー', method, (j.reason_ja || '') + '／エラー：' + e.message, d.url);
      }
    } else if (qty > 0) {
      trading_('ReviseInventoryStatus', '<InventoryStatus><ItemID>' + x_(itemId) + '</ItemID><Quantity>0</Quantity></InventoryStatus>');
      sh.getRange(row, LCOL.QTY).setValue(0);
      state = '売り切れ → eBayの在庫を0にしました';
    } else {
      state = '売り切れ（eBayの在庫はすでに0）';
    }
  } else {
    if (qty === 0) {
      trading_('ReviseInventoryStatus', '<InventoryStatus><ItemID>' + x_(itemId) + '</ItemID><Quantity>1</Quantity></InventoryStatus>');
      sh.getRange(row, LCOL.QTY).setValue(1);
      state = '再入荷 → eBayの在庫を1に戻しました';
    } else {
      state = '在庫あり';
    }
    if (newCost > 0 && oldCost > 0 && Math.abs(newCost - oldCost) >= 1) {
      const up = newCost > oldCost;
      msgs.push('仕入れ値が ' + oldCost.toLocaleString() + '円 → ' + newCost.toLocaleString() + '円 に' + (up ? '値上がり' : '値下がり'));
      if (up) {
        const adv = repriceAdvice_(itemId, Number(r[LCOL.PRICE - 1]) || 0, newCost);
        if (adv) {
          msgs.push(adv.text);
          if (adv.newPrice) sh.getRange(row, LCOL.NEW_PRICE).setValue(adv.newPrice);
        }
        priceUpAlarm_(r[LCOL.TITLE - 1], oldCost, newCost, adv, d.url);
      }
      sh.getRange(row, LCOL.COST).setValue(newCost);
    } else if (newCost > 0 && !oldCost) {
      sh.getRange(row, LCOL.COST).setValue(newCost);
    }
  }
  sh.getRange(row, LCOL.CHECKED).setValue(new Date());
  sh.getRange(row, LCOL.SRC_STATE).setValue(state + (msgs.length ? '／' + msgs.join('／') : ''));
  sh.getRange(row, LCOL.SRC_STATE).setBackground(j.available === false ? '#f8d0d0' : (msgs.length ? '#fff4dc' : '#d8f0d8'));
  stockLog_(r, method, j.available === false ? '🔴 ' + state : '🟢 ' + state, (j.reason_ja || '') + (msgs.length ? '／' + msgs.join('／') : ''), d.url);
  LAST_STOCK_ = { result: j.available === false ? (/取り下げました/.test(state) ? 'delisted' : 'soldout') : 'ok', reason: j.reason_ja || '', state: state };

  return page_(j.available === false ? '🔴 売り切れでした' : '🟢 在庫あり',
    'この商品はすでに出品中なので、在庫チェックを行いました。<br><br><b>' + esc_(r[LCOL.TITLE - 1]) + '</b><br>' +
    esc_(state) + (msgs.length ? '<br>' + esc_(msgs.join('<br>')) : '') +
    (reviseMsg ? '<br><br><b>' + esc_(reviseMsg) + '</b>' : '') +
    '<br><br><span style="color:#777">判断の理由：' + esc_(j.reason_ja || '') + '</span><br><br>このタブは閉じてOKです。');
}

