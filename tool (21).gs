// 「写真ログ」シートに1行記録（すべての段階の枚数）
function photoLog_(o) {
  try {
    const ss = ss_();
    let sh = ss.getSheetByName('写真ログ');
    if (!sh) {
      sh = ss.insertSheet('写真ログ');
      sh.getRange(1, 1, 1, 14).setValues([['日時', '段階', '仕入れURL', '取得方法', 'ページの写真数', 'ボタンが取得した数', 'シートの写真数', 'eBayに渡した数',
        'eBayに登録された数', '結果', '欠落・失敗の理由', 'eBay商品ID', '出品作成の行', 'サイト']]).setFontWeight('bold').setBackground('#e8f0f2');
      [120, 70, 240, 170, 90, 100, 90, 90, 100, 150, 380, 120, 80, 100].forEach((w, i) => sh.setColumnWidth(i + 1, w));
      sh.setFrozenRows(1);
    }
    const u = String(o.url || '');
    const site = /mercari/.test(u) ? 'メルカリ' : /paypayfleamarket/.test(u) ? 'Yahoo!フリマ' : /auctions\.yahoo/.test(u) ? 'ヤフオク' : /amazon/.test(u) ? 'Amazon' : ((u.match(/^https?:\/\/([^\/]+)/) || [])[1] || '');
    const v = x => (x === undefined || x === null || x === '' ? '' : x);
    sh.appendRow([new Date(), o.stage || '', u, v(o.method), v(o.page), v(o.got), v(o.sheet), v(o.passed), v(o.ebay), v(o.result), String(o.reason || '').slice(0, 1500), v(o.itemId), v(o.row), site]);
    const lr = sh.getLastRow();
    sh.getRange(lr, 12).setNumberFormat('@');
    if (/⚠|しない|失敗/.test(String(o.result || ''))) sh.getRange(lr, 10).setBackground('#f8d0d0');
    else if (/OK/.test(String(o.result || ''))) sh.getRange(lr, 10).setBackground('#d8f0d8');
    if (lr > 20000) sh.deleteRows(2, 2000);
  } catch (e) { Logger.log(e); }
}

// eBayに登録されている写真の枚数（確認できなければ -1）
function ebayPictureCount_(itemId) {
  if (!itemId) return -1;
  for (let k = 0; k < 2; k++) {
    try {
      const it = trading_('GetItem', '<ItemID>' + x_(String(itemId)) + '</ItemID><DetailLevel>ReturnAll</DetailLevel>');
      const item = it.root.getChild('Item', it.ns);
      const pd = item ? item.getChild('PictureDetails', it.ns) : null;
      return pd ? pd.getChildren('PictureURL', it.ns).length : 0;
    } catch (e) { Utilities.sleep(2000); }
  }
  return -1;
}

// 出品前の写真チェック：ページの写真数と比べる。メルカリで1枚しかないときは番号で残りを確認
function photoGate_(sh, row, r, imgs) {
  let raw = {}; try { raw = JSON.parse(r[P.RAW - 1] || '{}'); } catch (e) {}
  const src = String(r[P.SRC - 1] || '');
  const res = { imgs: imgs.slice(0, 24), page: Number(raw.pc) || '', got: Number(raw.got) || '', method: raw.im || '', note: '' };
  const notes = [];
  if (raw.inote) notes.push(String(raw.inote));
  const mid = (src.match(/jp\.mercari\.com\/item\/(m\d+)/) || [])[1];
  // メルカリ：1枚しかない、またはページの写真数より少ないときは、写真番号で残りを確認（この商品のIDの写真だけ）
  if (mid && (res.imgs.length <= 1 || (res.page && res.imgs.length < Math.min(24, res.page)))) {
    let probe = [];
    try { probe = mercariImages_(mid); } catch (e) {}
    if (probe.length > res.imgs.length) {
      notes.push('メルカリの写真番号で確認し、' + res.imgs.length + '枚 → ' + probe.length + '枚にしました');
      res.imgs = probe.slice(0, 24);
      sh.getRange(row, P.IMGS).setValue(res.imgs.join('\n'));
      res.page = Math.max(Number(res.page) || 0, probe.length);
    } else if (res.imgs.length <= 1) notes.push('写真番号でも2枚目は見つかりませんでした（ページの写真は1枚）');
  }
  const need = Math.min(24, Number(res.page) || 0);
  if (need && res.imgs.length < need) {
    const why = '写真が足りません：仕入れ先ページ ' + res.page + '枚・シート ' + res.imgs.length + '枚（' + (res.method || '取得方法不明') + '）' + (notes.length ? '／' + notes.join('／') : '');
    photoLog_({ stage: '出品', url: src, row: row, method: res.method, page: res.page, got: res.got, sheet: res.imgs.length, result: '出品しない（写真不足）', reason: why });
    throw new Error(why + '。仕入れ先の商品ページで、もう一度「eBayへ送る」を押してください');
  }
  res.note = notes.join('／');
  return res;
}

// メニュー：選んだ行の写真を確認（出品前テスト）。eBayの写真サーバーにアップロードまで行い、出品はしない
function menuPhotoTest() {
  run_(() => {
    const sh = SpreadsheetApp.getActiveSheet();
    if (sh.getName() !== '出品作成') throw new Error('「出品作成」シートで、確認したい行を選んでから押してください');
    const rg = sh.getActiveRange();
    const lines = [];
    for (let row = Math.max(2, rg.getRow()); row < rg.getRow() + rg.getNumRows() && lines.length < 5; row++) {
      const r = sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0];
      let raw = {}; try { raw = JSON.parse(r[P.RAW - 1] || '{}'); } catch (e) {}
      const imgs = String(r[P.IMGS - 1] || '').split(/\n+/).map(v => v.trim()).filter(v => /^https?:\/\//.test(v));
      let eps = [], err = '';
      try { eps = uploadPictures_(imgs.slice(0, 24)); } catch (e) { err = e.message; }
      const page = Number(raw.pc) || '';
      const ok = !err && eps.length === imgs.length && (!page || imgs.length >= Math.min(24, page));
      photoLog_({ stage: 'テスト', url: r[P.SRC - 1], row: row, method: raw.im, page: page, got: raw.got, sheet: imgs.length, passed: eps.length,
        result: ok ? 'OK（欠落なし）' : '⚠ 要確認', reason: err || (page && imgs.length < Math.min(24, page) ? 'ページの写真より少ない' : '') + (raw.inote ? '／' + raw.inote : '') });
      lines.push(row + '行目：ページ ' + (page || '不明') + '枚／ボタン ' + (raw.got || '不明') + '枚／シート ' + imgs.length + '枚／eBayアップロード ' + eps.length + '枚' + (ok ? ' → OK' : ' → 要確認' + (err ? '（' + err + '）' : '')));
    }
    ss_().getSheetByName('写真ログ').activate();
    return lines.join('／') + '（出品はしていません。詳しくは「写真ログ」シート）';
  });
}

// メニュー：出品済みの商品の写真枚数を確認（シートの枚数とeBayの枚数を比べる）
function menuPhotoAudit() {
  run_(() => {
    const sh = ss_().getSheetByName('出品作成');
    if (!sh || sh.getLastRow() < 2) throw new Error('「出品作成」シートに商品がありません');
    const vals = sh.getRange(2, 1, sh.getLastRow() - 1, PREP_HEADERS.length).getValues();
    let n = 0, short = 0;
    const start = Date.now();
    for (let i = vals.length - 1; i >= 0 && Date.now() - start < 4 * 60 * 1000; i--) {
      const r = vals[i], itemId = String(r[P.ITEMID - 1] || '').trim();
      if (!itemId) continue;
      let raw = {}; try { raw = JSON.parse(r[P.RAW - 1] || '{}'); } catch (e) {}
      const sheetN = String(r[P.IMGS - 1] || '').split(/\n+/).filter(v => /^https?:\/\//.test(v.trim())).length;
      const onEbay = ebayPictureCount_(itemId);
      const page = Number(raw.pc) || '';
      const want = Math.min(24, Math.max(sheetN, Number(page) || 0));
      const bad = onEbay >= 0 && onEbay < want;
      if (bad) short++;
      photoLog_({ stage: '確認', url: r[P.SRC - 1], row: i + 2, method: raw.im, page: page, got: raw.got, sheet: sheetN, ebay: onEbay, itemId: itemId,
        result: onEbay < 0 ? '確認できず' : bad ? '⚠ eBayの写真が少ない' : 'OK（欠落なし）',
        reason: bad ? '仕入れ先の商品ページで「eBayへ送る」を押すと、写真を取り直してeBayの出品も更新します' : '' });
      n++;
      if (n >= 40) break;
    }
    ss_().getSheetByName('写真ログ').activate();
    return '出品済み ' + n + '件を確認しました。写真が少ない商品：' + short + '件（「写真ログ」シート）';
  });
}

