      const loc = cat === 'EXPEDITED' ? { regionIncluded: [{ regionName: 'Worldwide' }] } : { regionIncluded: ecoCcs.map(cc => ({ regionName: cc, regionType: 'COUNTRY' })) };
      return { sortOrder: i, shippingServiceCode: codes[cat], freeShipping: false, shippingCost: { value: v.toFixed(2), currency: 'USD' }, additionalShippingCost: { value: v.toFixed(2), currency: 'USD' }, shipToLocations: loc };
    };
    const dom = (base.shippingOptions || []).filter(o => o.optionType === 'DOMESTIC');
    // v115：高額品（速い便）のポリシーの米国の配送は、FedEx用のポリシーと同じにする（選んであるときだけ）
    let domHi = dom, fedId = '';
    try { fedId = methodPolicies_().fed.id; if (fedId) { const fp = ebay_('get', '/sell/account/v1/fulfillment_policy/' + encodeURIComponent(fedId)); const d2 = (fp.shippingOptions || []).filter(o => o.optionType === 'DOMESTIC'); if (d2.length) domHi = d2; else fedId = ''; } } catch (e) { fedId = ''; }
    const mk = (name, list, d) => ({ name: name, marketplaceId: 'EBAY_US', categoryTypes: base.categoryTypes || [{ name: 'ALL_EXCLUDING_MOTORS_VEHICLES' }],
      handlingTime: base.handlingTime, shipToLocations: baseLoc, globalShipping: false,
      shippingOptions: (d || dom).concat([{ optionType: 'INTERNATIONAL', costType: 'FLAT_RATE', rateTableId: id, shippingServices: list }]) });
    // v157：同じ名前のポリシーがもうあれば（前に途中まで作れていたとき）、新しく作らずにそれを今の内容に直して使う
    let exist = [];
    try { exist = (ebay_('get', '/sell/account/v1/fulfillment_policy?marketplace_id=EBAY_US').fulfillmentPolicies || []); } catch (e) {}
    const upsert1 = body => {
      const hit = exist.find(x => String(x.name || '').trim() === body.name);
      if (hit) {
        let r = {};
        try { r = ebay_('put', '/sell/account/v1/fulfillment_policy/' + encodeURIComponent(hit.fulfillmentPolicyId), { body: body }); }
        catch (e) { if (!/same as in the system|same as the existing/i.test(e.message)) throw e; }   // v158：中身がもう同じ（直すところがない）ならそのまま使う
        return { fulfillmentPolicyId: String(r.fulfillmentPolicyId || hit.fulfillmentPolicyId), reused: true };
      }
      return ebay_('post', '/sell/account/v1/fulfillment_policy', { body: body });
    };
    // v166：eBayに「Invalid request」で断られたら、細かい指定を1つずつ外して作り直す（どれを外したかは記録して知らせる）
    const errText = e => String(e.message || e) + (e.ebayErrors ? '（' + e.ebayErrors.map(x => (x.errorId || '') + ' ' + (x.longMessage || x.message || '') + (x.parameters ? ' ' + JSON.stringify(x.parameters) : '')).join('／').slice(0, 300) + '）' : '');
    const simplified = [];
    const upsert = body => {
