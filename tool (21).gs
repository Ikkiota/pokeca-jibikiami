/* =====================================================================
 * v148：楽天・Yahoo!ショッピングの候補を増やす（0円）
 *  ・今までは「シリーズ＋レアリティ」（例 SV2a SAR）で、安い順に50件だけ見ていた → 安いカード（eBayでも安い）ばかりで、利益が出なかった
 *  ・これからは、カード型番リスト（毎時間 eBay から自動で増えている）の中で、eBayの最安が $40 以上の高いカードを、
 *    「カード名＋カード番号」で1枚ずつ探す（毎日100枚ずつ順番に・全部回ったら最初から）
 *  ・日本のお店の値段が、eBay（海外）の相場より安いのは、高いカード・古いカード・プロモに多い → ここを狙う
 *  ・判定は今までどおり（AIなし・0円）。かかる時間は1日 約6〜8分
 * ===================================================================== */
function zHighValueQueries_(kws, max, at) {
  const seen = new Set(kws.map(x => String(x.kw).toLowerCase()));
  const M = zModelRows_();
  const list = M.rows.filter(x => (x.r[ZM.USE - 1] === true || zModelOpen_(x.r)) && (Number(x.r[ZM.LOW - 1]) || 0) >= 40 && zCardNo_(x.r[ZM.KEY - 1]).num)
    .sort((a, b) => (Number(b.r[ZM.LOW - 1]) || 0) - (Number(a.r[ZM.LOW - 1]) || 0));
  if (!list.length) return [];
  const pages = Math.max(1, Math.ceil(list.length / max)), day = Math.floor((at + 9 * 3600000) / 86400000) % pages;
  const out = [];
  list.slice(day * max, day * max + max).forEach(x => {
    const cn = zCardNo_(x.r[ZM.KEY - 1]);
    const q = String(x.r[ZM.JA - 1] || '').trim() ? zJaQuery_(x.r) : (cn.set ? ['ポケモンカード', cn.set, cn.num, !/未鑑定/.test(String(x.r[ZM.GRADE - 1] || '未鑑定')) ? x.r[ZM.GRADE - 1] : ''].filter(v => v).join(' ') : '');   // 名前がなければ「シリーズ＋番号」で
    if (!q || seen.has(q.toLowerCase())) return;
    seen.add(q.toLowerCase());
    out.push({ kw: q, row: 0, mrow: x.row, hv: true });
    // v161：高いカード（上位50枚）は「PSA10」でも探す（eBayのPSA10は高く、日本のお店のPSA10は安いことがある）
    if (zGradedOk_() && out.length <= 100 && /未鑑定/.test(String(x.r[ZM.GRADE - 1] || '未鑑定')) && String(x.r[ZM.JA - 1] || '').trim()) {   // v202：鑑定品を候補にしないときは PSA10 で探さない
      const q2 = String(x.r[ZM.JA - 1]).trim() + ' ' + cn.num + ' PSA10';
      if (!seen.has(q2.toLowerCase())) { seen.add(q2.toLowerCase()); out.push({ kw: q2, row: 0, hv: true }); }
    }
  });
  // v161：未開封BOX（シリーズごと・毎日20シリーズずつ順番に）
  try { const sets = Z_SET_JA.map(a => 'ポケモンカード ' + a[0] + ' BOX 未開封'), per = 20, pg = Math.floor((at + 9 * 3600000) / 86400000) % Math.max(1, Math.ceil(sets.length / per));
    sets.slice(pg * per, pg * per + per).forEach(q3 => { if (!seen.has(q3.toLowerCase())) { seen.add(q3.toLowerCase()); out.push({ kw: q3, row: 0, hv: true }); } }); } catch (e) {}
  return out;
}

/* =====================================================================
 * v149：毎日 リサーチ150件・出品100件を、お金をかけずに、Googleの1日の上限（約90分）の中で
