function inventoryUrl_() {
  const u = prop_('WEBAPP_URL');
  return u ? u + '?page=inventory&token=' + encodeURIComponent(prop_('SEND_TOKEN')) : '（Webアプリが未設定です）';
}

function openInventoryApp() {
  const u = inventoryUrl_();
  if (!/^https:/.test(u)) { SpreadsheetApp.getUi().alert('先に「出品管理」→「【初回】送信ボタンを作る」でWebアプリのURLを登録してください。'); return; }
  SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput(
    '<div style="font-family:sans-serif;font-size:14px;line-height:1.7"><p><a href="' + u + '" target="_blank" style="display:inline-block;padding:12px 20px;background:#1a73e8;color:#fff;border-radius:8px;text-decoration:none;font-weight:bold">在庫管理画面を開く</a></p>' +
    '<p>スマホで使うときは、このリンクをブックマーク（ホーム画面に追加）しておくと便利です。リンクには合言葉が含まれるので、他の人に共有しないでください。</p>' +
    '<textarea style="width:100%;height:70px;font-size:11px" readonly onclick="this.select()">' + u + '</textarea></div>').setWidth(520).setHeight(260), '在庫管理画面');
}

function invList(token) {
  if (token !== prop_('SEND_TOKEN')) return { error: '合言葉が一致しません' };
  const sh = ss_().getSheetByName('出品一覧');
  if (!sh || sh.getLastRow() < 2) return { error: '「出品一覧」に商品がありません（「出品一覧をeBayから取り込む」を先に行ってください）' };
  const cfg = inventorySettings_();
  const now = Date.now();
  const rows = sh.getRange(2, 1, sh.getLastRow() - 1, LIST_HEADERS.length).getValues();
  const items = rows.filter(r => r[LCOL.ID - 1]).map(r => {
    const checked = r[LCOL.CHECKED - 1];
    const age = checked instanceof Date ? (now - checked.getTime()) / 3600000 : null;
    const state = String(r[LCOL.SRC_STATE - 1] || '');
    const qty = Number(r[LCOL.QTY - 1]) || 0;
    const src = String(r[LCOL.SRC_URL - 1] || '');
    const paused = /一時停止/.test(state);
    const out = /売り切れ/.test(state);
    return { id: String(r[LCOL.ID - 1]), title: String(r[LCOL.TITLE - 1] || ''), price: r[LCOL.PRICE - 1], qty: qty, src: src, url: String(r[LCOL.URL - 1] || ''),
      cost: Number(r[LCOL.COST - 1]) || 0, state: state, age: age == null ? null : Math.round(age * 10) / 10, risk: sourceRisk_(src),
      out: out, paused: paused, needCheck: !!src && !out && (qty > 0 || paused) && (age == null || age >= cfg.hours) };
  });
  return { items: items, hours: cfg.hours, active: items.filter(x => x.qty > 0).length, check: items.filter(x => x.needCheck).length,
    out: items.filter(x => x.out).length, paused: items.filter(x => x.paused).length, at: Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') };
}

function invMark(token, itemId, available) {
  if (token !== prop_('SEND_TOKEN')) throw new Error('合言葉が一致しません');
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const sh = ss_().getSheetByName('出品一覧');
    const rows = sh.getRange(2, 1, sh.getLastRow() - 1, LIST_HEADERS.length).getValues();
    const i = rows.findIndex(r => String(r[LCOL.ID - 1]) === String(itemId));
    if (i < 0) throw new Error('出品一覧に見つかりません');
    const row = i + 2, r = rows[i];
    const qty = Number(r[LCOL.QTY - 1]) || 0;
    const stamp = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm');
    let msg;
    if (available) {
      if (qty === 0) {
        trading_('ReviseInventoryStatus', '<InventoryStatus><ItemID>' + x_(itemId) + '</ItemID><Quantity>1</Quantity></InventoryStatus>');
        sh.getRange(row, LCOL.QTY).setValue(1);
        msg = '在庫あり → eBayの在庫を1に戻しました（' + stamp + '）';
      } else msg = '在庫あり（' + stamp + ' に確認）';
      sh.getRange(row, LCOL.SRC_STATE).setValue('在庫あり（画面で確認 ' + stamp + '）');
    } else {
      if (inventorySettings_().endOnSoldOut) {
        trading_('EndFixedPriceItem', '<ItemID>' + x_(itemId) + '</ItemID><EndingReason>NotAvailable</EndingReason>');
        msg = '売り切れ → eBayの出品を取り下げました（' + stamp + '）';
        recordDelisting_(r, '🛑 取り下げ', '在庫管理画面', '在庫管理画面で「売り切れ」と記録', r[LCOL.SRC_URL - 1]);
        sh.getRange(row, LCOL.MEMO).setValue(String(r[LCOL.MEMO - 1] || '') + (r[LCOL.MEMO - 1] ? '／' : '') + '【取り下げ ' + stamp + '】在庫管理画面で売り切れと確認');
      } else {
        if (qty > 0) trading_('ReviseInventoryStatus', '<InventoryStatus><ItemID>' + x_(itemId) + '</ItemID><Quantity>0</Quantity></InventoryStatus>');
        msg = '売り切れ → eBayの在庫を0にしました（' + stamp + '）';
      }
      sh.getRange(row, LCOL.QTY).setValue(0);
      sh.getRange(row, LCOL.SRC_STATE).setValue('売り切れ（画面で確認 ' + stamp + '）');
    }
    stockLog_(r, '在庫管理画面', available ? '🟢 在庫あり' : '🔴 ' + msg, '', r[LCOL.SRC_URL - 1]);
    sh.getRange(row, LCOL.CHECKED).setValue(new Date());
    const nq = available ? Math.max(qty, 1) : 0;
    return { msg: msg, item: { qty: nq, age: 0, state: available ? '在庫あり' : '売り切れ', out: !available, paused: false, needCheck: false } };
  } finally { lock.releaseLock(); }
}


/* =====================================================================
 * ビジネスポリシーの作成（eBay Account API）
 *  ・返品：60日、返品送料はバイヤー負担、返金（米国・海外とも）
 *  ・支払い：即時支払い
 *  ・配送：日本から発送、ハンドリングタイム10営業日（設定で変更可）
 *    米国は送料無料（価格に込み）、米国以外は重さ（〜250g／〜500g／〜1kg／〜1.5kg／〜2kg）と地域で送料
 *    地域：アジア／ヨーロッパ・カナダ・メキシコ・オセアニア・中東／中南米・アフリカ
 *    送料の金額：日本郵便 国際エアパケットの公式料金から計算
 *      「差額」＝ その地域の送料 − 米国向けの送料（価格に込み）。マイナスなら0（二重に取らない）
 *      「実費」＝ その地域の送料をそのまま
 *  ・ロシア・ベラルーシ・ウクライナ、私書箱・軍用住所には送らない
 *  ・作ったポリシーのIDを「設定」に登録し、出品時は商品の重さに合った配送ポリシーを自動で使う
 * ===================================================================== */
const AIRPACKET_JPY = {   // 日本郵便 国際エアパケット（国際特定記録料込み）100g〜2000g
  1: [720, 820, 920, 1020, 1120, 1220, 1320, 1420, 1520, 1620, 1720, 1820, 1920, 2020, 2120, 2220, 2320, 2420, 2520, 2620],
  2: [750, 870, 990, 1110, 1230, 1350, 1470, 1590, 1710, 1830, 1950, 2070, 2190, 2310, 2430, 2550, 2670, 2790, 2910, 3030],
  3: [880, 1060, 1240, 1420, 1600, 1780, 1960, 2140, 2320, 2500, 2680, 2860, 3040, 3220, 3400, 3580, 3760, 3940, 4120, 4300],
  4: [1200, 1410, 1620, 1830, 2040, 2250, 2460, 2670, 2880, 3090, 3300, 3510, 3720, 3930, 4140, 4350, 4560, 4770, 4980, 5190],
  5: [920, 1180, 1440, 1700, 1960, 2220, 2480, 2740, 3000, 3260, 3520, 3780, 4040, 4300, 4560, 4820, 5080, 5340, 5600, 5860],
};
const POLICY_BANDS = [250, 500, 1000, 1500, 2000];
const INTL_GROUPS = [
  { code: 'EconomyInternational', zone: 2, label: 'アジア', regions: ['Asia'] },
  { code: 'StandardInternational', zone: 3, label: 'ヨーロッパ・カナダ・メキシコ・オセアニア・中東', regions: ['Europe', 'CA', 'MX', 'Oceania', 'MiddleEast'] },
  { code: 'OtherInternational', zone: 5, label: '中南米・アフリカ', regions: ['SouthAmerica', 'CentralAmericaAndCaribbean', 'Africa'] },
];

function policySettings_() {
  const s = sheet_('設定');
  if (s.getRange('E70').getValue() === '') {
    s.getRange('E70').setValue('■ ビジネスポリシー').setFontWeight('bold');
    s.getRange('E71:E73').setValues([['ハンドリングタイム（営業日）'], ['米国以外の送料の決め方'], ['返品の受付日数']]).setFontWeight('bold');
    s.getRange('F71').setValue(10).setBackground('#fff4dc');
    s.getRange('F72').setValue('実費（その地域の送料をそのまま）').setBackground('#fff4dc')
      .setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['差額（米国の送料は価格に込みなので、その差だけ）', '実費（その地域の送料をそのまま）']).build());
    s.getRange('F73').setValue(60).setBackground('#fff4dc');
    s.getRange('E74').setValue('「出品管理」→「ビジネスポリシーを作成・更新する」で、この内容のポリシーをeBayに作ります（同じ名前があれば上書き）。送料は日本郵便の国際エアパケットの料金から計算します。')
      .setFontColor('#777777').setWrap(true);
  }
  const v = s.getRange('F71:F73').getValues().map(r => r[0]);
  return { handling: Number(v[0]) || 10, actual: /実費/.test(String(v[1])), returnDays: Number(v[2]) || 60 };
}

function airYen_(zone, g) { const t = AIRPACKET_JPY[zone]; return t[Math.min(19, Math.max(0, Math.ceil(g / 100) - 1))]; }

// 重さごと・地域ごとの送料（ドル）
function intlShippingTable_() {
  const off = official_(), cs = calcSettings_(), pc = policySettings_();
  return POLICY_BANDS.map(g => {
    const us = Math.min(airYen_(4, g) * (1 - off.stamp) + cs.clearance,
      (() => { const hit = (off.ship['エコノミー'] || []).find(r => r[0] >= g); return hit ? hit[1] * (1 + off.ecoSurcharge) + DDP_FEES.ecoClearanceYen : 1e9; })());
    const toUsd = yen => { const c = pc.actual ? yen : Math.max(0, yen - us); return c > 0 ? Math.ceil(c / off.rate) : 0; };
    const sp = speedpakBandYen_(g, off);
    return { g: g, usYen: Math.round(us), groups: INTL_GROUPS.map(gr => {
      const yen = airYen_(gr.zone, g) * (1 - off.stamp);
      return { code: gr.code, label: gr.label, regions: gr.regions, yen: Math.round(yen), usd: toUsd(yen) };
    }), speedpak: [
      { key: 'UKAU', label: 'SpeedPAK イギリス・オーストラリア', regions: ['GB', 'AU'], yen: Math.round(Math.max(sp.UK, sp.AU)), usd: toUsd(Math.max(sp.UK, sp.AU)) },
      { key: 'EU', label: 'SpeedPAK EU（キプロス・マルタ以外）', regions: SPEEDPAK_EU, yen: Math.round(sp.EU), usd: toUsd(sp.EU) },
    ] };
  });
}

function policyName_(g) { return 'Japan Free US / Intl ' + (g >= 1000 ? (g / 1000) + 'kg' : g + 'g'); }

// 同じ名前のポリシーがあれば更新、なければ作成
function upsertPolicy_(kind, body) {
  const list = ebay_('get', '/sell/account/v1/' + kind + '_policy?marketplace_id=EBAY_US');
  const arr = list[kind === 'fulfillment' ? 'fulfillmentPolicies' : kind === 'return' ? 'returnPolicies' : 'paymentPolicies'] || [];
  const hit = arr.find(x => x.name === body.name);
  const idKey = kind + 'PolicyId';
  if (hit) { ebay_('put', '/sell/account/v1/' + kind + '_policy/' + hit[idKey], { body: body }); return hit[idKey]; }
  const res = ebay_('post', '/sell/account/v1/' + kind + '_policy', { body: body });
  return res[idKey];
}

function createPolicies_() {
  const pc = policySettings_();
  const log = [];
  const stamp = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd HHmm');
  const cat = [{ name: 'ALL_EXCLUDING_MOTORS_VEHICLES' }];

  // 0) ビジネスポリシーが使えるか
  try {
    const prog = ebay_('get', '/sell/account/v1/program/get_opted_in_programs');
    const on = (prog.programs || []).some(x => x.programType === 'SELLING_POLICY_MANAGEMENT');
    if (!on) {
      try { ebay_('post', '/sell/account/v1/program/opt_in', { body: { programType: 'SELLING_POLICY_MANAGEMENT' } }); } catch (e) {}
      throw new Error('ビジネスポリシーの利用を有効にしました。eBay側で反映されるまで時間がかかることがあるので、しばらく（数時間〜1日）たってから、もう一度押してください。');
    }
  } catch (e) { if (/有効にしました/.test(e.message)) throw e; log.push('利用状況の確認：' + e.message); }

  // 既存のポリシーは更新しない（今の出品に影響するため）。毎回、新しい名前で作る
  const reused = [];
  const createNew = (kind, body) => {
    const idKey = kind + 'PolicyId';
    try {
      const res = ebay_('post', '/sell/account/v1/' + kind + '_policy', { body: body });
      return String(res[idKey]);
    } catch (e) {
      if (!/duplicate/i.test(e.message)) throw e;
      // 同じ内容のポリシーがすでにある → そのIDを使う（既存のポリシーは変更しない）
      let id = '';
      (e.ebayErrors || []).forEach(x => (x.parameters || []).forEach(pm => { if (!id && /policyid|duplicate/i.test(pm.name) && /^\d+$/.test(String(pm.value))) id = String(pm.value); }));
      if (!id) id = findSamePolicy_(kind, body);
      if (!id) throw new Error('同じ内容のポリシーがすでにあるとeBayに言われましたが、そのポリシーを見つけられませんでした（' + e.message + '）');
      reused.push(kind + ' ' + id);
      return id;
    }
  };
  const step = (label, fn) => { try { return fn(); } catch (e) { throw new Error(label + 'でエラー：' + e.message); } };

  // 返品ポリシー：受け付けられる形を順に試す（海外の条件を別に指定 → 指定なし → 返金方法の指定なし）
  const returnId = step('返品ポリシーの作成', () => {
    const base = { name: ('Returns ' + pc.returnDays + 'd buyer pays (' + stamp + ')').slice(0, 64), marketplaceId: 'EBAY_US', categoryTypes: cat,
      returnsAccepted: true, returnPeriod: { value: pc.returnDays, unit: 'DAY' }, returnShippingCostPayer: 'BUYER' };
    const variants = [
      Object.assign({}, base, { refundMethod: 'MONEY_BACK', internationalOverride: { returnsAccepted: true, returnPeriod: { value: pc.returnDays, unit: 'DAY' }, returnShippingCostPayer: 'BUYER' } }),
      Object.assign({}, base, { refundMethod: 'MONEY_BACK' }),
      Object.assign({}, base),
    ];
    const errs = [];
    for (let i = 0; i < variants.length; i++) {
      try { return createNew('return', variants[i]); }
      catch (e) {
        errs.push((i + 1) + '回目：' + e.message);
        if (/403|401|insufficient|scope/i.test(e.message)) break;   // 許可の問題は、形を変えても同じ
      }
    }
    recordApiError_('返品ポリシーの作成', errs);
    throw new Error(errs.join(' ／ '));
  });
  const paymentId = step('支払いポリシーの作成', () => createNew('payment', {
    name: ('Immediate payment (' + stamp + ')').slice(0, 64), marketplaceId: 'EBAY_US', categoryTypes: cat, immediatePay: true }));

  const table = intlShippingTable_();
  const spc = speedpakServiceCodes_();
  const meta = shipMeta_();
  const region = r => /^[A-Z]{2}$/.test(r) ? { regionName: r, regionType: 'COUNTRY' } : r === 'Worldwide' ? { regionName: 'Worldwide', regionType: 'WORLDWIDE' } : { regionName: r, regionType: 'WORLD_REGION' };
  const bands = [];
  let mode = 'full';   // full → SpeedPAK海外をまとめる → SpeedPAK海外なし → SpeedPAKなし
  table.forEach(t => {
    const body = m => {
      const useDomSp = m === 'full' || m === 'merge' || m === 'nointlsp';
      const useIntlSp = m === 'full' || m === 'merge';
      const dom = (useDomSp && spc.domestic ? [{ code: spc.domestic }] : []).concat([{ code: meta.domestic }])
        .filter((d, i, a) => d.code && a.findIndex(x => x.code === d.code) === i);
      const usedCodes = [];
      const intl = intlServices_(t, useIntlSp ? spc : {}, m === 'merge').map(x => {
        // eBayが受け付ける地域の名前だけにする（国は2文字のコード）
        const regs = x.shipToLocations.regionIncluded.map(rr => rr.regionName).filter(r => /^[A-Z]{2}$/.test(r) || meta.regions.has(r));
        if (!regs.length) return null;
        // 配送サービスのコードがeBayの一覧にない、または重なるときは、使える国際配送のコードに置き換える
        let code = x.shippingServiceCode;
        if (!meta.intl.has(code) || (usedCodes.indexOf(code) >= 0 && code !== spc.intl)) code = meta.intlList.find(c => usedCodes.indexOf(c) < 0) || code;
        usedCodes.push(code);
        x.shippingServiceCode = code;
        x.shipToLocations = { regionIncluded: regs.map(region) };
        return x;
      }).filter(x => x).map((x, i) => { x.sortOrder = i + 1; return x; });
      return {
        name: ('Japan Free US / Intl ' + (t.g >= 1000 ? (t.g / 1000) + 'kg' : t.g + 'g') + ' (' + stamp + ')').slice(0, 64),
        marketplaceId: 'EBAY_US', categoryTypes: cat,
        description: '日本から発送。米国は送料無料、米国以外は重さと地域で送料',
        handlingTime: { value: pc.handling, unit: 'DAY' },
        shipToLocations: { regionIncluded: [region('Worldwide')], regionExcluded: ['RU', 'BY', 'UA'].map(region) },
        shippingOptions: [
          { optionType: 'DOMESTIC', costType: 'FLAT_RATE', shippingServices: dom.map((d, i) => ({ sortOrder: i + 1, shippingServiceCode: d.code, freeShipping: true,
            shippingCost: { value: '0.00', currency: 'USD' } })) },
          { optionType: 'INTERNATIONAL', costType: 'FLAT_RATE', shippingServices: intl },
        ],
      };
    };
    const modes = ['full', 'merge', 'nointlsp', 'nosp'];
    let id = '', lastErr = '';
    for (let k = modes.indexOf(mode); k < modes.length && !id; k++) {
      if ((modes[k] === 'full' || modes[k] === 'merge') && !spc.intl) continue;
      try { id = createNew('fulfillment', body(modes[k])); mode = modes[k]; }
      catch (e) { lastErr = e.message; log.push((t.g >= 1000 ? t.g / 1000 + 'kg' : t.g + 'g') + '（' + modes[k] + '）：' + e.message); }
    }
    if (!id) {
      recordApiError_('配送ポリシー（' + (t.g >= 1000 ? t.g / 1000 + 'kg' : t.g + 'g') + 'まで）の作成', log.concat(['送った内容（最後）：' + JSON.stringify(body('nosp')).slice(0, 3000)]));
      throw new Error('配送ポリシー（' + (t.g >= 1000 ? t.g / 1000 + 'kg' : t.g + 'g') + 'まで）の作成でエラー：' + lastErr + '（詳しくは「エラーの記録」シート）');
    }
    bands.push({ max: t.g, id: id });
  });

  // 設定に登録（これから出品する商品だけに使われる。今の出品は変わらない）
  const s = sheet_('設定');
  s.getRange('B12').setValue((bands.find(b => b.max === 500) || bands[0]).id);
  s.getRange('B13').setValue(returnId);
  s.getRange('B14').setValue(paymentId);
  PropertiesService.getScriptProperties().setProperty('SHIP_POLICY_BANDS', JSON.stringify(bands));

  const modeText = { full: 'SpeedPAK（米国・英豪・EU）入り', merge: 'SpeedPAK入り（英豪・EUは1つにまとめた）', nointlsp: '米国だけSpeedPAK（海外のSpeedPAKは使えなかった）', nosp: 'SpeedPAKなし（使えなかった）' }[mode];
  const ss = ss_();
  let sh = ss.getSheetByName('ビジネスポリシー');
  if (!sh) sh = ss.insertSheet('ビジネスポリシー');
  sh.clear();
  sh.getRange('A1').setValue('ビジネスポリシー（' + stamp.replace(/ (\d\d)(\d\d)$/, ' $1:$2') + ' に新しく作成）').setFontWeight('bold').setFontSize(13);
  sh.getRange('A2').setValue('返品：' + pc.returnDays + '日・返品送料はバイヤー負担（ID ' + returnId + '）／支払い：即時支払い（ID ' + paymentId + '）／ハンドリングタイム：' + pc.handling + '営業日／発送元：日本／' +
    '米国以外の送料：' + (pc.actual ? '実費' : '差額') + '／' + modeText + '／送らない国：ロシア・ベラルーシ・ウクライナ').setWrap(true);
  sh.getRange('A3').setValue('今出品中の商品のポリシーは変えていません。新しいポリシーは、これから出品する商品だけに使われます（商品の重さで自動選択）。').setFontColor('#188038');
  const head = ['重さ（まで）', '配送ポリシーID', '米国（送料無料・価格に込みの送料 円）'].concat(INTL_GROUPS.map(g => g.label + '（$／元の送料 円）'))
    .concat(table[0].speedpak.map(x => x.label + '（$／元の送料 円）'));
  sh.getRange(5, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#e8f0f2').setWrap(true);
  sh.getRange(6, 1, table.length, head.length).setValues(table.map((t, i) => [(t.g >= 1000 ? t.g / 1000 + 'kg' : t.g + 'g'), bands[i].id, t.usYen]
    .concat(t.groups.map(gr => '$' + gr.usd + '（' + gr.yen.toLocaleString() + '円）'))
    .concat(t.speedpak.map(x => (mode === 'full' || mode === 'merge') ? '$' + x.usd + '（' + x.yen.toLocaleString() + '円）' : '（使っていない）'))));
  sh.getRange(6, 2, table.length, 1).setNumberFormat('@');
  [90, 150, 160, 200, 260, 200, 220, 220].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  let rr = 6 + table.length + 1;
  sh.getRange(rr++, 1).setValue('SpeedPAKのサービス：' + (spc.domestic ? '米国 ' + spc.domesticName + '（' + spc.domestic + '）' : '米国向けは見つかりませんでした') + '／' +
    (spc.intl ? '海外 ' + spc.intlName + '（' + spc.intl + '）' : '海外向けは見つかりませんでした')).setFontColor('#777777');
  sh.getRange(rr++, 1).setValue('私書箱（PO Box）・軍用住所（APO/FPO）への発送を止めるには、セラーハブの「配送の設定」→「発送しない地域」で設定してください。').setFontColor('#777777');
  if (reused.length) sh.getRange(rr++, 1).setValue('同じ内容のポリシーがすでにあったため、それをそのまま使いました（変更はしていません）：' + reused.join('、')).setFontColor('#1a73e8').setWrap(true);
  if (log.length) sh.getRange(rr++, 1).setValue('途中で試してうまくいかなかったもの：' + log.join('／')).setFontColor('#b06000').setWrap(true);
  return { returnId: returnId, paymentId: paymentId, bands: bands, mode: modeText };
}

// 商品の重さに合った配送ポリシーID
function shipPolicyForWeight_(g) {
  let bands = [];
  try { bands = JSON.parse(prop_('SHIP_POLICY_BANDS') || '[]'); } catch (e) {}
  if (!bands.length || !(g > 0)) return '';
  const hit = bands.find(b => g <= b.max) || bands[bands.length - 1];
  return hit ? hit.id : '';
}

function menuCreatePolicies() {
  run_(() => {
    let r;
    try { r = createPolicies_(); }
    catch (e) {
      if (/403|insufficient|scope|権限|401/i.test(e.message)) throw new Error('ビジネスポリシーを作る許可がまだありません。「③ eBay連携：認証ページを開く」「④ 戻り先URLを登録」をやり直してから、もう一度押してください。');
      throw e;
    }
    ss_().getSheetByName('ビジネスポリシー').activate();
    return '新しく作成しました：返品（' + r.returnId + '）・支払い（' + r.paymentId + '）・配送 ' + r.bands.length + '種類（重さ別・' + r.mode + '）。「設定」B12〜B14に登録済み。今出品中の商品のポリシーは変えていません';
  });
}


/* ---------- eBay SpeedPAK ----------
 *  配送サービスのコードは、eBayに使える配送サービスの一覧（GeteBayDetails）を問い合わせて、名前に「SpeedPAK」が入るものを使う
 *  料金：SpeedPAK Economy 公式料金（送料マスタがあればそれを、なければ2026年7月30日版）× 燃油サーチャージ
 */
const SPEEDPAK_EU = ['AT', 'BE', 'BG', 'HR', 'CZ', 'DK', 'EE', 'FI', 'FR', 'DE', 'GR', 'HU', 'IE', 'IT', 'LV', 'LT', 'LU', 'NL', 'PL', 'PT', 'RO', 'SK', 'SI', 'ES', 'SE'];
const SPEEDPAK_FALLBACK = { 250: { UK: 1173, AU: 1422, EU: 2643 }, 500: { UK: 1482, AU: 1537, EU: 3233 }, 1000: { UK: 2113, AU: 1950, EU: 4770 },
  1500: { UK: 2779, AU: 2322, EU: 5292 }, 2000: { UK: 3414, AU: 2974, EU: 7654 } };

function speedpakBandYen_(g, off) {
  const f = 1 + (off.ecoSurcharge || 0);
  const sp = off.speedpak || null;
  const look = list => { const hit = (list || []).find(r => r[0] >= g); return hit ? hit[1] : 0; };
  let uk = sp ? look(sp.UK) : 0, au = sp ? look(sp.AU) : 0, eu = 0;
  if (sp && sp.EU && Object.keys(sp.EU).length) {
    const vals = SPEEDPAK_EU.map(c => look(sp.EU[c])).filter(v => v > 0).sort((a, b) => a - b);
    if (vals.length) { const pos = (vals.length - 1) * 0.75, lo = Math.floor(pos), hi = Math.ceil(pos); eu = vals[lo] + (vals[hi] - vals[lo]) * (pos - lo); }
  }
  const fb = SPEEDPAK_FALLBACK[g] || SPEEDPAK_FALLBACK[2000];
  return { UK: (uk || fb.UK) * f, AU: (au || fb.AU) * f, EU: (eu || fb.EU) * f };
}

function speedpakServiceCodes_() {
  const cache = prop_('SPEEDPAK_CODES');
  if (cache) { try { return JSON.parse(cache); } catch (e) {} }
  const out = { domestic: '', domesticName: '', intl: '', intlName: '' };
  try {
    const res = trading_('GeteBayDetails', '<DetailName>ShippingServiceDetails</DetailName>');
    const ns = res.ns;
    res.root.getChildren('ShippingServiceDetails', ns).forEach(d => {
      const code = d.getChildText('ShippingService', ns) || '', desc = d.getChildText('Description', ns) || '';
      if (!/speedpak/i.test(code + ' ' + desc) || d.getChildText('ValidForSellingFlow', ns) === 'false') return;
      const intl = d.getChildText('InternationalService', ns) === 'true';
      const econ = /economy/i.test(code + desc) ? 2 : 1;      // Economy を優先
      if (intl) { if (!out.intl || econ > (out._ie || 0)) { out.intl = code; out.intlName = desc; out._ie = econ; } }
      else { if (!out.domestic || econ > (out._de || 0)) { out.domestic = code; out.domesticName = desc; out._de = econ; } }
    });
  } catch (e) {}
  delete out._ie; delete out._de;
  if (out.domestic || out.intl) PropertiesService.getScriptProperties().setProperty('SPEEDPAK_CODES', JSON.stringify(out));
  return out;
}

// 海外の配送サービス：エアパケ3つ＋SpeedPAK（英・豪／EU）。まとめる指定なら SpeedPAK は1つ（英・豪・EU）
function intlServices_(t, spc, mergeSp) {
  const list = t.groups.map(gr => ({ code: gr.code, usd: gr.usd, regions: gr.regions }));
  if (spc.intl) {
    if (mergeSp) {
      const usd = Math.max.apply(null, t.speedpak.map(x => x.usd));
      list.push({ code: spc.intl, usd: usd, regions: t.speedpak[0].regions.concat(t.speedpak[1].regions) });
    } else t.speedpak.forEach(x => list.push({ code: spc.intl, usd: x.usd, regions: x.regions }));
  }
  return list.slice(0, 5).map((x, i) => ({
    sortOrder: i + 1, shippingServiceCode: x.code, freeShipping: x.usd === 0,
    shippingCost: { value: x.usd.toFixed(2), currency: 'USD' }, additionalShippingCost: { value: x.usd.toFixed(2), currency: 'USD' },
    shipToLocations: { regionIncluded: x.regions.map(r => ({ regionName: r })) } }));
}


// eBay APIのエラーを「エラーの記録」シートに残す（あとで原因を確認できるように）
function recordApiError_(what, errs) {
  try {
    const ss = ss_();
    let sh = ss.getSheetByName('エラーの記録');
    if (!sh) { sh = ss.insertSheet('エラーの記録'); sh.getRange(1, 1, 1, 3).setValues([['日時', '処理', 'eBayからのエラーの内容']]).setFontWeight('bold'); sh.setColumnWidth(3, 800); }
    sh.appendRow([new Date(), what, errs.join('\n')]);
    sh.getRange(sh.getLastRow(), 3).setWrap(true);
  } catch (e) {}
}


// すでにあるポリシーの中から、同じ内容のものを探す（読むだけ・変更しない）
function findSamePolicy_(kind, body) {
  const list = ebay_('get', '/sell/account/v1/' + kind + '_policy?marketplace_id=EBAY_US');
  const arr = list[kind === 'fulfillment' ? 'fulfillmentPolicies' : kind === 'return' ? 'returnPolicies' : 'paymentPolicies'] || [];
  const idKey = kind + 'PolicyId';
  let hit = null;
  if (kind === 'return') {
    hit = arr.find(x => x.returnsAccepted === body.returnsAccepted && x.returnPeriod && body.returnPeriod &&
      Number(x.returnPeriod.value) === Number(body.returnPeriod.value) && x.returnShippingCostPayer === body.returnShippingCostPayer);
  } else if (kind === 'payment') {
    hit = arr.find(x => !!x.immediatePay === !!body.immediatePay);
  } else {
    const sig = p => JSON.stringify({ h: p.handlingTime && p.handlingTime.value,
      o: (p.shippingOptions || []).map(o => (o.shippingServices || []).map(sv => sv.shippingServiceCode + ':' + (sv.shippingCost ? Number(sv.shippingCost.value) : 0)).sort()) });
    hit = arr.find(x => sig(x) === sig(body));
  }
  return hit ? String(hit[idKey]) : '';
}


// eBayに、このサイトで使える配送サービスと地域の名前を問い合わせる（1日キャッシュ）
function shipMeta_() {
  const c = CacheService.getScriptCache().get('SHIP_META');
  if (c) { const j = JSON.parse(c); return { domestic: j.domestic, intl: new Set(j.intl), intlList: j.intlList, regions: new Set(j.regions) }; }
  const intl = [], domestic = [], regions = [];
  try {
    const res = trading_('GeteBayDetails', '<DetailName>ShippingServiceDetails</DetailName><DetailName>ShippingLocationDetails</DetailName>');
    const ns = res.ns;
    res.root.getChildren('ShippingServiceDetails', ns).forEach(d => {
      if (d.getChildText('ValidForSellingFlow', ns) === 'false') return;
      const code = d.getChildText('ShippingService', ns);
      if (!code) return;
      if (d.getChildText('InternationalService', ns) === 'true') intl.push(code); else domestic.push(code);
    });
    res.root.getChildren('ShippingLocationDetails', ns).forEach(d => { const r = d.getChildText('ShippingLocation', ns); if (r) regions.push(r); });
  } catch (e) {}
  // 国際配送の一般的なコードを優先して並べる
  const pref = ['StandardInternational', 'EconomyInternational', 'ExpeditedInternational', 'OtherInternational'];
  const intlList = pref.filter(c => intl.indexOf(c) >= 0).concat(intl.filter(c => pref.indexOf(c) < 0 && !/speedpak/i.test(c)));
  const dom = ['EconomyShippingFromOutsideUS', 'StandardShippingFromOutsideUS', 'ExpeditedShippingFromOutsideUS'].find(c => domestic.indexOf(c) >= 0) ||
    domestic.find(c => /outside/i.test(c)) || 'EconomyShippingFromOutsideUS';
  const out = { domestic: dom, intl: intl.length ? intl : pref, intlList: intlList.length ? intlList : pref,
    regions: regions.length ? regions : ['Asia', 'Europe', 'Oceania', 'MiddleEast', 'Africa', 'SouthAmerica', 'Americas', 'Worldwide'] };
  try { CacheService.getScriptCache().put('SHIP_META', JSON.stringify(out), 21600); } catch (e) {}
  return { domestic: out.domestic, intl: new Set(out.intl), intlList: out.intlList, regions: new Set(out.regions) };
}


/* =====================================================================
 * 価格の関門：目標利益より下げることは禁止
 *  ・出品作成シートの計算条件（手数料率・関税率・送料・固定費・仕入れ値・為替）で、新しい価格の利益を計算
 *  ・最低利益額（設定F29）を下回るなら反映しない
 *  ・計算条件が見つからない商品（ツール以外で出品した商品など）は、値下げそのものを反映しない（価格はそのまま）
 * ===================================================================== */
function priceGuard_(itemId, newPrice) {
  const prep = ss_().getSheetByName('出品作成');
  const minProfit = calcSettings_().minProfit;
  if (!prep || prep.getLastRow() < 2) return { ok: false, reason: '利益を確かめられないため値下げしません' };
  const r = prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues().find(v => String(v[P.ITEMID - 1]) === itemId);
  if (!r) return { ok: false, reason: 'この商品の利益の計算条件が見つからないため値下げしません' };
  const f = Number(r[P.FRATE - 1]), t = Number(r[P.TRATE - 1]) || 0, fx = Number(r[P.FX - 1]), cost = Number(r[P.COST - 1]);
  const ship = Number(r[P.SHIP - 1]) || 0, fixed = Number(r[P.FIXED - 1]) || 0;
  if (!(f > 0) || !(fx > 0) || !(cost > 0)) return { ok: false, reason: '利益の計算条件が足りないため値下げしません' };
  const profit = Math.round(newPrice * fx * (1 - f - t) - cost - ship - fixed);
  if (profit < minProfit) return { ok: false, reason: '$' + newPrice.toFixed(2) + ' だと利益 ' + profit.toLocaleString() + '円で、最低利益額 ' + minProfit.toLocaleString() + '円を下回ります' };
  return { ok: true, profit: profit };
}

/* =====================================================================
 * 広告（プロモーテッドリスティング・一般）
 *  広告率 ＝ eBayの推奨（トレンド）の広告率。ただし
 *   ・5.1%を超えない（上限5.1%。設定で下げることはできるが、5.1%より上にはできない）
 *   ・利益の計算はPL 5.1%込みなので、5.1%以下なら最低利益額は守られる。念のため、その広告率での利益も確かめる
 *   ・eBayの最低（2%）を下回る場合は2%、利益が足りない場合は広告を付けない
 *  付けたあと、eBayに登録された広告率を読み直して確認し、5.1%を超えていたらその場で5.1%に直す
 * ===================================================================== */
const AD_CAP = 5.1;
const AD_MIN = 2.0;
const AD_CAMPAIGN_NAME = 'eBayツール 自動広告（上限5.1%）';

function adCampaignId_() {
  let id = prop_('AD_CAMPAIGN_ID');
  if (id) return id;
  const list = ebay_('get', '/sell/marketing/v1/ad_campaign?limit=200');
  const hit = (list.campaigns || []).find(c => c.campaignName === AD_CAMPAIGN_NAME && c.campaignStatus !== 'ENDED');
  if (hit) id = hit.campaignId;
  else {
    const start = new Date(Date.now() + 60000).toISOString();
    ebay_('post', '/sell/marketing/v1/ad_campaign', { body: { campaignName: AD_CAMPAIGN_NAME, marketplaceId: 'EBAY_US', startDate: start,
      fundingStrategy: { fundingModel: 'COST_PER_SALE', bidPercentage: AD_CAP.toFixed(1) } } });
    const again = ebay_('get', '/sell/marketing/v1/ad_campaign?limit=200');
    const c = (again.campaigns || []).find(x => x.campaignName === AD_CAMPAIGN_NAME);
    if (!c) throw new Error('広告キャンペーンを作れませんでした');
    id = c.campaignId;
  }
  PropertiesService.getScriptProperties().setProperty('AD_CAMPAIGN_ID', id);
  return id;
}

function suggestedAdRate_(itemId) {
  try {
    const res = ebay_('post', '/sell/recommendation/v1/find?filter=' + encodeURIComponent('recommendationTypes:{AD}'),
      { marketplace: 'EBAY_US', body: { listingIds: [String(itemId)] } });
    const rec = (res.listingRecommendations || [])[0];
    const b = rec && rec.marketing && rec.marketing.ad && rec.marketing.ad.bidPercentages ? rec.marketing.ad.bidPercentages : [];
    const tr = b.find(x => x.basis === 'TRENDING') || b[0];
    return tr ? Number(tr.value) : null;
  } catch (e) { return null; }
}

// 利益が最低利益額を下回らない最大の広告率（%）。出品作成の行の計算条件（PL 5.1%込み）から逆算
function maxAdRateByProfit_(r) {
  const price = Number(r[P.PRICE - 1]), fx = Number(r[P.FX - 1]), f = Number(r[P.FRATE - 1]), t = Number(r[P.TRATE - 1]) || 0;
  const cost = Number(r[P.COST - 1]), ship = Number(r[P.SHIP - 1]) || 0, fixed = Number(r[P.FIXED - 1]) || 0;
  if (!(price > 0 && fx > 0 && f > 0)) return AD_CAP;
  const minProfit = calcSettings_().minProfit;
  const tb = /教科書/.test(String(r[P.FEETXT - 1] || ''));
  const plIncluded = tb ? Z_TB.ad : (official_().pl || 0.051);   // 計算にすでに入っているPLの率（v256：教科書の見積の品は2.2%）
  const base = price * fx * (1 - f - t) - cost - ship - fixed;      // PL 5.1%込みの利益
  const extra = (base - minProfit) / (price * fx);                  // あと何%まで手数料を増やせるか
  return Math.max(0, Math.min(tb ? Z_TB.ad * 100 : AD_CAP, (plIncluded + extra) * 100));
}

function promoteListing_(itemId, r) {
  if (sheet_('設定').getRange('F78').getValue() === false) return '広告：オフ（設定F78）';
  const sug = suggestedAdRate_(itemId);
  const tbRow = /教科書/.test(String(r[P.FEETXT - 1] || ''));
  const cap = Math.min(tbRow ? Z_TB.ad * 100 : AD_CAP, maxAdRateByProfit_(r));
  let rate = tbRow ? cap : (sug != null ? Math.min(sug, cap) : cap);   // v256：教科書の見積の品は 2.2%（eBay の推奨にかかわらずそろえる）
  rate = Math.floor(rate * 10) / 10;
  if (rate < AD_MIN) return '広告なし：利益を守れる広告率が' + AD_MIN + '%未満のため（推奨 ' + (sug != null ? sug + '%' : '不明') + '）';
  const cid = adCampaignId_();
  let res = ebay_('post', '/sell/marketing/v1/ad_campaign/' + cid + '/bulk_create_ads_by_listing_id',
    { body: { requests: [{ listingId: String(itemId), bidPercentage: rate.toFixed(1) }] } });
  const st = (res.responses || [])[0] || {};
  if (st.statusCode && st.statusCode >= 400) {
    // すでに広告がある（別のキャンペーンを含む）→ その広告の広告率を更新
    const ref = ebay_('get', '/sell/marketing/v1/ad_campaign/find_campaign_by_ad_reference?listing_id=' + encodeURIComponent(itemId));
    const c = (ref.campaigns || [])[0];
    if (!c) throw new Error('広告を作成できませんでした（' + JSON.stringify(st.errors || st).slice(0, 200) + '）');
    ebay_('post', '/sell/marketing/v1/ad_campaign/' + c.campaignId + '/bulk_update_ads_bid_by_listing_id',
      { body: { requests: [{ listingId: String(itemId), bidPercentage: rate.toFixed(1) }] } });
  }
  // 1件ずつ確認：eBayに登録された広告率を読み直す
  const check = verifyAdRate_(itemId);
  return '広告 ' + check.rate + '%（eBay推奨 ' + (sug != null ? sug + '%' : '不明') + '・上限 ' + AD_CAP + '%・利益を守れる上限 ' + (Math.floor(cap * 10) / 10) + '%）' + (check.fixed ? '／5.1%を超えていたため直しました' : '／確認済み');
}

function verifyAdRate_(itemId) {
  const ref = ebay_('get', '/sell/marketing/v1/ad_campaign/find_campaign_by_ad_reference?listing_id=' + encodeURIComponent(itemId));
  const c = (ref.campaigns || [])[0];
  if (!c) return { rate: '—', fixed: false };
  const ads = ebay_('get', '/sell/marketing/v1/ad_campaign/' + c.campaignId + '/ad?listing_ids=' + encodeURIComponent(itemId));
  const ad = (ads.ads || [])[0];
  let rate = ad ? Number(ad.bidPercentage) : NaN, fixed = false;
  if (rate > AD_CAP) {
    ebay_('post', '/sell/marketing/v1/ad_campaign/' + c.campaignId + '/bulk_update_ads_bid_by_listing_id',
      { body: { requests: [{ listingId: String(itemId), bidPercentage: AD_CAP.toFixed(1) }] } });
    rate = AD_CAP; fixed = true;
  }
  return { rate: isNaN(rate) ? '—' : rate, fixed: fixed };
}

// すべての一般（売れたら課金）キャンペーンの広告を確認し、5.1%を超える広告率を5.1%に直す
function auditAds_() {
  const camps = ebay_('get', '/sell/marketing/v1/ad_campaign?limit=200');
  let checked = 0, fixed = 0;
  (camps.campaigns || []).filter(c => c.campaignStatus === 'RUNNING' && c.fundingStrategy && c.fundingStrategy.fundingModel === 'COST_PER_SALE').forEach(c => {
    let offset = 0;
    for (let page = 0; page < 20; page++) {
      const ads = ebay_('get', '/sell/marketing/v1/ad_campaign/' + c.campaignId + '/ad?limit=500&offset=' + offset);
      const over = (ads.ads || []).filter(a => Number(a.bidPercentage) > AD_CAP);
      checked += (ads.ads || []).length;
      for (let i = 0; i < over.length; i += 500) {
        ebay_('post', '/sell/marketing/v1/ad_campaign/' + c.campaignId + '/bulk_update_ads_bid_by_listing_id',
          { body: { requests: over.slice(i, i + 500).map(a => ({ listingId: String(a.listingId), bidPercentage: AD_CAP.toFixed(1) })) } });
      }
      fixed += over.length;
      if (!ads.next || !(ads.ads || []).length) break;
      offset += 500;
    }
  });
  return { checked: checked, fixed: fixed };
}

function menuAuditAds() {
  run_(() => { const r = auditAds_(); return '広告 ' + r.checked + '件を確認しました。5.1%を超えていた ' + r.fixed + '件を5.1%に直しました'; });
}
function adsDailyAudit() { try { auditAds_(); } catch (e) { Logger.log(e); } }

function ensureAdSettings_(s) {
  if (s.getRange('E77').getValue() !== '') return;
  s.getRange('E77').setValue('■ 広告（上限5.1%）').setFontWeight('bold');
  s.getRange('E78').setValue('出品したら広告を自動で付ける').setFontWeight('bold');
  s.getRange('F78').insertCheckboxes().setValue(true);
  s.getRange('E79').setValue('広告率＝eBayの推奨の広告率。ただし5.1%を超えない・利益が最低利益額を下回らない率まで。2%未満になる場合は広告を付けません。付けたあとeBayの広告率を読み直して確認し、5.1%を超えていたら直します。毎日1回、すべての広告を確認して5.1%超えを直します。')
    .setFontColor('#777777').setWrap(true);
  try {
    ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'adsDailyAudit').forEach(t => ScriptApp.deleteTrigger(t));
    ScriptApp.newTrigger('adsDailyAudit').timeBased().atHour(5).everyDays(1).inTimezone('Asia/Tokyo').create();
  } catch (e) {}
}


/* =====================================================================
 * 梱包の判定（写真から）：送料のミスをなくす
 *  ・AIが商品の写真をすべて見て、外箱・説明書・付属品（ケース、コード、カード、特典など）があるかを確認
 *  ・外箱があれば外箱込み、付属品があれば付属品込みで、商品の大きさと重さを見積もる
 *  ・そこに梱包材（緩衝材・段ボールや封筒）を足して、発送するときのサイズと重さを出す
 *  ・確信が低いときは、種類ごとの既定値と比べて大きいほうを使う（安く見積もりすぎない）
 * ===================================================================== */
const PKG_REFERENCE =
  '【参考：よくある商品の大きさ・重さ（目安）】\n' +
  '・DS／3DSソフト（ケース＋説明書）：13.5×12.5×1.5cm・約70g。ソフトのみ：約10g\n' +
  '・Switchソフト（ケース）：17×10.5×1.1cm・約60g\n' +
  '・PS1ソフト（CDケース）：14×12.5×1cm・約90g（2枚組の厚いケース：約140g）\n' +
  '・PS2／PS3／PS4／Wii／GameCubeソフト（DVD型ケース）：19×13.5×1.5cm・約120g\n' +
  '・PSPソフト（UMDケース）：17.5×10×1.5cm・約70g\n' +
  '・スーパーファミコン（外箱＋説明書）：18.5×13×3.5cm・約120g。カセットのみ：約60g\n' +
  '・ファミコン（外箱＋説明書）：12×15×2.5cm・約90g。ニンテンドウ64（外箱）：21.5×14.5×4cm・約180g\n' +
  '・ゲームボーイ／アドバンス（外箱＋説明書）：12×9×2.5cm・約60g\n' +
  '・セガサターン（ケース）：14.5×12.5×2.5cm・約150g。ドリームキャスト：19×13.5×1.5cm・約120g\n' +
  '・CD（帯付き・プラケース）：14×12.5×1cm・約100g（2枚組：約150g）\n' +
  '・限定版・特典付き・BOX：写真の大きさから見積もる（外箱があれば必ず外箱のサイズ）\n' +
  '・ゲーム機本体（外箱あり）：外箱のサイズ（例：3DS本体の箱 約18×14×6cm・約500g）\n';

function packagingFromPhotos_(key, st, info, cur, ptype, cs) {
  const imgs = String(cur[P.IMGS - 1] || '').split(/\n+/).map(x => x.trim()).filter(x => /^https?:\/\//.test(x)).slice(0, 24);   // v105：全写真（eBayの上限24枚）
  const content = [{ type: 'text', text:
    'あなたは日本からeBayへ発送するセラーの梱包担当です。商品の写真をすべて見て、発送する物（外箱・説明書・付属品を含む）を確かめ、梱包したときのサイズと重さを見積もります。出力はJSONのみ。\n' +
    '【大事なルール】\n' +
    '1. 写真に外箱が写っていれば、外箱込みのサイズで考える（ソフトだけ・本体だけのサイズにしない）\n' +
    '2. 付属品（説明書、ケース、コード、ACアダプター、カード、特典、ディスク複数枚など）が写っていれば、それも入れる\n' +
    '3. 商品の大きさに、梱包材を足す：小物・ソフト類は各辺＋2〜3cm・＋50〜80g（緩衝材入りの封筒や薄い箱）、外箱つき・壊れやすい物は各辺＋4〜6cm・＋100〜200g（段ボール）\n' +
    '4. 迷ったら大きめ・重めに見積もる（小さく見積もると送料が足りなくなる）\n' +
    '5. 文章の情報（商品名・状態の説明）と写真が食い違うときは、写真を優先\n' +
    '6. あわせて、この商品の写真「ではない」もの（広告、バナー、ロゴ、アイコン、お店の告知や注意書きの画像、ほかの商品の写真）があれば、その写真の番号を not_this_item に入れる。商品そのもの・箱・説明書・付属品・タグ・裏側・傷のアップは「この商品の写真」。迷ったら入れない\n' + PKG_REFERENCE +
    '【商品】' + JSON.stringify({ name: info.name_ja, type: TYPE_LABELS[ptype] || ptype, features: info.features_ja, condition_note: info.condition_note_ja || '', page_weight_g: info.weight_g || null }) }];
  imgs.forEach((u, i) => { content.push({ type: 'text', text: '写真' + (i + 1) + '：' }); content.push({ type: 'image', source: { type: 'url', url: u } }); });
  content.push({ type: 'text', text: '{"has_outer_box":true/false,"has_manual":true/false,"accessories":["写真で確認できた付属品"],"contents":"発送する物の説明（日本語・短く）",' +
    '"item_size_cm":[長さ,幅,高さ],"item_weight_g":数値,"package_size_cm":[長さ,幅,高さ],"package_weight_g":数値,"confidence":"高/中/低","reason":"判断の根拠（日本語・短く）","not_this_item":[この商品の写真ではない写真の番号]}' });
  let out;
  try { out = parseJson_(claudeContent_(key, st.model, 'あなたは梱包と送料の見積もりの担当です。', imgs.length ? content : [content[0], content[content.length - 1]])); }
  catch (e) { return { weight: 0, box: '', note: '写真で梱包を判定できませんでした（' + e.message + '）。種類ごとの既定値で計算しています', photos: imgs.length, photoErr: e.message }; }
  const sus = (out.not_this_item || []).map(Number).filter(n => n >= 1 && n <= imgs.length).filter((n, k, a) => a.indexOf(n) === k).sort((a, b) => a - b);

  const ps = (out.package_size_cm || []).map(Number).filter(n => n > 0).sort((a, b) => b - a);
  let w = Math.ceil(Number(out.package_weight_g) || 0);
  let dims = ps.length === 3 ? ps.map(n => Math.ceil(n)) : null;
  // 確信が低いときは、種類ごとの既定値と比べて大きいほう（安く見積もりすぎない）
  const defBox = parseBox_(ptype === 'cd' ? cs.boxCd : /^game/.test(ptype) ? cs.boxGame : cs.boxOther);
  const defW = ptype === 'magazine' ? 600 : ptype === 'game_hw' ? 800 : ptype === 'other' ? cs.weight : 200;
  if (String(out.confidence) === '低') {
    w = Math.max(w, defW);
    if (dims && defBox.l) dims = [Math.max(dims[0], defBox.l), Math.max(dims[1], defBox.w), Math.max(dims[2], defBox.h)];
  }
  if (!(w > 0)) w = defW;
  const box = dims ? dims.join('x') : '';
  const note = (out.has_outer_box ? '外箱あり' : '外箱なし') + '・' + (out.has_manual ? '説明書あり' : '説明書なし') +
    ((out.accessories || []).length ? '・付属品：' + out.accessories.join('、') : '') +
    '／中身：' + (out.contents || '') +
    '／商品 ' + ((out.item_size_cm || []).join('×') || '?') + 'cm・' + (out.item_weight_g || '?') + 'g' +
    ' → 梱包込み ' + (box ? box.replace(/x/g, '×') + 'cm' : '（サイズ不明）') + '・' + w + 'g' +
    '／確信：' + (out.confidence || '?') + (String(out.confidence) === '低' ? '（既定値と比べて大きいほうを採用）' : '') +
    '／根拠：' + (out.reason || '') + (imgs.length ? '' : '／※写真がないため文章だけで判定');
  return { weight: w, box: box, note: note, photos: imgs.length, suspect: sus };
}


/* =====================================================================
 * URLから商品情報と画像を自動で取得（サーバー側）
 *  ・メルカリ・Yahoo!フリマ・Amazon・ラクマ・ヤフオクは規約上読みに行かない（メルカリは写真の番号から元画像だけ取得）
 *  ・それ以外は、サイトの robots.txt で許可されている場合だけ読む
 *  ・商品名・価格・説明・画像：構造化データ（Product）→ og:タグ → ページ本文の順
 * ===================================================================== */
const NO_FETCH_SITES = /(^|\.)(mercari\.com|paypayfleamarket\.yahoo\.co\.jp|amazon\.co\.jp|amazon\.com|fril\.jp|rakuma\.rakuten\.co\.jp|auctions\.yahoo\.co\.jp)$/i;

function robotsAllow_(url) {
  const m = String(url).match(/^(https?:\/\/[^\/]+)(\/[^?#]*)?/i);
  if (!m) return false;
  const origin = m[1], path = m[2] || '/';
  const cache = CacheService.getScriptCache();
  let txt = cache.get('robots:' + origin);
  if (txt === null) {
    try { const r = UrlFetchApp.fetch(origin + '/robots.txt', { muteHttpExceptions: true, followRedirects: true }); txt = r.getResponseCode() === 200 ? r.getContentText().slice(0, 50000) : ''; }
    catch (e) { txt = ''; }
    try { cache.put('robots:' + origin, txt, 21600); } catch (e) {}
  }
  // User-agent: * のグループの Disallow / Allow を見る（一番長く一致したルールを採用）
  let applies = false, best = { len: -1, allow: true };
  txt.split(/\r?\n/).forEach(line => {
    const l = line.replace(/#.*/, '').trim();
    const ua = l.match(/^user-agent:\s*(.*)$/i);
    if (ua) { applies = ua[1].trim() === '*'; return; }
    if (!applies) return;
    const rule = l.match(/^(allow|disallow):\s*(.*)$/i);
    if (!rule) return;
    const pat = rule[2].trim();
    if (!pat) return;
    const re = new RegExp('^' + pat.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*').replace(/\\\$$/, '$'));
    if (re.test(path) && pat.length > best.len) best = { len: pat.length, allow: /^allow$/i.test(rule[1]) };
  });
  return best.allow;
}

function fetchSourceInfo_(url) {
  const out = { title: '', price: 0, description: '', images: [], note: '' };
  const host = (String(url).match(/^https?:\/\/([^\/?#]+)/i) || [])[1] || '';
  // メルカリ：ページは読まず、写真の番号から元画像だけを取得（商品名・価格は「検索結果を送る」か手入力）
  const mid = (String(url).match(/jp\.mercari\.com\/item\/(m\d+)/) || [])[1];
  if (mid) { out.images = mercariImages_(mid); out.note = 'メルカリはページを読まず、写真だけ自動取得しました。商品名・価格は「検索結果を送る」経由か、B列・C列に入力'; return out; }
  if (NO_FETCH_SITES.test(host)) { out.note = 'このサイトは規約上、URLだけでは読み取れません。商品ページで「eBayへ送る」を押してください'; return out; }
  if (!robotsAllow_(url)) { out.note = 'このサイトは自動での読み取りを許可していません（robots.txt）。商品ページで「eBayへ送る」を押してください'; return out; }
  let html = '';
  try {
    const r = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true, headers: { 'Accept-Language': 'ja,en;q=0.8' } });
    if (r.getResponseCode() !== 200) { out.note = 'ページを開けませんでした（' + r.getResponseCode() + '）'; return out; }
    html = r.getContentText();
  } catch (e) { out.note = 'ページを開けませんでした（' + e.message + '）'; return out; }
  const meta = name => { const m = html.match(new RegExp('<meta[^>]+(?:property|name)=["\']' + name + '["\'][^>]+content=["\']([^"\']*)', 'i')) || html.match(new RegExp('<meta[^>]+content=["\']([^"\']*)["\'][^>]+(?:property|name)=["\']' + name + '["\']', 'i')); return m ? xmlUnescape_(m[1]) : ''; };
  const abs = u => { try { return u ? (u.indexOf('//') === 0 ? 'https:' + u : /^https?:/.test(u) ? u : (url.match(/^https?:\/\/[^\/]+/)[0] + (u[0] === '/' ? '' : '/') + u)) : ''; } catch (e) { return ''; } };
  // 1) 構造化データ（Product）
  (html.match(/<script[^>]+application\/ld\+json[^>]*>[\s\S]*?<\/script>/gi) || []).forEach(blk => {
    try {
      const j = JSON.parse(blk.replace(/^<script[^>]*>|<\/script>$/gi, '').trim());
      (Array.isArray(j) ? j : [j]).forEach(o => (o['@graph'] || [o]).forEach(pr => {
        if (!pr || !/Product/i.test(String(pr['@type']))) return;
        if (!out.title && pr.name) out.title = String(pr.name);
        if (!out.description && pr.description) out.description = String(pr.description);
        const of = Array.isArray(pr.offers) ? pr.offers[0] : pr.offers;
        if (!out.price && of && (of.price || of.lowPrice)) out.price = Number(String(of.price || of.lowPrice).replace(/[^\d.]/g, '')) || 0;
        const im = pr.image; (Array.isArray(im) ? im : [im]).forEach(x => { const u = abs(x && x.url ? x.url : x); if (u && out.images.indexOf(u) < 0) out.images.push(u); });
      }));
    } catch (e) {}
  });
  // 2) og:タグ
  if (!out.title) out.title = meta('og:title') || ((html.match(/<title>([\s\S]*?)<\/title>/i) || [])[1] || '').trim();
  if (!out.description) out.description = meta('og:description') || meta('description');
  if (!out.price) out.price = Number(String(meta('product:price:amount') || '').replace(/[^\d.]/g, '')) || guessYen_(html.replace(/<[^>]+>/g, ' ').slice(0, 20000));
  // 3) 写真：構造化データが1枚以下なら、og:image とページ内の大きな画像（ロゴ・アイコン・バナーを除く）
  if (out.images.length < 2) {
    const og = abs(meta('og:image'));
    if (og && out.images.indexOf(og) < 0) out.images.push(og);
    (html.match(/<img[^>]+>/gi) || []).forEach(tag => {
      if (out.images.length >= 24) return;
      const src = (tag.match(/(?:data-zoom-image|data-original|data-src|src)=["']([^"']+)/i) || [])[1];
      const u = abs(src || '');
      if (!u || /logo|icon|banner|sprite|blank|loading|placeholder|\.gif(\?|$)|\.svg(\?|$)|thumb_s|_s\.jpg/i.test(u)) return;
      const w = Number((tag.match(/width=["']?(\d+)/i) || [])[1] || 0);
      if (w && w < 200) return;
      if (out.images.indexOf(u) < 0) out.images.push(u);
    });
  }
  out.title = String(out.title).replace(/\s+/g, ' ').trim().slice(0, 200);
  out.images = out.images.slice(0, 24);
  out.note = 'ページから自動取得：商品名' + (out.title ? '○' : '×') + '・価格' + (out.price ? '○' : '×') + '・説明' + (out.description ? '○' : '×') + '・画像' + out.images.length + '枚';
  return out;
}

// メルカリの元画像（写真の番号順に、あるところまで）
function mercariImages_(mid) {
  const imgs = [];
  let miss = 0;
  for (let n = 1; n <= 20 && miss < 2; n++) {           // メルカリの写真は最大20枚。2回続けて見つからなければ終わり
    const u = 'https://static.mercdn.net/item/detail/orig/photos/' + mid + '_' + n + '.jpg';
    let ok = false;
    for (let k = 0; k < 2 && !ok; k++) {
      try { const res = UrlFetchApp.fetch(u, { muteHttpExceptions: true, method: 'get' }); ok = res.getResponseCode() === 200; if (!ok && res.getResponseCode() < 500) break; }
      catch (e) { Utilities.sleep(800); }
    }
    if (ok) { imgs.push(u); miss = 0; } else miss++;
  }
  return imgs;
}

// 画像URLを1枚ずつ開いて、画像として使えるものだけ残す（順番はそのまま・最大24枚）
function usableImages_(urls) {
  const out = [];
  urls.slice(0, 30).forEach(u => {
    if (out.length >= 24) return;
    try {
      const r = UrlFetchApp.fetch(u, { muteHttpExceptions: true, followRedirects: true });
      const ct = String(r.getHeaders()['Content-Type'] || r.getHeaders()['content-type'] || '');
      if (r.getResponseCode() === 200 && /^image\//i.test(ct) && r.getContent().length > 8000) out.push(u);
    } catch (e) {}
  });
  return out;
}

