/* =====================================================================
 * v208：あなたが送った品の仕入れ値を補う（ページから値段が読めなかったとき）
 *  ① 出品候補（0円）に同じURLの値段 ② 受け取った値段の文字 ③ 商品ページの文の最初の「¥○○」
 * ===================================================================== */
function zSentCost_(sh, row, v) {
  if (Number(v[P.COST - 1]) > 0) return 0;
  let raw = {}; try { raw = JSON.parse(v[P.RAW - 1] || '{}'); } catch (e) {}
  let yen = 0, how = '';
  try { yen = zKcPriceByUrl_(v[P.SRC - 1]); if (yen > 0) how = '出品候補（0円）の値段'; } catch (e) {}
  if (!(yen > 0)) { const n = Number(String(raw.price || '').replace(/[^\d]/g, '')); if (n >= 100 && n <= 3000000) { yen = n; how = '受け取った値段'; } }
  if (!(yen > 0)) { const m = String(raw.text || '').slice(0, 1500).match(/(?:^|\n)\s*([0-9][0-9,]{2,8})\s*円\s*(?:送料無料|送料込み?|（税込）|\(税込\))/); if (m) { const n = Number(m[1].replace(/,/g, '')); if (n >= 100 && n <= 3000000) { yen = n; how = '商品ページの文の値段（Yahoo!フリマの形）'; } } }   // v214
  if (!(yen > 0)) { const m = String(raw.text || '').slice(0, 6000).match(/[¥￥]\s*([0-9][0-9,]{2,8})/); if (m) { const n = Number(m[1].replace(/,/g, '')); if (n >= 100 && n <= 3000000) { yen = n; how = '商品ページの文の値段'; } } }
  if (!(yen > 0)) return 0;
  sh.getRange(row, P.COST).setValue(yen);
  v[P.COST - 1] = yen;
  zLog_('送った品の仕入れ値', '値段が読めなかったので ' + how + '（' + yen.toLocaleString() + '円）を使った：' + String(v[P.NAME - 1] || '').slice(0, 50));
  return yen;
}

/* =====================================================================
 * v208：相場の2倍以上で出品中の品の値段を、毎日1回少しずつ見直す（0円：eBay の出品検索だけ・AIは使わない）
 *  ・相場＝eBay に出品中の同じカード（自分の出品は除く）の中央値。3件未満なら変えない
 *  ・今の値段が相場の2倍以上なら、1日10％ずつ下げる。下げる先は「相場の2倍」と「最低ライン（最低利益 設定F29 かつ 利益率 追加の設定F303）」の高いほう
 *  ・最低ラインより下には絶対に下げない。値上げはしない
 * ===================================================================== */
function zHighPriceReviewJob() {
  if (zGhCareOn_()) return;   // v246：GitHub がする
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'zHighPriceReviewJob').forEach(t => ScriptApp.deleteTrigger(t));
  zTimed_('zHighPriceReviewJob', () => {
    try { const r = zHighPriceReview_(60); zLog_('相場の2倍以上の値段の見直し', JSON.stringify(r)); }
    catch (e) { zLog_('相場の2倍以上の値段の見直し', 'エラー：' + e.message); }
  });
}
function menuHighPriceReviewNow() {
  run_(() => { const r = zHighPriceReview_(60); return '見た品 ' + r.checked + '件・値下げ ' + r.down + '件・最低ラインのため下げられない ' + r.atFloor + '件（「0円の自動化の記録」に内容）'; });
}
function zHighPriceReview_(max) {
  const out = { checked: 0, down: 0, atFloor: 0, skip: 0, err: 0 };
  const lsh = ss_().getSheetByName('出品一覧'), prep = ss_().getSheetByName('出品作成');
  if (!lsh || lsh.getLastRow() < 2 || !prep || prep.getLastRow() < 2) return out;
  const pmap = {};
  prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues().forEach((v, i) => { const id = String(v[P.ITEMID - 1] || '').trim(); if (id) { v._row = i + 2; pmap[id] = v; } });
  const p = PropertiesService.getScriptProperties();
  const all = lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues()
    .map((v, i) => ({ v: v, row: i + 2, id: String(v[LCOL.ID - 1] || '').trim() }))
    .filter(x => x.id && Number(x.v[LCOL.QTY - 1]) > 0 && pmap[x.id]);
  let pos = Number(p.getProperty('Z_HPR_POS') || 0); if (!(pos >= 0) || pos >= all.length) pos = 0;   // 前回の続きから順番に
  const rows = all.slice(pos, pos + (max || 60)).concat(pos + (max || 60) > all.length ? all.slice(0, Math.max(0, Math.min(pos, pos + (max || 60) - all.length))) : []);
  const cs = calcSettings_(), off = official_(), fx = off.rate, mr = zMinRate_() / 100, t0 = Date.now();
  const lines = [];
  for (const x of rows) {
    if (Date.now() - t0 > 4 * 60 * 1000) break;
    out.checked++;
    try {
      const pv = pmap[x.id], cur = Number(x.v[LCOL.PRICE - 1]) || Number(pv[P.PRICE - 1]) || 0;
      const cost = Number(pv[P.COST - 1]) || 0, ship = Number(pv[P.SHIP - 1]), fixed = Number(pv[P.FIXED - 1]) || 0, f = Number(pv[P.FRATE - 1]) || 0, tr = Number(pv[P.TRATE - 1]) || 0;
      if (!(cur > 0) || !(cost > 0) || !(ship >= 0) || !(f > 0) || !(fx > 0)) { out.skip++; continue; }
      const t = zNorm_(String(pv[P.NAME - 1] || '') + ' ' + String(pv[P.TITLE - 1] || ''));
      const qm = String(pv[P.REF - 1] || '').match(/（([^（）]+)）\s*$/);
      const cn = zCardNo_(t), graded = zGraded_(String(pv[P.TITLE - 1] || ''));
      if (!qm || !cn.num) { out.skip++; continue; }
      const mk = zMarket_(qm[1], cn.num, cn.set, graded);
      const list = (mk.list || []).map(Number).filter(n => n > 0).sort((a, b) => a - b);
      const k = list.findIndex(n => Math.abs(n - cur) < 0.02); if (k >= 0) list.splice(k, 1);   // 自分の出品を除く
      if (list.length < 3) { out.skip++; continue; }
      const med = list.length % 2 ? list[(list.length - 1) / 2] : (list[list.length / 2 - 1] + list[list.length / 2]) / 2;
      if (cur < med * 2) continue;
      const keep = 1 - f - tr;
      const floor = keep > 0 ? zFloorUsd_(cost + ship + fixed, keep, cs.minProfit, fx) : Infinity;   // v210
      if (!isFinite(floor)) { out.skip++; continue; }
      const next = Math.round(Math.max(floor, med * 2, cur * 0.9) * 100) / 100;
      if (!(next < cur - 0.49)) { out.atFloor++; continue; }
      const after = Math.round(next * fx * keep - cost - ship - fixed);
      if (after < cs.minProfit || after / (next * fx) < zMinRate_(next * fx) / 100 - 0.0005) { out.atFloor++; continue; }   // 安全チェック：最低ラインを割るなら変えない
      trading_('ReviseInventoryStatus', '<InventoryStatus><ItemID>' + x_(x.id) + '</ItemID><StartPrice>' + next.toFixed(2) + '</StartPrice></InventoryStatus>');
      lsh.getRange(x.row, LCOL.PRICE).setValue(next);
      try { prep.getRange(pv._row, P.PRICE).setValue(next); } catch (e) {}
      lsh.getRange(x.row, LCOL.MEMO).setValue('相場の2倍以上の見直し：$' + cur.toFixed(2) + ' → $' + next.toFixed(2) + '（相場 $' + med.toFixed(2) + '・最低ライン $' + floor.toFixed(2) + '・' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）');
      out.down++; zDayCount_('hprDown', 1);
      lines.push(String(x.v[LCOL.TITLE - 1] || '').slice(0, 40) + '：$' + cur.toFixed(2) + '→$' + next.toFixed(2) + '（相場 $' + med.toFixed(2) + '・利益 ' + after.toLocaleString() + '円）');
    } catch (e) { out.err++; }
  }
  p.setProperty('Z_HPR_POS', String(all.length ? (pos + out.checked) % all.length : 0));
  if (lines.length) zLog_('相場の2倍以上の値段の見直し', '値下げ ' + lines.length + '件：' + lines.join('／').slice(0, 1500));
  return out;
}


/* =====================================================================
 * v209：出品中の品の利益が最低利益（設定 F29）・最低の利益率（追加の設定 F303）を下回っていたら、届く値段まで値上げする（0円：AIなし）
 *  ・仕入れ値・送料・手数料率は「出品作成」に記録した値、為替は今の値で計算する。記録のない出品は変えない
 *  ・値下げはしない。1回で終わらないときは、続きから
 * ===================================================================== */
function zRaiseToMinProfitJob() {
  if (zGhCareOn_()) return;   // v246：GitHub がする
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'zRaiseToMinProfitJob').forEach(t => ScriptApp.deleteTrigger(t));
  zTimed_('zRaiseToMinProfitJob', () => {
    try { const r = zRaiseToMinProfit_(); zLog_('最低利益までの値上げ', JSON.stringify(r)); if (r.more) { try { ScriptApp.newTrigger('zRaiseToMinProfitJob').timeBased().after(60 * 1000).create(); } catch (e) {} } }
    catch (e) { zLog_('最低利益までの値上げ', 'エラー：' + e.message); }
  });
}
function menuRaiseToMinProfitNow() {
  run_(() => { const r = zRaiseToMinProfit_(); if (r.more) { try { ScriptApp.newTrigger('zRaiseToMinProfitJob').timeBased().after(60 * 1000).create(); } catch (e) {} }
    return '見た品 ' + r.checked + '件・値上げ ' + r.up + '件・もともと最低利益以上 ' + r.ok + '件・記録がなく変えない ' + r.skip + '件・相場より高くなるので上げず「取り下げ候補」へ ' + (r.drop || 0) + '件・失敗 ' + r.err + '件' + (r.more ? '（残りは1分後から自動で続けます）' : '（全部終わりました）') + '。内容は「0円の自動化の記録」の「最低利益までの値上げ」'; });
}
function zRaiseToMinProfit_() {
  const out = { checked: 0, up: 0, ok: 0, skip: 0, err: 0, drop: 0, more: false };
  const lsh = ss_().getSheetByName('出品一覧'), prep = ss_().getSheetByName('出品作成');
  if (!lsh || lsh.getLastRow() < 2) return out;
  const pmap = {};
  if (prep && prep.getLastRow() > 1) prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues().forEach((v, i) => { const id = String(v[P.ITEMID - 1] || '').trim(); if (id) { v._row = i + 2; pmap[id] = v; } });
  const all = lsh.getRange(2, 1, lsh.getLastRow() - 1, LIST_HEADERS.length).getValues()
    .map((v, i) => ({ v: v, row: i + 2, id: String(v[LCOL.ID - 1] || '').trim() })).filter(x => x.id && Number(x.v[LCOL.QTY - 1]) > 0);
  const p = PropertiesService.getScriptProperties();
  let pos = Number(p.getProperty('Z_RMP_POS') || 0); if (!(pos >= 0) || pos >= all.length) pos = 0;
  const cs = calcSettings_(), fx = official_().rate, mr = zMinRateBase_() / 100, minProfit = cs.minProfit, t0 = Date.now(), lines = [], drops = [];
  let i = pos;
  for (; i < all.length; i++) {
    if (Date.now() - t0 > 4 * 60 * 1000) { out.more = true; break; }
    const x = all[i], pv = pmap[x.id]; out.checked++;
    try {
      if (!pv) { out.skip++; continue; }
      const cur = Number(x.v[LCOL.PRICE - 1]) || Number(pv[P.PRICE - 1]) || 0;
      const cost = Number(pv[P.COST - 1]) || 0, ship = Number(pv[P.SHIP - 1]), fixed = Number(pv[P.FIXED - 1]) || 0, f = Number(pv[P.FRATE - 1]) || 0, tr = Number(pv[P.TRATE - 1]) || 0;
      if (!(cur > 0) || !(cost > 0) || !(ship >= 0) || !(f > 0) || !(fx > 0) || !(minProfit > 0)) { out.skip++; continue; }
      const keep = 1 - f - tr; if (!(keep > 0)) { out.skip++; continue; }
      const profitAt = pr => Math.round(pr * fx * keep - cost - ship - fixed);
      const nowP = profitAt(cur);
      if (nowP >= minProfit && nowP / (cur * fx) >= mr) { out.ok++; continue; }   // v226：フロア（最低利益と最低の利益率 F303）を守れていれば変えない（高額品の上乗せはしない）
      const C = cost + ship + fixed; if (!(keep - mr > 0)) { out.skip++; continue; }
      const floor = Math.ceil(Math.max((C + minProfit) / keep / fx, C / (keep - mr) / fx) * 100) / 100 + 0.01;   // v226：フロアまでだけ
      const next = Math.round(floor * 100) / 100;
      if (!(next > cur)) { out.ok++; continue; }
      const med = Number(pv[P.MED - 1]) || 0;
      if (med > 0 && next > med * zMktX_()) {   // v258：相場の1.4倍まで上げる／v226：上げると相場（中央値）より高くなる品は上げずに「取り下げ候補」へ（決めるのはあなた）
        out.drop = (out.drop || 0) + 1;
        drops.push([Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd HH:mm'), "'" + x.id, String(x.v[LCOL.TITLE - 1] || ''), cur, next, med, nowP, Math.round(cur * fx) > 0 ? Math.round(nowP / (cur * fx) * 1000) / 10 + '%' : '', 'https://www.ebay.com/itm/' + x.id, '']);
        continue;
      }
      trading_('ReviseInventoryStatus', '<InventoryStatus><ItemID>' + x_(x.id) + '</ItemID><StartPrice>' + next.toFixed(2) + '</StartPrice></InventoryStatus>');
      lsh.getRange(x.row, LCOL.PRICE).setValue(next);
      try { prep.getRange(pv._row, P.PRICE).setValue(next); } catch (e) {}
      lsh.getRange(x.row, LCOL.MEMO).setValue('最低利益・利益率（' + Math.round(mr * 1000) / 10 + '％）までの値上げ：$' + cur.toFixed(2) + ' → $' + next.toFixed(2) + '（利益 ' + nowP.toLocaleString() + '円 → ' + profitAt(next).toLocaleString() + '円・' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + '）');
      out.up++;
      lines.push(String(x.v[LCOL.TITLE - 1] || '').slice(0, 40) + '：$' + cur.toFixed(2) + '→$' + next.toFixed(2) + '（利益 ' + nowP.toLocaleString() + '→' + profitAt(next).toLocaleString() + '円）');
    } catch (e) { out.err++; if (lines.length < 40) lines.push('❌ ' + x.id + '：' + String(e.message).slice(0, 120)); }
  }
  p.setProperty('Z_RMP_POS', String(out.more ? i : 0));
  if (lines.length) zLog_('最低利益までの値上げ', lines.join('／').slice(0, 1800));
  try { zDropCandWrite_(drops, pos === 0); } catch (e) { zLog_('最低利益までの値上げ', '取り下げ候補の書き込みエラー：' + e.message); }
  if (drops.length) zLog_('最低利益までの値上げ', '相場より高くなるので上げずに「取り下げ候補」へ：' + drops.length + '件');
  return out;
}
/* v226：取り下げ候補（毎晩の値上げで、フロアまで上げると相場の中央値より高くなる品）。上げも下げも取り下げもしない。決めるのはあなた */
function zDropCandWrite_(rows, fresh) {
  const ss = ss_(); let sh = ss.getSheetByName('取り下げ候補');
  const H = ['見た日時', 'eBay商品ID', 'タイトル', '今の値段（$）', 'フロアの値段（$）', '相場の中央値（$）', '今の利益（円）', '今の利益率', 'eBayのページ', 'あなたのメモ'];
  if (!sh) { sh = ss.insertSheet('取り下げ候補'); sh.getRange(1, 1, 1, H.length).setValues([H]).setFontWeight('bold').setBackground('#fde2e2'); sh.setFrozenRows(1); }
  if (fresh && sh.getLastRow() > 1) {   // 新しい回の最初：前回の一覧を消す（メモ欄に書いた行は残す）
    const v = sh.getRange(2, 1, sh.getLastRow() - 1, H.length).getValues().filter(r => String(r[9] || '').trim());
    sh.getRange(2, 1, sh.getLastRow() - 1, H.length).clearContent();
    if (v.length) sh.getRange(2, 1, v.length, H.length).setValues(v);
  }
  if (!rows.length) return;
  const have = sh.getLastRow() > 1 ? sh.getRange(2, 2, sh.getLastRow() - 1, 1).getValues().map(r => String(r[0]).replace(/^'/, '')) : [];
  const add = rows.filter(r => have.indexOf(String(r[1]).replace(/^'/, '')) < 0);
  if (add.length) sh.getRange(sh.getLastRow() + 1, 1, add.length, H.length).setValues(add);
}


/* v211：オファーの承認の下限＝最低利益（設定F29）と最低の利益率（追加の設定F303・高額はF307）の両方を守る一番安い値段 */
function zOfferFloor_(v) {
  const mp = Math.ceil((Number(v[P.MINPRICE - 1]) || 0) * 100) / 100;
  try {
    const cost = Number(v[P.COST - 1]) || 0, ship = Number(v[P.SHIP - 1]), fixed = Number(v[P.FIXED - 1]) || 0, f = Number(v[P.FRATE - 1]) || 0, tr = Number(v[P.TRATE - 1]) || 0, fx = official_().rate;
    if (cost > 0 && ship >= 0 && f > 0 && fx > 0 && 1 - f - tr > 0) { const fl = zFloorUsd_(cost + ship + fixed, 1 - f - tr, calcSettings_().minProfit, fx); if (isFinite(fl)) return Math.max(mp, fl); }
  } catch (e) {}
  return mp;
}


