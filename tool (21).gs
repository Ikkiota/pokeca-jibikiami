/* =====================================================================
 * v125：型番リスト（売れた実績）— 別のサイトのシートと同じ形（ポケカ向け）
 *  列：使う／シリーズ／型番（カード番号）／カード名（日本語）／状態（未鑑定・PSA10）／売れた値段$（送料込み）／確かめた日／メモ／仕入れ上限（円・自動）
 *  ・売れた実績（自分の店の注文・「Soldを送る」）で行を足す・値段を更新（AIなし）
 *  ・兄弟：売れたカードと同じシリーズ・同じレアリティのカードを eBay の出品から探して足す（AIなし）
 *  ・重複：同じシリーズ＋型番＋状態が2行目以降にあれば「使う」を外して「重複」
 *  ・仕入れ上限：売れた値段（30日以内）から計算。なければ eBay の出品中の最安から
 *  ・「使う」の行は、キーワード検索・メルカリのメール・Yahoo!ショッピングのルールの判定に、カード型番リストと一緒に使う
 * ===================================================================== */
const SL_SHEET = '型番リスト（売れた実績）';
const SL_HEAD = ['使う', 'シリーズ（例 SV2a）', '型番（カード番号 例 186/165）', 'カード名（日本語）', '状態（未鑑定／PSA10 など）', '売れた値段$（送料込み・Soldで確認）', '確かめた日', 'メモ', '仕入れ上限（円・自動）'];
const SL = { USE: 1, SET: 2, NUM: 3, JA: 4, GRADE: 5, PRICE: 6, DATE: 7, MEMO: 8, CAP: 9 };
function slSheet_() {
  const ss = ss_(); let sh = ss.getSheetByName(SL_SHEET);
  if (sh) return sh;
  sh = ss.insertSheet(SL_SHEET);
  sh.getRange(1, 1, 1, SL_HEAD.length).setValues([SL_HEAD]).setFontWeight('bold').setBackground('#e6f4ea').setWrap(true);
  [50, 110, 150, 160, 110, 150, 100, 420, 110].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(1);
  sh.setColumnWidth(11, 520);
  sh.getRange('K1').setValue('1日15分の手順（教科書 第3章・第18章）').setFontWeight('bold');
  sh.getRange('K2:K9').setValues([['① 5分：「出品候補（0円）」を開いて、仕入れたい品の GO にチェック →「0円の自動化」→「キーワード検索：GOした候補を判定・出品に回す」'],
    ['② 5分：売れていそうなカードを eBay で「Sold items」にして検索 →「Soldを送る」を押す（3〜5型番）。売れた値段と兄弟がこのシートに入ります'],
    ['③ 5分：このシートの新しい行（兄弟・追加候補）を見て、扱わないものは「使う」のチェックを外す'],
    [''], ['・お金はかかりません（売れた実績・兄弟・重複・仕入れ上限は、すべて AI なしで自動）'],
    ['・「使う」の行は、毎日の Yahoo!ショッピングの検索・メルカリのお知らせメールの判定に使います'],
    ['・売れた値段は30日間使います。古くなったら eBay の出品中の最安で上限を計算します'],
    ['・自分の店で売れたカードは、自動でここに入ります（毎日4時ごろ）']]).setWrap(true).setFontColor('#555555');
  return sh;
}
function slKey_(set, num, grade) { return (String(set || '').toLowerCase() + ' ' + String(num || '').toLowerCase()).trim() + '|' + String(grade || '未鑑定'); }
function slRows_() {
  const sh = slSheet_(), n = sh.getLastRow() - 1;
  return { sh: sh, rows: n > 0 ? sh.getRange(2, 1, n, SL_HEAD.length + 1).getValues().map((r, i) => ({ row: i + 2, r: r })) : [] };
}
// 行を足す（同じものがあれば値段・日付・メモだけ更新）
function slUpsert_(list) {
  const S = slRows_(), sh = S.sh, idx = {};
  S.rows.forEach(x => { const k = slKey_(x.r[SL.SET - 1], x.r[SL.NUM - 1], x.r[SL.GRADE - 1]); if (!idx[k]) idx[k] = x; });
  let added = 0, updated = 0;
  list.forEach(o => {
    const k = slKey_(o.set, o.num, o.grade), x = idx[k];
    if (x) {
      if (o.price > 0) { sh.getRange(x.row, SL.PRICE, 1, 3).setValues([[Math.round(o.price * 100) / 100, new Date(), o.memo]]); updated++; }
      return;
    }
    const r = [o.use !== false, o.set || '', o.num, o.ja || '', o.grade || '未鑑定', o.price > 0 ? Math.round(o.price * 100) / 100 : '', new Date(), o.memo || '', ''];
    sh.appendRow(r);
    sh.getRange(sh.getLastRow(), SL.USE).insertCheckboxes().setValue(o.use !== false);
    idx[k] = { row: sh.getLastRow(), r: r };
    added++;
  });
  return { added: added, updated: updated };
}
// 重複に印・仕入れ上限を計算し直す（0円）
function slRefresh_() {
  const S = slRows_(), sh = S.sh, seen = {};
  let dup = 0, caps = 0;
  const started = Date.now();
  S.rows.forEach(x => {
    const r = x.r, num = String(r[SL.NUM - 1] || '').trim(); if (!num || /^番号なし/.test(num)) return;   // v131
    const k = slKey_(r[SL.SET - 1], num, r[SL.GRADE - 1]);
    if (seen[k]) { if (r[SL.USE - 1] === true || !/^重複/.test(String(r[SL.MEMO - 1]))) { sh.getRange(x.row, SL.USE).setValue(false); sh.getRange(x.row, SL.MEMO).setValue('重複（' + seen[k] + '行目にあるので使わない）'); dup++; } return; }
    seen[k] = x.row;
    if (Date.now() - started > 90 * 1000) return;
    const sold = Number(r[SL.PRICE - 1]) || 0, d = r[SL.DATE - 1] instanceof Date ? r[SL.DATE - 1].getTime() : 0;
    let base = sold > 0 && Date.now() - d < 30 * 86400000 ? sold : 0;
    if (!base) {
      const cn = zCardNo_(num), graded = !/未鑑定/.test(String(r[SL.GRADE - 1] || '未鑑定'));
      const en = slEn_(r[SL.JA - 1], r[SL_EN_COL - 1]);   // v131：英語名の列も
      const mk = zMarket_(['Pokemon', en, cn.num || num, r[SL.SET - 1], graded ? r[SL.GRADE - 1] : '', 'Japanese'].filter(v => v).join(' '), cn.num || num, String(r[SL.SET - 1] || ''), graded);
      base = mk.low || 0;
    }
    const cap = zCap_(base);
    if (cap !== (Number(r[SL.CAP - 1]) || 0)) { sh.getRange(x.row, SL.CAP).setValue(cap || ''); caps++; }
  });
  return { dup: dup, caps: caps };
}
// 兄弟：同じシリーズ・同じレアリティのカードを eBay の出品から（1回に最大 n シリーズ）
function slSiblings_(seeds, n) {
  const add = [], done = {};
  seeds.slice(0, n || 5).forEach(o => {
    if (!o.set || !o.rar) return;
    const rar = o.rar, k = o.set.toLowerCase() + '|' + rar;
    if (done[k]) return; done[k] = 1;
    const mk = zMarket_('Pokemon Card ' + o.set + ' ' + rar + ' Japanese', '', '', false);
    const cnt = {};
    (mk.items || []).forEach(t => {
      if (!/japan/i.test(t) || Z_JUNK.test(t) || zGraded_(t)) return;
      if (!new RegExp('(^|[^A-Za-z])' + rar + '([^A-Za-z]|$)', 'i').test(t)) return;
      const c = zCardNo_(t); if (!c.num || (c.set && c.set.toLowerCase() !== o.set.toLowerCase())) return;
      if (c.num === o.num) return;
      const nm = zNameFromTitle_(t);
      cnt[c.num] = cnt[c.num] || { n: 0, ja: nm.ja };
      cnt[c.num].n++;
    });
    Object.keys(cnt).filter(num => cnt[num].n >= 2).slice(0, 15).forEach(num => add.push({ set: o.set, num: num, ja: cnt[num].ja, grade: '未鑑定', use: true, memo: '兄弟（' + o.set + ' ' + o.num + (o.ja ? '・' + o.ja : '') + ' が売れた・同じ' + rar + '）' }));
  });
  return add.length ? slUpsert_(add) : { added: 0, updated: 0 };
}
// 売れた実績を足す（自分の店の注文・Soldを送る）
function slFromSold_(list, how) {
  const items = list.map(o => ({ set: o.set || '', num: o.num, ja: o.ja || '', grade: o.grade || '未鑑定', price: o.price, use: true,
    memo: '売れた実績（' + how + (o.n ? '・' + o.n + '件' : '') + (o.price ? '・$' + Number(o.price).toFixed(2) : '') + '）', rar: o.rar }));
  const r = slUpsert_(items);
  const sib = slSiblings_(items.filter(x => x.set && x.rar && x.grade === '未鑑定'), 5);
  return { added: r.added, updated: r.updated, siblings: sib.added };
}
// 「使う」の行を、カード型番リストと同じ形に（ルールの判定用・読むだけ）
function slAsModelRows_() {
  const S = slRows_();
  return S.rows.filter(x => x.r[SL.USE - 1] === true && String(x.r[SL.NUM - 1] || '').trim() && !/^番号なし/.test(String(x.r[SL.NUM - 1]))).map(x => {
    const a = new Array(ZM_HEAD.length).fill('');
    const set = String(x.r[SL.SET - 1] || '').trim(), num = zCardNo_(x.r[SL.NUM - 1]).num || String(x.r[SL.NUM - 1]).trim();
    a[ZM.USE - 1] = true; a[ZM.KEY - 1] = (set ? set + ' ' : '') + num; a[ZM.JA - 1] = x.r[SL.JA - 1]; a[ZM.EN - 1] = slEn_(x.r[SL.JA - 1], x.r[SL_EN_COL - 1]);
    a[ZM.GRADE - 1] = x.r[SL.GRADE - 1] || '未鑑定'; a[ZM.CAP - 1] = Number(x.r[SL.CAP - 1]) || 0;
    return { row: 0, slRow: x.row, r: a };
  });
}
function slDaily_() {
  // 自分の店で売れたカード
  let own = {}; try { own = zOwnSales_(); } catch (e) {}
  const list = Object.keys(own).map(k => { const o = own[k]; const p = o.prices.sort((a, b) => a - b); return { set: o.set, num: o.num, ja: o.ja, grade: o.grade, rar: o.rar, price: p.length ? p[Math.floor(p.length / 2)] : 0, n: o.n }; });
  const a = list.length ? slFromSold_(list, '自分の店') : { added: 0, updated: 0, siblings: 0 };
  const b = slRefresh_();
  return { own: list.length, added: a.added, updated: a.updated, siblings: a.siblings, dup: b.dup, caps: b.caps };
}
function menuSlOpen() { slSheet_().activate(); }
function menuSlNow() { run_(() => { const r = slDaily_(); slSheet_().activate(); return '自分の店で売れたカード ' + r.own + '種類（新しく ' + r.added + '行・値段の更新 ' + r.updated + '行）・兄弟 ' + r.siblings + '行・重複 ' + r.dup + '行・仕入れ上限の計算 ' + r.caps + '行（「' + SL_SHEET + '」）'; }); }

/* ---------- v126：オファーが来たら、URLつきでメール（0円・同じオファーは1回だけ） ---------- */
function offerNotify_(all) {
  const out = trading_('GetBestOffers', '<BestOfferStatus>Active</BestOfferStatus><DetailLevel>ReturnAll</DetailLevel>');
  const ns = out.ns, groups = [];
  const arr = out.root.getChild('ItemBestOffersArray', ns);
  (arr ? arr.getChildren('ItemBestOffers', ns) : []).forEach(g => groups.push({ item: g.getChild('Item', ns), offers: g.getChild('BestOfferArray', ns) }));
  if (!groups.length) { const it = out.root.getChild('Item', ns), bo = out.root.getChild('BestOfferArray', ns); if (it && bo) groups.push({ item: it, offers: bo }); }
  if (!groups.length) return 0;
  const p = PropertiesService.getScriptProperties();
  let done = []; try { done = JSON.parse(p.getProperty('OFFER_NOTIFIED') || '[]'); } catch (e) {}
  const prep = prepSheet_();
  const pv = prep.getLastRow() > 1 ? prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues() : [];
  let os = { auto: false, ratio: 0, counter: true }; try { os = offerSettings_(); } catch (e) {}
  const lines = [];
  groups.forEach(g => {
    if (!g.item || !g.offers) return;
    const itemId = String(g.item.getChildText('ItemID', ns));
    const ssx = g.item.getChild('SellingStatus', ns);
    const price = Number(g.item.getChildText('BuyItNowPrice', ns)) || Number(ssx ? ssx.getChildText('CurrentPrice', ns) : 0) || 0;
    const row = pv.find(v => String(v[P.ITEMID - 1]) === itemId);
    const title = row ? String(row[P.TITLE - 1] || '') : String(g.item.getChildText('Title', ns) || '');
    const floor = row ? Math.ceil((Number(row[P.MINPRICE - 1]) || 0) * 100) / 100 : 0;
    g.offers.getChildren('BestOffer', ns).forEach(bo => {
      const id = String(bo.getChildText('BestOfferID', ns) || '');
      if (!id || (!all && done.indexOf(id) >= 0)) return;
      if (done.indexOf(id) < 0) done.push(id);
      const amt = Number(bo.getChildText('Price', ns)) || 0, qty = Number(bo.getChildText('Quantity', ns)) || 1;
      const exp = String(bo.getChildText('ExpirationTime', ns) || '');
      let stockLine = ''; if (!all) try { const sk = zAskStock_('オファー', itemId, title, row ? row[P.SRC - 1] : ''); if (sk) stockLine = '　仕入れ先の在庫：' + sk.txt + '\n'; } catch (e) {}   // v235
      const judge = !(floor > 0) ? '最低利益を守れる価格が分からない商品（ツールで出品していない商品など）→ eBayの画面で判断してください'
        : amt >= floor ? '✅ 最低利益を守れる（下限 $' + floor.toFixed(2) + '）' + (os.auto ? '→ 自動で承認します' : '→ 承認してよい額')
        : '⚠ 最低利益を割る（下限 $' + floor.toFixed(2) + '）' + (os.auto ? (os.counter ? '→ 自動で $' + floor.toFixed(2) + ' でカウンターします' : '→ 自動で断ります') : '→ カウンターか辞退');
      lines.push('■ ' + title.slice(0, 80) + '\n' +
        '　オファー：$' + amt.toFixed(2) + (qty > 1 ? '（' + qty + '個）' : '') + '／今の価格：$' + price.toFixed(2) + '\n' +
        '　判断：' + judge + '\n' +
        '　eBayの商品ページ：https://www.ebay.com/itm/' + itemId + '\n' +
        '　オファーに返事をする：https://www.ebay.com/sh/ord/offers' + '\n' +
        (row && row[P.SRC - 1] ? '　仕入れ先：' + row[P.SRC - 1] + '\n' : '') + stockLine +
        (exp ? '　返事の期限：' + Utilities.formatDate(new Date(exp), 'Asia/Tokyo', 'MM/dd HH:mm') + '（日本時間）\n' : ''));
    });
  });
  if (done.length > 500) done = done.slice(-500);
  p.setProperty('OFFER_NOTIFIED', JSON.stringify(done));
  if (all) return lines;
  if (!lines.length) return 0;
  MailApp.sendEmail(Session.getEffectiveUser().getEmail(), '【オファー】' + lines.length + '件 届きました',
    'eBayでオファー（値下げの申し込み）が届きました。\n\n' + lines.join('\n') + '\n記録：「オファーの記録」シート\n' + ss_().getUrl());
  return lines.length;
}

