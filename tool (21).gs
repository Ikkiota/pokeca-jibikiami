  log.getRange(log.getLastRow(), 8 + LOG_HEAD.length - 1).setWrap(true);
  sh.deleteRow(row);
}

// 1行分を出品して、eBay商品IDを返す（失敗したら例外）
let MANUAL_LIST_ = false;   // v143：あなたがメニュー「チェックした商品を出品」を押したときだけ true
function listPaused_() { return PropertiesService.getScriptProperties().getProperty('LISTING_PAUSED') === '1'; }
function listRow_(sh, row, ls) {
  if (zGhListOn_()) { const m = '【ロック待ち】GitHubで出品します（15分ほどで自動で出品）'; try { sh.getRange(row, P.STATUS).setValue('候補（出品エラー）'); sh.getRange(row, P.NOTE).setValue(m); } catch (e) {} throw new Error(m); }   // v245
  if (listPaused_() && !MANUAL_LIST_) throw new Error('出品停止中：あなたの指示があるまで自動では出品しません（「0円の自動化」→「出品を再開する」で戻せます）');   // v143
  try { const nm0 = zNorm_(String(sh.getRange(row, P.NAME).getValue() || '')); if (!MANUAL_LIST_ && (Z_HARD_DAMAGE.test(nm0) || (Z_DAMAGED.test(nm0) && !zDamagedSettings_().on))) throw new Error('傷・難ありの品なので出品しません（' + nm0.slice(0, 40) + '）'); } catch (e) { if (/傷・難あり/.test(e.message)) throw e; }   // v171：出品の直前にも確かめる
  try { API_ITEM_ = String(sh.getRange(row, P.SRC).getValue() || ''); } catch (e) {}
  { const t0 = String(sh.getRange(row, P.NAME).getValue() || '') + ' ' + String(sh.getRange(row, P.TITLE).getValue() || ''); if (!MANUAL_LIST_ && zGraded_(t0) && zInspSettings_().on) { sh.getRange(row, P.STATUS).setValue('保留（鑑定品・PSAは出さないきまり）'); throw new Error('鑑定品（PSAなど）は出品しません（あなたのきまり・自動点検担当 v233）'); } }
  { const ck = zPrepCardKey_(sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0]); if (ck && zListedCardKeys_().has(ck)) { sh.getRange(row, P.STATUS).setValue('重複（同じカードがもう eBay に出品中）'); throw new Error('二重出品を止めました：同じカード（' + ck.split('|')[0] + '）がもう出品中です'); } }   // v182：お金・時間を使う前に止める
  // 出品の直前に、ポリシーIDがeBayに実在するか確かめる（違っていれば、実在するものに自動で入れ替える）
  const pv = ensureValidPolicies_(ls);
  if (pv.fixed.length) sh.getRange(row, P.NOTE).setValue('ポリシーIDを直しました：' + pv.fixed.join('／'));
  if (!ls.shipId || !ls.returnId || !ls.payId) throw new Error('使える出品ポリシーが見つかりません。セラーハブでビジネスポリシー（配送・返品・支払い）を確認してください。');
  try { zPolishRow_(sh, row); } catch (e) {}   // v213：出品の前に、英語名（日本語の読み・誤訳）と空の仕様（Set・Rarity・Card Number）を直す
  const r = sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0];
  const title = String(r[P.TITLE - 1] || '').trim();
  const price = Number(r[P.PRICE - 1]);
  const cat = String(r[P.CAT - 1] || '').trim();
  let imgs = String(r[P.IMGS - 1] || '').split(/\n+/).map(v => v.trim()).filter(v => /^https?:\/\//.test(v)).slice(0, 24);
  // 画像が空なら、仕入れURLから自動で取りに行く（メルカリは写真の番号から、一般のショップは許可されていればページから）
  let autoImgNote = '';
  if (!imgs.length && String(r[P.SRC - 1] || '').trim()) {
    const fr = fetchSourceInfo_(String(r[P.SRC - 1]).trim());
    imgs = usableImages_(fr.images || []);
    if (imgs.length) {
      sh.getRange(row, P.IMGS).setValue(imgs.join('\n'));
      sh.getRange(row, P.IMGSTAT).setValue('出品時に仕入れURLから画像を自動取得：' + imgs.length + '枚（順番どおり）');
    } else autoImgNote = '仕入れURLからも自動で取得できませんでした（' + (fr.note || '') + '）。';
  }
  const qty = Math.max(1, parseInt(r[P.QTY - 1], 10) || 1);
  const cond = parseInt(String(r[P.COND - 1]), 10) || 1000;
  if (!title) throw new Error('英語タイトルが空です');
  if (title.length > 80) throw new Error('タイトルが80文字を超えています（' + title.length + '文字）');
  if (!(price > 0)) throw new Error('販売価格（N列）を入れてください');
  if (!cat) throw new Error('カテゴリIDが空です');
  if (!imgs.length) {
    photoLog_({ stage: '出品', url: r[P.SRC - 1], row: row, sheet: 0, reason: '画像URLがありません。' + autoImgNote, result: '出品しない' });
    throw new Error('画像URLがありません。' + autoImgNote + '仕入れ先の商品ページで「eBayへ送る」を押すと、画像付きで作り直せます');
  }
  // v101：写真の枚数チェック（ページの写真より少なければ出品しない／メルカリで1枚だけなら残りを確認）
  const pcheck = photoGate_(sh, row, r, imgs);
  imgs = pcheck.imgs;
  // v177：海外購入の案内・バナーの画像は外す（カードの写真が1枚も残らないときは1枚目だけ）
  { const k = zDropBanners_(imgs); if (k.length !== imgs.length) { imgs = k; sh.getRange(row, P.IMGS).setValue(imgs.join('\n')); } }   // v180：URLに文字がなくても、横長の案内画像（Buyee など）は形で見分けて外す
  // v93：カードの鑑定状態を写真で判定（未査定なら、写真をアップロードする前に止める）
  const cc = resolveListingCondition_(sh, row, r, cat, cond, imgs);
  const condFinal = cc.cond;
  // 写真を1枚ずつ、順番どおりにeBayへアップロード。1枚でも失敗したら出品しない
  let eps, fastPics = false;
  // v149：写真は仕入れ先の写真のURL（https）をそのまま eBay に渡す（1枚ずつアップロードしない＝1品 20〜40秒の節約）。断られたら今までどおりアップロード
  if (zFastPicsOn_() && imgs.length && imgs.every(u => /^https:\/\//i.test(String(u)))) {
    const adj0 = photoAdjustSettings_();
    eps = imgs.map((u, i) => (adj0.on && (adj0.all || i === 0)) ? brightenUrl_(u, adj0) : String(u)); fastPics = true;
    LAST_PHOTO_NOTE_ = '写真は仕入れ先のURLをそのまま使用（1枚目は明るさ補正）';
  } else
  try { eps = uploadPictures_(imgs); }
  catch (e) { photoLog_({ stage: '出品', url: r[P.SRC - 1], row: row, method: pcheck.method, page: pcheck.page, got: pcheck.got, sheet: imgs.length, passed: 0, result: '出品しない', reason: 'eBayへの写真アップロードに失敗：' + e.message }); throw e; }
  if (eps.length !== imgs.length) {
    photoLog_({ stage: '出品', url: r[P.SRC - 1], row: row, method: pcheck.method, page: pcheck.page, got: pcheck.got, sheet: imgs.length, passed: eps.length, result: '出品しない', reason: 'アップロードした枚数が合いません' });
    throw new Error('写真の枚数が合いません（シート ' + imgs.length + '枚・eBayへアップロード ' + eps.length + '枚）。出品を止めました');
  }
  sh.getRange(row, P.IMGSTAT).setValue('eBayにアップロード済み：' + eps.length + '枚（仕入れ先の順番どおり）' + (pcheck.note ? '／' + pcheck.note : ''));
  const condNote = String(r[P.CONDNOTE - 1] || '').trim().slice(0, 1000);

  const specs = String(r[P.SPECS - 1] || '').split(/\n+/).map(l => {
    const k = l.indexOf(':');
    return k > 0 ? [l.slice(0, k).trim().slice(0, 65), l.slice(k + 1).trim().slice(0, 65)] : null;
  }).filter(v => v && v[0] && v[1] && !/^shipping method$/i.test(v[0])).slice(0, 44);
  const sm = shipMethodLabel_(r[P.METHOD - 1]);
  if (sm.en) specs.push(['Shipping Method', sm.en]);
  const jan = String(r[P.JAN - 1] || '').replace(/\D/g, '');
  const sku = 'SRC-' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyMMddHHmmss') + '-' + row;

  // v109：国別送料 v2（レートテーブル）が使える商品は v2 の配送ポリシー。使えない・断られたときは今までの方法
  let rtp = null; try { rtp = rtPolicyForRow_(r); } catch (e) { rtp = null; }
  let ofx = ''; try { ofx = offerXmlNew_(price, Number(r[P.MINPRICE - 1]) || 0); } catch (e) { ofx = ''; }   // v113：オファー（オンのときだけ）
  const mkItem = () =>
    '<Item>' +
    '<Title>' + x_(title) + '</Title>' +
    '<Description><![CDATA[' + zItemDesc_(title, specs, condFinal, condNote && conditionNoteAllowed_(condFinal) ? condNote : '').replace(/]]>/g, ']]&gt;') + ']]></Description>' +   // v234：商品ごとの説明
    '<PrimaryCategory><CategoryID>' + x_(cat) + '</CategoryID></PrimaryCategory>' +
    '<StartPrice currencyID="USD">' + price.toFixed(2) + '</StartPrice>' +
    '<ConditionID>' + condFinal + '</ConditionID>' + cc.xml +
    '<Country>JP</Country><Currency>USD</Currency>' +
    '<Location>' + x_(ls.location) + '</Location>' +
    '<ListingDuration>GTC</ListingDuration><ListingType>FixedPriceItem</ListingType>' +
    '<Quantity>' + qty + '</Quantity>' +
    '<SKU>' + sku + '</SKU>' +
    '<PictureDetails>' + eps.map(u => '<PictureURL>' + x_(u) + '</PictureURL>').join('') + '</PictureDetails>' +
    (condNote && conditionNoteAllowed_(condFinal) ? '<ConditionDescription>' + x_(condNote) + '</ConditionDescription>' : '') +
    (specs.length ? '<ItemSpecifics>' + specs.map(v => '<NameValueList><Name>' + x_(v[0]) + '</Name><Value>' + x_(v[1]) + '</Value></NameValueList>').join('') + '</ItemSpecifics>' : '') +
    (jan.length === 13 ? '<ProductListingDetails><EAN>' + jan + '</EAN></ProductListingDetails>' : '') +
    '<SellerProfiles>' +
    '<SellerShippingProfile><ShippingProfileID>' + x_(rtp ? rtp.id : (icPolicyIdForListing_() || policyForMethod_(r[P.METHOD - 1]).id || shipPolicyForWeight_(Number(r[P.WEIGHT - 1]) || 0) || ls.shipId)) + '</ShippingProfileID></SellerShippingProfile>' +
    '<SellerReturnProfile><ReturnProfileID>' + x_(ls.returnId) + '</ReturnProfileID></SellerReturnProfile>' +
    '<SellerPaymentProfile><PaymentProfileID>' + x_(ls.payId) + '</PaymentProfileID></SellerPaymentProfile>' +
    '</SellerProfiles>' +
    (rtp ? (rtp.xml || '') : (icPolicyIdForListing_() ? icOverrideXml_(r) : '')) +   // v108・v109：国別送料（オンのときだけ）
    ofx +   // v113：オファー（オンのときだけ）
    '</Item>';
  let item = mkItem();
  // v149：写真のURLをそのまま渡して eBay に断られたら、今までどおり1枚ずつアップロードしてやり直す
  if (fastPics) { try { trading_('VerifyAddFixedPriceItem', item); } catch (ef) { if (/pictur|photo|image|写真|url/i.test(String(ef.message))) { eps = uploadPictures_(imgs); fastPics = false; item = mkItem(); } } }

  // v113：オファーを付けて断られたら、オファーなしで今までどおりの事前チェックへ
  let verified = false;
  if (ofx) { try { trading_('VerifyAddFixedPriceItem', item); verified = true; } catch (e0) { if (/offer/i.test(String(e0.message))) { ofx = ''; item = mkItem(); try { zLog_('オファー', 'eBay がこの出品のオファーを断ったので、オファーなしで出品（あとで自動でもう一度オンにします）：' + String(e0.message).slice(0, 150)); } catch (e1) {} } } }   // v212：オファー以外の理由で断られたときは、オファーを付けたまま次の方法を試す
  if (!verified) try {
    trading_('VerifyAddFixedPriceItem', item);            // まず事前チェック
  } catch (e) {
    if (!rtp) throw new Error('事前チェックでエラー：' + e.message);
    // 国別送料 v2 で断られた → 今までの方法でもう一度
    rtp = null; item = mkItem();
    try { trading_('VerifyAddFixedPriceItem', item); } catch (e2) { throw new Error('事前チェックでエラー：' + e2.message); }
  }
  // v171：二重に出品しない（同じ行・同じ仕入れ先URLが、もう出品済みなら止める。ほかの処理と同時に動いても1回だけ）
  const dupLock = LockService.getDocumentLock(); dupLock.waitLock(120000);   // v237：30秒→2分（一度にたくさん送っても順番待ちで止まらないように）
  let out;
  try {
    const st0 = String(sh.getRange(row, P.STATUS).getValue() || ''), id0 = String(sh.getRange(row, P.ITEMID).getValue() || '').trim();
    if (st0 === '出品済み' || id0) throw new Error('二重出品を止めました：この行はもう出品済みです（eBay商品ID ' + id0 + '）');
    { const ck = zPrepCardKey_(r); if (ck && zListedCardKeys_().has(ck)) { sh.getRange(row, P.STATUS).setValue('重複（同じカードがもう eBay に出品中）'); throw new Error('二重出品を止めました：同じカード（' + ck.split('|')[0] + '）がもう出品中です'); } }   // v182：同じカードを別のお店から同時に出品しない
    const src0 = String(r[P.SRC - 1] || '').split('?')[0];
    if (src0) { const n0 = Math.max(1, sh.getLastRow() - 1), stv = sh.getRange(2, P.STATUS, n0, 1).getValues(), srv = sh.getRange(2, P.SRC, n0, 1).getValues(); if (stv.some((x, k) => k + 2 !== row && String(x[0]) === '出品済み' && String(srv[k][0] || '').split('?')[0] === src0)) throw new Error('二重出品を止めました：同じ仕入れ先の品が、出品作成でもう出品済みです'); }
    if (src0) { const l2 = listSheet_(); if (l2.getLastRow() > 1 && l2.getRange(2, LCOL.SRC_URL, l2.getLastRow() - 1, 1).getValues().some(x => String(x[0] || '').split('?')[0] === src0)) throw new Error('二重出品を止めました：同じ仕入れ先の品が、もう出品一覧にあります'); }
    out = trading_('AddFixedPriceItem', item);        // 問題なければ出品
    sh.getRange(row, P.ITEMID).setNumberFormat('@').setValue(out.root.getChildText('ItemID', out.ns));
    sh.getRange(row, P.STATUS).setValue('出品済み');
    SpreadsheetApp.flush();
  } finally { dupLock.releaseLock(); }
  const itemId = out.root.getChildText('ItemID', out.ns);
  // v101：eBayに登録された写真の枚数を確認して記録
  let onEbay = ebayPictureCount_(itemId);
  // v170：写真が足りない・0枚なら、その場で1枚ずつアップロードして入れ直す（写真なしの出品を残さない）
  // v175：eBay の写真サーバーにない写真（外のURL）が混ざっていても入れ直す
  const nonHosted = eps.some(u => !/ebayimg\.com/i.test(String(u)));
  if (onEbay >= 0 && (onEbay < imgs.length || nonHosted)) {
    try {
      const eps2 = uploadPictures_(imgs);
      trading_('ReviseFixedPriceItem', '<Item><ItemID>' + x_(itemId) + '</ItemID><PictureDetails>' + eps2.map(u => '<PictureURL>' + x_(u) + '</PictureURL>').join('') + '</PictureDetails></Item>');
      onEbay = ebayPictureCount_(itemId); eps = eps2;
      LAST_PHOTO_NOTE_ = (LAST_PHOTO_NOTE_ ? LAST_PHOTO_NOTE_ + '／' : '') + '写真が足りなかったので、アップロードして入れ直した（eBayに ' + onEbay + '枚）';
    } catch (e) { LAST_PHOTO_NOTE_ = (LAST_PHOTO_NOTE_ ? LAST_PHOTO_NOTE_ + '／' : '') + '⚠ 写真の入れ直しに失敗：' + String(e.message).slice(0, 120); }
  }
  photoLog_({ stage: '出品', url: r[P.SRC - 1], row: row, method: pcheck.method, page: pcheck.page, got: pcheck.got, sheet: imgs.length, passed: eps.length, ebay: onEbay, itemId: itemId,
    result: onEbay === eps.length ? 'OK（欠落なし）' : onEbay < 0 ? '出品済み（eBayの枚数は確認できず）' : '⚠ eBayの枚数が少ない', reason: pcheck.note });
  if (onEbay >= 0 && onEbay < eps.length) LAST_PHOTO_NOTE_ = (LAST_PHOTO_NOTE_ ? LAST_PHOTO_NOTE_ + '／' : '') + '⚠ eBayに登録された写真が ' + onEbay + '枚（渡したのは ' + eps.length + '枚）';
  sh.getRange(row, P.ITEMID).setNumberFormat('@').setValue(itemId);
  sh.getRange(row, P.STATUS).setValue('出品済み');
  if (sm.ja) sh.getRange(row, P.METHODLABEL).setValue(sm.ja);
  sh.getRange(row, P.NOTE).setValue('出品：' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'MM/dd HH:mm') + (cc.note ? '／' + cc.note : '') + (LAST_PHOTO_NOTE_ ? '／' + LAST_PHOTO_NOTE_ : ''));
  sh.getRange(row, P.GO).setValue(false);

  // 出品一覧にも追加（仕入れ値・仕入れURLつき）→ 在庫チェックに使う
  const ls2 = listSheet_();
  ls2.appendRow([itemId, sku, title, price, 'USD', qty, 0, '', '', false, '出品ツールで作成',
    'https://www.ebay.com/itm/' + itemId, r[P.COST - 1], r[P.SRC - 1], '', new Date(), '在庫あり（出品時）']);
  ls2.getRange(ls2.getLastRow(), LCOL.APPLY).insertCheckboxes();

  // 広告：eBayの推奨の広告率＋利益ルール（5.1%を超えない・利益が最低利益額を下回らない）
  try { sh.getRange(row, P.ADRATE).setValue(promoteListing_(itemId, sh.getRange(row, 1, 1, PREP_HEADERS.length).getValues()[0])); }
  catch (e) { sh.getRange(row, P.ADRATE).setValue('広告を付けられませんでした：' + e.message); }
  return itemId;
}

function x_(s) {
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&apos;');
}


/* =====================================================================
