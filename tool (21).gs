// v138：見張り役（1時間に1回）：検索が途中で止まっていたら続きを始める・毎日の検索がオフならオンに戻す
function zResearchWatchdog_() {
  const p = PropertiesService.getScriptProperties(), out = [];
  if (Z_GH_RESEARCH) return '';   // v242：GASのキーワード検索は動かさないので、見張り役も休む
