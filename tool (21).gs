      let j = {}; try { j = JSON.parse(body); } catch (e) {}
      (j.hits || []).forEach(h => items.push({ pt: Number(h.point && h.point.amount) || 0, url: String(h.url || ''), title: String(h.name || ''), price: Number(h.price) || 0, freeShip: !!(h.shipping && h.shipping.code === 2),
        cond: String(h.condition || '') === 'used' ? '中古' : '新品', desc: String(h.description || '').replace(/<[^>]+>/g, ' ').slice(0, 1000), store: h.seller ? String(h.seller.name || '') : '' }));
    } else {
      if (code === 404) return;
      if (code !== 200) { if (code === 401 || code === 403) { try { c.put('RK_DOWN', '認証エラー HTTP ' + code, 6 * 3600); } catch (e) {} } if (code === 429) { try { c.put('RK_DOWN', '回数の上限 HTTP 429', 1800); } catch (e) {} } errs.push('楽天：HTTP ' + code); return; }
      let j = {}; try { j = JSON.parse(body); } catch (e) {}
      (Array.isArray(j.items) ? j.items : Array.isArray(j.Items) ? j.Items : []).map(x => (x && (x.Item || x.item)) || x).forEach(it => {
        const raw = String(it.itemName || '');
        if (Number(it.availability) === 0 && st.inStock) return;
        if (st.usedOnly && !/中古|ユーズド|USED|美品/.test(raw)) return;
        const imgs = (it.mediumImageUrls || []).concat(it.smallImageUrls || []).map(x => typeof x === 'string' ? x : (x && x.imageUrl) || '').filter(x => x)
          .map(u => String(u).replace(/^http:/, 'https:').replace(/[?&]_ex=\d+x\d+/, '').replace(/\?$/, '')).filter((u, k2, a) => a.indexOf(u) === k2);
        items.push({ pt: Math.floor((Number(it.itemPrice) || 0) * (Math.max(1, Number(it.pointRate) || 1)) / 100), url: String(it.itemUrl || ''), title: rkClean_(raw), price: Number(it.itemPrice) || 0, freeShip: Number(it.postageFlag) === 0,
          cond: /中古|ユーズド|USED|美品/.test(raw) ? '中古' : '新品', desc: '沖縄・離島は別途（楽天の送料無料は沖縄を除くことが多いため、上限を足して判定）', store: '楽天：' + String(it.shopName || ''), images: imgs.slice(0, 20) });
      });
    }
  });
  return { items: items, errs: errs };
}

