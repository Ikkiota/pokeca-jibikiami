  let run = {}; try { run = JSON.parse(p.getProperty('KW_RUN') || '{}'); } catch (e) {}
  if (run.at && !run.stop) {
    const waiting = ScriptApp.getProjectTriggers().some(t => t.getHandlerFunction() === 'kwSearchContinue');
    const idle = Date.now() - (run.upd || run.at);
    if (!waiting && idle > 10 * 60 * 1000 && zTimeLeft_() > 20 * 60) { try { runSoon_('kwSearchContinue'); out.push('検索が ' + Math.round(idle / 60000) + '分止まっていたので、続き（' + (run.i || 0) + '件目から）を始めた'); } catch (e) { out.push('続きを始められなかった：' + e.message); } }
  }
  if (out.length) zLog_('見張り役', out.join('／'));
  return out;
}
