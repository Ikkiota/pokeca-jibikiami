/* ---------- 出品エラーを防ぐための補正 ---------- */
// 必須の仕様項目が抜けていたら埋める（例：本・雑誌の Author、Brand など）
function fillRequiredAspects_(specs, required, info) {
  const out = Object.assign({}, specs);
  const has = name => Object.keys(out).some(k => k.toLowerCase() === String(name).toLowerCase() && String(out[k]).trim());
  const pick = (req, wanted) => {
    if (!req.selectionOnly || !req.values.length) return wanted;
    const hit = req.values.find(v => v.toLowerCase() === String(wanted).toLowerCase());
    return hit || req.values.find(v => /does not apply|unbranded|unknown|various|n\/a/i.test(v)) || req.values[0];
  };
  required.forEach(req => {
    if (has(req.name)) return;
    const n = req.name.toLowerCase();
    let v;
    if (n === 'brand') v = info.brand || 'Unbranded';
    else if (n === 'author') v = 'Various';
    else if (n === 'publisher') v = info.brand || 'Does not apply';
    else if (n === 'language') v = 'Japanese';
    else if (/country.*(manufacture|origin)/.test(n)) v = /日本|japan/i.test(String(info.origin || '')) ? 'Japan' : 'Does not apply';
    else if (n === 'mpn' || n === 'model') v = info.model || 'Does not apply';
    else v = 'Does not apply';
    out[req.name] = pick(req, v);
  });
  return out;
}

