function zTr_(text, from, to) { try { return LanguageApp.translate(String(text || '').slice(0, 4500), from || '', to); } catch (e) { return ''; } }
function zSign_(body) { const st = getSettings_(); return 'Hi,\n\n' + body + '\n\nBest regards,\n' + (st.signature || ''); }
function zFloorForItem_(itemId) {
  const prep = prepSheet_();
  if (prep.getLastRow() < 2) return 0;
  const r = prep.getRange(2, 1, prep.getLastRow() - 1, PREP_HEADERS.length).getValues().find(v => String(v[P.ITEMID - 1]) === String(itemId));
  return r ? Math.ceil((Number(r[P.MINPRICE - 1]) || 0) * 100) / 100 : 0;
}
function zTracking_(itemId, buyer) {
  const since = new Date(Date.now() - 60 * 86400000).toISOString();
  const res = ebay_('get', '/sell/fulfillment/v1/order?limit=200&filter=' + encodeURIComponent('creationdate:[' + since + '..]'));
  const o = (res.orders || []).find(x => String((x.buyer || {}).username || '') === String(buyer) && (x.lineItems || []).some(li => String(li.legacyItemId) === String(itemId)));
  if (!o) return { found: false };
  if (!(o.fulfillmentHrefs || []).length) return { found: true, shipped: false };
  const f = ebay_('get', '/sell/fulfillment/v1/order/' + encodeURIComponent(o.orderId) + '/shipping_fulfillment');
  const sf = (f.fulfillments || [])[0];
  return sf ? { found: true, shipped: true, number: sf.shipmentTrackingNumber || '', carrier: sf.shippingCarrierCode || '' } : { found: true, shipped: false };
}
// 1通の下書き（返す：reply が空なら「人へ」）
function zDraftOne_(msg, itemId, buyer) {
  const t = String(msg || '');
  if (ZT_HUMAN.test(t)) return { reply: '', note: '要確認：返品・返金・破損・未着・キャンセル・eBayの外への誘導などの言葉があるので、自分で返信してください' };
  // 値下げ交渉
  const am = t.match(/\$\s*(\d{1,5}(?:\.\d{1,2})?)|(\d{1,5}(?:\.\d{1,2})?)\s*(?:usd|dollars?)/i);
  if (/offer|discount|lower|best price|cheaper|deal|reduce/i.test(t) || (am && /can you do|would you (take|accept)|accept|how about|for \$/i.test(t))) {
    const floor = zFloorForItem_(itemId);
    if (!(floor > 0)) return { reply: '', note: '要確認：値下げの相談ですが、最低利益を守れる価格が分からない商品です' };
    const amt = am ? Number(am[1] || am[2]) : 0;
    let offerOn = false; try { offerOn = offerSettings_().on; } catch (e) {}
    if (!offerOn) return { reply: '', note: '要確認：値下げの相談（' + (amt ? '$' + amt.toFixed(2) + '・' : '') + '最低利益を守れる下限 $' + floor.toFixed(2) + '）。オファー（「追加の設定」F231）がオフなので、自分で返信してください' };
    if (amt && amt >= floor) return { reply: zSign_('Thank you for your offer! We can accept $' + amt.toFixed(2) + '. Please send it using the "Make Offer" button on the listing, and we will accept it.'), note: '値下げ交渉：$' + amt.toFixed(2) + ' は最低利益を守れる（下限 $' + floor.toFixed(2) + '）' };
    return { reply: zSign_('Thank you for your interest! The best price we can offer for this item is $' + floor.toFixed(2) + '. If that works for you, please send an offer using the "Make Offer" button.'), note: '値下げ交渉：' + (amt ? '$' + amt.toFixed(2) + ' は最低利益を割るので、' : '') + '下限 $' + floor.toFixed(2) + ' を案内' };
  }
  // 発送・追跡
  if (/tracking|shipped|ship it|when will|where is|\barrive\b|delivery|status of my order/i.test(t) && !/arrived|received|got it|came today/i.test(t)) {
    try {
      const tr = zTracking_(itemId, buyer);
      if (tr.shipped && tr.number) return { reply: zSign_('Thank you for your message. Your order has been shipped. The tracking number is ' + tr.number + (tr.carrier ? ' (' + tr.carrier + ')' : '') + '. Please allow a little time for the tracking information to update.'), note: '発送状況：eBayの注文から追跡番号を入れた' };
      if (tr.found && !tr.shipped) return { reply: '', note: '要確認：まだ発送していない注文です（発送日は約束しないで、自分で返信してください）' };
    } catch (e) { return { reply: '', note: '要確認：注文を読めませんでした（' + String(e.message).slice(0, 60) + '）' }; }
    return { reply: '', note: '要確認：注文が見つかりませんでした' };
  }
  // テンプレ
  const tpl = zTplSheet_(), tv = tpl.getLastRow() > 1 ? tpl.getRange(2, 1, tpl.getLastRow() - 1, ZT_HEAD.length).getValues() : [];
  const low = t.toLowerCase();
  const hit = tv.find(r => String(r[1] || '').split(/[,、]/).map(w => w.trim().toLowerCase()).filter(w => w).some(w => low.indexOf(w) >= 0) && String(r[2] || '').trim());
  if (hit) return { reply: zSign_(String(hit[2]).trim()), note: '返信テンプレ「' + hit[0] + '」' };
  if (/thank/i.test(t) && t.length < 200) return { reply: zSign_('Thank you very much for your message!'), note: 'お礼だけの短いメッセージ' };
  return { reply: '', note: '要確認：テンプレに合う場面がありませんでした（「返信テンプレ」シートに言葉を足すと、次から下書きします）' };
}
function draftRepliesFree_(limit) {
  const sh = sheet_('メッセージ');
  const last = sh.getLastRow();
  if (last < 2) return { drafted: 0 };
  const data = sh.getRange(2, 1, last - 1, MSG_HEADERS.length).getValues();
  let drafted = 0;
  for (let i = 0; i < data.length && drafted < limit; i++) {
    const r = data[i], row = i + 2;
    if (!String(r[COL.STATUS - 1]).startsWith('新着') || r[COL.REPLY - 1]) continue;
    try {
      const msg = String(r[COL.MSG - 1] || '');
      const d = zDraftOne_(msg, r[COL.ITEM - 1], r[COL.BUYER - 1]);
      sh.getRange(row, COL.MSG_JA, 1, 3).setValues([[zTr_(msg, '', 'ja'), d.reply, d.reply ? zTr_(d.reply, 'en', 'ja') : '']]);
      sh.getRange(row, COL.STATUS).setValue(d.reply ? '下書き済み（確認してください）' : '要確認（自分で返信）');
      sh.getRange(row, COL.NOTE).setValue('無料の下書き：' + d.note);
      drafted++;
    } catch (e) { sh.getRange(row, COL.NOTE).setValue('下書きエラー：' + e.message); }
  }
  return { drafted: drafted };
}
function jaToEnFree_(ja) {
  const st = getSettings_();
  let en = zTr_(String(ja).replace(new RegExp(String(st.signature || '___').replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\s*$'), '').trim(), 'ja', 'en');
  if (!en) throw new Error('Googleの翻訳が使えませんでした。少し時間をおいてもう一度押してください');
  if (!/Best regards/i.test(en)) en += '\n\nBest regards,\n' + (st.signature || '');
  return en.slice(0, 2000);
}

