  if (sp.AU && sp.AU.length) lists.push({ cc: 'AU', key: 'AU', list: sp.AU });
  if (!lists.length) return null;
  const eco = Number(off.ecoSurcharge) || 0;
  // 重さの区分：料金表にある区分をすべて（g）
  const W = Array.from(new Set([].concat.apply([], lists.map(x => x.list.map(r => Number(r[0])))))).filter(g => g > 0).sort((a, b) => a - b);
  let nt = null; try { if (typeof rwFuelNotice_ === 'function') nt = rwFuelNotice_('SpeedPAK Economy'); } catch (e) {}
  let master = ''; try { const s = ss_().getSheetByName('送料マスタ'); if (s) master = s.getRange(5, 3, 4, 1).getValues().map(r => r[0] instanceof Date ? Utilities.formatDate(r[0], 'Asia/Tokyo', 'yyyy/MM/dd') : String(r[0] || '')).filter(x => x).join('・'); } catch (e) {}
  const sh = apSheet_('送料表（SpeedPAK Economy）').sh;
  sh.clear();
  const today = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy/MM/dd');
  const pct = x => (Math.round(x * 1000) / 10) + '%';
  const label = g => g < 1000 ? g + 'g' : (g % 1000 === 0 ? g / 1000 : (g / 1000).toFixed(g % 100 === 0 ? 1 : 2)) + 'kg';
  const notes = [
    '料金表：eBay SpeedPAK Economy（Orange Connex）の料金表Excel を「送料マスタ」に毎月自動で取り込んだ基本料金（最終取り込み：' + (master || '未取り込み') + '）× （1＋燃油サーチャージ ' + pct(eco) + '）',
    '燃油サーチャージ：' + pct(eco) + '（' + (nt ? 'オレンジコネックスのお知らせ・' + Utilities.formatDate(nt.eff, 'Asia/Tokyo', 'yyyy/MM/dd') + ' 発効' : '正式シートのエコノミー送料 G11') + '）。お知らせメールが届くと自動で変わり、この表も自動で作り直します',
    '重さの列は「その重さまで」。料金は「請求重量」で見る：実重量と 容積重量（縦×横×高さ cm ÷ 8,000）の重いほう',
    '米国あての条件：本土48州だけ（アラスカ・ハワイ・プエルトリコなどは別料金）・商品価格1,200ドルまで・長さ66cmまで・長さ＋2×(幅＋高さ)が274cmまで。ほかの国の条件は料金表で確認',
    'この表に入っていない国は、SpeedPAK Economy では送れません（FedEx・DHL・国際エアパケット・EMSを使います）。関税・通関の手数料は別'];
  let r = 1;
  sh.getRange(r++, 1).setValue('SpeedPAK Economy 送料表　' + today + '作成・円・燃油サーチャージ ' + pct(eco) + '込み').setFontWeight('bold').setFontSize(13);
  notes.forEach(n => sh.getRange(r++, 1).setValue(n).setFontColor('#555555'));
  r++;
  const headRow = r;
  sh.getRange(headRow, 1, 1, 5 + W.length).setValues([['国', 'コード', 'グループ', 'eBayの地域', '料金表'].concat(W.map(g => label(g) + 'まで'))]).setFontWeight('bold').setBackground('#e8f0fe').setWrap(true);
  const rows = lists.map(x => {
    const c = IC_COUNTRIES[x.cc] || [];
    const nm = x.cc === 'US' ? IC_SPK_NAMES.US[0] : (c[0] || x.cc);
    return [nm, x.cc, x.cc === 'US' ? '米国' : icGroupName_(c[4] || ''), c[5] || (IC_SPK_NAMES[x.key] || [])[1] || '', x.key].concat(W.map(g => { const hit = x.list.find(q => Number(q[0]) >= g); return hit ? Math.round(Number(hit[1]) * (1 + eco)) : '—'; }));
  });
  sh.getRange(headRow + 1, 1, rows.length, 5 + W.length).setValues(rows);
  sh.getRange(headRow + 1, 6, rows.length, W.length).setNumberFormat('#,##0');
  sh.setFrozenRows(headRow); sh.setFrozenColumns(2);
  sh.setColumnWidth(1, 190); sh.setColumnWidth(2, 50); sh.setColumnWidth(3, 110); sh.setColumnWidth(4, 130); sh.setColumnWidth(5, 70);
  for (let i = 0; i < W.length; i++) sh.setColumnWidth(6 + i, 66);
  return { sheet: sh, countries: rows.length, weights: W.length, eco: eco };
}
// 料金・燃油サーチャージが変わったら、送料表（FedEx・DHL・EMS・SpeedPAK Economy）を自動で作り直す（毎日11時台）
