  const fTxt = Object.keys(stt.f).sort((x, y) => stt.f[y] - stt.f[x]).slice(0, 5).map(k => k + ' ' + stt.f[k]).join('・');
  const msg = '今日 ' + stt.q + '語・見つけた ' + stt.found + '品・候補に入れた ' + stt.sent + '品（今回 ' + n + '語・' + a + '品）' + (fTxt ? '｜外した理由（今日）：' + fTxt : '');
  zLog_('お店API（昼）', msg.slice(0, 1200));
  return msg;
}


