      if (r) { try { did = promoteListing_(it.id, prep.getRange(r, 1, 1, PREP_HEADERS.length).getValues()[0]); prep.getRange(r, P.ADRATE).setValue(did); if (/^広告 5\.1%/.test(did)) out.fixed++; else out.cannot++; } catch (e) { did = '❌ ' + String(e.message).slice(0, 150); out.cannot++; } }
      else { try { did = (function () { const cid = adCampaignId_(); ebay_('post', '/sell/marketing/v1/ad_campaign/' + cid + '/bulk_create_ads_by_listing_id', { body: { requests: [{ listingId: it.id, bidPercentage: '5.1' }] } }); const c = verifyAdRate_(it.id); return '広告 ' + c.rate + '%（出品作成に記録なし・5.1%で付けた）'; })(); if (/^広告 5\.1/.test(did)) out.fixed++; else out.cannot++; } catch (e) { did = '❌ ' + String(e.message).slice(0, 150); out.cannot++; } }
    } else if (fix && !/✅/.test(judge)) { out.more = true; }
    rows.push([now, it.id, it.t, it.price, a ? a.rate : '', judge, did]);
