  cands.push([ymax, 0]);
  cands.push([0, Math.max.apply(null, P.map(p => p[1] / p[0]))]);
  let best = null;
  cands.forEach(c => {
    let a = c[0], b = c[1];
    if (b < 0) { b = 0; a = ymax; }
    if (a < 0) { a = 0; b = Math.max.apply(null, P.map(p => p[1] / p[0])); }
    a = Math.ceil(a * 100 - 1e-6) / 100; b = Math.ceil(b * 100 - 1e-6) / 100;
    if (!P.every(p => a + b * p[0] >= p[1] - 1e-9)) return;
