    const bp = Math.max(1, Math.ceil(kws.length / 30)), bg = Math.floor((now + 9 * 3600000) / dayMs) % bp;
    kws.slice(bg * 30, bg * 30 + 30).forEach(q => { seen[q] = 1;
      const merc = 'https://jp.mercari.com/search?keyword=' + encodeURIComponent(q) + '&status=on_sale&sort=created_time&order=desc&price_min=1000&price_max=60000#ebaytool-fl';
      const yf = 'https://paypayfleamarket.yahoo.co.jp/search/' + encodeURIComponent(q) + '?open=1&sort=openTime&order=desc&minPrice=1000&maxPrice=60000#ebaytool-fl';
      rows.push(['（広く探す）', q, '', merc, yf]); }); } } catch (e) {}
  if (rows.length) {
    sh.getRange(2, 1, rows.length, 5).setValues(rows);
    sh.getRange(2, 4, rows.length, 2).setRichTextValues(rows.map(r => [SpreadsheetApp.newRichTextValue().setText('メルカリで開く').setLinkUrl(r[3]).build(), SpreadsheetApp.newRichTextValue().setText('Yahoo!フリマで開く').setLinkUrl(r[4]).build()]));
    sh.getRange(1, 7).setValue('まとめて開く（チェック）').setFontWeight('bold').setBackground('#e6f4ea');   // v195
    sh.getRange(2, 7, rows.length, 1).insertCheckboxes();
    try { ss.setActiveSheet(sh); ss.moveActiveSheet(1); } catch (e) {}   // v206：いちばん左へ（書き終わってから）
    try { ss.getSheets().filter(x => /^フリマで探す（\d\d\/\d\d）$/.test(x.getName())).slice(14).forEach(x => ss.deleteSheet(x)); } catch (e) {}   // 新しい14日分だけ残す
    try { const old = ss.getSheetByName(FL_SHEET); if (old && !old.isSheetHidden()) old.hideSheet(); } catch (e) {}
  }
  [140, 220, 110, 150, 170, 360].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(1);
  sh.getRange(rows.length + 3, 1).setValue('使い方：リンクを開く → 検索結果が出たら、ブックマークの「検索結果を送る」を押す → 自動で判定して「出品候補（0円）」へ（AIなし・0円）。仕入れ上限の高い型番から並んでいます。').setFontColor('#555555');
  sh.activate();
  return rows.length;
}
