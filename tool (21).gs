    .addSeparator()
    .addItem('リサーチを実行', 'runResearch')
    .addItem('eBayの検索結果を1件ずつ調べる（URLを貼る）', 'surveyEbaySearch')
    .addItem('リサーチ候補を今すぐ調べる', 'menuResearchQueue')
    .addSeparator()
    .addItem('仕入れ候補を処理する（①〜⑨）', 'menuProcessIntake')
