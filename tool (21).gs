/* =====================================================================
 * v101：仕入れ先ページの写真を「すべて」集める（ボタンの中で、ブラウザ上で動く関数）
 *  ・この関数はApps Scriptでは実行しません。文字列にしてボタン（ブックマークレット）に埋め込みます
 *  ・メルカリ：ページ内の「この商品のID＋写真番号」をすべて拾い、番号順に並べる（サムネイル用の縮小URLも元画像に直す）
 *  ・ヤフオク／Yahoo!フリマ：ページ内の出品画像（サムネイルの縮小URLは元画像に直す）。ほかの商品へのリンクの中の画像は使わない
 *  ・Amazon：商品画像の一覧（colorImages）
 *  ・その他：構造化データ（JSON-LD）のすべての画像＋写真エリアの画像（遅延読み込みでまだ表示されていない画像も含む）
 *  ・重複を除き、ページの順番どおり。eBayの上限24枚まで
 *  返り値：images（URL）、pageCount（ページで見つかった写真の数）、method（取得方法）、notes（気になる点）
 * ===================================================================== */
function collectSourceImages__() {
  var MAX = 24, out = [], seen = {}, notes = [], method = '', pageCount = 0;
  var host = location.hostname;
  var html = document.documentElement.innerHTML;
  function abs(u) {
    u = String(u || '').trim().replace(/&amp;/g, '&');
    if (!u || /^data:/i.test(u)) return '';
    if (u.indexOf('//') === 0) u = 'https:' + u;
    else if (u.charAt(0) === '/') u = location.origin + u;
    return u;
  }
  function base(u) { return u.split('#')[0].split('?')[0]; }
  function bad(u) { return /sprite|play-icon|transparent|blank\.gif|spacer|loading|placeholder|\/logo|logo[._-]|\/icons?\/|[._-]icon[._-]|banner|noimage|no_image|na_170x170/i.test(base(u)); }
  function add(u) {
    u = abs(u);
    if (!/^https?:/i.test(u) || bad(u)) return false;
    var b = base(u);
    if (seen[b]) return false;
    seen[b] = 1; out.push(u); return true;
  }
  function largest(ss) {
    if (!ss) return '';
    var best = '', bw = -1;
    String(ss).split(',').forEach(function (p) { var a = p.trim().split(/\s+/); var w = parseFloat(a[1]) || 1; if (a[0] && w >= bw) { bw = w; best = a[0]; } });
    return best;
  }
  function srcsOf(i) {
    return [i.getAttribute('data-zoom-image'), i.getAttribute('data-large'), i.getAttribute('data-original'), i.getAttribute('data-src'),
      i.getAttribute('data-lazy-src'), largest(i.getAttribute('srcset')), largest(i.getAttribute('data-srcset')), i.currentSrc, i.getAttribute('src')]
      .filter(function (x) { return x && !/^data:/i.test(x); });
  }
  function linksElsewhere(el) {
    var here = location.pathname;
    for (var e = el; e && e !== document.body; e = e.parentElement) {
      if (e.tagName === 'A') {
        var hr = e.getAttribute('href') || '';
        if (hr && hr.charAt(0) !== '#' && hr.indexOf(here) < 0 && !/\.(jpe?g|png|webp|gif)(\?|$)/i.test(hr)) return true;
      }
      if (/^(HEADER|FOOTER|NAV|ASIDE)$/.test(e.tagName)) return true;
    }
    return false;
  }

  /* ---------- メルカリ（通常の出品） ---------- */
  var mid = (location.pathname.match(/\/item\/(m\d+)/) || [])[1];
  if (/mercari\.com$/.test(host) && mid) {
    method = 'メルカリ（写真番号）';
    var re = new RegExp('/item/detail/orig/photos/' + mid + '_(\\d+)\\.(jpe?g|png|webp)(\\?\\d+)?', 'g'), m, nums = {}, ts = '';
    while ((m = re.exec(html)) !== null) { nums[+m[1]] = 1; if (m[3] && !ts) ts = m[3]; }
    var list = Object.keys(nums).map(Number).sort(function (a, b) { return a - b; });
    if (list.length) {
      var mx = list[list.length - 1];
      pageCount = Math.max(list.length, mx);
      var miss = [];
      for (var n = 1; n <= mx; n++) if (!nums[n]) miss.push(n);
      if (miss.length) notes.push('写真番号 ' + miss.join(',') + ' がページ内に見つかりません');
      list.forEach(function (n) { add('https://static.mercdn.net/item/detail/orig/photos/' + mid + '_' + n + '.jpg' + ts); });
    }
  }

  /* ---------- ヤフオク・Yahoo!フリマ ---------- */
  if (!out.length && /auctions\.yahoo\.co\.jp$|paypayfleamarket\.yahoo\.co\.jp$/.test(host)) {
    method = /paypay/.test(host) ? 'Yahoo!フリマ（ページの画像）' : 'ヤフオク（ページの画像）';
    var thumbs = [], all = [];
    var full = function (s) { var mm = String(s).match(/(images\.auctions\.yahoo\.co\.jp\/image\/[^?#"'\s]+?\.(?:jpe?g|png|gif|webp))/i); return mm ? 'https://auctions.c.yimg.jp/' + mm[1] : ''; };
    document.querySelectorAll('img').forEach(function (i) {
      if (linksElsewhere(i)) return;
      srcsOf(i).forEach(function (s) {
        var f = full(s);
        if (!f) return;
        all.push(f);
        if (/auc-pctr\.c\.yimg\.jp/.test(s) && /[?&]w=\d+/.test(s)) thumbs.push(f);   /* サムネイルの並び＝ページの掲載順 */
      });
    });
    thumbs.concat(all).forEach(add);
    pageCount = out.length;
  }

  /* ---------- Amazon ---------- */
  if (!out.length && /amazon\./.test(host)) {
    method = 'Amazon（商品画像の一覧）';
    var cm = html.match(/'colorImages'\s*:\s*\{\s*'initial'\s*:\s*(\[[\s\S]*?\])\s*\}/);
    if (cm) { try { JSON.parse(cm[1]).forEach(function (o) { add(o.hiRes || o.large); }); } catch (e) { notes.push('Amazonの画像一覧を読めませんでした'); } }
    if (!out.length) {
      var li = document.querySelector('#landingImage');
      if (li) add(li.getAttribute('data-old-hires') || li.src);
      document.querySelectorAll('#altImages img').forEach(function (i) { add(String(i.src).replace(/\._[^.\/]+_\./, '.')); });
    }
    pageCount = out.length;
  }

  /* ---------- その他のショップ ---------- */
  if (!out.length) {
    method = 'ページの画像（構造化データ＋写真エリア）';
    document.querySelectorAll('script[type="application/ld+json"]').forEach(function (s) {
      try {
        var j = JSON.parse(s.textContent);
        (Array.isArray(j) ? j : [j]).forEach(function (o) {
          (o['@graph'] || [o]).forEach(function (p) {
            if (p && /Product/i.test(p['@type'])) { var im = p.image; (Array.isArray(im) ? im : [im]).forEach(function (x) { add(x && x.url ? x.url : x); }); }
          });
        });
      } catch (e) {}
    });
    var badBox = /recommend|related|similar|ranking|history|footer|header|nav|banner|advert|\bad-|suggest|other-item|seller-item|おすすめ|関連/i;
    var main = document.querySelector('main') || document.querySelector('#main') || document.body;
    main.querySelectorAll('img').forEach(function (i) {
      if (linksElsewhere(i)) return;
      for (var e = i; e && e !== document.body; e = e.parentElement) {
        var c = (e.id || '') + ' ' + (typeof e.className === 'string' ? e.className : '');
        if (badBox.test(c)) return;
      }
      var loaded = i.complete && i.naturalWidth > 0;
      var w = loaded ? i.naturalWidth : (parseInt(i.getAttribute('width'), 10) || 0);
      var hgt = loaded ? i.naturalHeight : (parseInt(i.getAttribute('height'), 10) || 0);
      var lazy = i.getAttribute('data-src') || i.getAttribute('data-original') || i.getAttribute('data-lazy-src') || i.getAttribute('data-srcset') || i.getAttribute('data-zoom-image');
      /* 小さい画像（サムネイル）は、拡大画像へのリンクがあればそれを使う */
      var a = i.closest ? i.closest('a') : null;
      var ah = a ? a.getAttribute('href') || '' : '';
      if (/\.(jpe?g|png|webp)(\?|$)/i.test(ah)) { add(ah); return; }
      if (loaded && (w < 250 || hgt < 250)) return;
      if (!loaded && !lazy && w && w < 150) return;
      add(srcsOf(i)[0]);
    });
    if (!out.length) add((document.querySelector('meta[property="og:image"]') || {}).content);
    pageCount = out.length;
  }

  if (out.length === 1) notes.push('写真が1枚しか見つかりませんでした（ページの写真が本当に1枚か確認してください）');
  if (pageCount > MAX) notes.push('ページの写真 ' + pageCount + '枚のうち、eBayの上限の' + MAX + '枚まで使います');
  return { images: out.slice(0, MAX), pageCount: pageCount || out.length, method: method, notes: notes };
}

/* =====================================================================
 * v101：写真の記録・チェック
