    if (!codes[ecoCat] || !codes.EXPEDITED) throw new Error('安い便・速い便に使えるeBayの配送サービスが見つかりません（' + JSON.stringify(codes) + '）');
    // レートテーブルに入っていない国のための金額（安全側：いちばん高い国の、上限の重さの金額）
    const live = JSON.parse(PropertiesService.getScriptProperties().getProperty('RT_LIVE'));
    const kgU = rs.unit === 'lb' ? rs.maxKg * RT_LB : rs.maxKg;
    // レートテーブルの行に入っていない国の送料（ポリシーの定額）：送る国ぜんぶの中でいちばん高い国の、上限の重さの金額（安全側）
    const stF = icSettings_(); const fxF = Number(official_().rate) || 150; const allCcs = rtShipCountries_();
    const fbMap = {};
    const fb = cat => {
      if (fbMap[cat] != null) return fbMap[cat];
      const f = rtFitFor_(allCcs, cat, rs, stF, fxF);
      const fromTable = Math.max.apply(null, live.rates.filter(r => r.cat === cat).map(r => r.a + r.b * kgU).concat([0]));
      return (fbMap[cat] = Math.ceil(Math.max(fromTable, f ? f.a + f.b * rs.maxKg : 0)));
    };
    const ecoCcs = rtEcoCountries_(rs, stF, allCcs);
    const svc = (cat, i) => {
      const v = fb(cat);
      // v165：$0 は「どの国・どの重さでも米国向けの送料（商品の値段に含めている）より安い」という意味なので正しい。計算できない（NaN・マイナス）ときだけ止める
      if (!(v >= 0) || !isFinite(v)) throw new Error(RT_LABEL[cat] + 'の定額の送料が計算できません（' + v + '）。燃油サーチャージ・料金表を確かめてください');
