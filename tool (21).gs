            const cs = /^[A-Z]{2}$/.test(loc) ? [loc] : rtRegionCountries_(loc, shipTo);
            (cs || []).forEach(cc => { if (shipTo.indexOf(cc) >= 0 && (byCc[cc] == null || c < byCc[cc])) byCc[cc] = c; });
          });
        });
        Object.keys(byCc).forEach(cc => {
          const c = icCountryCost_(cc, w, box, Object.assign({}, st, { highOnly: price >= highUsd }));
          if (!c) { short.push([cc, 'ALL', null]); return; }
          const need = Math.max(0, (c.yen - us) / rfx / (1 - feeR));
