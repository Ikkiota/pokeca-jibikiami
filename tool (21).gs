          const why = !/未鑑定|未開封/.test(g) && !/PSA\s*\d+\s*相当/.test(t) ? '外した：鑑定品（PSA など・1点物）は候補にしない（v202）' : Z_JUNK.test(t) ? '外した：まとめ売り・中国語版など（v202）' : '';
