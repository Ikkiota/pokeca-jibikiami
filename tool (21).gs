    });
    if (unknown.length) { bad.push('地域「' + unknown.join('・') + '」の国が分かりません（行 ' + r.rateId + '）'); return; }
    // v110：米国だけの行は、米国向けの送料との差＝0ドル（基本0・重さあたり0）を入れる
    if (!list.length && (r.shippingRegionNames || []).length && (r.shippingRegionNames || []).every(n => rtNameToCode_(n) === 'US')) {
