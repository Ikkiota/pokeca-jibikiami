      '<tr style="font-weight:bold"><td>合計</td><td style="text-align:right">$' + b.total.toFixed(2) + '</td><td></td></tr></table>' +
      (Math.abs(b.total - b.reported) > 0.01 && b.reported ? '<p style="color:#b00">eBayが報告している手数料合計：$' + b.reported.toFixed(2) + '</p>' : '') +
      '</div>').setWidth(560).setHeight(420);
    ui.showModalDialog(html, '手数料の内訳');
  } catch (e) {
    ui.alert('エラー：' + e.message);
  }
}


