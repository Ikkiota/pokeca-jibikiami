  sh.getRange('E2:E5').setValues([['自動送信する'], ['件名'], ['本文'], ['配達完了が分からないとき、発送から何日後に送るか']]).setFontWeight('bold');
  sh.getRange('F2').insertCheckboxes().setValue(false);
