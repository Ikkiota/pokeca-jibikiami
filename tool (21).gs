  P.forEach(p => { const o = best.a + best.b * p[0] - p[1]; if (o > mo.usd) mo = { usd: o, kg: p[0] }; });
  return { a: best.a, b: best.b, maxOver: Math.round(mo.usd * 100) / 100, maxOverKg: mo.kg };
